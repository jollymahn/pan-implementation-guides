# Shape of the file the SCM Gateway Registration wizard produces.
#
# Download the real one from Strata Cloud Manager:
#   AI Gateway > Admin Settings > Gateway Registration >
#   Configure Gateway Deployment > Download values.yaml
#
# Save it beside this file as values.yaml. Do not hand-write it, and do not
# commit it: it carries a live registry password and Client Auth Key. Keep a
# backup in a password manager.
#
# Terraform layers the Service block and the JWT settings on top of this file,
# so there is nothing to add by hand. LOG_STORE stays unset on purpose; see the
# comment in locals.tf.

imageCredentials:
  - name: airsgatewayregistrycredentials
    create: true
    registry: "https://registry.portkey.ai"
    username: REPLACED_BY_SCM_WIZARD
    password: REPLACED_BY_SCM_WIZARD

environment:
  create: true
  secret: true
  data:
    PORTKEY_CLIENT_AUTH: REPLACED_BY_SCM_WIZARD
    ORGANISATIONS_TO_SYNC: REPLACED_BY_SCM_WIZARD
