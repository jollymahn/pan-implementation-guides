###############################################################################
# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
# The defaults in variables.tf already match the configuration this lab was
# validated with on a $200 free-credit subscription, so an empty tfvars file is
# a working file. Everything below is an override.
###############################################################################

# ── Placement ────────────────────────────────────────────────────────────────
# prefix   = "aigw-lab"
# location = "centralus"

# ── Free-tier footprint (the validated default) ──────────────────────────────
# 1 AKS node (2 vCPU) + 1 Windows VM (2 vCPU) = 4 vCPUs, which is the whole
# Total Regional Cores quota. Keycloak goes behind an internal load balancer so
# the Windows VM can have the third Standard public IP.
#
# lab_mode             = true
# aks_node_count       = 1
# deploy_windows_vm    = true
# keycloak_internal_lb = true

# ── Larger subscription ──────────────────────────────────────────────────────
# With an 8 vCPU quota and 4 public IPs, run two nodes and the VM together and
# put Keycloak on a public address so its admin console opens in a browser on
# your workstation.
#
# lab_mode             = false
# regional_core_quota  = 8
# public_ip_quota      = 4
# aks_node_count       = 2
# keycloak_internal_lb = false

# ── Keycloak durability ──────────────────────────────────────────────────────
# A 4 GiB managed disk holds the H2 database, so a pod restart keeps the realm
# and keeps the signing keys behind the JWKS you paste into SCM. Turning this
# off reverts to a Keycloak that loses both on every restart, and SCM gives no
# hint when it happens: tokens are simply rejected.
#
# keycloak_persistence   = true
# keycloak_storage_size  = "4Gi"
# keycloak_storage_class = "managed-csi"

# ── Node and VM sizing ───────────────────────────────────────────────────────
# Standard_B2s and Standard_B2als_v2 are commonly rejected on free-tier
# subscriptions with VMSizeNotSupported, RestrictedVMSize, or SkuNotAvailable.
# Standard_D2als_v7 is the size that succeeded for both the AKS nodes and the
# Windows VM. If you change either size, update the matching vcpus variable so
# the quota precondition stays honest.
#
# aks_node_vm_size = "Standard_D2als_v7"
# aks_node_vcpus   = 2
# windows_vm_size  = "Standard_D2als_v7"
# windows_vm_vcpus = 2

# ── Gateway ──────────────────────────────────────────────────────────────────
# Path to the values.yaml downloaded from the SCM Gateway Registration wizard,
# relative to this directory.
#
# scm_values_file = "values.yaml"

# Turn on once you reach Phase 6. The gateway then validates Keycloak-issued
# bearer tokens against the JWKS pasted into SCM.
#
# enable_jwt_auth = false

# ── Credentials ──────────────────────────────────────────────────────────────
# Leave both unset to have Terraform generate them, then read them back with
#   terraform output -raw keycloak_admin_password
#   terraform output -raw windows_admin_password
#
# keycloak_admin_password = "..."
# windows_admin_password  = "..."

# ── Access ───────────────────────────────────────────────────────────────────
# Restrict RDP to your own address. Find it with: curl -s ifconfig.me
#
# rdp_source_address_prefix = "203.0.113.42/32"

# ── Phase 6 only ─────────────────────────────────────────────────────────────
# Creates the container registry the JWT demo app image is pushed to.
#
# deploy_acr = false
