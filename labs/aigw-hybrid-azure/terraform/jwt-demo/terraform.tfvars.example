###############################################################################
# Copy to terraform.tfvars and fill in the four required values.
#
# Run the root module first. These four come from its outputs and from SCM.
###############################################################################

# From SCM: Workspace Control > <your workspace> > Settings, shown top right.
# The slug, not the display name. A display name here produces
# "Following keys are not valid: openai" on every request.
portkey_workspace_slug = "ws-example-a-7c41b9"

# From the root module: terraform -chdir=.. output -raw scm_gateway_url
gateway_url = "http://203.0.113.10/v1"

# From the root module: terraform -chdir=.. output -raw keycloak_url
keycloak_browser_url = "http://10.0.1.250"

# From the root module: terraform -chdir=.. output -raw keycloak_admin_password
keycloak_admin_password = "..."

# Printed by ./build-and-push.sh
app_image = "aigwlabacrx1y2z3.azurecr.io/jwt-demo-app:v1"

# ── Optional ─────────────────────────────────────────────────────────────────
# kubeconfig_context = "aigw-lab-aks"
# keycloak_admin_url = "http://127.0.0.1:8081"   # the port-forward address
# realm_name         = "aigw-lab"
# test_username      = "testuser"
# gateway_model      = "@openai/gpt-4o-mini"
