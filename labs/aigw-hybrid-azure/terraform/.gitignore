# The SCM wizard's values file carries the registry password and the
# PORTKEY_CLIENT_AUTH key. It never gets committed.
values.yaml
*values*.yaml
!values.yaml.example

# State holds the generated Keycloak and Windows passwords in clear text.
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars
*.auto.tfvars
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
