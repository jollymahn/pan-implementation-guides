<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="Management Plane Flow" id="aigw-management-plane-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Management plane &amp;mdash; why the link is outbound only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;The gateway always initiates. SCM never calls in.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="620" height="48" as="geometry"/>
        </mxCell>

        <!-- ══ Your environment ══ -->
        <mxCell id="your-env" value="&lt;b&gt;Your Azure subscription&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px;&quot;&gt;(no inbound ports opened)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;fontSize=13;fontFamily=Helvetica;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="30" y="85" width="420" height="500" as="geometry"/>
        </mxCell>

        <mxCell id="gw-pod" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="140" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="gw-pod-label" value="&lt;b&gt;airs-gw gateway pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Holds PORTKEY_CLIENT_AUTH and&lt;br&gt;ORGANISATIONS_TO_SYNC from values.yaml&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="gw-icon" value="&#x1f6e1;&#xfe0f;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="222" y="205" width="36" height="30" as="geometry"/>
        </mxCell>

        <!-- Log store (the thing that does not work) -->
        <mxCell id="logstore" value="&lt;b&gt;LOG_STORE&lt;/b&gt;&amp;nbsp;&lt;font style=&quot;font-size:10px;&quot;&gt;(left unset)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Blob storage inside your environment.&lt;br&gt;The gateway can write to it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dc2626;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="400" width="300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e-gw-logstore" value="" style="endArrow=block;html=1;strokeColor=#999999;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;" edge="1" parent="1" source="gw-pod" target="logstore">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-gw-logstore-label" value="&lt;font style=&quot;font-size:10px;&quot;&gt;write path&lt;br&gt;&lt;i&gt;works&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="248" y="305" width="80" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="logstore-note" value="&lt;font color=&quot;#dc2626&quot; style=&quot;font-size:10px;&quot;&gt;Every SCM log detail view then fails with&lt;br&gt;&lt;b&gt;Resource not found&lt;/b&gt;, because the read&lt;br&gt;comes from SCM, not from the gateway.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="492" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- ══ SCM ══ -->
        <mxCell id="scm-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22c55e;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="140" width="330" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="scm-label" value="&lt;b&gt;Strata Cloud Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;api.portkey.ai&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="152" width="310" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="scm-item-1" value="Model Catalog &amp;mdash; provider credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="815" y="205" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="scm-item-2" value="Guardrails and routing config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="815" y="245" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="scm-item-3" value="JWT settings and JWKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="815" y="285" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="scm-item-4" value="Analytics, logs, prompt and response bodies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="815" y="325" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="scm-item-5" value="Gateway URL fields (manual paste)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="815" y="365" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="scm-note" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;i&gt;None of this has an API on this&lt;br&gt;integration path. It is configured by hand.&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="815" y="405" width="280" height="40" as="geometry"/>
        </mxCell>

        <!-- ══ Outbound flows ══ -->
        <mxCell id="flow-1" style="endArrow=block;html=1;strokeColor=#E5A300;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="392" y="165" as="sourcePoint"/>
            <mxPoint x="788" y="165" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="470" y="128" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="flow-1-label" value="&lt;font style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Config sync + heartbeat&lt;/b&gt;&lt;br&gt;Outbound HTTPS 443. The gateway polls SCM&lt;br&gt;and pulls provider credentials and config down.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="502" y="100" width="285" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="flow-2" style="endArrow=block;html=1;strokeColor=#E5A300;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="392" y="260" as="sourcePoint"/>
            <mxPoint x="788" y="260" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="470" y="223" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="flow-2-label" value="&lt;font style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Telemetry push&lt;/b&gt;&lt;br&gt;Request metadata and bodies are pushed out&lt;br&gt;to the SCM backend, which stores them.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="502" y="196" width="285" height="52" as="geometry"/>
        </mxCell>

        <!-- ══ Blocked inbound ══ -->
        <mxCell id="flow-3" style="endArrow=block;html=1;strokeColor=#dc2626;strokeWidth=2;dashed=1;dashPattern=4 4;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="788" y="430" as="sourcePoint"/>
            <mxPoint x="394" y="430" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="blocked-x" value="&#x2715;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontSize=26;fontColor=#dc2626;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="572" y="414" width="36" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="flow-3-label" value="&lt;font color=&quot;#dc2626&quot; style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;No inbound path exists&lt;/b&gt;&lt;br&gt;SCM cannot read anything that lives&lt;br&gt;inside your environment.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="455" y="452" width="275" height="52" as="geometry"/>
        </mxCell>

        <!-- ══ Takeaway ══ -->
        <mxCell id="takeaway" value="&lt;font style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;What this costs you:&lt;/b&gt; prompt and response bodies live with the SCM backend rather than in your own storage. For a deployment where data residency matters, that is a decision to document rather than a default to inherit.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#f59e0b;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="470" y="530" width="650" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
