<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="JWT Authenticated Request Flow" id="aigw-jwt-request-flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Request pattern &amp;mdash; JWT authentication (Step 6.3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Keycloak issues the token, the gateway validates its signature against a JWKS that was pasted into SCM by hand.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="860" height="48" as="geometry"/>
        </mxCell>

        <!-- ══ Setup band: the manual JWKS paste ══ -->
        <mxCell id="setup-band" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;strokeWidth=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="30" y="78" width="1140" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="setup-label" value="&lt;font style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;One-time setup, before any request works&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="45" y="84" width="330" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="setup-kc" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Keycloak realm&lt;/b&gt;&lt;br&gt;RSA signing keypair&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="110" width="150" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="setup-tf" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;terraform output&lt;/b&gt;&lt;br&gt;jwks_json (public keys only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="275" y="110" width="190" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="setup-paste" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Manual paste into SCM&lt;/b&gt;&lt;br&gt;Admin Settings &amp;gt; Authentication&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#f59e0b;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="535" y="110" width="200" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="setup-sync" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Gateway pulls it down&lt;/b&gt;&lt;br&gt;on the next config sync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="805" y="110" width="180" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="se1" style="endArrow=block;html=1;strokeColor=#999999;strokeWidth=1;endFill=1;" edge="1" parent="1" source="setup-kc" target="setup-tf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se2" style="endArrow=block;html=1;strokeColor=#999999;strokeWidth=1;endFill=1;" edge="1" parent="1" source="setup-tf" target="setup-paste">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se3" style="endArrow=block;html=1;strokeColor=#999999;strokeWidth=1;endFill=1;" edge="1" parent="1" source="setup-paste" target="setup-sync">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="setup-warn" value="&lt;font color=&quot;#dc2626&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Redo this after any teardown.&lt;/b&gt;&lt;br&gt;A rebuilt realm signs with new keys.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1000" y="110" width="165" height="48" as="geometry"/>
        </mxCell>

        <!-- ══ Actors ══ -->
        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;on the Windows VM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="150" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="app" value="&lt;b&gt;JWT demo app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Flask&lt;br&gt;10.0.1.251:5000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="310" y="278" width="160" height="84" as="geometry"/>
        </mxCell>

        <mxCell id="keycloak" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;realm aigw-lab&lt;br&gt;10.0.1.250:80&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="310" y="490" width="160" height="84" as="geometry"/>
        </mxCell>

        <mxCell id="gw" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="620" y="270" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="gw-label" value="&lt;b&gt;airs-gw gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;JWT_ENABLED = ON&lt;br&gt;Verifies signature against JWKS,&lt;br&gt;then reads the claims&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="628" y="278" width="214" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="gw-icon" value="&#x1f6e1;&#xfe0f;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="717" y="338" width="36" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="llm" value="&lt;b&gt;LLM provider&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#f59e0b;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1010" y="288" width="155" height="64" as="geometry"/>
        </mxCell>

        <!-- ══ Steps ══ -->
        <mxCell id="f1" style="endArrow=block;html=1;strokeColor=#006DCC;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="237" y="277" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="f1-lbl" value="&lt;font style=&quot;font-size:10px;&quot;&gt;Open the app&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="195" y="246" width="110" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="f2" style="endArrow=block;html=1;strokeColor=#006DCC;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;curved=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="358" as="sourcePoint"/>
            <mxPoint x="306" y="518" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="150" y="500"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="128" y="418" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="f2-lbl" value="&lt;font style=&quot;font-size:10px;&quot;&gt;Redirected to sign in.&lt;br&gt;&lt;i&gt;The browser reaches Keycloak&lt;br&gt;at the load balancer address.&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="158" y="400" width="150" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="f3" style="endArrow=block;startArrow=block;html=1;strokeColor=#22c55e;strokeWidth=2;endFill=1;startFill=1;" edge="1" parent="1" source="app" target="keycloak">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="378" y="413" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="f3-lbl" value="&lt;font style=&quot;font-size:10px;&quot;&gt;Code exchanged for a token&lt;br&gt;over cluster DNS&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="410" y="408" width="175" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="f4" style="endArrow=block;html=1;strokeColor=#006DCC;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;" edge="1" parent="1" source="app" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="533" y="280" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="f4-lbl" value="&lt;font style=&quot;font-size:10px;&quot;&gt;Authorization:&lt;br&gt;Bearer &amp;lt;token&amp;gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="478" y="336" width="135" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="f5" style="endArrow=block;html=1;strokeColor=#E5A300;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;" edge="1" parent="1" source="gw" target="llm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="918" y="280" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="f5-lbl" value="&lt;font style=&quot;font-size:10px;&quot;&gt;Only after the signature&lt;br&gt;and claims both check out&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="856" y="336" width="150" height="36" as="geometry"/>
        </mxCell>

        <!-- ══ Token contents ══ -->
        <mxCell id="token-title" value="&lt;b&gt;What the token has to carry&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="30" y="618" width="300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="token-box" value="&lt;font style=&quot;font-size:11px;font-family:monospace;&quot;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;iss&quot;: &quot;http://10.0.1.250/realms/aigw-lab&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&quot;portkey_workspace&quot;&lt;/b&gt;: &quot;ws-example-a-7c41b9&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&quot;scopes&quot;&lt;/b&gt;: [&quot;completions.write&quot;]&lt;br&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="643" width="420" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="token-note" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;i&gt;Both claims come from hardcoded protocol mappers on the client.&lt;br&gt;&quot;scopes&quot; is a separate array so it does not collide with Keycloak's&lt;br&gt;own space-separated &quot;scope&quot; string.&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="752" width="420" height="48" as="geometry"/>
        </mxCell>

        <!-- ══ The expensive gotcha ══ -->
        <mxCell id="gotcha" value="&lt;font style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;The workspace claim is the step that costs the most debugging time&lt;/b&gt;&lt;br&gt;&lt;br&gt;The gateway is documented to fall back to the organization's default workspace when a token&lt;br&gt;carries no workspace claim. On this integration path that fallback does not resolve reliably, and&lt;br&gt;every completion returns &lt;font style=&quot;font-family:monospace;&quot;&gt;Following keys are not valid: openai&lt;/font&gt; even though the&lt;br&gt;identical request works with a plain API key.&lt;br&gt;&lt;br&gt;Embed the workspace explicitly, and use the &lt;b&gt;slug&lt;/b&gt; (&lt;font style=&quot;font-family:monospace;&quot;&gt;ws-example-a-7c41b9&lt;/font&gt;), never the&lt;br&gt;display name (&lt;font style=&quot;font-family:monospace;&quot;&gt;main_airs_workspace_4471206350&lt;/font&gt;).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#dc2626;strokeWidth=2;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="618" width="680" height="182" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
