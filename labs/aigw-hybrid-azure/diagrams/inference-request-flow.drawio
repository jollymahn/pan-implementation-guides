<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="Inference Request Flow" id="aigw-inference-request-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Request pattern &amp;mdash; API key authentication (Step 6.2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;One completion proves the load balancer, the gateway, the config sync that delivered the credential, and the provider.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="800" height="48" as="geometry"/>
        </mxCell>

        <!-- ══ Caller ══ -->
        <mxCell id="caller" value="" style="shape=mxgraph.azure.virtual_machine;fillColor=#22c55e;strokeColor=#22c55e;pointerEvents=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="185" width="56" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="caller-label" value="&lt;b&gt;Windows VM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;10.0.2.x&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="33" y="240" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- ══ Gateway LB ══ -->
        <mxCell id="gw-lb" value="&lt;b&gt;LoadBalancer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;airs-gw Service&lt;br&gt;port 80&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="215" y="175" width="130" height="70" as="geometry"/>
        </mxCell>

        <!-- ══ Gateway pod ══ -->
        <mxCell id="gw-pod" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="150" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="gw-pod-label" value="&lt;b&gt;airs-gw gateway pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Resolves @openai to the saved&lt;br&gt;integration, attaches the provider&lt;br&gt;credential, applies guardrails&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="428" y="158" width="204" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="gw-icon" value="&#x1f6e1;&#xfe0f;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="512" y="232" width="36" height="30" as="geometry"/>
        </mxCell>

        <!-- ══ LLM provider ══ -->
        <mxCell id="llm" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;gpt-4o-mini&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#f59e0b;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="960" y="170" width="170" height="80" as="geometry"/>
        </mxCell>

        <!-- ══ SCM ══ -->
        <mxCell id="scm" value="&lt;b&gt;Strata Cloud Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Model Catalog credential in,&lt;br&gt;analytics and log bodies out&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="435" y="395" width="190" height="80" as="geometry"/>
        </mxCell>

        <!-- ══ Flow 1: VM to LB ══ -->
        <mxCell id="f1" style="endArrow=block;html=1;strokeColor=#006DCC;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;" edge="1" parent="1" source="caller" target="gw-lb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="150" y="150" width="26" height="26" as="geometry"/>
        </mxCell>

        <!-- ══ Flow 2: LB to pod ══ -->
        <mxCell id="f2" style="endArrow=block;html=1;strokeColor=#006DCC;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;" edge="1" parent="1" source="gw-lb" target="gw-pod">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="368" y="150" width="26" height="26" as="geometry"/>
        </mxCell>

        <!-- ══ Flow 3: pod to provider ══ -->
        <mxCell id="f3" style="endArrow=block;html=1;strokeColor=#E5A300;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;" edge="1" parent="1" source="gw-pod" target="llm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="782" y="150" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="f3-label" value="&lt;font style=&quot;font-size:10px;&quot;&gt;Outbound HTTPS,&lt;br&gt;provider credential attached&lt;br&gt;&lt;i&gt;never leaves SCM's catalog&lt;br&gt;as plain text in your cluster&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="680" y="228" width="230" height="56" as="geometry"/>
        </mxCell>

        <!-- ══ Flow 4: response ══ -->
        <mxCell id="f4" style="endArrow=block;html=1;strokeColor=#22c55e;strokeWidth=2;endFill=1;curved=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1045" y="255" as="sourcePoint"/>
            <mxPoint x="120" y="300" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="1045" y="330"/>
              <mxPoint x="700" y="330"/>
              <mxPoint x="300" y="320"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="850" y="316" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="f4-label" value="&lt;font color=&quot;#22c55e&quot; style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Completion returns the same way&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="420" y="316" width="250" height="25" as="geometry"/>
        </mxCell>

        <!-- ══ Flow 5: telemetry ══ -->
        <mxCell id="f5" style="endArrow=block;html=1;strokeColor=#E5A300;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;" edge="1" parent="1" source="gw-pod" target="scm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="517" y="350" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="f5-label" value="&lt;font style=&quot;font-size:10px;&quot;&gt;Analytics and log bodies&lt;br&gt;pushed outbound&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="638" y="345" width="170" height="35" as="geometry"/>
        </mxCell>

        <!-- ══ The request ══ -->
        <mxCell id="req-title" value="&lt;b&gt;The request&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="30" y="505" width="200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="req-box" value="&lt;font style=&quot;font-size:11px;font-family:monospace;&quot;&gt;POST http://&amp;lt;GATEWAY_IP&amp;gt;/v1/chat/completions&lt;br&gt;Content-Type: application/json&lt;br&gt;&lt;b&gt;x-portkey-api-key:&lt;/b&gt; &amp;lt;SCM Workspace API Key&amp;gt;&lt;br&gt;&lt;br&gt;{ &quot;model&quot;: &lt;b&gt;&quot;@openai/gpt-4o-mini&quot;&lt;/b&gt;, &quot;messages&quot;: [ ... ] }&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="530" width="520" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="gotcha" value="&lt;font style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;The slug goes in the model field, not a header.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Organizations with &lt;font style=&quot;font-family:monospace;&quot;&gt;block_inline_config&lt;/font&gt; enabled reject the&lt;br&gt;&lt;font style=&quot;font-family:monospace;&quot;&gt;x-portkey-provider&lt;/font&gt; header with &lt;font style=&quot;font-family:monospace;&quot;&gt;inline_provider_blocked&lt;/font&gt;.&lt;br&gt;Referencing the saved integration as &lt;font style=&quot;font-family:monospace;&quot;&gt;@&amp;lt;slug&amp;gt;/&amp;lt;model&amp;gt;&lt;/font&gt; works&lt;br&gt;either way, so this guide always does that.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#f59e0b;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="505" width="550" height="130" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
