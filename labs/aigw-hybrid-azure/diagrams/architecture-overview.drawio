<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIGW Hybrid Lab Architecture" id="aigw-architecture-overview">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ══ Title ══ -->
        <mxCell id="title" value="&lt;b&gt;AI Gateway Hybrid Lab on Azure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Self-hosted data plane on AKS, managed from Strata Cloud Manager&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="560" height="50" as="geometry"/>
        </mxCell>

        <!-- ══ VNet container ══ -->
        <mxCell id="lab-vnet" value="&lt;b&gt;Lab VNet (10.0.0.0/16)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;fontSize=13;fontFamily=Helvetica;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="30" y="85" width="640" height="560" as="geometry"/>
