        <mxCell id="nsg-rules" value="&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:10px;font-family:Helvetica;&quot;&gt;&lt;tr style=&quot;background:#00294D;color:#fff;&quot;&gt;&lt;td&gt;&lt;b&gt;Priority&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Rule&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Port&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Source&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;100&lt;/td&gt;&lt;td&gt;Allow-SSH&lt;/td&gt;&lt;td&gt;TCP/22&lt;/td&gt;&lt;td&gt;Admin CIDR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;200&lt;/td&gt;&lt;td&gt;Allow-HTTPS&lt;/td&gt;&lt;td&gt;TCP/443&lt;/td&gt;&lt;td&gt;Admin CIDR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;300&lt;/td&gt;&lt;td&gt;Allow-3978&lt;/td&gt;&lt;td&gt;TCP/3978&lt;/td&gt;&lt;td&gt;FW mgmt CIDR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;400&lt;/td&gt;&lt;td&gt;Allow-28443&lt;/td&gt;&lt;td&gt;TCP/28443&lt;/td&gt;&lt;td&gt;FW mgmt CIDR&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#E5A300;fillColor=none;strokeWidth=1;" vertex="1" parent="1">
