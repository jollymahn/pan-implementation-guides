          <mxGeometry x="300" y="180" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Config ID -->
        <mxCell id="c-config" value="&lt;b&gt;Config ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Reusable config object&lt;br&gt;with guardrail attached&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FFB81C;strokeWidth=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- AIRS Guardrail -->
        <mxCell id="c-guard" value="&lt;b&gt;AIRS Guardrail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;input + output scanning&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FFB81C;strokeWidth=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="160" height="40" as="geometry"/>
        </mxCell>

        <!-- LLM (Cloud) -->
        <mxCell id="c-llm" value="&lt;b&gt;LLM Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Virtual Keys in dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#006DCC;strokeWidth=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="160" height="35" as="geometry"/>
        </mxCell>

        <!-- How to use label -->
        <mxCell id="c-how" value="&lt;font style=&quot;font-size:10px;color:#00294D;&quot;&gt;&lt;b&gt;How credentials flow:&lt;/b&gt;&lt;br&gt;1. Store AIRS API Key in dashboard&lt;br&gt;2. Create guardrail + Config in UI&lt;br&gt;3. Pass &lt;code&gt;x-portkey-config: CONFIG_ID&lt;/code&gt; header&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#dee2e6;strokeWidth=1;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="400" height="60" as="geometry"/>
