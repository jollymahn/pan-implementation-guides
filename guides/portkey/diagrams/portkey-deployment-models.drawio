        <mxCell id="s-gw-label" value="&lt;b style=&quot;color:#00294D;font-size:12px;&quot;&gt;127.0.0.1:8787&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Local / Private Gateway&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="610" y="175" width="155" height="40" as="geometry"/>
        </mxCell>

        <!-- Inline config -->
        <mxCell id="s-inline" value="&lt;b&gt;Inline JSON Config&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Passed via x-portkey-config&lt;br&gt;header on every request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FFB81C;strokeWidth=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="830" y="180" width="170" height="55" as="geometry"/>
        </mxCell>

        <!-- Plugin -->
        <mxCell id="s-plugin" value="&lt;b&gt;panw-prisma-airs.intercept&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Open-source plugin&lt;br&gt;&#x1f511; AIRS API Key in JSON&lt;br&gt;profile_name in JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FFB81C;strokeWidth=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="620" y="250" width="180" height="65" as="geometry"/>
        </mxCell>

        <!-- LLM (Self-hosted) -->
        <mxCell id="s-llm" value="&lt;b&gt;LLM Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Authorization header inline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#006DCC;strokeWidth=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="620" y="330" width="180" height="35" as="geometry"/>
        </mxCell>

        <!-- How to use label -->
        <mxCell id="s-how" value="&lt;font style=&quot;font-size:10px;color:#00294D;&quot;&gt;&lt;b&gt;How credentials flow:&lt;/b&gt;&lt;br&gt;1. AIRS API Key in JSON config body&lt;br&gt;2. Profile name in JSON config body&lt;br&gt;3. Pass full JSON as &lt;code&gt;x-portkey-config&lt;/code&gt; header&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#dee2e6;strokeWidth=1;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="400" width="420" height="60" as="geometry"/>
