        <!-- Bottom comparison -->
        <mxCell id="compare-table" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:10px;font-family:Helvetica;&quot;&gt;&lt;tr style=&quot;background:#00294D;color:#fff;&quot;&gt;&lt;td&gt;&lt;b&gt;Aspect&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Portkey Cloud&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Self-Hosted&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;AIRS API Key&lt;/td&gt;&lt;td&gt;Stored in dashboard (managed secret)&lt;/td&gt;&lt;td&gt;Passed inline in JSON header&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Guardrail config&lt;/td&gt;&lt;td&gt;Dashboard UI &amp;rarr; Config ID&lt;/td&gt;&lt;td&gt;Full JSON in x-portkey-config&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LLM credentials&lt;/td&gt;&lt;td&gt;Virtual Keys in dashboard&lt;/td&gt;&lt;td&gt;Authorization header inline&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Gateway endpoint&lt;/td&gt;&lt;td&gt;https://api.portkey.ai&lt;/td&gt;&lt;td&gt;http://127.0.0.1:8787&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
