<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="Portkey Deployment Models" id="portkey-deployment-models">
    <mxGraphModel dx="1100" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:16px;color:#00294D;&quot;&gt;Deployment Models — Portkey Cloud vs Self-Hosted&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="280" y="10" width="470" height="30" as="geometry"/>
        </mxCell>

        <!-- ═══ LEFT: Portkey Cloud ═══ -->
        <mxCell id="cloud-lane" value="&lt;b style=&quot;font-size:13px;color:#00294D;&quot;&gt;Portkey Cloud (SaaS)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;fontSize=13;fontFamily=Helvetica;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="30" y="55" width="480" height="490" as="geometry"/>
        </mxCell>

        <!-- App (Cloud) -->
        <mxCell id="c-app" value="&lt;b&gt;Application&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3b82f6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="120" height="35" as="geometry"/>
        </mxCell>

        <!-- Portkey Cloud Gateway -->
        <mxCell id="c-gw" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22c55e;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="420" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="c-gw-label" value="&lt;b style=&quot;color:#00294D;font-size:12px;&quot;&gt;api.portkey.ai&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Managed Gateway&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="70" y="175" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Dashboard config -->
