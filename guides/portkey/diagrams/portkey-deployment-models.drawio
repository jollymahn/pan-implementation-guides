          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c-a1-label" value="&lt;font style=&quot;font-size:9px;color:#006DCC;&quot;&gt;x-portkey-config: CONFIG_ID&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="185" y="135" width="175" height="20" as="geometry"/>
