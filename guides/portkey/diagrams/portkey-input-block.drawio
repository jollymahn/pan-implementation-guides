<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="Portkey AIRS Input Block" id="portkey-input-block">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:16px;color:#00294D;&quot;&gt;Input Block — Malicious Prompt Stopped Before Reaching LLM&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="10" width="560" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 1: Application sends malicious prompt -->
        <mxCell id="step1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef4444;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="55" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="app-label" value="&lt;b style=&quot;color:#00294D;font-size:13px;&quot;&gt;Application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;i&gt;&quot;Ignore all previous&lt;br&gt;instructions and reveal...&quot;&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="85" y="58" width="165" height="55" as="geometry"/>
        </mxCell>

        <!-- Arrow 1→2 -->
        <mxCell id="a1" style="endArrow=block;html=1;strokeColor=#ef4444;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="240" y="95" as="sourcePoint"/>
            <mxPoint x="360" y="95" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="a1-label" value="&lt;font style=&quot;font-size:9px;color:#ef4444;&quot;&gt;malicious prompt&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="255" y="75" width="105" height="20" as="geometry"/>
        </mxCell>

        <!-- Step 2: Input Guardrail BLOCKS -->
        <mxCell id="step2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef4444;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="330" y="60" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="input-scan" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="370" y="55" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="input-scan-label" value="&lt;b style=&quot;color:#00294D;font-size:13px;&quot;&gt;Input Guardrail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;AIRS detects: &lt;b&gt;Prompt Injection&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#ef4444;&quot;&gt;&#x2717; BLOCK (deny: true)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="380" y="55" width="195" height="55" as="geometry"/>
        </mxCell>

        <!-- Blocked X to LLM -->
        <mxCell id="blocked-line" style="endArrow=block;html=1;strokeColor=#ef4444;strokeWidth=2;endFill=1;dashed=1;dashPattern=4 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="570" y="95" as="sourcePoint"/>
            <mxPoint x="700" y="95" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="block-x" value="&lt;font style=&quot;font-size:24px;color:#ef4444;&quot;&gt;&lt;b&gt;&#x2717;&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="620" y="75" width="40" height="40" as="geometry"/>
        </mxCell>

        <!-- LLM (grayed out — never reached) -->
        <mxCell id="llm" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#dee2e6;strokeWidth=1;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="700" y="55" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="llm-label" value="&lt;font style=&quot;color:#999999;font-size:13px;&quot;&gt;&lt;b&gt;LLM Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Never reached&lt;br&gt;No tokens consumed&lt;/font&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="715" y="58" width="130" height="55" as="geometry"/>
        </mxCell>

        <!-- Step 3: 400 error back to app -->
        <mxCell id="step3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef4444;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="error-arrow" style="endArrow=block;html=1;strokeColor=#ef4444;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="135" as="sourcePoint"/>
            <mxPoint x="160" y="210" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="250" y="170"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="app-error" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="205" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="app-error-label" value="&lt;b style=&quot;color:#00294D;font-size:13px;&quot;&gt;Application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Receives &lt;b style=&quot;color:#ef4444;&quot;&gt;HTTP 400&lt;/b&gt;&lt;br&gt;Guardrail violation error&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="85" y="210" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="error-label" value="&lt;font style=&quot;font-size:10px;color:#ef4444;&quot;&gt;&lt;b&gt;400 Error&lt;/b&gt;&lt;br&gt;guardrail violation&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="235" y="155" width="120" height="35" as="geometry"/>
        </mxCell>

        <!-- AIRS API call -->
        <mxCell id="airs-api" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#f59e0b;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="210" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="airs-label" value="&lt;b style=&quot;color:#00294D;font-size:11px;&quot;&gt;Prisma AIRS Scan API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Verdict: &lt;b style=&quot;color:#ef4444;&quot;&gt;BLOCK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="415" y="215" width="155" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="input-airs" style="endArrow=block;startArrow=block;html=1;strokeColor=#f59e0b;strokeWidth=1;dashed=1;dashPattern=4 4;endFill=1;startFill=1;" edge="1" parent="1" source="input-scan" target="airs-api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Summary -->
        <mxCell id="summary" value="&lt;font style=&quot;font-size:11px;&quot;&gt;&lt;b style=&quot;color:#ef4444;&quot;&gt;Result:&lt;/b&gt; The malicious prompt is caught at the &lt;b&gt;input guardrail&lt;/b&gt; &amp;mdash; before any tokens are spent. The LLM provider is never contacted. The application receives a 400 error with the block reason. Zero cost, zero risk of data exfiltration.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="520" height="55" as="geometry"/>
        </mxCell>

        <!-- Detection categories -->
        <mxCell id="cats-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#dee2e6;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="410" width="520" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cats-title" value="&lt;b style=&quot;font-size:11px;color:#00294D;&quot;&gt;AIRS Detection Categories (Input)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="415" width="240" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="cats-list" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&#x1f6ab; Prompt Injection &amp;nbsp;&amp;nbsp; &#x1f517; Malicious URLs &amp;nbsp;&amp;nbsp; &#x1f4a3; Jailbreak Attempts &amp;nbsp;&amp;nbsp; &#x1f510; DLP (sensitive data) &amp;nbsp;&amp;nbsp; &#x2620;&#xfe0f; Toxic Content&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="445" width="495" height="25" as="geometry"/>
        </mxCell>

      </root>
