<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="Portkey AIRS Output Block" id="portkey-output-block">
    <mxGraphModel dx="1200" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:16px;color:#00294D;&quot;&gt;Output Block — Toxic LLM Response Caught Before Reaching Caller&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="590" height="30" as="geometry"/>
        </mxCell>

        <!-- Top Row: Steps 1-3 (input scan passes, LLM responds) -->

        <!-- Step 1 -->
        <mxCell id="step1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="55" width="130" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="app-label" value="&lt;b style=&quot;color:#00294D;font-size:12px;&quot;&gt;Application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Sends clean prompt&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="88" y="62" width="130" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrow 1→2 -->
        <mxCell id="a1" style="endArrow=block;html=1;strokeColor=#22c55e;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="87" as="sourcePoint"/>
            <mxPoint x="310" y="87" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 2: Input scan passes -->
        <mxCell id="step2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="input-scan" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22c55e;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="55" width="160" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="input-label" value="&lt;b style=&quot;color:#00294D;font-size:12px;&quot;&gt;Input Guardrail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b style=&quot;color:#22c55e;&quot;&gt;&#x2713; ALLOW&lt;/b&gt; (clean prompt)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="325" y="62" width="170" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrow 2→3 -->
        <mxCell id="a2" style="endArrow=block;html=1;strokeColor=#22c55e;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="87" as="sourcePoint"/>
            <mxPoint x="580" y="87" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 3: LLM generates toxic response -->
        <mxCell id="step3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f59e0b;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="550" y="60" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="llm" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#f59e0b;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="55" width="180" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="llm-label" value="&lt;b style=&quot;color:#00294D;font-size:12px;&quot;&gt;LLM Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Generates response containing&lt;br&gt;&lt;b style=&quot;color:#ef4444;&quot;&gt;toxic / unsafe content&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="595" y="55" width="195" height="55" as="geometry"/>
        </mxCell>

        <!-- Arrow 3→4 (curves down) -->
        <mxCell id="a3" style="endArrow=block;html=1;strokeColor=#ef4444;strokeWidth=2;endFill=1;curved=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="770" y="87" as="sourcePoint"/>
            <mxPoint x="770" y="227" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="830" y="160"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a3-label" value="&lt;font style=&quot;font-size:9px;color:#ef4444;&quot;&gt;toxic response&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="825" y="150" width="90" height="20" as="geometry"/>
        </mxCell>

        <!-- Step 4: Output Guardrail BLOCKS -->
        <mxCell id="step4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef4444;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="550" y="210" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="output-scan" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="200" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="output-label" value="&lt;b style=&quot;color:#00294D;font-size:12px;&quot;&gt;Output Guardrail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;AIRS detects: &lt;b&gt;Toxic Content&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#ef4444;&quot;&gt;&#x2717; BLOCK (deny: true)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="605" y="202" width="195" height="55" as="geometry"/>
        </mxCell>

        <!-- Step 5: Error back to app -->
        <mxCell id="step5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef4444;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="error-arrow" style="endArrow=block;html=1;strokeColor=#ef4444;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="590" y="235" as="sourcePoint"/>
            <mxPoint x="210" y="235" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="error-label" value="&lt;font style=&quot;font-size:10px;color:#ef4444;&quot;&gt;&lt;b&gt;400 Error&lt;/b&gt; — toxic content blocked&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="310" y="215" width="215" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="app-error" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="130" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="app-error-label" value="&lt;b style=&quot;color:#00294D;font-size:12px;&quot;&gt;Application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Receives &lt;b style=&quot;color:#ef4444;&quot;&gt;HTTP 400&lt;/b&gt;&lt;br&gt;instead of toxic response&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="75" y="205" width="170" height="55" as="geometry"/>
        </mxCell>

        <!-- Summary -->
        <mxCell id="summary" value="&lt;font style=&quot;font-size:11px;&quot;&gt;&lt;b style=&quot;color:#ef4444;&quot;&gt;Result:&lt;/b&gt; The prompt was clean enough to pass input scanning, but the LLM generated unsafe content. The &lt;b&gt;output guardrail&lt;/b&gt; catches it before it reaches the caller. The application never sees the toxic response &amp;mdash; it receives a 400 error instead.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="550" height="50" as="geometry"/>
        </mxCell>

        <!-- Why output scanning matters -->
        <mxCell id="why-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#dee2e6;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="395" width="550" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="why-title" value="&lt;b style=&quot;font-size:11px;color:#00294D;&quot;&gt;Why Output Scanning Matters&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="400" width="205" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="why-list" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&#x2022; LLMs can generate harmful content from benign prompts (hallucination, training data leakage)&lt;br&gt;&#x2022; Adversarial prompts may bypass input scanning but trigger unsafe model behavior&lt;br&gt;&#x2022; Output scanning protects end-users and downstream systems from model-generated risks&lt;br&gt;&#x2022; Categories: Toxic language, PII/sensitive data in responses, malicious code/URLs, bias&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="425" width="530" height="65" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
