set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  vsys vsys1 zone OUTBOUND network layer3 ethernet1/1.20
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  vsys vsys1 zone EASTWEST network layer3 ethernet1/1.30
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  vsys vsys1 zone UNTRUST network layer3 ethernet1/2
