# --- Device config ---
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system type dhcp-client accept-dhcp-hostname yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system type dhcp-client accept-dhcp-domain yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system type dhcp-client send-hostname yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system type dhcp-client send-client-id yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system device-telemetry threat-prevention no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system device-telemetry device-health-performance no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system device-telemetry product-usage no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system permitted-ip 10.0.0.0/8
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system permitted-ip 172.16.0.0/12
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system permitted-ip 192.168.0.0/16
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig system permitted-ip <ADMIN_IP>
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig setting ctd x-forwarded-for 2
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  deviceconfig setting ctd strip-x-fwd-for yes

# --- Zones ---
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  vsys vsys1 zone TRUST network layer3
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  vsys vsys1 zone INBOUND network layer3 ethernet1/1.10
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  vsys vsys1 zone UNTRUST network layer3 ethernet1/2
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  vsys vsys1 zone GWLB network layer3 ethernet1/1
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  vsys vsys1 zone APP1-DISTRIBUTED-INBOUND network layer3 ethernet1/1.101
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  vsys vsys1 zone APP2-DISTRIBUTED-INBOUND network layer3 ethernet1/1.102
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  vsys vsys1 zone APP3-DISTRIBUTED-INBOUND network layer3 ethernet1/1.103
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  vsys vsys1 import network interface [ ethernet1/1 ethernet1/1.10 ethernet1/1.101 ethernet1/1.102 ethernet1/1.103 ethernet1/2 ]

# --- Template variables ---
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND variable $EXTERNAL-GW type ip-netmask 1.1.1.1
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND variable $EXTERNAL-GW description PUBLIC-INTERFACE
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND variable $INTERNAL-GW type ip-netmask 2.2.2.2
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND variable $INTERNAL-GW description PRIVATE-INTERFACE
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND settings default-vsys vsys1

# ═══════════════════════════════════════════════════════════════
# PHASE 5A: OBEW DEVICE GROUP POLICY (outbound + east-west)
# ═══════════════════════════════════════════════════════════════

# --- GWLB Health Probe ---
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE target negate no
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE to GWLB
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE from GWLB
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE source-user any
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE category any
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE application [ ssl web-browsing ]
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE service [ service-http service-https ]
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE source-hip any
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE destination-hip any
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE action allow
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE disabled no
set device-group DG-AWS-COMBINED-OBEW pre-rulebase security rules AWS-HEALTH-PROBE tag [ AWS-HEALTH-GWLB BASELINE EXAMPLE ]
