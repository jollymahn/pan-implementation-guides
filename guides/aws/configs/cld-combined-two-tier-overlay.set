# --- Device config ---
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  deviceconfig system type dhcp-client accept-dhcp-hostname yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  deviceconfig system type dhcp-client accept-dhcp-domain yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  deviceconfig system type dhcp-client send-hostname yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  deviceconfig system type dhcp-client send-client-id yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  deviceconfig system device-telemetry threat-prevention no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  deviceconfig system device-telemetry device-health-performance no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  deviceconfig system device-telemetry product-usage no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  deviceconfig system permitted-ip 10.0.0.0/8
