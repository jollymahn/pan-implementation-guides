set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  vsys vsys1 import network interface [ ethernet1/1 ethernet1/1.20 ethernet1/1.30 ethernet1/2 ]

# --- Template variables ---
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW variable $EXTERNAL-GW type ip-netmask 1.1.1.1
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW variable $EXTERNAL-GW description PUBLIC-INTERFACE
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW variable $INTERNAL-GW type ip-netmask 2.2.2.2
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW variable $INTERNAL-GW description PRIVATE-INTERFACE
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW settings default-vsys vsys1

# ═══════════════════════════════════════════════════════════════
# PHASE 4B: INBOUND TEMPLATE (inbound interfaces only)
#   ethernet1/1     — GWLB parent (health checks)
#   ethernet1/1.10  — INBOUND (generic)
#   ethernet1/1.101 — APP1-DISTRIBUTED-INBOUND
#   ethernet1/1.102 — APP2-DISTRIBUTED-INBOUND
#   ethernet1/1.103 — APP3-DISTRIBUTED-INBOUND
#   ethernet1/2     — UNTRUST (overlay public interface)
# ═══════════════════════════════════════════════════════════════

set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND description "Two-Tier Inbound — interfaces, zones, routing (overlay)"

# --- Interface management profiles ---
