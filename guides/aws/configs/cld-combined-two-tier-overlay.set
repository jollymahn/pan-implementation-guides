set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  network profiles interface-management-profile INTERNAL-PING ping yes

# --- ethernet1/1 (GWLB parent) ---
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  network interface ethernet ethernet1/1 layer3 ndp-proxy enabled no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings upstream-nat enable no
