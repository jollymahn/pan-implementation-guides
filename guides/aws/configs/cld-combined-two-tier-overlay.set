# ═══════════════════════════════════════════════════════════════
# PHASE 6: SW FIREWALL LICENSE PLUGIN (one per firewall group)
# ═══════════════════════════════════════════════════════════════

set plugins sw_fw_license license-manager LM-AWS-COMBINED-OBEW device-group DG-AWS-COMBINED-OBEW
set plugins sw_fw_license license-manager LM-AWS-COMBINED-OBEW template-stack STK-AWS-COMBINED-OBEW-AZ-A
set plugins sw_fw_license license-manager LM-AWS-COMBINED-OBEW bootstrap-definition <BSD_OBEW>
set plugins sw_fw_license license-manager LM-AWS-COMBINED-OBEW auto-deactivate Never

set plugins sw_fw_license license-manager LM-AWS-COMBINED-INBOUND device-group DG-AWS-COMBINED-INBOUND
set plugins sw_fw_license license-manager LM-AWS-COMBINED-INBOUND template-stack STK-AWS-COMBINED-INBOUND-AZ-A
set plugins sw_fw_license license-manager LM-AWS-COMBINED-INBOUND bootstrap-definition <BSD_INBOUND>
set plugins sw_fw_license license-manager LM-AWS-COMBINED-INBOUND auto-deactivate Never
