# #############################################################################
#
#   PANORAMA CONFIGURATION — OVERLAY ROUTING (Combined Two-Tier Design)
#
#   DERIVED (not yet validated) from the single-tier combined overlay config.
#   Two-tier splits a single firewall group into two:
#     - OBEW firewalls: outbound + east-west traffic (security_obew_vpc)
#     - INBOUND firewalls: inbound traffic only (security_inbound_vpc)
#
#   Matches the cld-combined-two-tier.tfvars Terraform configuration.
#
#   Push this to Panorama BEFORE running terraform apply. The firewalls
#   bootstrap with dgname/tplname from the tfvars and pull this config.
#
# #############################################################################
#
# PLACEHOLDERS — Find-and-replace before pushing to Panorama:
#
#   Placeholder              Example              Scope
#   ──────────────────────   ──────────────────   ─────────────────────────────
#   <OBEW_NET>               10.51                Security OBEW VPC prefix
#   <INBOUND_NET>            10.52                Security Inbound VPC prefix
#   <APP1_NET>               10.48                App1 spoke VPC prefix
#   <APP2_NET>               10.49                App2 spoke VPC prefix
#   <APP3_NET>               10.106               App3 spoke VPC prefix (optional)
#   <ADMIN_IP>               203.0.113.10         Admin source IP for SSH rules
#   <REGION_CODE>            USW2                 Short region code for template names
#   <APP2_ALB_FQDN>          my-alb.elb...        App2 ALB FQDN (or remove object)
#   <BSD_OBEW>               bsd-aws-obew         Bootstrap definition for OBEW FWs
#   <BSD_INBOUND>            bsd-aws-inbound      Bootstrap definition for inbound FWs
#
# Quick replace:
#   sed -i '' \
#     's/<OBEW_NET>/10.51/g;
#      s/<INBOUND_NET>/10.52/g;
#      s/<APP1_NET>/10.48/g;
#      s/<APP2_NET>/10.49/g;
#      s/<APP3_NET>/10.106/g;
#      s/<ADMIN_IP>/203.0.113.10/g;
#      s/<REGION_CODE>/USW2/g;
#      s/<BSD_OBEW>/bsd-aws-obew/g;
#      s/<BSD_INBOUND>/bsd-aws-inbound/g' \
#     cld-combined-two-tier-overlay.set
#
# =============================================================================
#
# Two-tier architecture:
#   - DG-AWS-COMBINED-OBEW    → vmseries_obew group in security_obew_vpc
#   - DG-AWS-COMBINED-INBOUND → vmseries_inbound group in security_inbound_vpc
#   - Shared level-1 and level-2 templates are reused across both groups
#   - Each group gets its own level-4 template with role-specific interfaces
#
# Edit-before-paste checklist:
#   - Gateway IPs: $INTERNAL-GW / $EXTERNAL-GW per AZ (template stack overrides)
#   - GWLB + private subnet CIDRs in address objects
#   - Panorama IP: 2-TPL panorama-server line
#   - Bootstrap definitions: <BSD_OBEW> and <BSD_INBOUND> (created via GUI)

# ═══════════════════════════════════════════════════════════════
# PHASE 1: STRUCTURAL OBJECTS
# ═══════════════════════════════════════════════════════════════

# --- Device Groups ---
set device-group DG-AWS-COMBINED-OBEW description "AWS Combined Two-Tier — Outbound/East-West Firewalls"
set device-group DG-AWS-COMBINED-INBOUND description "AWS Combined Two-Tier — Inbound Firewalls"

# --- OBEW Template Stacks (per-AZ) ---
set template-stack STK-AWS-COMBINED-OBEW-AZ-A templates 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW
set template-stack STK-AWS-COMBINED-OBEW-AZ-A templates 2-TPL-AWS-GLOBAL-COMMON-BASELINE
set template-stack STK-AWS-COMBINED-OBEW-AZ-A templates 1-TPL-AWS-REGIONAL-<REGION_CODE>
set template-stack STK-AWS-COMBINED-OBEW-AZ-A settings default-vsys vsys1
set template-stack STK-AWS-COMBINED-OBEW-AZ-B templates 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW
set template-stack STK-AWS-COMBINED-OBEW-AZ-B templates 2-TPL-AWS-GLOBAL-COMMON-BASELINE
set template-stack STK-AWS-COMBINED-OBEW-AZ-B templates 1-TPL-AWS-REGIONAL-<REGION_CODE>
set template-stack STK-AWS-COMBINED-OBEW-AZ-B settings default-vsys vsys1

# --- INBOUND Template Stacks (per-AZ) ---
set template-stack STK-AWS-COMBINED-INBOUND-AZ-A templates 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND
set template-stack STK-AWS-COMBINED-INBOUND-AZ-A templates 2-TPL-AWS-GLOBAL-COMMON-BASELINE
set template-stack STK-AWS-COMBINED-INBOUND-AZ-A templates 1-TPL-AWS-REGIONAL-<REGION_CODE>
set template-stack STK-AWS-COMBINED-INBOUND-AZ-A settings default-vsys vsys1
set template-stack STK-AWS-COMBINED-INBOUND-AZ-B templates 4-TPL-AWS-GWLB-OVRLY-COMBINED-INBOUND
set template-stack STK-AWS-COMBINED-INBOUND-AZ-B templates 2-TPL-AWS-GLOBAL-COMMON-BASELINE
set template-stack STK-AWS-COMBINED-INBOUND-AZ-B templates 1-TPL-AWS-REGIONAL-<REGION_CODE>
set template-stack STK-AWS-COMBINED-INBOUND-AZ-B settings default-vsys vsys1

# --- OBEW per-AZ gateway variable overrides ---
# AZ-A: private=<OBEW_NET>.0.64/28 → gw=<OBEW_NET>.0.65, public=<OBEW_NET>.0.96/28 → gw=<OBEW_NET>.0.97
set template-stack STK-AWS-COMBINED-OBEW-AZ-A variable $INTERNAL-GW type ip-netmask <OBEW_NET>.0.65
set template-stack STK-AWS-COMBINED-OBEW-AZ-A variable $EXTERNAL-GW type ip-netmask <OBEW_NET>.0.97
# AZ-B: private=<OBEW_NET>.1.64/28 → gw=<OBEW_NET>.1.65, public=<OBEW_NET>.1.96/28 → gw=<OBEW_NET>.1.97
set template-stack STK-AWS-COMBINED-OBEW-AZ-B variable $INTERNAL-GW type ip-netmask <OBEW_NET>.1.65
set template-stack STK-AWS-COMBINED-OBEW-AZ-B variable $EXTERNAL-GW type ip-netmask <OBEW_NET>.1.97

# --- INBOUND per-AZ gateway variable overrides ---
# AZ-A: private=<INBOUND_NET>.0.64/28 → gw=<INBOUND_NET>.0.65, public=<INBOUND_NET>.0.96/28 → gw=<INBOUND_NET>.0.97
set template-stack STK-AWS-COMBINED-INBOUND-AZ-A variable $INTERNAL-GW type ip-netmask <INBOUND_NET>.0.65
set template-stack STK-AWS-COMBINED-INBOUND-AZ-A variable $EXTERNAL-GW type ip-netmask <INBOUND_NET>.0.97
# AZ-B: private=<INBOUND_NET>.1.64/28 → gw=<INBOUND_NET>.1.65, public=<INBOUND_NET>.1.96/28 → gw=<INBOUND_NET>.1.97
set template-stack STK-AWS-COMBINED-INBOUND-AZ-B variable $INTERNAL-GW type ip-netmask <INBOUND_NET>.1.65
set template-stack STK-AWS-COMBINED-INBOUND-AZ-B variable $EXTERNAL-GW type ip-netmask <INBOUND_NET>.1.97

# --- Reference templates on DGs (enables zone dropdowns in security rules) ---
set device-group DG-AWS-COMBINED-OBEW reference-templates STK-AWS-COMBINED-OBEW-AZ-A
set device-group DG-AWS-COMBINED-OBEW reference-templates STK-AWS-COMBINED-OBEW-AZ-B
set device-group DG-AWS-COMBINED-INBOUND reference-templates STK-AWS-COMBINED-INBOUND-AZ-A
set device-group DG-AWS-COMBINED-INBOUND reference-templates STK-AWS-COMBINED-INBOUND-AZ-B

# ═══════════════════════════════════════════════════════════════
# PHASE 2: SHARED OBJECTS (tags, addresses, profile groups)
# ═══════════════════════════════════════════════════════════════

set shared tag INBOUND color color1
set shared tag INBOUND comments "INBOUND FLOW"
set shared tag OUTBOUND color color13
set shared tag OUTBOUND comments "OUTBOUND FLOW"
set shared tag EASTWEST color color13
set shared tag EASTWEST comments "EAST/WEST POLICY"
set shared tag AWS-HEALTH-GWLB color color24
set shared tag AWS-HEALTH-GWLB comments "HEALTH PROBES"
set shared tag AWS-FW-DATA-PRIVATE color color24
set shared tag AWS-FW-DATA-PRIVATE comments FW-Data-plane-interface
set shared tag BASELINE color color15
set shared tag BASELINE comments "BASELINE CONFIG ELEMENTS"
set shared tag EXAMPLE color color6
set shared tag EXAMPLE comments "EXAMPLE ELEMENT OR POLICY"
set shared tag APP1 color color2
set shared tag APP1 comments APP1-ELEMENTS
set shared tag APP2 color color17
set shared tag APP2 comments APP2-ELEMENTS
set shared tag APP3 color color9
set shared tag ALB color color9
set shared tag ALB comments NLB-ELEMENTS
set shared tag OVERLAY-NAT color color6
set shared tag AWS-WEB-FARM-APP1 color color22
set shared tag AWS-WEB-FARM-APP1 comments INTERNAL
set shared tag PALO-GP-GATEWAY color color1
set shared tag PALO-GP-GATEWAY comments PALO-GP-GATEWAY

# --- Address objects: admin ---
set shared address H-<ADMIN_IP> description ADMIN-SOURCE-IP
set shared address H-<ADMIN_IP> ip-netmask <ADMIN_IP>
set shared address H-<ADMIN_IP> tag [ INBOUND BASELINE PALO-GP-GATEWAY ]
set shared address H-APP2-WEB-ALB-FQDN description <APP2_ALB_FQDN>
set shared address H-APP2-WEB-ALB-FQDN fqdn <APP2_ALB_FQDN>
set shared address H-APP2-WEB-ALB-FQDN tag [ APP2 ALB BASELINE ]
set shared address N-10.0.0.0-8 description RFC-1918-10
set shared address N-10.0.0.0-8 ip-netmask 10.0.0.0/8
set shared address N-10.0.0.0-8 tag BASELINE

# --- Address objects: OBEW VPC GWLB subnets ---
set shared address N-<OBEW_NET>.0.48-28 description OBEW-GWLB-SUBNET-A
set shared address N-<OBEW_NET>.0.48-28 ip-netmask <OBEW_NET>.0.48/28
set shared address N-<OBEW_NET>.0.48-28 tag AWS-HEALTH-GWLB
set shared address N-<OBEW_NET>.1.48-28 description OBEW-GWLB-SUBNET-B
set shared address N-<OBEW_NET>.1.48-28 ip-netmask <OBEW_NET>.1.48/28
set shared address N-<OBEW_NET>.1.48-28 tag AWS-HEALTH-GWLB
set shared address N-<OBEW_NET>.2.48-28 description OBEW-GWLB-SUBNET-C
set shared address N-<OBEW_NET>.2.48-28 ip-netmask <OBEW_NET>.2.48/28
set shared address N-<OBEW_NET>.2.48-28 tag AWS-HEALTH-GWLB
set shared address N-<OBEW_NET>.3.48-28 description OBEW-GWLB-SUBNET-D
set shared address N-<OBEW_NET>.3.48-28 ip-netmask <OBEW_NET>.3.48/28
set shared address N-<OBEW_NET>.3.48-28 tag AWS-HEALTH-GWLB

# --- Address objects: OBEW VPC firewall private subnets ---
set shared address N-<OBEW_NET>.0.64-28 description OBEW-FW-PRIVATE-SUBNET-A
set shared address N-<OBEW_NET>.0.64-28 ip-netmask <OBEW_NET>.0.64/28
set shared address N-<OBEW_NET>.0.64-28 tag AWS-FW-DATA-PRIVATE
set shared address N-<OBEW_NET>.1.64-28 description OBEW-FW-PRIVATE-SUBNET-B
set shared address N-<OBEW_NET>.1.64-28 ip-netmask <OBEW_NET>.1.64/28
set shared address N-<OBEW_NET>.1.64-28 tag AWS-FW-DATA-PRIVATE
set shared address N-<OBEW_NET>.2.64-28 description OBEW-FW-PRIVATE-SUBNET-C
set shared address N-<OBEW_NET>.2.64-28 ip-netmask <OBEW_NET>.2.64/28
set shared address N-<OBEW_NET>.2.64-28 tag AWS-FW-DATA-PRIVATE
set shared address N-<OBEW_NET>.3.64-28 description OBEW-FW-PRIVATE-SUBNET-D
set shared address N-<OBEW_NET>.3.64-28 ip-netmask <OBEW_NET>.3.64/28
set shared address N-<OBEW_NET>.3.64-28 tag AWS-FW-DATA-PRIVATE

# --- Address objects: INBOUND VPC GWLB subnets ---
set shared address N-<INBOUND_NET>.0.48-28 description INBOUND-GWLB-SUBNET-A
set shared address N-<INBOUND_NET>.0.48-28 ip-netmask <INBOUND_NET>.0.48/28
set shared address N-<INBOUND_NET>.0.48-28 tag AWS-HEALTH-GWLB
set shared address N-<INBOUND_NET>.1.48-28 description INBOUND-GWLB-SUBNET-B
set shared address N-<INBOUND_NET>.1.48-28 ip-netmask <INBOUND_NET>.1.48/28
set shared address N-<INBOUND_NET>.1.48-28 tag AWS-HEALTH-GWLB
set shared address N-<INBOUND_NET>.2.48-28 description INBOUND-GWLB-SUBNET-C
set shared address N-<INBOUND_NET>.2.48-28 ip-netmask <INBOUND_NET>.2.48/28
set shared address N-<INBOUND_NET>.2.48-28 tag AWS-HEALTH-GWLB
set shared address N-<INBOUND_NET>.3.48-28 description INBOUND-GWLB-SUBNET-D
set shared address N-<INBOUND_NET>.3.48-28 ip-netmask <INBOUND_NET>.3.48/28
set shared address N-<INBOUND_NET>.3.48-28 tag AWS-HEALTH-GWLB

# --- Address objects: INBOUND VPC firewall private subnets ---
set shared address N-<INBOUND_NET>.0.64-28 description INBOUND-FW-PRIVATE-SUBNET-A
set shared address N-<INBOUND_NET>.0.64-28 ip-netmask <INBOUND_NET>.0.64/28
set shared address N-<INBOUND_NET>.0.64-28 tag AWS-FW-DATA-PRIVATE
set shared address N-<INBOUND_NET>.1.64-28 description INBOUND-FW-PRIVATE-SUBNET-B
set shared address N-<INBOUND_NET>.1.64-28 ip-netmask <INBOUND_NET>.1.64/28
set shared address N-<INBOUND_NET>.1.64-28 tag AWS-FW-DATA-PRIVATE
set shared address N-<INBOUND_NET>.2.64-28 description INBOUND-FW-PRIVATE-SUBNET-C
set shared address N-<INBOUND_NET>.2.64-28 ip-netmask <INBOUND_NET>.2.64/28
set shared address N-<INBOUND_NET>.2.64-28 tag AWS-FW-DATA-PRIVATE
set shared address N-<INBOUND_NET>.3.64-28 description INBOUND-FW-PRIVATE-SUBNET-D
set shared address N-<INBOUND_NET>.3.64-28 ip-netmask <INBOUND_NET>.3.64/28
set shared address N-<INBOUND_NET>.3.64-28 tag AWS-FW-DATA-PRIVATE

# --- Address objects: spoke VPCs ---
set shared address N-<APP1_NET>.0.0-21 description APP1-VPC
set shared address N-<APP1_NET>.0.0-21 ip-netmask <APP1_NET>.0.0/21
set shared address N-<APP1_NET>.0.0-21 tag [ AWS-WEB-FARM-APP1 BASELINE ]
set shared address N-<APP2_NET>.0.0-21 description APP2-VPC
set shared address N-<APP2_NET>.0.0-21 ip-netmask <APP2_NET>.0.0/21
set shared address N-<APP2_NET>.0.0-21 tag [ APP2 BASELINE ]
set shared address N-<APP3_NET>.0.0-21 description APP3-VPC
set shared address N-<APP3_NET>.0.0-21 ip-netmask <APP3_NET>.0.0/21
set shared address N-<APP3_NET>.0.0-21 tag [ APP3 BASELINE ]

# --- Dynamic address groups ---
set shared address-group GRP-AWS-GWLB-HEALTH-PROBE-SUBNETS dynamic filter "'AWS-HEALTH-GWLB'"
set shared address-group GRP-AWS-GWLB-HEALTH-PROBE-SUBNETS tag AWS-HEALTH-GWLB
set shared address-group GRP-FIREWALL-PRIVATE-SUBNETS dynamic filter "'AWS-FW-DATA-PRIVATE'"
set shared address-group GRP-FIREWALL-PRIVATE-SUBNETS tag AWS-FW-DATA-PRIVATE

# --- Security profile groups ---
set shared profile-group Outbound spyware Outbound-AS
set shared profile-group Outbound vulnerability Outbound-VP
set shared profile-group Outbound url-filtering Outbound-URL
set shared profile-group Outbound file-blocking Outbound-FB
set shared profile-group Outbound wildfire-analysis Outbound-WF
set shared profile-group Outbound virus Outbound-AV
set shared profile-group Inbound spyware Inbound-AS
set shared profile-group Inbound vulnerability Inbound-VP
set shared profile-group Inbound file-blocking Inbound-FB
set shared profile-group Inbound wildfire-analysis Inbound-WF
set shared profile-group Inbound virus Inbound-AV
set shared profile-group Internal spyware Internal-AS
set shared profile-group Internal vulnerability Internal-VP
set shared profile-group Internal file-blocking Internal-FB
set shared profile-group Internal wildfire-analysis Internal-WF
set shared profile-group Internal virus Internal-AV
set shared profile-group Alert-Only spyware Alert-Only-AS
set shared profile-group Alert-Only vulnerability Alert-Only-VP
set shared profile-group Alert-Only url-filtering Alert-Only-URL
set shared profile-group Alert-Only file-blocking Alert-Only-FB
set shared profile-group Alert-Only wildfire-analysis Alert-Only-WF
set shared profile-group Alert-Only virus Alert-Only-AV
set shared profile-group default spyware Outbound-AS
set shared profile-group default vulnerability Outbound-VP
set shared profile-group default url-filtering Outbound-URL
set shared profile-group default file-blocking Outbound-FB
set shared profile-group default wildfire-analysis Outbound-WF
set shared profile-group default virus Outbound-AV

# ═══════════════════════════════════════════════════════════════
# PHASE 3: SHARED TEMPLATES (level 1 + 2, reused by both groups)
# ═══════════════════════════════════════════════════════════════

set template 1-TPL-AWS-REGIONAL-<REGION_CODE> description US-WEST-REGIONAL-TEMPLATE-FOR-REGIONAL-TACACS-AND-LOG-COLLECTORS
set template 1-TPL-AWS-REGIONAL-<REGION_CODE> settings default-vsys vsys1
set template 1-TPL-AWS-REGIONAL-<REGION_CODE> config  vsys vsys1
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE description "COMMON SETTINGS DNS, NTP, BANNERS"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  vsys vsys1
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system update-server updates.paloaltonetworks.com
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system dns-setting servers primary 169.254.169.253
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system dns-setting servers secondary 8.8.8.8
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system ntp-servers primary-ntp-server ntp-server-address 169.254.169.123
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system ntp-servers secondary-ntp-server ntp-server-address time.aws.com
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client send-client-id no
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client send-hostname yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client accept-dhcp-hostname no
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client accept-dhcp-domain no
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner motd-enable yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner message "!!!! DO NOT MAKE CHANGES ON THE LOCAL FIREWALL. MAKE ALL CHANGES ON PANORAMA. MAKE SURE YOU HAVE CAB APPROVAL PRIOR TO MAKING ANY CHANGES. !!!"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner motd-color color1
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner severity warning
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner banner-header "!!! THIS IS A FIREWALL. !!!"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner banner-header-color color1
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner banner-header-text-color color18
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system panorama local-panorama panorama-server 10.251.2.51
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system domain variable.com
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system timezone UTC
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system login-banner "!!!! GET OUT !!!!!"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig setting ctd x-forwarded-for 2
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig setting wildfire report-benign-file yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig setting wildfire report-grayware-file yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings system match-list system filter "All Logs"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings system match-list system send-to-panorama yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings config match-list config filter "All Logs"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings config match-list config send-to-panorama yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings userid match-list user-id filter "All Logs"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings userid match-list user-id send-to-panorama yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings iptag match-list ip-tag filter "All Logs"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings iptag match-list ip-tag send-to-panorama yes

# ═══════════════════════════════════════════════════════════════
# PHASE 4A: OBEW TEMPLATE (outbound + east-west interfaces only)
#   ethernet1/1     — GWLB parent (health checks)
#   ethernet1/1.20  — OUTBOUND subinterface
#   ethernet1/1.30  — EASTWEST subinterface
#   ethernet1/2     — UNTRUST (overlay public interface)
# ═══════════════════════════════════════════════════════════════

set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW description "Two-Tier OBEW — interfaces, zones, routing (overlay)"

# --- Interface management profiles ---
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network profiles interface-management-profile AWS-HEALTH-CHECKS https yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network profiles interface-management-profile AWS-HEALTH-CHECKS http yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network profiles interface-management-profile AWS-HEALTH-CHECKS ssh no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network profiles interface-management-profile AWS-HEALTH-CHECKS permitted-ip 10.0.0.0/8
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network profiles interface-management-profile PUBLIC-PING permitted-ip <ADMIN_IP>
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network profiles interface-management-profile PUBLIC-PING ping yes
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network profiles interface-management-profile INTERNAL-PING permitted-ip 10.0.0.0/8
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network profiles interface-management-profile INTERNAL-PING permitted-ip 172.16.0.0/12
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network profiles interface-management-profile INTERNAL-PING permitted-ip 192.168.0.0/16
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network profiles interface-management-profile INTERNAL-PING ping yes

# --- ethernet1/1 (GWLB parent) ---
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network interface ethernet ethernet1/1 layer3 ndp-proxy enabled no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings upstream-nat enable no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings upstream-nat static-ip
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings enable no
set template 4-TPL-AWS-GWLB-OVRLY-COMBINED-OBEW config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings ipv6-enable no
