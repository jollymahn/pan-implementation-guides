# Dedicated Inbound Design — Overlay Routing
# Adapted from panorama-config-cld-overlay.set (combined design)
#
# Differences from combined:
#   - No ethernet1/1.10 (generic INBOUND) — dedicated uses per-app subinterfaces only
#   - No ethernet1/1.103 / APP3 — only 2 spoke apps
#   - Spoke VPC CIDRs are /21 (10.48.0.0/21, 10.49.0.0/21)
#   - Dedicated inbound VPC handles all internet-facing traffic
#
# Reuses existing templates:
#   - CLD-1-TPL-AWS-REGIONAL-USW2
#   - CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE
#
# Edit-before-paste checklist:
#   - Gateway IPs: $INTERNAL-GW / $EXTERNAL-GW per AZ (template stack overrides)
#   - Panorama IP: CLD-2-TPL panorama-server line (currently YOUR-PANORAMA-IP)

# ═══════════════════════════════════════════════════════════════
# PHASE 1: STRUCTURAL OBJECTS (create before template content)
# ═══════════════════════════════════════════════════════════════

# --- Device Group ---
set device-group CLD-DG-AWS-DEDICATED description "AWS Dedicated Inbound Design Device Group"

# --- Template Stacks (per-AZ, one template-add per line) ---
set template-stack CLD-STK-AWS-DEDICATED-AZ-A templates CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED
set template-stack CLD-STK-AWS-DEDICATED-AZ-A templates CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE
set template-stack CLD-STK-AWS-DEDICATED-AZ-A templates CLD-1-TPL-AWS-REGIONAL-USW2
set template-stack CLD-STK-AWS-DEDICATED-AZ-A settings default-vsys vsys1
set template-stack CLD-STK-AWS-DEDICATED-AZ-B templates CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED
set template-stack CLD-STK-AWS-DEDICATED-AZ-B templates CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE
set template-stack CLD-STK-AWS-DEDICATED-AZ-B templates CLD-1-TPL-AWS-REGIONAL-USW2
set template-stack CLD-STK-AWS-DEDICATED-AZ-B settings default-vsys vsys1

# --- Per-AZ gateway variable overrides ---
# Security VPC subnets are identical to combined design
# AZ-A: private=10.51.0.64/28 → gw=10.51.0.65, public=10.51.0.96/28 → gw=10.51.0.97
set template-stack CLD-STK-AWS-DEDICATED-AZ-A variable $INTERNAL-GW type ip-netmask 10.51.0.65
set template-stack CLD-STK-AWS-DEDICATED-AZ-A variable $EXTERNAL-GW type ip-netmask 10.51.0.97
# AZ-B: private=10.51.1.64/28 → gw=10.51.1.65, public=10.51.1.96/28 → gw=10.51.1.97
set template-stack CLD-STK-AWS-DEDICATED-AZ-B variable $INTERNAL-GW type ip-netmask 10.51.1.65
set template-stack CLD-STK-AWS-DEDICATED-AZ-B variable $EXTERNAL-GW type ip-netmask 10.51.1.97

# --- Reference templates on DG (enables zone dropdowns in security rules) ---
set device-group CLD-DG-AWS-DEDICATED reference-templates CLD-STK-AWS-DEDICATED-AZ-A
set device-group CLD-DG-AWS-DEDICATED reference-templates CLD-STK-AWS-DEDICATED-AZ-B

# ═══════════════════════════════════════════════════════════════
# PHASE 2: SHARED OBJECTS (tags, addresses, profile groups)
# Set commands are idempotent — safe to re-run if objects exist
# ═══════════════════════════════════════════════════════════════

set shared tag INBOUND color color1
set shared tag INBOUND comments "INBOUND FLOW"
set shared tag OUTBOUND color color13
set shared tag OUTBOUND comments "OUTBOUND FLOW"
set shared tag EASTWEST color color13
set shared tag EASTWEST comments "EAST/WEST POLICY"
set shared tag AWS-HEALTH-GWLB color color24
set shared tag AWS-HEALTH-GWLB comments "HEALTH PROBES"
set shared tag AWS-FW-DATA-PRIVATE color color24
set shared tag AWS-FW-DATA-PRIVATE comments FW-Data-plane-interface
set shared tag BASELINE color color15
set shared tag BASELINE comments "BASELINE CONFIG ELEMENTS"
set shared tag EXAMPLE color color6
set shared tag EXAMPLE comments "EXAMPLE ELEMENT OR POLICY"
set shared tag APP1 color color2
set shared tag APP1 comments APP1-ELEMENTS
set shared tag APP2 color color17
set shared tag APP2 comments APP2-ELEMENTS
set shared tag ALB color color9
set shared tag ALB comments NLB-ELEMENTS
set shared tag OVERLAY-NAT color color6
set shared tag AWS-WEB-FARM-APP1 color color22
set shared tag AWS-WEB-FARM-APP1 comments INTERNAL
set shared tag PALO-GP-GATEWAY color color1
set shared tag PALO-GP-GATEWAY comments PALO-GP-GATEWAY

# --- Address objects ---
set shared address H-YOUR-PUBLIC-IP description PALO-ALTO-CALIFORNIA-GP-GATEWAY
set shared address H-YOUR-PUBLIC-IP ip-netmask YOUR-PUBLIC-IP
set shared address H-YOUR-PUBLIC-IP tag [ INBOUND BASELINE PALO-GP-GATEWAY ]
set shared address N-10.0.0.0-8 description RFC-1918-10
set shared address N-10.0.0.0-8 ip-netmask 10.0.0.0/8
set shared address N-10.0.0.0-8 tag BASELINE
set shared address N-10.51.0.48-28 description GWLB-SUBNET-A
set shared address N-10.51.0.48-28 ip-netmask 10.51.0.48/28
set shared address N-10.51.0.48-28 tag AWS-HEALTH-GWLB
set shared address N-10.51.0.64-28 description FIREWALL-PRIVATE-SUBNET-A
set shared address N-10.51.0.64-28 ip-netmask 10.51.0.64/28
set shared address N-10.51.0.64-28 tag AWS-FW-DATA-PRIVATE
set shared address N-10.51.1.48-28 description GWLB-SUBNET-B
set shared address N-10.51.1.48-28 ip-netmask 10.51.1.48/28
set shared address N-10.51.1.48-28 tag AWS-HEALTH-GWLB
set shared address N-10.51.1.64-28 description FIREWALL-PRIVATE-SUBNET-B
set shared address N-10.51.1.64-28 ip-netmask 10.51.1.64/28
set shared address N-10.51.1.64-28 tag AWS-FW-DATA-PRIVATE
set shared address N-10.51.2.48-28 description GWLB-SUBNET-C
set shared address N-10.51.2.48-28 ip-netmask 10.51.2.48/28
set shared address N-10.51.2.48-28 tag AWS-HEALTH-GWLB
# Spoke VPC addresses — /20 CIDRs for dedicated inbound design
set shared address N-10.48.0.0-21 description APP1-VPC
set shared address N-10.48.0.0-21 ip-netmask 10.48.0.0/21
set shared address N-10.48.0.0-21 tag [ AWS-WEB-FARM-APP1 BASELINE ]
set shared address N-10.49.0.0-21 description APP2-VPC
set shared address N-10.49.0.0-21 ip-netmask 10.49.0.0/21
set shared address N-10.49.0.0-21 tag [ APP2 BASELINE ]

# Inbound VPC addresses — per-app LB subnets (dedicated inbound design)
set shared address N-10.50.0.0-28 ip-netmask 10.50.0.0/28
set shared address N-10.50.0.0-28 description "INBOUND VPC - APP1 LB SUBNET AZ-A"
set shared address N-10.50.0.0-28 tag [ INBOUND APP1 BASELINE ]
set shared address N-10.50.1.0-28 ip-netmask 10.50.1.0/28
set shared address N-10.50.1.0-28 description "INBOUND VPC - APP1 LB SUBNET AZ-B"
set shared address N-10.50.1.0-28 tag [ INBOUND APP1 BASELINE ]
set shared address N-10.50.0.48-28 ip-netmask 10.50.0.48/28
set shared address N-10.50.0.48-28 description "INBOUND VPC - APP2 LB SUBNET AZ-A"
set shared address N-10.50.0.48-28 tag [ INBOUND APP2 BASELINE ]
set shared address N-10.50.1.48-28 ip-netmask 10.50.1.48/28
set shared address N-10.50.1.48-28 description "INBOUND VPC - APP2 LB SUBNET AZ-B"
set shared address N-10.50.1.48-28 tag [ INBOUND APP2 BASELINE ]

# --- Dynamic address groups ---
set shared address-group GRP-AWS-GWLB-HEALTH-PROBE-SUBNETS dynamic filter "'AWS-HEALTH-GWLB'"
set shared address-group GRP-AWS-GWLB-HEALTH-PROBE-SUBNETS tag AWS-HEALTH-GWLB
set shared address-group GRP-FIREWALL-PRIVATE-SUBNETS dynamic filter "'AWS-FW-DATA-PRIVATE'"
set shared address-group GRP-FIREWALL-PRIVATE-SUBNETS tag AWS-FW-DATA-PRIVATE

# --- Security profile groups ---
set shared profile-group Outbound spyware Outbound-AS
set shared profile-group Outbound vulnerability Outbound-VP
set shared profile-group Outbound url-filtering Outbound-URL
set shared profile-group Outbound file-blocking Outbound-FB
set shared profile-group Outbound wildfire-analysis Outbound-WF
set shared profile-group Outbound virus Outbound-AV
set shared profile-group Inbound spyware Inbound-AS
set shared profile-group Inbound vulnerability Inbound-VP
set shared profile-group Inbound file-blocking Inbound-FB
set shared profile-group Inbound wildfire-analysis Inbound-WF
set shared profile-group Inbound virus Inbound-AV
set shared profile-group Internal spyware Internal-AS
set shared profile-group Internal vulnerability Internal-VP
set shared profile-group Internal file-blocking Internal-FB
set shared profile-group Internal wildfire-analysis Internal-WF
set shared profile-group Internal virus Internal-AV
set shared profile-group Alert-Only spyware Alert-Only-AS
set shared profile-group Alert-Only vulnerability Alert-Only-VP
set shared profile-group Alert-Only url-filtering Alert-Only-URL
set shared profile-group Alert-Only file-blocking Alert-Only-FB
set shared profile-group Alert-Only wildfire-analysis Alert-Only-WF
set shared profile-group Alert-Only virus Alert-Only-AV
set shared profile-group default spyware Outbound-AS
set shared profile-group default vulnerability Outbound-VP
set shared profile-group default url-filtering Outbound-URL
set shared profile-group default file-blocking Outbound-FB
set shared profile-group default wildfire-analysis Outbound-WF
set shared profile-group default virus Outbound-AV

# ═══════════════════════════════════════════════════════════════
# PHASE 3: REUSABLE TEMPLATES (only if not already on Panorama)
# CLD-1 and CLD-2 are unchanged from combined — skip if present
# ═══════════════════════════════════════════════════════════════

set template CLD-1-TPL-AWS-REGIONAL-USW2 description US-WEST-REGIONAL-TEMPLATE-FOR-REGIONAL-TACACS-AND-LOG-COLLECTORS
set template CLD-1-TPL-AWS-REGIONAL-USW2 settings default-vsys vsys1
set template CLD-1-TPL-AWS-REGIONAL-USW2 config  vsys vsys1
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE description "COMMON SETTINGS DNS, NTP, BANNERS"
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  vsys vsys1
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system update-server updates.paloaltonetworks.com
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system dns-setting servers primary 169.254.169.253
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system dns-setting servers secondary 8.8.8.8
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system ntp-servers primary-ntp-server ntp-server-address 169.254.169.123
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system ntp-servers secondary-ntp-server ntp-server-address time.aws.com
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client send-client-id no
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client send-hostname yes
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client accept-dhcp-hostname no
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client accept-dhcp-domain no
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner motd-enable yes
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner message "!!!! DO NOT MAKE CHANGES ON THE LOCAL FIREWALL. MAKE ALL CHANGES ON PANORAMA. MAKE SURE YOU HAVE CAB APPROVAL PRIOR TO MAKING ANY CHANGES. !!!"
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner motd-color color1
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner severity warning
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner banner-header "!!! THIS IS A FIREWALL. !!!"
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner banner-header-color color1
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner banner-header-text-color color18
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system panorama local-panorama panorama-server YOUR-PANORAMA-IP
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system domain variable.com
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system timezone UTC
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system login-banner "!!!! GET OUT !!!!!"
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig setting ctd x-forwarded-for 2
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig setting wildfire report-benign-file yes
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig setting wildfire report-grayware-file yes
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings system match-list system filter "All Logs"
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings system match-list system send-to-panorama yes
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings config match-list config filter "All Logs"
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings config match-list config send-to-panorama yes
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings userid match-list user-id filter "All Logs"
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings userid match-list user-id send-to-panorama yes
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings iptag match-list ip-tag filter "All Logs"
set template CLD-2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings iptag match-list ip-tag send-to-panorama yes

# ═══════════════════════════════════════════════════════════════
# PHASE 4: DEDICATED INBOUND TEMPLATE (network, zones, routing)
# Uses single INBOUND subinterface (ethernet1/1.10) for all inbound apps
# ═══════════════════════════════════════════════════════════════

set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED description "Dedicated Inbound — interfaces, zones, routing (overlay)"

# --- Interface management profiles ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network profiles interface-management-profile AWS-HEALTH-CHECKS https yes
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network profiles interface-management-profile AWS-HEALTH-CHECKS http yes
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network profiles interface-management-profile AWS-HEALTH-CHECKS ssh no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network profiles interface-management-profile AWS-HEALTH-CHECKS permitted-ip 10.0.0.0/8
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network profiles interface-management-profile PUBLIC-PING permitted-ip YOUR-PUBLIC-IP
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network profiles interface-management-profile PUBLIC-PING ping yes
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network profiles interface-management-profile INTERNAL-PING permitted-ip 10.0.0.0/8
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network profiles interface-management-profile INTERNAL-PING permitted-ip 172.16.0.0/12
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network profiles interface-management-profile INTERNAL-PING permitted-ip 192.168.0.0/16
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network profiles interface-management-profile INTERNAL-PING ping yes

# --- ethernet1/1 (GWLB parent interface) ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 ndp-proxy enabled no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings upstream-nat enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings upstream-nat static-ip
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings ipv6-enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 interface-management-profile AWS-HEALTH-CHECKS
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 lldp enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 dhcp-client create-default-route no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 dhcp-client send-hostname enable yes

# --- ethernet1/1.20 (OUTBOUND subinterface) ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 tag 20
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 comment OUTBOUND
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 dhcp-client create-default-route no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 sdwan-link-settings enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 sdwan-link-settings upstream-nat enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 sdwan-link-settings ipv6-enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 ndp-proxy enabled no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 adjust-tcp-mss enable no

# --- ethernet1/1.30 (EASTWEST subinterface) ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 tag 30
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 comment EASTWEST
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 dhcp-client create-default-route no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 ndp-proxy enabled no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 sdwan-link-settings enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 sdwan-link-settings upstream-nat enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 sdwan-link-settings ipv6-enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 adjust-tcp-mss enable no

# --- ethernet1/1.10 (INBOUND subinterface — all inbound apps) ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 tag 10
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 comment INBOUND
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 dhcp-client create-default-route no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 sdwan-link-settings enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 sdwan-link-settings upstream-nat enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 sdwan-link-settings ipv6-enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 ndp-proxy enabled no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 adjust-tcp-mss enable no

set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/1 comment GWLB

# --- ethernet1/2 (UNTRUST / overlay public interface) ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/2 layer3 ndp-proxy enabled no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/2 layer3 sdwan-link-settings upstream-nat enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/2 layer3 sdwan-link-settings upstream-nat static-ip
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/2 layer3 sdwan-link-settings enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/2 layer3 sdwan-link-settings ipv6-enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/2 layer3 lldp enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/2 layer3 dhcp-client create-default-route no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network interface ethernet ethernet1/2 comment UNTRUST-OVERLAY

# --- Logical Router (AWS-LR) ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network logical-router AWS-LR vrf default multicast pim ssm-address-space group-list None
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network logical-router AWS-LR vrf default multicast pim rpf-lookup-mode mrib-then-urib
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network logical-router AWS-LR vrf default multicast pim route-ageout-time 210
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network logical-router AWS-LR vrf default multicast pim enable yes
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network logical-router AWS-LR vrf default multicast igmp enable yes
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network logical-router AWS-LR vrf default multicast msdp enable no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network logical-router AWS-LR vrf default multicast enable no
