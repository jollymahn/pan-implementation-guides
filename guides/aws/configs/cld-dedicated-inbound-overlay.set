set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND destination [ N-10.50.0.0-28 N-10.50.1.0-28 N-10.50.0.48-28 N-10.50.1.48-28 ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND disabled no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND log-start no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND log-end yes
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND description "INBOUND SSH POLICY TO SPOKE VMS FOR TESTING AND INSTALLATION OF NGINX"
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND profile-setting group Inbound
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND saas-user-list any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND saas-tenant-list any

# --- Outbound rule ---
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND target negate no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND to UNTRUST
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND from OUTBOUND
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND destination any
