set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  network logical-router AWS-LR vrf default interface [ ethernet1/1 ethernet1/1.10 ethernet1/1.20 ethernet1/1.30 ethernet1/2 ]

# --- Device config ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system type dhcp-client accept-dhcp-hostname yes
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system type dhcp-client accept-dhcp-domain yes
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system type dhcp-client send-hostname yes
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system type dhcp-client send-client-id yes
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system device-telemetry threat-prevention no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system device-telemetry device-health-performance no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system device-telemetry product-usage no
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system permitted-ip 10.0.0.0/8
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system permitted-ip 172.16.0.0/12
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system permitted-ip 192.168.0.0/16
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system permitted-ip YOUR-PUBLIC-IP
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig system permitted-ip YOUR-PUBLIC-IP-2
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig setting ctd x-forwarded-for 2
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  deviceconfig setting ctd strip-x-fwd-for yes

# --- Zones ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  vsys vsys1 zone TRUST network layer3
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  vsys vsys1 zone INBOUND network layer3 ethernet1/1.10
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  vsys vsys1 zone OUTBOUND network layer3 ethernet1/1.20
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  vsys vsys1 zone EASTWEST network layer3 ethernet1/1.30
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  vsys vsys1 zone UNTRUST network layer3 ethernet1/2
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  vsys vsys1 zone GWLB network layer3 ethernet1/1

# --- Interface imports ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED config  vsys vsys1 import network interface [ ethernet1/1 ethernet1/1.10 ethernet1/1.20 ethernet1/1.30 ethernet1/2 ]

# --- Template variables (defaults, overridden in template stacks) ---
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED variable $EXTERNAL-GW type ip-netmask 1.1.1.1
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED variable $EXTERNAL-GW description PUBLIC-INTERFACE
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED variable $INTERNAL-GW type ip-netmask 2.2.2.2
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED variable $INTERNAL-GW description PRIVATE-INTERFACE
set template CLD-4-TPL-AWS-GWLB-OVRLY-DEDICATED settings default-vsys vsys1

# ═══════════════════════════════════════════════════════════════
# PHASE 5: DEVICE GROUP POLICY (security + NAT rules)
# Uses /20 address objects and dedicated inbound zones
# ═══════════════════════════════════════════════════════════════

# --- GWLB Health Probe rule ---
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE target negate no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE to GWLB
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE from GWLB
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE source-user any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE category any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE application [ ssl web-browsing ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE service [ service-http service-https ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE source-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE destination-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE action allow
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE disabled no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE tag [ AWS-HEALTH-GWLB BASELINE EXAMPLE ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE group-tag AWS-HEALTH-GWLB
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE source GRP-AWS-GWLB-HEALTH-PROBE-SUBNETS
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE destination GRP-FIREWALL-PRIVATE-SUBNETS
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE log-end no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE log-setting default
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE log-start no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-HEALTH-PROBE description "POLICY FOR GWLB HEALTH PROBES FROM GATEWAY LOAD BALANCER TO FIREWALL PRIVATE DATA PLANE INTERFACES"

# --- Inbound SSH rule ---
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND target negate no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND to INBOUND
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND from INBOUND
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND source-user any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND category any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND application [ scps ssh ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND service application-default
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND source-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND destination-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND action allow
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND log-setting default
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND group-tag INBOUND
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules SSH-INBOUND tag [ INBOUND APP1 APP2 BASELINE EXAMPLE ]
