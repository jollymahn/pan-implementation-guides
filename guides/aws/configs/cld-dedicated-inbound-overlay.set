set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS description "PING FROM ONPREM TO AWS"

# --- East-West rule ---
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST target negate no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST to EASTWEST
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST from EASTWEST
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST source-user any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST category any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST application [ icmp ping scps ssh ssl traceroute web-browsing ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST service any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST source-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST destination-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST tag [ EASTWEST APP1 APP2 BASELINE ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST action allow
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST group-tag EASTWEST
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST disabled no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST source [ N-10.48.0.0-21 N-10.49.0.0-21 ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST destination [ N-10.48.0.0-21 N-10.49.0.0-21 ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST log-start no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST log-end yes
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST profile-setting group Internal
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST description "POLICY FOR EAST-WEST WEB AND SSH TRAFFIC"
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-EAST-WEST log-setting default

# --- NAT: Outbound source translation ---
set device-group CLD-DG-AWS-DEDICATED pre-rulebase nat rules AWS-OUTBOUND source-translation dynamic-ip-and-port interface-address interface ethernet1/2
set device-group CLD-DG-AWS-DEDICATED pre-rulebase nat rules AWS-OUTBOUND target negate no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase nat rules AWS-OUTBOUND to UNTRUST
set device-group CLD-DG-AWS-DEDICATED pre-rulebase nat rules AWS-OUTBOUND from OUTBOUND
set device-group CLD-DG-AWS-DEDICATED pre-rulebase nat rules AWS-OUTBOUND source [ N-10.48.0.0-21 N-10.49.0.0-21 ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase nat rules AWS-OUTBOUND destination any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase nat rules AWS-OUTBOUND tag [ OUTBOUND OVERLAY-NAT ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase nat rules AWS-OUTBOUND service any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase nat rules AWS-OUTBOUND to-interface ethernet1/2
set device-group CLD-DG-AWS-DEDICATED pre-rulebase nat rules AWS-OUTBOUND group-tag OUTBOUND

# --- Default security rules ---
set device-group CLD-DG-AWS-DEDICATED post-rulebase default-security-rules rules intrazone-default action deny
set device-group CLD-DG-AWS-DEDICATED post-rulebase default-security-rules rules intrazone-default log-end yes
set device-group CLD-DG-AWS-DEDICATED post-rulebase default-security-rules rules intrazone-default log-setting default
set device-group CLD-DG-AWS-DEDICATED post-rulebase default-security-rules rules interzone-default log-end yes
set device-group CLD-DG-AWS-DEDICATED post-rulebase default-security-rules rules interzone-default log-setting default

# ═══════════════════════════════════════════════════════════════
# PHASE 6: SW FIREWALL LICENSE PLUGIN (license-manager)
# Bootstrap definition BD-SJ-VM-SERIES must exist (created via GUI)
# ═══════════════════════════════════════════════════════════════

set plugins sw_fw_license license-manager CLD-LM-AWS-DEDICATED device-group CLD-DG-AWS-DEDICATED
set plugins sw_fw_license license-manager CLD-LM-AWS-DEDICATED template-stack CLD-STK-AWS-DEDICATED-AZ-A
set plugins sw_fw_license license-manager CLD-LM-AWS-DEDICATED bootstrap-definition BD-SJ-VM-SERIES
set plugins sw_fw_license license-manager CLD-LM-AWS-DEDICATED auto-deactivate Never
