set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND category any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND log-start no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND log-end yes
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND description "OUTBOUND POLICY FOR UPDATES, SOFTWARE AND INTERNET ACCESS FROM AWS"
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND profile-setting group default

# --- APP1 inbound web rule ---
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP1-NLB-WEB target negate no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP1-NLB-WEB to INBOUND
