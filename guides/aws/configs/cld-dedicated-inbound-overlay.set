set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP1-NLB-WEB saas-tenant-list any

# --- APP2 inbound web rule ---
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB target negate no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB to INBOUND
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB from INBOUND
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB source-user any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB category any
