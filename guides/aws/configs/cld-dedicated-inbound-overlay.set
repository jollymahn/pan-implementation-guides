set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB service application-default
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB source-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB destination-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB action allow
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB log-setting default
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB group-tag INBOUND
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB tag [ INBOUND APP2 ALB BASELINE EXAMPLE ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB source any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB destination [ N-10.50.0.48-28 N-10.50.1.48-28 ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB disabled no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB log-start no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB log-end yes
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB profile-setting group Inbound
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB description "INBOUND WEB TRAFFIC TO APP2 VIA DEDICATED NLB"
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB saas-user-list any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules APP2-NLB-WEB saas-tenant-list any

# --- On-prem ICMP to AWS ---
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS target negate no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS to EASTWEST
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS from EASTWEST
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS destination [ N-10.48.0.0-21 N-10.49.0.0-21 ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS source-user any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS category any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS application [ dns icmp ping traceroute ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS service application-default
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS source-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS destination-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS action allow
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS log-setting default
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS disabled no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS tag [ BASELINE EXAMPLE ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS group-tag INBOUND
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS source N-10.0.0.0-8
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS log-start no
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules ONPREM-ICMP-TO-AWS log-end yes
