set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND service any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND source-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND destination-hip any
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND tag [ OUTBOUND APP1 APP2 OVERLAY-NAT BASELINE EXAMPLE ]
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND action allow
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND group-tag OUTBOUND
set device-group CLD-DG-AWS-DEDICATED pre-rulebase security rules AWS-OUTBOUND log-setting default
