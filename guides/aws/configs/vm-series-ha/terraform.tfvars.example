##############################################################################
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in your values before running:
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init
#   terraform plan
#   terraform apply
##############################################################################

### Required — must be set for every deployment

region       = "us-east-1"
az1          = "us-east-1a"   # AZ for the Active firewall (FW1)
az2          = "us-east-1b"   # AZ for the Passive firewall (FW2)
ssh_key_name = "my-key-pair"  # Name of an existing EC2 key pair in the target region

### Optional — sane defaults are provided in variables.tf

name_prefix   = "pan-ha-"
instance_type = "m5.xlarge"    # Minimum. Use m5.2xlarge / c5.2xlarge for >500 Mbps

# Restrict management access to your admin network — never leave as 0.0.0.0/0 in production
mgmt_cidrs = ["203.0.113.0/24"]  # Replace with your admin IP range

panos_version = "11.1.4-h7"    # Match the version available in your region/marketplace

# BYOL by default. Change to Bundle 1/2 product code if using a capacity license.
# vmseries_product_code = "6njl1pau431dv1qxipg63mvah"

global_tags = {
  Terraform   = "true"
  Environment = "security"
  Project     = "vm-series-ha"
  Owner       = "network-team"
}

### Bootstrap — Panorama-managed example
# Uncomment and fill in for Panorama-connected firewalls:

# bootstrap_options_fw1 = {
#   hostname        = "pan-fw1"
#   panorama-server = "panorama1.example.com"
#   tplname         = "ha-template-stack"
#   dgname          = "ha-device-group"
#   auth-key        = "LUFRPT1..."
#   dns-primary     = "8.8.8.8"
#   dns-secondary   = "8.8.4.4"
# }
#
# bootstrap_options_fw2 = {
#   hostname        = "pan-fw2"
#   panorama-server = "panorama1.example.com"
#   tplname         = "ha-template-stack"
#   dgname          = "ha-device-group"
#   auth-key        = "LUFRPT1..."
#   dns-primary     = "8.8.8.8"
#   dns-secondary   = "8.8.4.4"
# }

### Bootstrap — SCM (Strata Cloud Manager) example
# Uncomment and fill in for SCM-managed firewalls:

# bootstrap_options_fw1 = {
#   hostname                              = "pan-fw1"
#   vm-series-auto-registration-pin-id    = "your-pin-id"
#   vm-series-auto-registration-pin-value = "your-pin-value"
#   dns-primary                           = "8.8.8.8"
# }
#
# bootstrap_options_fw2 = {
#   hostname                              = "pan-fw2"
#   vm-series-auto-registration-pin-id    = "your-pin-id"
#   vm-series-auto-registration-pin-value = "your-pin-value"
#   dns-primary                           = "8.8.8.8"
# }

### Bootstrap — Standalone (no manager) example
# Use if configuring firewalls manually via the web UI after deployment.
# Set only hostname and DNS — PAN-OS boots with the default admin/admin credentials.

bootstrap_options_fw1 = {
  hostname      = "pan-fw1"
  dns-primary   = "8.8.8.8"
  dns-secondary = "8.8.4.4"
}

bootstrap_options_fw2 = {
  hostname      = "pan-fw2"
  dns-primary   = "8.8.8.8"
  dns-secondary = "8.8.4.4"
}

### Subnet CIDRs — change only if the defaults conflict with your address space

# vpc_cidr = "10.0.0.0/16"
#
# subnet_cidrs = {
#   mgmt_az1    = "10.0.0.0/24"
#   mgmt_az2    = "10.0.1.0/24"
#   untrust_az1 = "10.0.10.0/24"
#   untrust_az2 = "10.0.11.0/24"
#   trust_az1   = "10.0.20.0/24"
#   trust_az2   = "10.0.21.0/24"
#   ha1_az1     = "10.0.30.0/24"
#   ha1_az2     = "10.0.31.0/24"
#   ha2_az1     = "10.0.40.0/24"
#   ha2_az2     = "10.0.41.0/24"
# }

