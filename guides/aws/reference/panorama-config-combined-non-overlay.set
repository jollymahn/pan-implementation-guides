# #############################################################################
#
#   PANORAMA CONFIGURATION — NON-OVERLAY ROUTING (Combined Design)
#
#   Validated Panorama set-command sequence for the Combined Design with
#   Non-Overlay Routing. Matches the combined_design.tfvars Terraform
#   configuration.
#
#   Non-overlay differences from the overlay config:
#   - Single template stack (no per-AZ split — gateway IPs not needed)
#   - No firewall-side NAT rules (AWS NAT Gateway handles egress source NAT)
#   - No overlay routing or advanced routing plugin commands
#
#   Push this to Panorama BEFORE running terraform apply. The firewalls
#   bootstrap with dgname/tplname from the tfvars and pull this config.
#
# #############################################################################
#
# PLACEHOLDERS — Find-and-replace before pushing to Panorama:
#
#   Placeholder           Example                Scope
#   ───────────────────   ────────────────────   ─────────────────────────────
#   <SEC_NET>             10.51                  Security VPC subnet prefix
#   <APP1_NET>            10.104                 App1 spoke VPC prefix
#   <APP2_NET>            10.105                 App2 spoke VPC prefix
#   <APP3_NET>            10.106                 App3 spoke VPC prefix (optional)
#   <ADMIN_IP>            203.0.113.10           Admin source IP for SSH rules
#   <REGION_CODE>         USW2                   Short region code for template names
#   <REGION>              us-west-2              AWS region (FQDN references)
#   <PANORAMA_IP>         10.255.2.51            Panorama management IP
#   <PANORAMA_HOSTNAME>   MY-PANORAMA            Panorama hostname (comments only)
#
# Quick replace:
#   sed -i '' \
#     's/<SEC_NET>/10.51/g;
#      s/<APP1_NET>/10.104/g;
#      s/<APP2_NET>/10.105/g;
#      s/<APP3_NET>/10.106/g;
#      s/<ADMIN_IP>/203.0.113.10/g;
#      s/<REGION_CODE>/USW2/g;
#      s/<REGION>/us-west-2/g;
#      s/<PANORAMA_IP>/10.255.2.51/g;
#      s/<PANORAMA_HOSTNAME>/MY-PANORAMA/g' \
#     panorama-config-non-overlay.set
#
# Push to Panorama:
#   /guides/panorama-config push panorama-config-non-overlay.set
#
# =============================================================================

# ═════════════════════════════════════════════════════════════════════
#  panorama-config-cld-non-overlay.set
#
#  Adapted from reference/panorama-config-2a-aws.set for:
#    -  prefix on all templates, stacks, DGs
#    - Non-Overlay routing model (overlay sections removed)
#    - NAT rules removed (Non-Overlay uses AWS NAT Gateway)
#    - DNS/NTP updated to AWS-native per guide recommendation
#    - Panorama server IP set to <PANORAMA_IP> (<PANORAMA_HOSTNAME>)
#
#  EXCLUDES (handle manually in Panorama UI):
#    - RADIUS / TACACS server-profile shared secrets
#    - Authentication profiles, sequences, admin roles
#    - Administrator accounts (break-glass, AAA-backed)
#    - License plugin config (already configured)
#    - Template stacks (already created as STK-AWS-COMBINED-AZ-A/B)
# ═════════════════════════════════════════════════════════════════════

# ═════════════════════════════════════════════════════════════════════
# SECTION 1 — SHARED TAGS
# ═════════════════════════════════════════════════════════════════════
set shared tag INBOUND color color1
set shared tag INBOUND comments "INBOUND FLOW"
set shared tag OUTBOUND color color13
set shared tag OUTBOUND comments "OUTBOUND FLOW"
set shared tag EASTWEST color color13
set shared tag EASTWEST comments "EAST/WEST POLICY"
set shared tag AWS-HEALTH-GWLB color color24
set shared tag AWS-HEALTH-GWLB comments "HEALTH PROBES"
set shared tag AWS-FW-DATA-PRIVATE color color24
set shared tag AWS-FW-DATA-PRIVATE comments FW-Data-plane-interface
set shared tag BASELINE color color15
set shared tag BASELINE comments "BASELINE CONFIG ELEMENTS"
set shared tag EXAMPLE color color6
set shared tag EXAMPLE comments "EXAMPLE ELEMENT OR POLICY"
set shared tag APP1 color color2
set shared tag APP1 comments APP1-ELEMENTS
set shared tag APP2 color color17
set shared tag APP2 comments APP2-ELEMENTS
set shared tag APP3 color color9
set shared tag ALB color color9
set shared tag ALB comments NLB-ELEMENTS
set shared tag AWS-WEB-FARM-APP1 color color22
set shared tag AWS-WEB-FARM-APP1 comments INTERNAL
set shared tag PALO-GP-GATEWAY color color1
set shared tag PALO-GP-GATEWAY comments PALO-GP-GATEWAY

# ═════════════════════════════════════════════════════════════════════
# SECTION 2 — SHARED ADDRESS OBJECTS
# ═════════════════════════════════════════════════════════════════════
set shared address H-<ADMIN_IP> description PALO-ALTO-CALIFORNIA-GP-GATEWAY
set shared address H-<ADMIN_IP> ip-netmask <ADMIN_IP>
set shared address H-<ADMIN_IP> tag [ INBOUND BASELINE PALO-GP-GATEWAY ]
set shared address H-APP2-WEB-ALB-FQDN description app2-ALB1-1305844078.<REGION>.elb.amazonaws.com
set shared address H-APP2-WEB-ALB-FQDN fqdn app2-ALB1-1305844078.<REGION>.elb.amazonaws.com
set shared address H-APP2-WEB-ALB-FQDN tag [ APP2 ALB BASELINE ]
set shared address N-10.0.0.0-8 description RFC-1918-10
set shared address N-10.0.0.0-8 ip-netmask 10.0.0.0/8
set shared address N-10.0.0.0-8 tag BASELINE
set shared address N-10.103.32.48-28 description GWLB-SUBNET-A
set shared address N-10.103.32.48-28 ip-netmask 10.103.32.48/28
set shared address N-10.103.32.48-28 tag AWS-HEALTH-GWLB
set shared address N-10.103.32.64-28 description FIREWALL-PRIVATE-SUBNET-A
set shared address N-10.103.32.64-28 ip-netmask 10.103.32.64/28
set shared address N-10.103.32.64-28 tag AWS-FW-DATA-PRIVATE
set shared address N-10.103.33.48-28 description GWLB-SUBNET-B
set shared address N-10.103.33.48-28 ip-netmask 10.103.33.48/28
set shared address N-10.103.33.48-28 tag AWS-HEALTH-GWLB
set shared address N-10.103.33.64-28 description FIREWALL-PRIVATE-SUBNET-B
set shared address N-10.103.33.64-28 ip-netmask 10.103.33.64/28
set shared address N-10.103.33.64-28 tag AWS-FW-DATA-PRIVATE
set shared address N-10.103.34.48-28 description GWLB-SUBNET-C
set shared address N-10.103.34.48-28 ip-netmask 10.103.34.48/28
set shared address N-10.103.34.48-28 tag AWS-HEALTH-GWLB
set shared address N-10.103.35.48-28 description GWLB-SUBNET-D
set shared address N-10.103.35.48-28 ip-netmask 10.103.35.48/28
set shared address N-10.103.35.48-28 tag AWS-HEALTH-GWLB
set shared address N-<APP1_NET>.0.0-22 description APP1-VPC
set shared address N-<APP1_NET>.0.0-22 ip-netmask <APP1_NET>.0.0/22
set shared address N-<APP1_NET>.0.0-22 tag [ AWS-WEB-FARM-APP1 BASELINE ]
set shared address N-<APP2_NET>.0.0-22 description APP2-VPC
set shared address N-<APP2_NET>.0.0-22 ip-netmask <APP2_NET>.0.0/22
set shared address N-<APP2_NET>.0.0-22 tag [ APP2 BASELINE ]
set shared address N-<APP3_NET>.0.0-22 description APP3-VPC
set shared address N-<APP3_NET>.0.0-22 ip-netmask <APP3_NET>.0.0/22
set shared address N-<APP3_NET>.0.0-22 tag [ APP3 BASELINE ]

# ═════════════════════════════════════════════════════════════════════
# SECTION 3 — SHARED ADDRESS GROUPS (dynamic, tag-filter based)
# ═════════════════════════════════════════════════════════════════════
set shared address-group GRP-AWS-GWLB-HEALTH-PROBE-SUBNETS dynamic filter "'AWS-HEALTH-GWLB'"
set shared address-group GRP-AWS-GWLB-HEALTH-PROBE-SUBNETS tag AWS-HEALTH-GWLB
set shared address-group GRP-FIREWALL-PRIVATE-SUBNETS dynamic filter "'AWS-FW-DATA-PRIVATE'"
set shared address-group GRP-FIREWALL-PRIVATE-SUBNETS tag AWS-FW-DATA-PRIVATE

# ═════════════════════════════════════════════════════════════════════
# SECTION 4 — SHARED PROFILE GROUPS
# ═════════════════════════════════════════════════════════════════════
set shared profile-group Outbound spyware Outbound-AS
set shared profile-group Outbound vulnerability Outbound-VP
set shared profile-group Outbound url-filtering Outbound-URL
set shared profile-group Outbound file-blocking Outbound-FB
set shared profile-group Outbound wildfire-analysis Outbound-WF
set shared profile-group Outbound virus Outbound-AV
set shared profile-group Inbound spyware Inbound-AS
set shared profile-group Inbound vulnerability Inbound-VP
set shared profile-group Inbound file-blocking Inbound-FB
set shared profile-group Inbound wildfire-analysis Inbound-WF
set shared profile-group Inbound virus Inbound-AV
set shared profile-group Internal spyware Internal-AS
set shared profile-group Internal vulnerability Internal-VP
set shared profile-group Internal file-blocking Internal-FB
set shared profile-group Internal wildfire-analysis Internal-WF
set shared profile-group Internal virus Internal-AV
set shared profile-group Alert-Only spyware Alert-Only-AS
set shared profile-group Alert-Only vulnerability Alert-Only-VP
set shared profile-group Alert-Only url-filtering Alert-Only-URL
set shared profile-group Alert-Only file-blocking Alert-Only-FB
set shared profile-group Alert-Only wildfire-analysis Alert-Only-WF
set shared profile-group Alert-Only virus Alert-Only-AV
set shared profile-group default spyware Outbound-AS
set shared profile-group default vulnerability Outbound-VP
set shared profile-group default url-filtering Outbound-URL
set shared profile-group default file-blocking Outbound-FB
set shared profile-group default wildfire-analysis Outbound-WF
set shared profile-group default virus Outbound-AV

# ═════════════════════════════════════════════════════════════════════
# SECTION 5 — TEMPLATE 1-TPL-AWS-REGIONAL-<REGION_CODE> (region-specific)
# ═════════════════════════════════════════════════════════════════════
set template 1-TPL-AWS-REGIONAL-<REGION_CODE> description US-WEST-REGIONAL-TEMPLATE-FOR-REGIONAL-TACACS-AND-LOG-COLLECTORS
set template 1-TPL-AWS-REGIONAL-<REGION_CODE> settings default-vsys vsys1
set template 1-TPL-AWS-REGIONAL-<REGION_CODE> config  vsys vsys1

# ═════════════════════════════════════════════════════════════════════
# SECTION 6 — TEMPLATE 2-TPL-AWS-GLOBAL-COMMON-BASELINE
#   DNS/NTP updated to AWS-native per guide recommendation
#   Panorama server IP set to <PANORAMA_HOSTNAME> (<PANORAMA_IP>)
# ═════════════════════════════════════════════════════════════════════
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE description "COMMON SETTINGS DNS, NTP, BANNERS"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  vsys vsys1
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system update-server updates.paloaltonetworks.com
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system dns-setting servers primary 169.254.169.253
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system dns-setting servers secondary 8.8.8.8
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system ntp-servers primary-ntp-server ntp-server-address 169.254.169.123
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system ntp-servers secondary-ntp-server ntp-server-address time.aws.com
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client send-client-id no
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client send-hostname yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client accept-dhcp-hostname no
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system type dhcp-client accept-dhcp-domain no
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner motd-enable yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner message "!!!! DO NOT MAKE CHANGES ON THE LOCAL FIREWALL. MAKE ALL CHANGES ON PANORAMA. MAKE SURE YOU HAVE CAB APPROVAL PRIOR TO MAKING ANY CHANGES. !!!"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner motd-color color1
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner severity warning
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner banner-header "!!! THIS IS A FIREWALL. !!!"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner banner-header-color color1
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system motd-and-banner banner-header-text-color color18
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system panorama local-panorama panorama-server <PANORAMA_IP>
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system timezone UTC
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig system login-banner "!!!! GET OUT !!!!!"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig setting ctd x-forwarded-for 2
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig setting wildfire report-benign-file yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config  deviceconfig setting wildfire report-grayware-file yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings system match-list system filter "All Logs"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings system match-list system send-to-panorama yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings config match-list config filter "All Logs"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings config match-list config send-to-panorama yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings userid match-list user-id filter "All Logs"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings userid match-list user-id send-to-panorama yes
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings iptag match-list ip-tag filter "All Logs"
set template 2-TPL-AWS-GLOBAL-COMMON-BASELINE config shared log-settings iptag match-list ip-tag send-to-panorama yes

# ═════════════════════════════════════════════════════════════════════
# SECTION 9 — TEMPLATE 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED
#   Non-Overlay: ethernet1/1 accepts DHCP default route, no static routes
# ═════════════════════════════════════════════════════════════════════
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED description "Network Settings: interfaces, zones, routing"
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile AWS-HEALTH-CHECKS https yes
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile AWS-HEALTH-CHECKS permitted-ip 10.0.0.0/8
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile AWS-HEALTH-CHECKS permitted-ip 172.16.0.0/12
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile AWS-HEALTH-CHECKS http yes
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile AWS-HEALTH-CHECKS ssh no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile PUBLIC-PING permitted-ip <ADMIN_IP>
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile PUBLIC-PING ping yes
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile INTERNAL-PING permitted-ip 10.0.0.0/8
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile INTERNAL-PING permitted-ip 172.16.0.0/12
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile INTERNAL-PING permitted-ip 192.168.0.0/16
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network profiles interface-management-profile INTERNAL-PING ping yes
# ethernet1/1 — GWLB-facing private dataplane
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 ndp-proxy enabled no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings upstream-nat enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings upstream-nat static-ip
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 sdwan-link-settings ipv6-enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 interface-management-profile AWS-HEALTH-CHECKS
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 lldp enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 dhcp-client
# Subinterfaces
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 tag 10
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 ndp-proxy enabled no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 sdwan-link-settings enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 sdwan-link-settings upstream-nat enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 sdwan-link-settings upstream-nat static-ip
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 sdwan-link-settings ipv6-enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 adjust-tcp-mss enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 dhcp-client create-default-route no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.10 comment INBOUND-DEDICATED
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 tag 20
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 comment OUTBOUND
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 dhcp-client create-default-route no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 sdwan-link-settings enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 sdwan-link-settings upstream-nat enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 sdwan-link-settings upstream-nat static-ip
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 sdwan-link-settings ipv6-enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 ndp-proxy enabled no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.20 adjust-tcp-mss enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 tag 30
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 comment EASTWEST
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 dhcp-client create-default-route no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 ndp-proxy enabled no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 sdwan-link-settings enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 sdwan-link-settings upstream-nat enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 sdwan-link-settings upstream-nat static-ip
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 sdwan-link-settings ipv6-enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.30 adjust-tcp-mss enable no
# Per-app distributed inbound subinterfaces
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.101 sdwan-link-settings upstream-nat enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.101 sdwan-link-settings upstream-nat static-ip
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.101 sdwan-link-settings enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.101 sdwan-link-settings ipv6-enable no
