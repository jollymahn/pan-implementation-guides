set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.101 adjust-tcp-mss enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.101 tag 101
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.101 dhcp-client create-default-route no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.102 sdwan-link-settings upstream-nat enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.102 sdwan-link-settings upstream-nat static-ip
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.102 sdwan-link-settings enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.102 sdwan-link-settings ipv6-enable no
set template 4-TPL-AWS-GWLB-NON-OVRLY-COMBINED config  network interface ethernet ethernet1/1 layer3 units ethernet1/1.102 ndp-proxy enabled no
