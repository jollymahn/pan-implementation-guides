            <mxPoint x="745" y="578" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- HA2 link: ha2-az1 right edge → ha2-az2 left edge (y center = 650) -->
        <mxCell id="ha2-link" value="&lt;b&gt;HA2 — Session Sync&lt;/b&gt;&lt;br&gt;TCP 28778 &amp;nbsp;|&amp;nbsp; eth1/4 &#x2194; eth1/4" style="endArrow=block;startArrow=block;html=1;strokeColor=#7c3aed;strokeWidth=3;endFill=1;startFill=1;fontSize=11;fontFamily=Helvetica;align=center;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="655" y="650" as="sourcePoint"/>
            <mxPoint x="745" y="650" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  FW → SUBNET CONNECTORS (light, dashed)          -->
        <!-- ═══════════════════════════════════════════════ -->

        <!-- FW1 up to mgmt-az1 -->
        <mxCell id="fw1-mgmt-line" style="endArrow=none;html=1;strokeColor=#006DCC;strokeWidth=1;dashed=1;dashPattern=3 3;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="fw1-bg" target="mgmt-az1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FW1 up to untrust-az1 -->
        <mxCell id="fw1-untrust-line" style="endArrow=none;html=1;strokeColor=#E5A300;strokeWidth=1;dashed=1;dashPattern=3 3;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="fw1-bg" target="untrust-az1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FW1 down to trust-az1 -->
        <mxCell id="fw1-trust-line" style="endArrow=none;html=1;strokeColor=#22c55e;strokeWidth=1;dashed=1;dashPattern=3 3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fw1-bg" target="trust-az1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FW2 up to mgmt-az2 -->
        <mxCell id="fw2-mgmt-line" style="endArrow=none;html=1;strokeColor=#006DCC;strokeWidth=1;dashed=1;dashPattern=3 3;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="fw2-bg" target="mgmt-az2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FW2 up to untrust-az2 -->
        <mxCell id="fw2-untrust-line" style="endArrow=none;html=1;strokeColor=#E5A300;strokeWidth=1;dashed=1;dashPattern=3 3;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="fw2-bg" target="untrust-az2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FW2 down to trust-az2 -->
        <mxCell id="fw2-trust-line" style="endArrow=none;html=1;strokeColor=#22c55e;strokeWidth=1;dashed=1;dashPattern=3 3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fw2-bg" target="trust-az2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- IGW → untrust subnets (public traffic path) -->
        <mxCell id="igw-untrust-az1" style="endArrow=block;html=1;strokeColor=#E5A300;strokeWidth=2;endFill=1;dashed=1;dashPattern=6 3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="660" y="138" as="sourcePoint"/>
            <mxPoint x="357" y="287" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="660" y="175"/>
              <mxPoint x="357" y="175"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="igw-untrust-az2" style="endArrow=block;html=1;strokeColor=#E5A300;strokeWidth=2;endFill=1;dashed=1;dashPattern=6 3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="138" as="sourcePoint"/>
            <mxPoint x="1042" y="287" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="740" y="175"/>
              <mxPoint x="1042" y="175"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  LEGEND                                          -->
        <!-- ═══════════════════════════════════════════════ -->

        <mxCell id="legend-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1320" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="legend-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="728" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- Subnet color legend -->
        <mxCell id="leg-mgmt" value="Management subnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#006DCC;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="752" width="170" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="leg-untrust" value="Untrust (public) subnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="752" width="175" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="leg-trust" value="Trust (private) subnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="752" width="165" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="leg-ha" value="HA1 / HA2 subnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9333ea;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="610" y="752" width="145" height="26" as="geometry"/>
        </mxCell>

        <!-- Failover note -->
        <mxCell id="failover-note" value="&lt;b&gt;On HA failover:&lt;/b&gt; PAN-OS on FW2 calls EC2 API using its IAM instance profile to (1) move the Floating EIP from FW1 untrust ENI to FW2 untrust ENI, and (2) update the trust route table next-hop to point to FW2&apos;s trust ENI. Failover completes in ~30&amp;ndash;60 seconds." style="text;html=1;align=left;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="790" width="1290" height="40" as="geometry"/>
        </mxCell>

        <!-- HA port note -->
        <mxCell id="ha-port-note" value="&lt;b&gt;HA1&lt;/b&gt; (TCP 28769): heartbeat + hello messages. Firewall monitors this link to detect peer failure. &amp;nbsp;&amp;nbsp; &lt;b&gt;HA2&lt;/b&gt; (TCP 28778): bulk session state sync. Passive firewall holds a live copy of all sessions — in-flight connections survive failover with minimal packet loss." style="text;html=1;align=left;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="836" width="1290" height="36" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
