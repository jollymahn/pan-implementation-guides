          <mxGeometry x="474" y="654" width="100" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="leg-failover" value="&lt;b&gt;On HA failover:&lt;/b&gt; PAN-OS on FW2 calls the EC2 API using its IAM instance profile to (1) move the Floating EIP from FW1&apos;s untrust ENI to FW2&apos;s untrust ENI, and (2) update the trust route table to point to FW2&apos;s trust ENI. Failover completes in ~30&amp;ndash;60 seconds." style="text;html=1;align=left;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="56" y="690" width="1464" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="leg-ha-ports" value="&lt;b&gt;HA1&lt;/b&gt; (TCP 28769): heartbeat + hello — firewall monitors this link to detect peer failure. &amp;nbsp;&amp;nbsp; &lt;b&gt;HA2&lt;/b&gt; (TCP 28778): bulk session state sync — passive firewall holds a live copy of all sessions, so in-flight connections survive failover with minimal packet loss." style="text;html=1;align=left;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="56" y="726" width="1464" height="32" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
