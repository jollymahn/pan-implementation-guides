<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Call Flow" id="aigw-call-flow">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="What the gateway does to one request" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="The application sends three values. The gateway does ten steps. The provider sees one caller." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ APP ============ -->
        <mxCell id="app" value="&lt;b&gt;YOUR APPLICATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="300" height="348" as="geometry"/>
        </mxCell>
        <mxCell id="app-b" value="&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;You change three values. You do not change the application logic.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="126" width="266" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v1" value="&lt;b&gt;1&#160;&#160;Base URL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;https://aigw.portkey.ai&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Or your own gateway address.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="58" y="172" width="266" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="v2" value="&lt;b&gt;2&#160;&#160;Gateway API key&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;Authorization: Bearer ...&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;This replaces the provider key.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="58" y="240" width="266" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="v3" value="&lt;b&gt;3&#160;&#160;Model reference&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;@&amp;lt;slug&amp;gt;/&amp;lt;model-name&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The slug tells the gateway which integration to use.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="58" y="308" width="266" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="v4" value="&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;&lt;b&gt;A fourth value, for some clients only.&lt;/b&gt; If the client sends a bare model name, add the header x-portkey-provider: @&amp;lt;slug&amp;gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="58" y="382" width="266" height="52" as="geometry"/>
        </mxCell>

        <!-- ============ GATEWAY ============ -->
        <mxCell id="gw" value="&lt;b&gt;AI GATEWAY&lt;/b&gt;&#160;&#160;&#160;&lt;font style=&quot;font-size:10px;font-weight:normal;color:#666666&quot;&gt;the inference layer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="420" y="96" width="580" height="500" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;1&#160;&#160;Authenticate the key&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;A bad key gives 401.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="442" y="130" width="536" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2&#160;&#160;Read the slug&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The slug selects the integration. No slug gives 400.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="442" y="170" width="536" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3&#160;&#160;Check the model&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;You can use only a provisioned model.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="442" y="210" width="536" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4&#160;&#160;Apply the budget and the rate limit&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Over the limit gives 429.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="442" y="250" width="536" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5&#160;&#160;Look in the cache&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;A cache hit returns here. The provider is not called.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="442" y="290" width="536" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6&#160;&#160;Examine the prompt&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;A guardrail can stop the request here.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="442" y="330" width="536" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7&#160;&#160;Change the credential&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The gateway removes your key. It adds the provider credential.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="442" y="370" width="536" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;8&#160;&#160;Translate the request&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Only if the client protocol and the provider protocol are different.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="442" y="410" width="536" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="s9" value="&lt;b&gt;9&#160;&#160;Send the request to the provider&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="442" y="450" width="536" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="s10" value="&lt;b&gt;10&#160;&#160;Examine the answer, then log it&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The gateway records the tokens, the cost and the prompt.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="442" y="490" width="536" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="gw-note" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Steps 1 to 4 are fast. Step 5 can remove all provider latency. Step 9 is where almost all the time goes.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="442" y="532" width="536" height="34" as="geometry"/>
        </mxCell>

        <!-- ============ PROVIDER ============ -->
        <mxCell id="prov" value="&lt;b&gt;MODEL PROVIDER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1080" y="96" width="340" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="prov-b" value="&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;The provider receives the request from the gateway. It does not receive it from your application.&lt;br&gt;&lt;br&gt;The provider sees one caller, not many. Your application no longer holds a provider key.&lt;br&gt;&lt;br&gt;&lt;b&gt;One of:&lt;/b&gt;&lt;br&gt;Open AI&#160;&#183;&#160;Anthropic&#160;&#183;&#160;Google&lt;br&gt;Azure OpenAI&#160;&#183;&#160;Azure Foundry&lt;br&gt;Bedrock&#160;&#183;&#160;Bedrock Mantle&lt;br&gt;Claude Platform on AWS&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1098" y="126" width="304" height="276" as="geometry"/>
        </mxCell>

        <!-- ============ ARROWS ============ -->
        <mxCell id="a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a1l" value="&lt;font style=&quot;font-size:10px;color:#22c55e&quot;&gt;&lt;b&gt;request&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="344" y="146" width="72" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.72;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="prov"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2l" value="&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;&lt;b&gt;provider credential&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1000" y="228" width="82" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="a3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;dashed=1;dashPattern=8 4;exitX=0;exitY=0.78;exitDx=0;exitDy=0;entryX=1;entryY=0.88;entryDx=0;entryDy=0;" edge="1" parent="1" source="prov" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;dashed=1;dashPattern=8 4;exitX=0;exitY=0.96;exitDx=0;exitDy=0;entryX=1;entryY=0.88;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4l" value="&lt;font style=&quot;font-size:10px;color:#006DCC&quot;&gt;&lt;b&gt;answer&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="344" y="384" width="72" height="22" as="geometry"/>
        </mxCell>

        <!-- ============ LATENCY ============ -->
        <mxCell id="lt" value="Where the time goes" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="628" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="Step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="330" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Effect on latency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="660" width="420" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="What you can do" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="660" width="630" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="r1a" value="Steps 1 to 4, and step 10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="330" height="36" as="geometry"/></mxCell>
        <mxCell id="r1b" value="Small. These steps are local to the gateway." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="688" width="420" height="36" as="geometry"/></mxCell>
        <mxCell id="r1c" value="Nothing. Do not try to tune these." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="790" y="688" width="630" height="36" as="geometry"/></mxCell>

        <mxCell id="r2a" value="Step 5, the cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="724" width="330" height="48" as="geometry"/></mxCell>
        <mxCell id="r2b" value="A cache hit removes all provider latency. The gateway answers immediately." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="724" width="420" height="48" as="geometry"/></mxCell>
        <mxCell id="r2c" value="Turn on the cache for prompts that repeat. A simple cache matches the same text. A semantic cache matches text with the same meaning." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="790" y="724" width="630" height="48" as="geometry"/></mxCell>

        <mxCell id="r3a" value="Step 6 and step 10, the guardrails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="330" height="48" as="geometry"/></mxCell>
        <mxCell id="r3b" value="Each guardrail adds a check. A guardrail that calls a scan service adds a network request." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="772" width="420" height="48" as="geometry"/></mxCell>
        <mxCell id="r3c" value="Add only the guardrails you need. Measure the latency before you add a guardrail and after you add it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="790" y="772" width="630" height="48" as="geometry"/></mxCell>

        <mxCell id="r4a" value="Step 9, the provider call" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="330" height="48" as="geometry"/></mxCell>
        <mxCell id="r4b" value="Large. This is the model. It is almost all of the time the user waits." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="820" width="420" height="48" as="geometry"/></mxCell>
        <mxCell id="r4c" value="Use a smaller model, or turn on streaming. Streaming does not make the answer faster. It shows the first words sooner." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="790" y="820" width="630" height="48" as="geometry"/></mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;The gateway is not a network device&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="896" width="680" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="Each application must point at the gateway. Routing does not do this.&lt;br&gt;DNS does not do this. A proxy setting does not do this.&lt;br&gt;&lt;br&gt;An application that still points at the provider continues to work. The&lt;br&gt;gateway cannot see it. Make a list of all your applications first." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="926" width="650" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Streaming hides the token count&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="896" width="680" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="With stream: true, an Open AI compatible provider sends no usage data.&lt;br&gt;The gateway then logs zero tokens and zero cost. The budget does not&lt;br&gt;see the spend.&lt;br&gt;&lt;br&gt;To correct this, the application must also send&lt;br&gt;stream_options: {include_usage: true}." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="926" width="650" height="82" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
