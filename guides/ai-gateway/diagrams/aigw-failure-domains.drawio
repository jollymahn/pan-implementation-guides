<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Failure Domains" id="aigw-failure-domains">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t" value="Five things that can fail" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="Only one of them is severe. The chart defaults make three of them worse than they need to be." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="d0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="268" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="n0" value="A pod" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="54" y="112" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v0" value="SURVIVABLE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#22c55e;" vertex="1" parent="1">
          <mxGeometry x="54" y="150" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="g0" value="With 3 replicas, the other pods take the traffic. The pod holds no state." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="54" y="178" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="wl0" value="WATCH OUT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#b91c1c;" vertex="1" parent="1">
          <mxGeometry x="54" y="292" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="b0" value="Chart default is &lt;b&gt;1 replica&lt;/b&gt;. Then a pod failure is a full outage." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="54" y="312" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="318" y="100" width="268" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="A node or a zone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="332" y="112" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v1" value="SURVIVABLE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#22c55e;" vertex="1" parent="1">
          <mxGeometry x="332" y="150" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="With a topology spread, the pods are in different zones." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="332" y="178" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="wl1" value="WATCH OUT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#b91c1c;" vertex="1" parent="1">
          <mxGeometry x="332" y="292" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="Chart default spreads &lt;b&gt;nothing&lt;/b&gt;, and makes &lt;b&gt;no PodDisruptionBudget&lt;/b&gt;. A node drain can take every pod." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="332" y="312" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="596" y="100" width="268" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="The cache" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="610" y="112" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v2" value="SEVERE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#ef4444;" vertex="1" parent="1">
          <mxGeometry x="610" y="150" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="Config is re-fetched on next use, so the gateway recovers. Rate limit state resets. Unsent usage counters are lost." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="610" y="178" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="wl2" value="WATCH OUT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#b91c1c;" vertex="1" parent="1">
          <mxGeometry x="610" y="292" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="Redis default policy &lt;b&gt;noeviction&lt;/b&gt; makes all new writes fail at the memory limit." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="610" y="312" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="874" y="100" width="268" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="The Management Plane" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="888" y="112" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v3" value="TOLERATED WELL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#22c55e;" vertex="1" parent="1">
          <mxGeometry x="888" y="150" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="Traffic continues from the 7-day config cache. Analytics queue, then send on recovery." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="888" y="178" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="wl3" value="WATCH OUT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#b91c1c;" vertex="1" parent="1">
          <mxGeometry x="888" y="292" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="You cannot make a change. No new keys, integrations or routing configs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="888" y="312" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1152" y="100" width="268" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="A model provider" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="1166" y="112" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v4" value="SURVIVABLE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#E5A300;" vertex="1" parent="1">
          <mxGeometry x="1166" y="150" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="Fallbacks, retries, a circuit breaker and load balancing all handle this." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1166" y="178" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="wl4" value="WATCH OUT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#b91c1c;" vertex="1" parent="1">
          <mxGeometry x="1166" y="292" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="None of these are on by default. Each one is configuration you add." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1166" y="312" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="tt" value="The one combination that stops traffic" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1000" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="The cache AND the Management Plane, together" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="464" width="1380" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="Each failure is survivable on its own. Together they are not. The gateway cannot read a configuration object from an empty cache, and it cannot fetch that object from a Management Plane it cannot reach.
So give the cache its own high availability, and do not run it on the same nodes as the gateway pods." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="494" width="1350" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="What a Management Plane outage actually costs you" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1000" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="h0" value="Continues to work" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="612" width="690" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="Stops working" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="612" width="690" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="ra0" value="All LLM requests, from the cached configuration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="690" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="rb0" value="New integrations and new API keys" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="730" y="640" width="690" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ra1" value="Rate limits, at their last known state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="690" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="rb1" value="Changes to a routing configuration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="730" y="670" width="690" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ra2" value="Routing, load balancing and fallbacks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="690" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="rb2" value="Changes to a prompt template" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="730" y="700" width="690" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ra3" value="Response caching, and guardrails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="690" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="rb3" value="Live dashboard analytics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="730" y="730" width="690" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ra4" value="Request logging to your own storage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="690" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="rb4" value="Every console operation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="730" y="760" width="690" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="The configuration cache holds a 7-day TTL. An outage shorter than that never reaches your users." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1380" height="24" as="geometry"/>
        </mxCell>

      </root>
