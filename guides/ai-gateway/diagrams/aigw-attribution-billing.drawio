<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Attribution and Billing" id="aigw-attribution">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Attribution and billing &#8212; where the numbers and the group information come from" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Every cost figure and every group breakdown traces back to one thing: the gateway API key the request arrived with, and the metadata you attached to that key." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1300" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ ATTRIBUTION CHAIN ============ -->
        <mxCell id="chain-title" value="THE  ATTRIBUTION  CHAIN" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="420" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;Organization&lt;/b&gt;&#160;&#160;=&#160;&#160;TSG (Tenant Service Group)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The licensing and flex credit boundary. Set once when the&lt;br&gt;deployment profile is mapped in the Customer Support Portal.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="420" height="88" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Workspace&lt;/b&gt;&#160;&#160;=&#160;&#160;SCM Workspace&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The team boundary. Provisioning an integration to a workspace&lt;br&gt;decides which teams may use it, and sets that team&#39;s budget&lt;br&gt;and rate ceiling. Admin access is governed by SBAC roles.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="222" width="420" height="88" as="geometry"/>
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;Integration&lt;/b&gt;&#160;&#160;one provider connection&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Holds the provider credential, the model allowlist, and the&lt;br&gt;&lt;b&gt;pricing adjust multiplier&lt;/b&gt; that turns list price into your&lt;br&gt;effective rate. Identified in every call by its &lt;b&gt;slug&lt;/b&gt;.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="334" width="420" height="88" as="geometry"/>
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;Gateway API key&lt;/b&gt;&#160;&#160;one per application&#160;&#160;&#8592;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;the pivot&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Carries scoped permissions, its own budget and rate limit, an&lt;br&gt;expiry, and &lt;b&gt;JSON metadata tags&lt;/b&gt; you define:&lt;br&gt;&lt;font style=&quot;font-family:Courier New&quot;&gt;{ app: chatbot, env: prod, team: platform, cc: 4820 }&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=3;fontSize=11.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="446" width="420" height="88" as="geometry"/>
        </mxCell>

        <mxCell id="c5" value="&lt;b&gt;The request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Arrives bearing that key. The gateway stamps the log record&lt;br&gt;with the key, its metadata, the integration, the model, the token&lt;br&gt;counts, and the computed cost.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="558" width="420" height="88" as="geometry"/>
        </mxCell>

        <mxCell id="ce1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#3b82f6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#3b82f6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#3b82f6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============ LOG RECORD ============ -->
        <mxCell id="log-title" value="WHAT  IS  CAPTURED  PER  REQUEST" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="86" width="440" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="logbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="110" width="440" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="log-body" value="&lt;b&gt;Prompt log&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;native storage, 1 year retention&lt;/font&gt;&lt;br&gt;&#8226;&#160;Trace ID&lt;br&gt;&#8226;&#160;Full request and response context windows&lt;br&gt;&#8226;&#160;Token counts, request and response&lt;br&gt;&#8226;&#160;Total cost for the call&lt;br&gt;&#8226;&#160;Model invoked&lt;br&gt;&#8226;&#160;Provider integration used&lt;br&gt;&#8226;&#160;&lt;b&gt;The API key that made the call&lt;/b&gt;&lt;br&gt;&#8226;&#160;Request timing and latency&lt;br&gt;&lt;br&gt;&lt;b&gt;Event log&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;native + Strata Logging Service&lt;/font&gt;&lt;br&gt;&#8226;&#160;Audit, authentication, traffic, metrics&lt;br&gt;&#8226;&#160;Streams to SIEM and SOAR over OpenTelemetry&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;Prompt log export to your own bucket is Hybrid only.&lt;br&gt;If compliance needs prompts in storage you control,&lt;br&gt;that requirement picks the deployment model.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="516" y="124" width="412" height="296" as="geometry"/>
        </mxCell>

        <!-- ============ GROUPS ============ -->
        <mxCell id="grp-title" value="WHERE  &#34;GROUP&#34;  INFORMATION  COMES  FROM" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="980" y="86" width="440" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="grpbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="440" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="grp-body" value="&lt;b&gt;Not from your identity provider.&lt;/b&gt;&lt;br&gt;&lt;br&gt;SSO and Cloud Identity Engine govern &lt;i&gt;who can log&lt;br&gt;into Strata Cloud Manager&lt;/i&gt;. They do not tag traffic.&lt;br&gt;There is no directory group carried on the request.&lt;br&gt;&lt;br&gt;&lt;b&gt;Groups are metadata you define.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt;&#160;You attach JSON tags to each gateway API key.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt;&#160;Requests inherit those tags into the logs.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt;&#160;In Policies &amp;amp; Profiles, a budget or rate policy&lt;br&gt;&#160;&#160;&#160;&#160;&#160;matches on a &lt;b&gt;Condition Key&lt;/b&gt; with includes and&lt;br&gt;&#160;&#160;&#160;&#160;&#160;excludes value lists.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt;&#160;&lt;b&gt;Group by Key&lt;/b&gt; then applies the cap &lt;i&gt;per value&lt;/i&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;of that key rather than to the matched set as&lt;br&gt;&#160;&#160;&#160;&#160;&#160;a whole. Group by &lt;font style=&quot;font-family:Courier New&quot;&gt;team&lt;/font&gt; and every team gets&lt;br&gt;&#160;&#160;&#160;&#160;&#160;its own ceiling from one policy.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;&lt;b&gt;So your metadata schema is your chargeback&lt;br&gt;model.&lt;/b&gt; Design it before you issue the first key.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="996" y="124" width="412" height="296" as="geometry"/>
        </mxCell>

        <!-- ============ TWO MONEY FLOWS ============ -->
        <mxCell id="money-title" value="TWO  SEPARATE  MONEY  FLOWS" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="446" width="440" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="m1" value="&lt;b&gt;1.&#160;&#160;What you pay Palo Alto Networks&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12.5;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="500" y="470" width="440" height="238" as="geometry"/>
        </mxCell>
        <mxCell id="m1b" value="&lt;b&gt;Flex credits&lt;/b&gt;, metered by token consumption.&lt;br&gt;&lt;br&gt;&#8226;&#160;1 token = 4 characters&lt;br&gt;&#8226;&#160;LLM prompts, MCP calls, and agent-to-agent&lt;br&gt;&#160;&#160;&#160;traffic all count against the same pool&lt;br&gt;&#8226;&#160;Identical pricing for SaaS and Hybrid&lt;br&gt;&#8226;&#160;No extra charge for more gateways&lt;br&gt;&lt;br&gt;&lt;b&gt;Seen in:&lt;/b&gt; Customer Support Portal &#8594; Products &#8594;&lt;br&gt;Software NGFW Credits &#8594; the AI-GW profile row." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="516" y="500" width="412" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="m2" value="&lt;b&gt;2.&#160;&#160;What you pay the model provider&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12.5;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="980" y="470" width="440" height="238" as="geometry"/>
        </mxCell>
        <mxCell id="m2b" value="&lt;b&gt;Unchanged by the gateway.&lt;/b&gt; AWS, Anthropic, or&lt;br&gt;Microsoft still bills your provider account directly.&lt;br&gt;&lt;br&gt;What the gateway adds is a &lt;i&gt;calculated&lt;/i&gt; view of that&lt;br&gt;spend, per call, so you can attribute and cap it:&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Pricing adjust multiplier&lt;/b&gt; per integration&lt;br&gt;&#160;&#160;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;0.80&lt;/font&gt; = a 20% negotiated discount&lt;br&gt;&#160;&#160;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;1.20&lt;/font&gt; = a 20% internal showback markup&lt;br&gt;&#8226;&#160;&lt;b&gt;Budget limits&lt;/b&gt; in USD or tokens, which block&lt;br&gt;&#160;&#160;&#160;traffic once hit&lt;br&gt;&lt;br&gt;&lt;b&gt;Seen in:&lt;/b&gt; AI Gateway &#8594; Observability." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="996" y="500" width="412" height="200" as="geometry"/>
        </mxCell>

        <!-- ============ DESIGN IMPLICATION ============ -->
        <mxCell id="imp" value="&lt;b&gt;The design decision this diagram exists to force&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1380" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="imp-b1" value="&lt;b&gt;Agree the metadata schema before issuing keys.&lt;/b&gt;&lt;br&gt;Every dimension Finance will later want to slice by has to&lt;br&gt;exist as a tag on the key from day one. A reasonable&lt;br&gt;starting set:&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ app: &#183;&#183;&#183;, team: &#183;&#183;&#183;, env: prod|nonprod,&lt;br&gt;&#160;&#160;cost_center: &#183;&#183;&#183;, owner: &#183;&#183;&#183; }&lt;/font&gt;&lt;br&gt;&lt;br&gt;Retrofitting is painful: budget limits never apply&lt;br&gt;retroactively, and keys already in production carry the&lt;br&gt;old tags until they are reissued." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="774" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="imp-b2" value="&lt;b&gt;One key per application, not one key per tenant.&lt;/b&gt;&lt;br&gt;A shared key collapses every team into a single row in the&lt;br&gt;logs and makes revocation an outage. The granularity of&lt;br&gt;your keys is the granularity of your reporting, your rate&lt;br&gt;limiting, and your blast radius.&lt;br&gt;&lt;br&gt;&lt;b&gt;Per-user attribution is not automatic.&lt;/b&gt;&lt;br&gt;A shared application key attributes to the application.&lt;br&gt;If the customer needs cost or audit per end user, that&lt;br&gt;has to be designed in deliberately &#8212; confirm with the&lt;br&gt;tenant how per-request metadata is accepted before&lt;br&gt;promising it." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="510" y="774" width="440" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="imp-b3" value="&lt;b&gt;Limits stack, and the most restrictive wins.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Key level&lt;/b&gt; &#8212; this application&lt;br&gt;&#8226;&#160;&lt;b&gt;Workspace level&lt;/b&gt; &#8212; this team&#39;s use of an integration&lt;br&gt;&#8226;&#160;&lt;b&gt;Policy level&lt;/b&gt; &#8212; organization-wide, scoped by metadata&lt;br&gt;&#160;&#160;&#160;conditions and group keys&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;Budget and rate limits cannot be edited once set, by&lt;br&gt;any organization member. Get the numbers right the&lt;br&gt;first time, or plan to recreate the object.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="982" y="774" width="426" height="160" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
