<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway hybrid data plane on GCP" id="aigw-hybrid-gcp-vpc">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI Gateway hybrid data plane on GCP" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Everything inside the VPC is yours, and prompt content never leaves it. Only anonymised metrics go outbound. The management plane also connects inbound, over Private Service Connect or an IP allow-list." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1500" height="24" as="geometry"/>
        </mxCell>

        <!-- Applications -->
        <mxCell id="apps" value="&lt;b&gt;Your applications&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pods, GCE, Cloud Run, or anything&lt;br&gt;that can reach the VPC&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url = internal LB&lt;br&gt;api_key = &amp;lt;workspace key&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="215" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="apps-note" value="No provider API keys live here.&#10;The app speaks one OpenAI-shaped&#10;API to one internal endpoint." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="328" width="230" height="50" as="geometry"/>
        </mxCell>

        <!-- VPC -->
        <mxCell id="vpc" value="&lt;b&gt;Your VPC&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;private subnets across two zones, plus a REGIONAL_MANAGED_PROXY subnet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#E5A300;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="860" height="680" as="geometry"/>
        </mxCell>

        <mxCell id="nlb" value="&lt;b&gt;Internal Application LB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Regional. Will not provision&lt;br&gt;without an ACTIVE proxy-only&lt;br&gt;subnet in this VPC.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="160" width="230" height="90" as="geometry"/>
        </mxCell>

        <!-- EKS cluster -->
        <mxCell id="eks" value="&lt;b&gt;GKE cluster&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;node pool, one node per zone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="320" y="280" width="800" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="pod-a" value="&lt;b&gt;Worker node &#183; gateway pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;zone a&#160;&#160;&#183;&#160;&#160;2 vCPU / 4 GiB or larger&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Auth &#183; routing &#183; guardrails&lt;br&gt;rate limits &#183; budgets&lt;br&gt;metering &#183; logging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="322" width="370" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="pod-b" value="&lt;b&gt;Worker node &#183; gateway pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;zone b&#160;&#160;&#183;&#160;&#160;2 vCPU / 4 GiB or larger&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Auth &#183; routing &#183; guardrails&lt;br&gt;rate limits &#183; budgets&lt;br&gt;metering &#183; logging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="322" width="370" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="eks-note" value="&lt;b&gt;Minimum 2 worker nodes&lt;/b&gt;, at least 2 vCPU and 4 GiB each. One per zone is the documented best practice. The gateway is stateless, so it scales horizontally.&lt;br&gt;&lt;b&gt;Workload Identity&lt;/b&gt; binds the Kubernetes ServiceAccount to a Google service account, which is how the pods reach Cloud Storage with no static key. Installed with &lt;b&gt;helm install portkey-ai/gateway&lt;/b&gt; into namespace &lt;b&gt;portkeyai&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="482" width="760" height="70" as="geometry"/>
        </mxCell>

        <!-- Managed services -->
        <mxCell id="redis" value="&lt;b&gt;Memorystore &#183; cache store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Redis or Valkey. Must sit in&lt;br&gt;the same VPC as the gateway.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Synced config &#183; API keys&lt;br&gt;rate limit and budget state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="615" width="250" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;Cloud Storage &#183; log store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Reached with Workload Identity&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;&lt;b&gt;Full prompt and completion bodies&lt;/b&gt;&lt;br&gt;Roughly 10 kB per document.&lt;br&gt;Encrypted at rest, in your account.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="615" width="250" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="nat" value="&lt;b&gt;Cloud NAT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Regional&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;The outbound path when you are&lt;br&gt;not using Private Service Connect.&lt;br&gt;Filter by FQDN here.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="615" width="240" height="125" as="geometry"/>
        </mxCell>

        <!-- Outside -->
        <mxCell id="mgmt" value="&lt;b&gt;PAN management plane&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;aigw.portkey.ai&lt;br&gt;albus.portkey.ai&lt;br&gt;or a Private Service Connect endpoint&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Strata Cloud Manager UI&lt;br&gt;Config, analytics, log presentation&lt;br&gt;Licensing and entitlement&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#3b82f6&quot;&gt;&lt;b&gt;Receives anonymised metrics.&lt;/b&gt;&lt;br&gt;Prompt content stays in your VPC.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="150" width="360" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="providers" value="&lt;b&gt;Model providers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;api.openai.com&lt;br&gt;api.anthropic.com&lt;br&gt;&#183;&#183;&#183;-aiplatform.googleapis.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;The gateway makes these calls now,&lt;br&gt;so the egress rules follow it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#666666;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="420" width="360" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="registries" value="&lt;b&gt;Container registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Gateway images, pulled with the&lt;br&gt;Docker credentials Palo Alto Networks&lt;br&gt;issues against your Organisation ID.&lt;br&gt;&lt;br&gt;Install and upgrade only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#666666;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="620" width="360" height="130" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00294D;strokeWidth=2.5;fontSize=10.5;fontFamily=Helvetica;fontColor=#00294D;endArrow=blockThin;endFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="apps" target="nlb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1l" value="&lt;b&gt;1&lt;/b&gt;&#160;&#160;HTTPS, internal" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#00294D;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="252" y="182" width="110" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00294D;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="nlb" target="eks">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2l" value="&lt;b&gt;2&lt;/b&gt;&#160;&#160;Balanced across zones" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#00294D;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="446" y="252" width="150" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E5A300;strokeWidth=2;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eks" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3l" value="&lt;b&gt;3&lt;/b&gt;&#160;&#160;Read config, write counters" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#E5A300;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="415" y="588" width="180" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E5A300;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eks" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4l" value="&lt;b&gt;4&lt;/b&gt;&#160;&#160;Write logs" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#E5A300;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="612" y="588" width="90" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.88;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eks" target="nat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5l" value="&lt;b&gt;5&lt;/b&gt;&#160;&#160;All egress" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#3b82f6;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1014" y="588" width="90" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.2;entryX=0;entryY=0.85;" edge="1" parent="1" source="nat" target="mgmt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6l" value="&lt;b&gt;6&lt;/b&gt;&#160;&#160;Outbound: config sync, metrics, usage&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Private Service Connect, or internet to aigw / albus" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#3b82f6;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1200" y="366" width="320" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00294D;strokeWidth=2.5;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nat" target="providers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7l" value="&lt;b&gt;7&lt;/b&gt;&#160;&#160;The LLM call" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#00294D;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1200" y="398" width="140" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="nat" target="registries">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8l" value="&lt;b&gt;8&lt;/b&gt;&#160;&#160;Image pull" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#666666;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1200" y="592" width="120" height="20" as="geometry"/>
        </mxCell>

        <!-- Inbound from the management plane -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ef4444;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=0;exitY=0.09;entryX=1;entryY=0.3;" edge="1" parent="1" source="mgmt" target="nlb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9l" value="&lt;b&gt;9&lt;/b&gt;&#160;&#160;Inbound: management plane to gateway, over Private Service Connect or an IP allow-list" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#ef4444;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="576" y="158" width="560" height="20" as="geometry"/>
        </mxCell>

        <!-- Footer -->
        <mxCell id="foot" value="&lt;b&gt;Traffic crosses the VPC boundary in both directions.&lt;/b&gt;&#160;&#160;Flows 6, 8, and 9 reach Palo Alto Networks, and none of them carries prompt or completion content. Flow 4 is where that content lands, inside your own account. Configure both directions: outbound alone leaves a gateway that serves traffic but never appears in Strata Cloud Manager." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="815" width="1540" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="foot2" value="Create the REGIONAL_MANAGED_PROXY subnet before you deploy. It is a prerequisite of the VPC rather than the chart, so nothing in the Helm output will tell you it is missing. The symptom is a load balancer that never provisions." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="843" width="1540" height="24" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
