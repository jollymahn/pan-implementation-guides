<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Semantic cache lookup" id="aigw-semcache">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="How a request finds a cached answer" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Semantic cache is a superset of simple cache, so the gateway tries an exact match first and only embeds the prompt when that misses. Every gate below is a reason a hit you expected did not happen." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1400" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="flowhdr" value="LOOKUP ORDER" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="400" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="a" value="&lt;b&gt;Request arrives at the gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#00294D;strokeWidth=2;fontSize=11.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="128" width="560" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="b" value="&lt;b&gt;Is a cache block set in the config?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Top level or per target. A target-level block wins over a top-level one.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="188" width="560" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="c" value="&lt;b&gt;Simple-cache lookup: exact match&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The full request body, the metadata header, and the cache namespace all have to match a stored entry, and that entry has to be inside its max_age. One changed character is a miss.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="262" width="560" height="72" as="geometry"/>
        </mxCell>

        <mxCell id="d" value="&lt;b&gt;Is the mode semantic?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Simple mode stops here. Semantic mode carries on.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="354" width="560" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="e" value="&lt;b&gt;Is the request eligible for semantic matching?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Route is /chat/completions or /completions. Under 8,191 tokens. Four messages or fewer. At least one user message present, since a request carrying only system messages is dropped.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="424" width="560" height="76" as="geometry"/>
        </mxCell>

        <mxCell id="f" value="&lt;b&gt;Embed the user text and search the vector store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A hit needs cosine similarity above the threshold (0.95 by default) &lt;i&gt;and&lt;/i&gt; an exact match on the model and every other body parameter and on the metadata header. The system prompt is ignored, so changing it neither causes nor prevents a hit.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="560" height="88" as="geometry"/>
        </mxCell>

        <mxCell id="g" value="&lt;b&gt;Call the provider, then store the response as a new entry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The first request for any prompt always lands here, and so does every request sent with x-portkey-cache-force-refresh: true.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#00294D;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="628" width="560" height="62" as="geometry"/>
        </mxCell>

        <mxCell id="ob" value="&lt;b&gt;Cache Disabled&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Also what you get when x-portkey-debug is false, which switches caching off entirely.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#666666;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=7;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="688" y="188" width="236" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="oc" value="&lt;b&gt;Cache Hit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Served from Redis. No provider call, no provider cost, and the latency saving shows on the Analytics cache tab.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=7;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="688" y="262" width="236" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="of" value="&lt;b&gt;Cache Semantic Hit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A differently worded prompt served the stored answer. Logged under its own status so you can tell the two hit types apart.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=3;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=7;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="688" y="520" width="236" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="og" value="&lt;b&gt;Cache Miss&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Or Cache Refreshed when the force-refresh header was set. For a semantic hit, that header refreshes every matching entry, not just one.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=7;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="688" y="628" width="236" height="82" as="geometry"/>
        </mxCell>

        <mxCell id="n1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n2" value="no match" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n3" value="no match" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n4" value="yes" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n5" value="yes" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n6" value="below threshold" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f" target="g"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="m1" value="no" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b" target="ob"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2" value="match" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#15803d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c" target="oc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m3" value="above threshold" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#22c55e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#15803d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f" target="of"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#f59e0b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="og"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="m5" value="simple mode" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#f59e0b;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;fontSize=10;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d" target="og"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="379"/><mxPoint x="940" y="657"/></Array></mxGeometry></mxCell>
        <mxCell id="m6" value="not eligible" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#f59e0b;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.68;entryDx=0;entryDy=0;fontSize=10;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e" target="og"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="954" y="462"/><mxPoint x="954" y="684"/></Array></mxGeometry></mxCell>

        <mxCell id="comphdr" value="WHAT A SELF-HOSTED GATEWAY NEEDS FOR SEMANTIC MODE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="968" y="100" width="500" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="&lt;b&gt;1.&#160;An embedding provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;One of openai, azure-openai, google, or vertex-ai. The gateway calls it on every eligible request that misses the exact-match check.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9.5px;color:#00294D&quot;&gt;SEMANTIC_CACHE_EMBEDDING_PROVIDER&lt;br&gt;SEMANTIC_CACHE_EMBEDDINGS_URL&lt;br&gt;SEMANTIC_CACHE_EMBEDDING_MODEL&lt;br&gt;SEMANTIC_CACHE_EMBEDDING_API_KEY&lt;br&gt;SEMANTIC_CACHE_EMBEDDING_DIMENSIONS&lt;br&gt;SEMANTIC_CACHE_SIMILARITY_THRESHOLD&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#b45309&quot;&gt;Azure OpenAI takes a plain API key here. Managed identity and Entra token auth are not supported for this one call.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="968" y="128" width="492" height="246" as="geometry"/>
        </mxCell>

        <mxCell id="p2" value="&lt;b&gt;2.&#160;A vector store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Milvus or Pinecone, holding the embeddings the similarity search runs against.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9.5px;color:#00294D&quot;&gt;VECTOR_STORE&lt;br&gt;VECTOR_STORE_ADDRESS&lt;br&gt;VECTOR_STORE_COLLECTION_NAME&lt;br&gt;VECTOR_STORE_API_KEY&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;&lt;b&gt;Milvus&lt;/b&gt; &#8212; name the collection after the embedding model, give it id (Varchar), values (FloatVector at the configured dimension) and metadata (JSON).&lt;br&gt;&lt;b&gt;Pinecone&lt;/b&gt; &#8212; omit the collection name, set the address to the index name, and create the index with cosine as its metric.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="968" y="390" width="492" height="212" as="geometry"/>
        </mxCell>

        <mxCell id="p3" value="&lt;b&gt;3.&#160;Redis, which you already have&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The cached responses themselves live in the gateway&#39;s Redis. The vector store holds only the embeddings used to find them, so the two have to be sized and retained together.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="968" y="618" width="492" height="72" as="geometry"/>
        </mxCell>

        <mxCell id="refhdr" value="LIFETIME AND PARTITIONING" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="736" width="500" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="ref" value="&lt;font style=&quot;font-size:11px&quot;&gt;&#8226;&#160;&lt;b&gt;TTL&lt;/b&gt; comes from &lt;font face=&quot;Courier New&quot;&gt;max_age&lt;/font&gt; on the cache block: 60 seconds minimum, 90 days maximum, 7 days when you leave it out. An organisation default set under Admin Settings wins whenever a request asks for longer than it, so a per-request value can only ever shorten the lifetime.&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Partitioning&lt;/b&gt; is by every request header by default, which is usually why a hit rate looks lower than expected. Send &lt;font face=&quot;Courier New&quot;&gt;x-portkey-cache-namespace&lt;/font&gt; to partition by one string of your choosing instead, per user or per tenant.&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Status&lt;/b&gt; appears on every log line as Cache Hit, Cache Semantic Hit, Cache Miss, Cache Refreshed, or Cache Disabled, and the hit rate, latency saving and cost saving roll up on the Analytics cache tab.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="758" width="1420" height="128" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
