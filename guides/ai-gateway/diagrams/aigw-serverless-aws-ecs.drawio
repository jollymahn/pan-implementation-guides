<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway on Amazon ECS" id="aigw-serverless-aws-ecs">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI Gateway hybrid data plane on Amazon ECS" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Terraform builds everything inside the VPC boundary. No Kubernetes cluster is involved. Prompt content never leaves your account: it lands in your own S3 bucket, and only anonymised metrics go outbound." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1540" height="24" as="geometry"/>
        </mxCell>

        <!-- Applications -->
        <mxCell id="apps" value="&lt;b&gt;Your applications&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ECS tasks, EC2, Lambda, or anything&lt;br&gt;that can reach the load balancer&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url = load balancer DNS&lt;br&gt;api_key = &amp;lt;workspace key&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="apps-note" value="No provider API keys live here.&#10;The app speaks one OpenAI-shaped&#10;API to one endpoint." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="328" width="230" height="50" as="geometry"/>
        </mxCell>

        <!-- VPC -->
        <mxCell id="vpc" value="&lt;b&gt;Your VPC&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;private subnets across two Availability Zones&#160;&#160;&#183;&#160;&#160;built by the module when create_new_vpc = true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#E5A300;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="860" height="730" as="geometry"/>
        </mxCell>

        <mxCell id="lb" value="&lt;b&gt;Load balancer&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;NLB or ALB&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;NLB for layer-4 and inbound PrivateLink.&lt;br&gt;ALB for TLS termination, WAF, and the&lt;br&gt;host-based routing that server_mode = &quot;all&quot; needs.&lt;br&gt;Idle timeout must exceed your longest generation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="175" width="300" height="100" as="geometry"/>
        </mxCell>

        <!-- ECS cluster -->
        <mxCell id="ecs" value="&lt;b&gt;ECS cluster&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;awsvpc networking&#160;&#160;&#183;&#160;&#160;capacity provider backed by an Auto Scaling group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="320" y="310" width="800" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="task-a" value="&lt;b&gt;Gateway task&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;us-east-1a&#160;&#160;&#183;&#160;&#160;1024 CPU units &#183; 2048 MiB&lt;br&gt;container port 8787&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Auth &#183; routing &#183; guardrails&lt;br&gt;rate limits &#183; budgets&lt;br&gt;metering &#183; logging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="352" width="370" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="task-b" value="&lt;b&gt;Gateway task&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;us-east-1b&#160;&#160;&#183;&#160;&#160;1024 CPU units &#183; 2048 MiB&lt;br&gt;container port 8787&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Target tracking on CPU and memory&lt;br&gt;scales the task count between&lt;br&gt;the min and max you set.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="352" width="370" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="ecs-note" value="&lt;b&gt;Capacity.&lt;/b&gt; With create_cluster = true the module registers one capacity provider backed by an EC2 Auto Scaling group (t4g.medium by default), so tasks run on container instances you own. The task definition also declares FARGATE compatibility, but the module never registers a Fargate capacity provider: reaching Fargate means create_cluster = false and pointing capacity_provider_name at your own cluster. See the Fargate note in the guide before planning on it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="506" width="760" height="84" as="geometry"/>
        </mxCell>

        <!-- Managed services -->
        <mxCell id="redis" value="&lt;b&gt;Cache store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Built-in Redis task, or ElastiCache&lt;br&gt;for Redis OSS or Valkey. Either way&lt;br&gt;it sits in this VPC.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Synced config &#183; API keys&lt;br&gt;rate limit and budget state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="650" width="245" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;S3 &#183; log store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Reached with the task IAM role&lt;br&gt;(LOG_STORE = s3_assume)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;&lt;b&gt;Full prompt and completion bodies&lt;/b&gt;&lt;br&gt;Roughly 10 kB per document.&lt;br&gt;Encrypted at rest, in your account.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="595" y="650" width="250" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="nat" value="&lt;b&gt;NAT gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;One per AZ, or one shared&lt;br&gt;when single_nat_gateway = true&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;The outbound path when you&lt;br&gt;are not using PrivateLink.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="875" y="650" width="245" height="130" as="geometry"/>
        </mxCell>

        <!-- Secrets Manager -->
        <mxCell id="secrets" value="&lt;b&gt;AWS Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Two secrets, created before Terraform runs:&lt;br&gt;&#183; Docker registry username and password&lt;br&gt;&#183; PORTKEY_CLIENT_AUTH and ORGANISATIONS_TO_SYNC&lt;br&gt;&lt;br&gt;The task definition references the &lt;b&gt;ARNs&lt;/b&gt;.&lt;br&gt;Raw values never appear in Terraform state.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="175" width="470" height="110" as="geometry"/>
        </mxCell>

        <!-- Outside -->
        <mxCell id="mgmt" value="&lt;b&gt;PAN management plane&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;aigw.portkey.ai&lt;br&gt;albus.portkey.ai&lt;br&gt;aws-cp.portkey.ai&#160;&#160;(PrivateLink)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Strata Cloud Manager UI&lt;br&gt;Config, analytics, log presentation&lt;br&gt;Licensing and entitlement&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#3b82f6&quot;&gt;&lt;b&gt;Receives anonymised metrics.&lt;/b&gt;&lt;br&gt;Prompt content stays in your VPC.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="300" width="360" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="providers" value="&lt;b&gt;Model providers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;api.openai.com&lt;br&gt;api.anthropic.com&lt;br&gt;bedrock-runtime.&#183;&#183;&#183;.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;The gateway makes these calls now,&lt;br&gt;so the egress rules follow it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#666666;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="560" width="360" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="registry" value="&lt;b&gt;Container registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Gateway images, pulled with the Docker&lt;br&gt;credentials Palo Alto Networks issues&lt;br&gt;against your Organisation ID.&lt;br&gt;&lt;br&gt;Install and upgrade only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#666666;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="738" width="360" height="120" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00294D;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="apps" target="lb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1l" value="&lt;b&gt;1&lt;/b&gt;&#160;&#160;HTTPS" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#00294D;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="256" y="182" width="70" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00294D;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=0.25;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="lb" target="ecs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2l" value="&lt;b&gt;2&lt;/b&gt;&#160;&#160;Balanced across zones, port 8787" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#00294D;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="400" y="279" width="210" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="secrets" target="ecs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3l" value="&lt;b&gt;3&lt;/b&gt;&#160;&#160;Injected at task start" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#ef4444;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="900" y="292" width="150" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E5A300;strokeWidth=2;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ecs" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4l" value="&lt;b&gt;4&lt;/b&gt;&#160;&#160;Read config, write counters" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#E5A300;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="410" y="624" width="180" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E5A300;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ecs" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5l" value="&lt;b&gt;5&lt;/b&gt;&#160;&#160;Write logs" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#E5A300;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="608" y="624" width="90" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.88;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ecs" target="nat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6l" value="&lt;b&gt;6&lt;/b&gt;&#160;&#160;All egress" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#3b82f6;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1010" y="624" width="90" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.15;entryX=0;entryY=0.85;" edge="1" parent="1" source="nat" target="mgmt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7l" value="&lt;b&gt;7&lt;/b&gt;&#160;&#160;Outbound: config sync, metrics, usage&lt;br&gt;&#160;&#160;&#160;&#160;&#160;PrivateLink, or internet to aigw / albus" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#3b82f6;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1200" y="502" width="320" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00294D;strokeWidth=2.5;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nat" target="providers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8l" value="&lt;b&gt;8&lt;/b&gt;&#160;&#160;The LLM call" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#00294D;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1200" y="536" width="140" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="nat" target="registry">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9l" value="&lt;b&gt;9&lt;/b&gt;&#160;&#160;Image pull" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#666666;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1200" y="714" width="120" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ef4444;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=0;exitY=0.05;entryX=0.5;entryY=0;" edge="1" parent="1" source="mgmt" target="lb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1170" y="145"/>
              <mxPoint x="470" y="145"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10l" value="&lt;b&gt;10&lt;/b&gt;&#160;&#160;Inbound: management plane to gateway, over a VPC endpoint service (NLB only) or an IP allow-list" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#ef4444;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="500" y="124" width="640" height="20" as="geometry"/>
        </mxCell>

        <!-- Footer -->
        <mxCell id="foot" value="&lt;b&gt;Configure both directions.&lt;/b&gt;&#160;&#160;Flows 7, 9, and 10 reach Palo Alto Networks, and none of them carries prompt or completion content. Flow 5 is where that content lands, inside your own account. Outbound alone leaves a gateway that serves traffic but never appears in Strata Cloud Manager." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="1540" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="foot2" value="An AWS VPC endpoint service can only be created against a Network Load Balancer. If you chose an ALB (because server_mode = &quot;all&quot; needs host-based routing), inbound PrivateLink needs an NLB placed in front of that ALB, provisioned outside this module." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="906" width="1540" height="24" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
