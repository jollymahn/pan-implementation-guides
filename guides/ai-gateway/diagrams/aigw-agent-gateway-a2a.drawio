<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Agent Gateway and A2A" id="aigw-a2a">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="What changes when an A2A call goes through the Agent Gateway" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="The client swaps one base URL and keeps speaking A2A. The gateway becomes the agent server the client talks to, and the client never holds a credential for the real one." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1400" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="hdr1" value="WITHOUT THE AGENT GATEWAY" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="500" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="laneA" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="122" width="1420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Agent client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Your service, or another agent.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="144" width="200" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;Upstream A2A agent server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Holds every skill it exposes, and its own credential.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="144" width="260" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="aa" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="anote" value="&lt;font style=&quot;font-size:11px&quot;&gt;Each client authenticates to the agent directly, reaches every skill the agent publishes, and leaves no record anyone else can audit. Revoking one client means changing the agent.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="648" y="144" width="792" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="hdr2" value="THROUGH THE AGENT GATEWAY" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="248" width="500" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="laneB" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="1420" height="196" as="geometry"/>
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;Agent client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Unchanged A2A client code. It points at the virtual server and sends a gateway API key as its bearer token.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="212" height="116" as="geometry"/>
        </mxCell>

        <mxCell id="gw" value="&lt;b&gt;Prisma AIRS AI Gateway&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00294D;strokeWidth=2;fontSize=11.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="324" y="294" width="824" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="&lt;b&gt;Virtual agent server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A server to the client and a client to the real agent. It answers the agent card request and relays the conversation.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="326" width="252" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;Agent Registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Decides whether this key may reach this agent at all, and which of its skills it may call. Access is granted per agent and per skill.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="612" y="326" width="252" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;Log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Every request to the virtual server is recorded, which is what makes agent traffic auditable and governable at all.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="884" y="326" width="248" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="b2" value="&lt;b&gt;Upstream A2A agent server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Reached only by the gateway, using the credential you registered. Must be a public http or https endpoint.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1200" y="310" width="240" height="116" as="geometry"/>
        </mxCell>

        <mxCell id="ba" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bb" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bc" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bd" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="stephdr" value="WHAT YOU CONFIGURE, IN ORDER" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="492" width="500" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;1.&#160;Permit the key&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;On the API Keys page, turn on the &lt;b&gt;Agent Gateway&lt;/b&gt; toggle for the key, and enable the &lt;font face=&quot;Courier New&quot;&gt;agents.invoke&lt;/font&gt; scope on any key that will actually call an agent.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="514" width="340" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;2.&#160;Register the agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Add the upstream server URL in the Agent Registry, then press &lt;b&gt;Fetch Agent Card&lt;/b&gt;. That call reads &lt;font face=&quot;Courier New&quot;&gt;/.well-known/agent.json&lt;/font&gt; and validates the transport and authentication schemes before you rely on them.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="514" width="340" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;3.&#160;Provision and scope&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Choose which workspaces get the agent, then narrow access to the specific skills each workspace needs. A client should be able to reach the one capability it was built for, not the agent&#39;s whole surface.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="760" y="514" width="340" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;4.&#160;Swap the URL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Replace the agent server URL in your client with the virtual one from the Agents tab:&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9.5px;color:#00294D&quot;&gt;https://aigw.portkey.ai/agent/{slug}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Self-hosted deployments substitute their own gateway host. Nothing else in the client changes.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=3;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1120" y="514" width="340" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="limhdr" value="WHAT THE UPSTREAM URL HAS TO BE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="652" width="500" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="lim" value="&lt;font style=&quot;font-size:11px&quot;&gt;Backend v1.16.1 and later apply SSRF protections to the registered URL, so the gateway rejects private IP addresses, cloud metadata hosts, and any URL carrying a &lt;font face=&quot;Courier New&quot;&gt;#&lt;/font&gt; fragment. An agent running inside your own network has to be published on a reachable public http or https endpoint before the registry will accept it, which is worth knowing before the first Fetch Agent Card attempt fails.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="674" width="700" height="84" as="geometry"/>
        </mxCell>

        <mxCell id="soonhdr" value="NOT YET AVAILABLE, LISTED AS COMING SOON" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="652" width="500" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="soon" value="&lt;font style=&quot;font-size:11px&quot;&gt;Access control today is per agent and per skill. Three finer grains are published as coming soon and are not available yet: access control for specific users, skill-level control inside specific workspaces, and skill-level control for specific users. Until they land, the workspace is the smallest unit you can scope an agent to, so plan workspace boundaries around who should reach which agent.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="760" y="674" width="700" height="84" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
