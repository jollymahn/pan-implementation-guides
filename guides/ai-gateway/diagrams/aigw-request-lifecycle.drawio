<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Request Lifecycle" id="aigw-lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="What the gateway does to a single request" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Six checks, then a credential swap, then the meter. Each check is a place the request can stop, and each stop is a control the customer asked for." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1200" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="in" value="&lt;b&gt;Request in&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="90" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="g1" value="&lt;b&gt;1.&#160;Authenticate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Is the gateway API key valid, unexpired, and not revoked?&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#ef4444&quot;&gt;&lt;b&gt;Stops with&lt;/b&gt;&lt;br&gt;401 &#8212; unauthorized&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="158" y="160" width="172" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="g2" value="&lt;b&gt;2.&#160;Resolve the slug&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Which integration serves this call, and may this key use it?&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#ef4444&quot;&gt;&lt;b&gt;Stops with&lt;/b&gt;&lt;br&gt;400 &#8212; x-portkey-provider or x-portkey-config required&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="350" y="160" width="172" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="g3" value="&lt;b&gt;3.&#160;Model allowlist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Is the requested model one you provisioned on this integration?&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#ef4444&quot;&gt;&lt;b&gt;Stops with&lt;/b&gt;&lt;br&gt;Rejected &#8212; this is the allowlist working, not a fault&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="542" y="160" width="172" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="g4" value="&lt;b&gt;4.&#160;Guardrails&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Basic and third-party guardrails, including Check Language and Detect Gibberish.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#ef4444&quot;&gt;&lt;b&gt;Stops with&lt;/b&gt;&lt;br&gt;Blocked by guardrail&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="734" y="160" width="172" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="g5" value="&lt;b&gt;5.&#160;Rate limit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Requests or tokens, per minute, hour, or day. Key, workspace, and policy limits all apply.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#ef4444&quot;&gt;&lt;b&gt;Stops with&lt;/b&gt;&lt;br&gt;Rate limit exceeded, until the window resets&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="926" y="160" width="172" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="g6" value="&lt;b&gt;6.&#160;Budget&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cost in USD or token count, checked against the key, the workspace, and any policy.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#ef4444&quot;&gt;&lt;b&gt;Stops with&lt;/b&gt;&lt;br&gt;Blocked until the budget resets, or permanently if no reset cadence&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1118" y="160" width="172" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="g7" value="&lt;b&gt;7.&#160;Swap credential and forward&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Gateway key removed, provider credential attached, request reshaped to the provider API.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=3;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1310" y="160" width="110" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="ea" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="in" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g5" target="g6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g6" target="g7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="rejectlane" value="&lt;b&gt;Any check that fails stops here&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;the request is rejected, the app gets the error, and the attempt is still logged. A blocked call is evidence, not a gap in the record." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="158" y="342" width="1132" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="r1" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="g1"><mxGeometry relative="1" as="geometry"><mxPoint x="244" y="342" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="r2" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="g2"><mxGeometry relative="1" as="geometry"><mxPoint x="436" y="342" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="r3" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="g3"><mxGeometry relative="1" as="geometry"><mxPoint x="628" y="342" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="r4" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="g4"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="342" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="r5" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="g5"><mxGeometry relative="1" as="geometry"><mxPoint x="1012" y="342" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="r6" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="g6"><mxGeometry relative="1" as="geometry"><mxPoint x="1204" y="342" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Provider + return path -->
        <mxCell id="prov" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Anthropic, Bedrock,&lt;br&gt;Azure OpenAI, Vertex AI,&lt;br&gt;or a private model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11.5;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1290" y="430" width="150" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e-g7-prov" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g7" target="prov"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="meter" value="&lt;b&gt;8.&#160;Meter, log, and return&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Token counts in and out&#160;&#183;&#160;computed cost, with the pricing multiplier applied&#160;&#183;&#160;latency&#160;&#183;&#160;the full prompt and response&#160;&#183;&#160;the key and its metadata tags. Then the response goes back to the app unchanged.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="820" y="430" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e-prov-meter" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prov" target="meter"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="back" value="response to the app" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;fontSize=10;fontFamily=Helvetica;fontColor=#22c55e;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="meter" target="in">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="85" y="480"/></Array></mxGeometry>
        </mxCell>

        <!-- Log destinations -->
        <mxCell id="dest-title" value="WHERE  THE  RECORD  GOES" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="200" y="566" width="440" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;AI Gateway Observability&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Prompt logs and event logs, native storage, 1 year retention. Click a row for the full trace.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="592" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Strata Logging Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Threat Logs, via the TSG mapping. Not required to run the gateway, but this is where SOC tooling expects to look.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="592" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Your SIEM or SOAR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Event logs stream to OpenTelemetry-compatible endpoints, or export from SLS. Both SaaS and Hybrid.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="592" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;Your own object storage&lt;/b&gt;&#160;&lt;font style=&quot;color:#E5A300&quot;&gt;Hybrid only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Prompt log export to S3, Azure Blob, GCS, or an S3-compatible store. Set in the Helm chart, not in SCM.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1010" y="592" width="250" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="fan1" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#3b82f6;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="meter" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fan2" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#3b82f6;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="meter" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fan3" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#3b82f6;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="meter" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fan4" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#E5A300;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="meter" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Scope note -->
        <mxCell id="scope" value="&lt;b&gt;What this pipeline does not do&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="718" width="1380" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="scope-b1" value="&lt;b&gt;PII detection&lt;/b&gt; and &lt;b&gt;content moderation&lt;/b&gt; are deliberately not gateway&lt;br&gt;guardrails. They belong to AI Runtime, which brings advanced DLP and&lt;br&gt;threat detection. If the customer needs inline scanning for prompt&lt;br&gt;injection, data leakage, or malicious content, the gateway alone does&lt;br&gt;not cover it &#8212; pair it with AIRS API Intercept." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="752" width="620" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="scope-b2" value="&lt;b&gt;It does not see traffic that does not come to it.&lt;/b&gt; Every check above&lt;br&gt;starts with a request that was addressed to the gateway. An application&lt;br&gt;still pointing at the provider endpoint passes through none of these&lt;br&gt;gates and appears in none of these logs. Coverage is an application&lt;br&gt;inventory exercise, and it is the part customers underestimate." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="720" y="752" width="690" height="90" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
