<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Key Flow" id="aigw-key-flow">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="How the API key gets into the app call" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Two different keys are in play. The application only ever holds the gateway key; the provider key never leaves Strata Cloud Manager." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1100" height="24" as="geometry"/>
        </mxCell>

        <!-- ================= DATA PLANE LANE ================= -->
        <mxCell id="lane-data" value="DATA  PLANE  &#8212;  where the prompt actually travels" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dee2e6;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="1400" height="440" as="geometry"/>
        </mxCell>

        <!-- App -->
        <mxCell id="app" value="&lt;b&gt;Your application or agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;Claude Code, a custom app,&lt;br&gt;an MCP client, a CI job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="250" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="app-detail" value="&lt;b&gt;What the app is configured with&lt;/b&gt;&lt;br&gt;&lt;br&gt;ANTHROPIC_BASE_URL=&lt;br&gt;&#160;&#160;https://aigw.portkey.ai&lt;br&gt;&lt;br&gt;ANTHROPIC_AUTH_TOKEN=&lt;br&gt;&#160;&#160;&amp;lt;gateway API key&amp;gt;&lt;br&gt;&lt;br&gt;ANTHROPIC_CUSTOM_HEADERS=&lt;br&gt;&#160;&#160;x-portkey-provider:&lt;br&gt;&#160;&#160;@default-anthropic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="268" width="250" height="196" as="geometry"/>
        </mxCell>

        <mxCell id="app-note" value="No provider key anywhere in the app,&#10;its config, or its container image." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="188" height="50" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw" value="&lt;b&gt;Prisma AIRS AI Gateway&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;data plane&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;SaaS (hosted by Palo Alto Networks) or Hybrid (your Kubernetes cluster)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=center;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="450" y="120" width="440" height="390" as="geometry"/>
        </mxCell>

        <mxCell id="s1c" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="472" y="180" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Authenticate the gateway key&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Valid? Not expired? Not over its own budget?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="510" y="175" width="358" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="s2c" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="472" y="238" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Resolve the slug &#8594; integration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;@default-anthropic identifies which connection to use&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="510" y="233" width="358" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="s3c" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="472" y="296" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Enforce the controls&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Model allowlist, guardrails, budget, rate limit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="510" y="291" width="358" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="s4c" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="472" y="354" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Swap in the provider credential&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Gateway key is stripped; the provider key is attached&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="510" y="349" width="358" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="s5c" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="472" y="412" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;Meter and log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tokens, cost, latency, prompt, response, metadata tags&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="510" y="407" width="358" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="s6c" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="472" y="464" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;Return the response to the app unchanged&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="510" y="464" width="358" height="26" as="geometry"/>
        </mxCell>

        <!-- Provider -->
        <mxCell id="prov" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;&lt;br&gt;Anthropic API&#160;&#160;&#183;&#160;&#160;Amazon Bedrock&lt;br&gt;Azure OpenAI&#160;&#160;&#183;&#160;&#160;Vertex AI&lt;br&gt;or a privately hosted model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="140" width="250" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="prov-detail" value="&lt;b&gt;What the provider receives&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST api.anthropic.com&lt;br&gt;&#160;&#160;&#160;&#160;&#160;/v1/messages&lt;br&gt;&lt;br&gt;x-api-key: sk-ant-...&lt;br&gt;&lt;br&gt;{ model: claude-fable-5,&lt;br&gt;&#160;&#160;messages: [ ... ] }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1050" y="268" width="250" height="196" as="geometry"/>
        </mxCell>

        <mxCell id="prov-note" value="The provider sees the gateway as the&#10;caller. One provider key serves every&#10;team, app, and user behind it." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#E5A300;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1050" y="470" width="260" height="46" as="geometry"/>
        </mxCell>

        <!-- Wire transforms -->
        <mxCell id="wire1" value="&lt;b&gt;On the wire&lt;/b&gt;&lt;br&gt;Authorization: Bearer&lt;br&gt;&#160;&#160;&amp;lt;gateway key&amp;gt;&lt;br&gt;x-portkey-provider:&lt;br&gt;&#160;&#160;@default-anthropic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#006DCC;strokeWidth=1;fontSize=9;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#006DCC;" vertex="1" parent="1">
          <mxGeometry x="322" y="188" width="120" height="114" as="geometry"/>
        </mxCell>

        <mxCell id="wire2" value="&lt;b&gt;On the wire&lt;/b&gt;&lt;br&gt;x-api-key:&lt;br&gt;&#160;&#160;sk-ant-...&lt;br&gt;&lt;br&gt;(gateway key&lt;br&gt;&#160;removed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ef4444;strokeWidth=1;fontSize=9;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#ef4444;" vertex="1" parent="1">
          <mxGeometry x="898" y="188" width="120" height="114" as="geometry"/>
        </mxCell>

        <mxCell id="e-app-gw" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.13;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-gw-prov" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;exitX=1;exitY=0.13;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="prov">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ================= CONTROL PLANE LANE ================= -->
        <mxCell id="lane-ctrl" value="CONTROL  PLANE  &#8212;  configured once, consulted on every request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dee2e6;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="550" width="1400" height="420" as="geometry"/>
        </mxCell>

        <!-- Secrets manager -->
        <mxCell id="vault" value="&lt;b&gt;Your secrets manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;optional&lt;/font&gt;&lt;br&gt;&lt;br&gt;Azure Key Vault, AWS Secrets&lt;br&gt;Manager, HashiCorp Vault,&lt;br&gt;CyberArk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#999999;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="vault-note" value="Where the provider key lives before&#10;setup, and where rotation starts." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="756" width="250" height="40" as="geometry"/>
        </mxCell>

        <!-- SCM -->
        <mxCell id="scm" value="&lt;b&gt;Strata Cloud Manager&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;AI Security &#8594; AI Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=center;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="450" y="590" width="440" height="330" as="geometry"/>
        </mxCell>

        <mxCell id="integration" value="&lt;b&gt;Integration&#160;&#160;&#183;&#160;&#160;default-anthropic&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3b82f6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#00294D;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="472" y="632" width="396" height="188" as="geometry"/>
        </mxCell>
        <mxCell id="int-key" value="&#128274;&#160;&#160;&lt;b&gt;Provider API key&lt;/b&gt;&#160;&#160;sk-ant-&#183;&#183;&#183;&#183;&#183;&#183;&#183;&#183;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;never leaves SCM&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="484" y="662" width="372" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="int-rows" value="&#8226;&#160;&lt;b&gt;Slug&lt;/b&gt; &#8212; default-anthropic&#160;&#160;(what the app names in the call)&lt;br&gt;&#8226;&#160;&lt;b&gt;Model allowlist&lt;/b&gt; &#8212; only the models you enabled&lt;br&gt;&#8226;&#160;&lt;b&gt;Workspace provisioning&lt;/b&gt; &#8212; which teams may use it&lt;br&gt;&#8226;&#160;&lt;b&gt;Budget and rate limits&lt;/b&gt; &#8212; per workspace&lt;br&gt;&#8226;&#160;&lt;b&gt;Pricing adjust multiplier&lt;/b&gt; &#8212; your effective rate" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="486" y="700" width="372" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="gwkeys" value="&lt;b&gt;Gateway API keys&lt;/b&gt;&#160;&#160;one per application&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Scoped permissions&#160;&#183;&#160;own budget and rate limit&#160;&#183;&#160;expiry&#160;&#183;&#160;metadata tags&#160;&#183;&#160;revocable&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="472" y="840" width="396" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="e-vault-scm" value="one-time paste at setup" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#999999;dashed=1;dashPattern=8 4;fontSize=10;fontFamily=Helvetica;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="vault" target="scm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-scm-gw" value="credential and policy&#10;resolved per request" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#3b82f6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;fontFamily=Helvetica;fontColor=#3b82f6;" edge="1" parent="1" source="scm" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-gwkey-app" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;dashed=1;dashPattern=8 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;fontSize=10;fontFamily=Helvetica;fontColor=#22c55e;" edge="1" parent="1" source="gwkeys" target="app-detail">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="864"/>
              <mxPoint x="330" y="435"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="gwkey-app-label" value="gateway key&#10;issued to the&#10;app team" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="444" width="92" height="58" as="geometry"/>
        </mxCell>

        <!-- Why keys matter callout -->
        <mxCell id="why" value="&lt;b&gt;Why the two-key split is the whole point&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="1000" y="590" width="400" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="why-body" value="&lt;b&gt;Without the gateway&lt;/b&gt;&lt;br&gt;Every app holds a live provider key. The key is&lt;br&gt;in env files, images, and laptops. You cannot&lt;br&gt;tell which team spent what. Revoking one key&lt;br&gt;breaks every app sharing it. Any model the&lt;br&gt;provider offers is reachable.&lt;br&gt;&lt;br&gt;&lt;b&gt;With the gateway&lt;/b&gt;&lt;br&gt;&#8226;&#160;The provider key is entered once and is&lt;br&gt;&#160;&#160;&#160;never distributed.&lt;br&gt;&#8226;&#160;Each app gets its own gateway key, so it&lt;br&gt;&#160;&#160;&#160;can be revoked alone.&lt;br&gt;&#8226;&#160;Every call is attributable, because the key&lt;br&gt;&#160;&#160;&#160;identifies the caller.&lt;br&gt;&#8226;&#160;Rotating the provider key is one edit in&lt;br&gt;&#160;&#160;&#160;SCM, with no application change.&lt;br&gt;&#8226;&#160;Budget, rate, and model limits attach to&lt;br&gt;&#160;&#160;&#160;the key, not to the provider account." style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1016" y="622" width="374" height="290" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
