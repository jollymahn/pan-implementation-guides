<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway fronting OpenAI" id="aigw-openai">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI Gateway fronting OpenAI" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="One OpenAI key, held by the gateway and never distributed. Read the red box first: this fronts the OpenAI API, not the ChatGPT app." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1200" height="24" as="geometry"/>
        </mxCell>

        <!-- App -->
        <mxCell id="app" value="&lt;b&gt;Your application&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url =&lt;br&gt;&#160;&#160;https://aigw.portkey.ai/v1&lt;br&gt;api_key = &amp;lt;gateway key&amp;gt;&lt;br&gt;model =&lt;br&gt;&#160;&#160;@default-openai/gpt-&#183;&#183;&#183;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="230" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="app-note" value="The OpenAI SDK takes a base_url argument, so&#10;this is two lines of change and no logic change.&#10;No sk-proj- key on the host, in the image, or in&#10;the environment of anything the app runs on." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="298" width="270" height="70" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw" value="&lt;b&gt;Prisma AIRS AI Gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=center;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="330" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="gw-steps" value="&#8226;&#160;Authenticate the gateway key&lt;br&gt;&#8226;&#160;Resolve &lt;font style=&quot;font-family:Courier New&quot;&gt;default-openai&lt;/font&gt;&lt;br&gt;&#8226;&#160;Check the model is on the allowlist&lt;br&gt;&#8226;&#160;Check budget and rate limits&lt;br&gt;&#8226;&#160;Apply guardrails&lt;br&gt;&#8226;&#160;&lt;b&gt;Strip the gateway key and attach the&lt;br&gt;&#160;&#160;&#160;integration&#39;s OpenAI key&lt;/b&gt;&lt;br&gt;&#8226;&#160;Meter tokens, cost, and latency&lt;br&gt;&#8226;&#160;Write the prompt and response log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="154" width="290" height="178" as="geometry"/>
        </mxCell>

        <!-- OpenAI platform -->
        <mxCell id="oai" value="&lt;b&gt;OpenAI platform&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;your organization and project" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#E5A300;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="600" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="oai-ep" value="&lt;b&gt;OpenAI API endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;api.openai.com/v1&lt;br&gt;/chat/completions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="845" y="140" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="models" value="&lt;b&gt;Models&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Only the ones you provisioned&lt;br&gt;on the integration are reachable&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;gpt-&#183;&#183;&#183;&lt;br&gt;o&#183;-reasoning&lt;br&gt;text-embedding-&#183;&#183;&#183;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1150" y="140" width="240" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="key" value="&lt;b&gt;The OpenAI key the gateway holds&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;Authorization: Bearer sk-proj-&#183;&#183;&#183;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Scope it to one project, not the whole org.&lt;br&gt;Rotate it in SCM, with no application change.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="840" y="250" width="270" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="vis" value="&lt;b&gt;OpenAI-side visibility&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The usage dashboard sees one key&lt;br&gt;making every call.&lt;br&gt;&lt;br&gt;Per-team breakdown lives in the AI&lt;br&gt;Gateway logs, not in OpenAI billing.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1150" y="292" width="240" height="90" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="gateway key + slug" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;fontSize=10;fontFamily=Helvetica;fontColor=#22c55e;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="OpenAI key&#10;attached here" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;fontSize=10;fontFamily=Helvetica;fontColor=#E5A300;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="oai-ep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="oai-ep" target="models">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="key" target="oai-ep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SCM integration card -->
        <mxCell id="scm" value="&lt;b&gt;Strata Cloud Manager&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;Integration: &lt;font style=&quot;font-family:Courier New&quot;&gt;default-openai&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="670" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="scm-body" value="&lt;b&gt;Basic information&lt;/b&gt;&lt;br&gt;&#160;&#160;Name, Description&lt;br&gt;&#160;&#160;&lt;b&gt;Slug&lt;/b&gt; &lt;font style=&quot;font-family:Courier New&quot;&gt;default-openai&lt;/font&gt; &#8212; what the app names in the call&lt;br&gt;&lt;br&gt;&lt;b&gt;Credential&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;stays here, never handed out&lt;/font&gt;&lt;br&gt;&#160;&#160;OpenAI API key. Optional fields on this page may include&lt;br&gt;&#160;&#160;&lt;b&gt;Organization ID&lt;/b&gt; and &lt;b&gt;Project ID&lt;/b&gt;; fill them if your account uses them.&lt;br&gt;&lt;br&gt;&lt;b&gt;Model provisioning&lt;/b&gt;&lt;br&gt;&#160;&#160;All models, or an explicit allowlist. Everything not on the list is&lt;br&gt;&#160;&#160;unreachable through this integration, which is how you keep an&lt;br&gt;&#160;&#160;expensive reasoning model out of a chatbot&#39;s reach.&lt;br&gt;&lt;br&gt;&lt;b&gt;Workspace provisioning&lt;/b&gt;&lt;br&gt;&#160;&#160;Which teams see OpenAI in their Model Catalog, and each team&#39;s&lt;br&gt;&#160;&#160;budget and rate limit.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pricing adjust multiplier&lt;/b&gt;&lt;br&gt;&#160;&#160;Your negotiated OpenAI rate, or an internal showback markup." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="444" width="636" height="266" as="geometry"/>
        </mxCell>

        <!-- The ChatGPT trap -->
        <mxCell id="trap" value="&lt;b&gt;The gateway fronts the OpenAI API. It cannot front the ChatGPT app.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="750" y="410" width="670" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="trap-body" value="ChatGPT in a browser, the desktop app, and the mobile app have no base&lt;br&gt;URL setting. There is nothing to point at a gateway, so that traffic never&lt;br&gt;reaches Observability and no budget, allowlist, or guardrail touches it.&lt;br&gt;&lt;br&gt;When a customer says &quot;we use ChatGPT&quot;, establish which one they mean:&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Code calling&lt;/b&gt; &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;api.openai.com&lt;/font&gt; &#8212; an SDK, an agent framework, a&lt;br&gt;&#160;&#160;&#160;CI job. This is what the gateway covers, and it is the whole point.&lt;br&gt;&#8226;&#160;&lt;b&gt;People typing into&lt;/b&gt; &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;chatgpt.com&lt;/font&gt; &#8212; covered by network egress&lt;br&gt;&#160;&#160;&#160;policy, a CASB or SASE control, or ChatGPT Enterprise&#39;s own admin&lt;br&gt;&#160;&#160;&#160;and compliance tooling. Not by the AI Gateway.&lt;br&gt;&lt;br&gt;The same split applies to Claude.ai against the Anthropic API, and to a&lt;br&gt;Copilot surface against the Azure endpoint behind it. Naming the split on&lt;br&gt;the first call avoids a scope argument at cutover, because &quot;we are&lt;br&gt;governing our AI usage&quot; means two different projects." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="442" width="640" height="240" as="geometry"/>
        </mxCell>

        <!-- Two meters -->
        <mxCell id="bills" value="&lt;b&gt;Two meters run at once&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="750" y="710" width="670" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="bills-body" value="&lt;b&gt;1.&#160;&#160;OpenAI bills your OpenAI account for inference.&lt;/b&gt; Unchanged by the&lt;br&gt;&#160;&#160;&#160;&#160;&#160;gateway. Same key, same rates, same platform usage dashboard.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&#160;&#160;Palo Alto Networks meters flex credits by token volume.&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;1 token = 4 characters. Prompts, MCP, and agent-to-agent traffic all&lt;br&gt;&#160;&#160;&#160;&#160;&#160;count. Identical pricing for SaaS and Hybrid.&lt;br&gt;&lt;br&gt;Because every call now carries one key, the OpenAI usage dashboard&lt;br&gt;collapses to a single line. Per-team and per-app breakdown moves into&lt;br&gt;the gateway logs, and depends entirely on your key metadata." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="742" width="640" height="150" as="geometry"/>
        </mxCell>

        <!-- Verify -->
        <mxCell id="verify" value="&lt;b&gt;Verify in the customer&#39;s tenant before committing to these on a design call&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="670" height="182" as="geometry"/>
        </mxCell>
        <mxCell id="verify-body" value="Grounded in the repository guides and the PAN reference page. Web&lt;br&gt;research was blocked in this session, so none of it was checked externally:&lt;br&gt;&lt;br&gt;&#8226;&#160;Whether the details page exposes Organization ID and Project ID as&lt;br&gt;&#160;&#160;&#160;named fields, or expects a key that already carries that scope.&lt;br&gt;&#8226;&#160;Which OpenAI endpoints are proxied. Chat completions is safe to&lt;br&gt;&#160;&#160;&#160;assume; Responses, Assistants, Batch, and Realtime are not.&lt;br&gt;&#8226;&#160;Whether an OpenAI-compatible self-hosted model (vLLM, Ollama) uses&lt;br&gt;&#160;&#160;&#160;this integration with a Custom Host, or a different provider entry.&lt;br&gt;&#8226;&#160;Whether streaming responses are logged in full or summarized." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="772" width="640" height="190" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
