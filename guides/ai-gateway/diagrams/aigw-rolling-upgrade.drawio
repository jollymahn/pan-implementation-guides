<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Rolling Upgrade" id="aigw-rolling-upgrade">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Two upgrades, one setting apart" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="The chart default stops your pod before the new pod is ready. One block of YAML changes that." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ BAD LANE ============ -->
        <mxCell id="bad" value="WITH THE CHART DEFAULTS&#160;&#160;&#8212;&#160;&#160;replicaCount: 1, strategy: {}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#ef4444;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1380" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;1&#160;&#160;Before&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;One pod. It serves all traffic.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="66" y="128" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b1p" value="&lt;b&gt;old&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="86" y="206" width="70" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="b2" value="&lt;b&gt;2&#160;&#160;Kubernetes stops the old pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The default permits 25 percent unavailable. With one pod, that is your only pod.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="128" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b2p" value="&lt;s&gt;old&lt;/s&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;dashed=1;fontSize=11;fontFamily=Helvetica;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="420" y="206" width="70" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="b3" value="&lt;b&gt;3&#160;&#160;No pod is ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The new pod pulls its image and starts. This takes seconds, or minutes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="734" y="128" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b3p" value="&lt;b&gt;new&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;starting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="754" y="206" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="b3x" value="&lt;font style=&quot;font-size:11px;color:#ef4444&quot;&gt;&lt;b&gt;TRAFFIC FAILS&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="836" y="206" width="180" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="b4" value="&lt;b&gt;4&#160;&#160;After&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Service returns.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1068" y="128" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b4p" value="&lt;b&gt;new&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1088" y="206" width="70" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="bnote" value="&lt;font style=&quot;font-size:11px;color:#ef4444&quot;&gt;The gap in step 3 is the outage. It lasts as long as the new pod takes to become ready.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="66" y="266" width="1300" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="be1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#999999;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#999999;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ GOOD LANE ============ -->
        <mxCell id="good" value="WITH THE SETTINGS IN SECTION 3&#160;&#160;&#8212;&#160;&#160;replicaCount: 3, maxSurge: 1, maxUnavailable: 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="344" width="1380" height="268" as="geometry"/>
        </mxCell>

        <mxCell id="g1" value="&lt;b&gt;1&#160;&#160;Before&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Three pods serve traffic.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="66" y="382" width="300" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="g1a" value="old" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="452" width="56" height="34" as="geometry"/></mxCell>
        <mxCell id="g1b" value="old" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="146" y="452" width="56" height="34" as="geometry"/></mxCell>
        <mxCell id="g1c" value="old" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="212" y="452" width="56" height="34" as="geometry"/></mxCell>

        <mxCell id="g2" value="&lt;b&gt;2&#160;&#160;A fourth pod starts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;maxSurge: 1 permits one extra pod. The three old pods still serve traffic.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="382" width="300" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="g2a" value="old" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="414" y="452" width="56" height="34" as="geometry"/></mxCell>
        <mxCell id="g2b" value="old" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="452" width="56" height="34" as="geometry"/></mxCell>
        <mxCell id="g2c" value="old" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="546" y="452" width="56" height="34" as="geometry"/></mxCell>
        <mxCell id="g2d" value="new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="612" y="452" width="56" height="34" as="geometry"/></mxCell>

        <mxCell id="g3" value="&lt;b&gt;3&#160;&#160;The new pod is ready, one old pod stops&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;maxUnavailable: 0 means an old pod stops only after a new pod is ready.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="734" y="382" width="300" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="g3a" value="&lt;s&gt;old&lt;/s&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#999999;strokeWidth=1;dashed=1;fontSize=10;fontFamily=Helvetica;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="748" y="452" width="56" height="34" as="geometry"/></mxCell>
        <mxCell id="g3b" value="old" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="814" y="452" width="56" height="34" as="geometry"/></mxCell>
        <mxCell id="g3c" value="old" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="880" y="452" width="56" height="34" as="geometry"/></mxCell>
        <mxCell id="g3d" value="new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="946" y="452" width="56" height="34" as="geometry"/></mxCell>

        <mxCell id="g4" value="&lt;b&gt;4&#160;&#160;Repeat, then finish&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The cycle repeats twice more. Three new pods serve traffic.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1068" y="382" width="300" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="g4a" value="new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1082" y="452" width="56" height="34" as="geometry"/></mxCell>
        <mxCell id="g4b" value="new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1148" y="452" width="56" height="34" as="geometry"/></mxCell>
        <mxCell id="g4c" value="new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1214" y="452" width="56" height="34" as="geometry"/></mxCell>

        <mxCell id="gnote" value="&lt;font style=&quot;font-size:11px;color:#22c55e&quot;&gt;&lt;b&gt;At every moment, at least three pods are ready. Traffic never drops.&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="66" y="504" width="1300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="gnote2" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The readiness probe decides when a new pod counts as ready. The chart checks every 60 seconds, so a three-pod upgrade takes a few minutes. That is correct. Do not make it faster by permitting unavailable pods.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="66" y="530" width="1300" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="ge1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;The one block of YAML&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="680" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="&lt;font style=&quot;font-family:Courier New;font-size:11px&quot;&gt;replicaCount: 3&lt;br&gt;&lt;br&gt;strategy:&lt;br&gt;&#160;&#160;type: RollingUpdate&lt;br&gt;&#160;&#160;rollingUpdate:&lt;br&gt;&#160;&#160;&#160;&#160;maxSurge: 1&lt;br&gt;&#160;&#160;&#160;&#160;maxUnavailable: 0&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;The chart ships this example commented out, and leaves strategy empty. Uncomment it.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="670" width="650" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;A node drain ignores all of this&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="640" width="680" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="The deployment strategy controls a Helm upgrade. It does not&lt;br&gt;control a node drain.&lt;br&gt;&lt;br&gt;A cluster upgrade drains nodes. Without a PodDisruptionBudget,&lt;br&gt;a drain can stop every gateway pod at the same time, even with&lt;br&gt;three replicas and a correct strategy.&lt;br&gt;&lt;br&gt;The chart does not make a PodDisruptionBudget. Write one.&lt;br&gt;Section 3.2 of the page gives it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="670" width="650" height="160" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
