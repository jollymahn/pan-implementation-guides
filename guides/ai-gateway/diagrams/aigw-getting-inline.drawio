<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Getting Inline" id="aigw-getting-inline">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Getting the gateway inline" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="No application logic changes. Three values move the traffic: the base URL, the credential, and the slug that names which integration should serve the call." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1200" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ BEFORE ============ -->
        <mxCell id="before-lane" value="BEFORE&#160;&#160;&#8212;&#160;&#160;direct to the provider" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#ef4444;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="680" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="b-app" value="&lt;b&gt;App&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="110" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b-key" value="&#128273;&#160;provider key&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;lives in the app&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="55" y="262" width="120" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="b-prov" value="&lt;b&gt;api.anthropic.com&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bedrock-runtime&#183;&#183;&#183;.amazonaws.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="180" width="210" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="b-edge" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="b-app" target="b-prov">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="b-code" value="base_url = https://api.anthropic.com&lt;br&gt;api_key&#160;&#160;= sk-ant-&#183;&#183;&#183;&#183;&#183;&#183;&#183;&#183;&lt;br&gt;model&#160;&#160;&#160;&#160;= claude-fable-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="330" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="b-cost" value="&lt;b&gt;What you give up&lt;/b&gt;&#160;&#160;no per-team cost view&#160;&#183;&#160;no model allowlist&#160;&#183;&#160;no shared budget ceiling&#160;&#183;&#160;no prompt log&#160;&#183;&#160;keys spread across teams" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="326" width="620" height="34" as="geometry"/>
        </mxCell>

        <!-- ============ AFTER ============ -->
        <mxCell id="after-lane" value="AFTER&#160;&#160;&#8212;&#160;&#160;through the AI Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="750" y="90" width="680" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="a-app" value="&lt;b&gt;App&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="780" y="180" width="100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a-key" value="&#128273;&#160;gateway key&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;scoped&#160;&#183;&#160;revocable&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="770" y="262" width="120" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="a-gw" value="&lt;b&gt;AI Gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="1000" y="180" width="130" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="a-prov" value="&lt;b&gt;Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;key held in SCM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1250" y="180" width="150" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="a-e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="a-app" target="a-gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;" edge="1" parent="1" source="a-gw" target="a-prov">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a-code" value="base_url = https://aigw.portkey.ai&lt;br&gt;api_key&#160;&#160;= &amp;lt;gateway key&amp;gt;&lt;br&gt;model&#160;&#160;&#160;&#160;= @default-anthropic/claude-fable-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#22c55e;strokeWidth=1;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="900" y="120" width="380" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="a-gain" value="&lt;b&gt;What you gain&lt;/b&gt;&#160;&#160;cost per team&#160;&#183;&#160;model allowlist&#160;&#183;&#160;budget and rate ceilings&#160;&#183;&#160;full prompt log&#160;&#183;&#160;one key to rotate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="780" y="326" width="620" height="34" as="geometry"/>
        </mxCell>

        <!-- ============ REQUIRED ELEMENTS ============ -->
        <mxCell id="req-title" value="The required elements &#8212; and where each one comes from" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="900" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="hdr1" value="Element" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="446" width="200" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="hdr2" value="Example value" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="446" width="360" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="hdr3" value="Where you get it in Strata Cloud Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="446" width="410" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="hdr4" value="If you get it wrong" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1010" y="446" width="390" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="r1a" value="&lt;b&gt;Gateway base URL&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="478" width="200" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="r1b" value="https://aigw.portkey.ai&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:Helvetica;color:#666666&quot;&gt;shown with a /v1 suffix in SCM&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="240" y="478" width="360" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="r1c" value="Integrations page, &lt;b&gt;Gateway URLs&lt;/b&gt; field.&lt;br&gt;&lt;font style=&quot;color:#E5A300&quot;&gt;Hybrid: ignore it and use your own cluster service.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="600" y="478" width="410" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="r1d" value="Traffic silently keeps going direct to the provider, or 404s on a doubled /v1 path." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1010" y="478" width="390" height="58" as="geometry"/>
        </mxCell>

        <mxCell id="r2a" value="&lt;b&gt;Gateway API key&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="536" width="200" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="r2b" value="Authorization: Bearer &amp;lt;key&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="240" y="536" width="360" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="r2c" value="AI Gateway &#8594; API Keys. Create one per application, with permissions, limits, expiry, and metadata tags." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="600" y="536" width="410" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="r2d" value="401. Sharing one key across apps also collapses your cost attribution to a single bucket." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1010" y="536" width="390" height="58" as="geometry"/>
        </mxCell>

        <mxCell id="r3a" value="&lt;b&gt;Integration slug&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="594" width="200" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r3b" value="default-anthropic&lt;br&gt;default-bedrock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="240" y="594" width="360" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r3c" value="You choose it when creating the integration. Lowercase letters, digits, and hyphens only &#8212; no spaces, no slashes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="600" y="594" width="410" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r3d" value="A slug with a space or slash breaks traffic in a way that is very hard to trace back to this one field." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1010" y="594" width="390" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="r4a" value="&lt;b&gt;Model reference&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;slug + model&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="200" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r4b" value="@default-anthropic/claude-fable-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="240" y="660" width="360" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r4c" value="Integration panel &#8594; Model Provisioning tab. Only models you provisioned appear here." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="600" y="660" width="410" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r4d" value="A model outside the allowlist is rejected. That rejection is the allowlist working, not a fault." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1010" y="660" width="390" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="r5a" value="&lt;b&gt;Provider header&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;only for clients that send a bare model name&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="726" width="200" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="r5b" value="x-portkey-provider:&lt;br&gt;&#160;&#160;@default-anthropic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="240" y="726" width="360" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="r5c" value="Same slug as above, sent as a header instead of inside the model string. Needed by Claude Code and similar native clients." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="600" y="726" width="410" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="r5d" value="400 &#8212; either x-portkey-config or x-portkey-provider header is required. The gateway cannot guess the integration." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1010" y="726" width="390" height="72" as="geometry"/>
        </mxCell>

        <!-- Deployment note -->
        <mxCell id="dep" value="&lt;b&gt;SaaS or Hybrid changes exactly one of these five values&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="822" width="670" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="dep-body" value="&lt;b&gt;SaaS&lt;/b&gt;&#160;&#160;&#160;base URL = https://aigw.portkey.ai&lt;br&gt;&lt;font style=&quot;color:#666666;font-size:10px&quot;&gt;Prompts transit a Palo Alto Networks hosted endpoint.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Hybrid&lt;/b&gt;&#160;base URL = your in-cluster service, read from&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;kubectl get svc -n airs-gw&#160;&#160;(gateway port)&lt;br&gt;&lt;font style=&quot;color:#666666;font-size:10px&quot;&gt;Prompts never leave your environment. The key, the slug, and the&lt;br&gt;model reference are identical, because they all come from the same&lt;br&gt;SCM tenant either way.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="852" width="640" height="112" as="geometry"/>
        </mxCell>

        <mxCell id="warn" value="&lt;b&gt;Worth saying out loud to the customer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="730" y="822" width="670" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="warn-body" value="The gateway is &lt;b&gt;opt-in per application&lt;/b&gt;. It is not a network&lt;br&gt;interception point: nothing is forced through it by routing, DNS, or&lt;br&gt;a proxy setting. An app that still points at the provider endpoint&lt;br&gt;keeps working and stays completely invisible to the gateway.&lt;br&gt;&lt;br&gt;So coverage is an inventory problem, not a deployment problem.&lt;br&gt;Plan for how you will find and convert every AI caller, and how&lt;br&gt;you will stop new ones bypassing it &#8212; egress policy to the provider&lt;br&gt;endpoints, or revoking the direct provider keys once cut over." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="746" y="852" width="640" height="148" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
