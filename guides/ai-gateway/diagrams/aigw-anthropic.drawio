<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway fronting Anthropic" id="aigw-anthropic">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI Gateway fronting Anthropic" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Two authentication types, not three. Read the base URL carefully: the Anthropic SDK adds its own path, so this is the one provider where /v1 is wrong." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1200" height="24" as="geometry"/>
        </mxCell>

        <!-- App -->
        <mxCell id="app" value="&lt;b&gt;Your application&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url =&lt;br&gt;&#160;&#160;https://aigw.portkey.ai&lt;br&gt;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;no /v1 here&lt;/font&gt;&lt;br&gt;api_key = &amp;lt;gateway key&amp;gt;&lt;br&gt;model =&lt;br&gt;&#160;&#160;@default-anthropic/claude-&#183;&#183;&#183;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="230" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="app-note" value="The Anthropic SDK appends its own path. Adding&#10;/v1 produces /v1/v1/messages and a 404.&#10;A client that sends a bare model name also needs&#10;the header x-portkey-provider. Claude Code is one." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="308" width="290" height="70" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw" value="&lt;b&gt;Prisma AIRS AI Gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=center;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="330" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="gw-steps" value="&#8226;&#160;Authenticate the gateway key&lt;br&gt;&#8226;&#160;Resolve &lt;font style=&quot;font-family:Courier New&quot;&gt;default-anthropic&lt;/font&gt;&lt;br&gt;&#8226;&#160;Check the model is on the allowlist&lt;br&gt;&#8226;&#160;Check budget and rate limits&lt;br&gt;&#8226;&#160;Apply guardrails&lt;br&gt;&#8226;&#160;&lt;b&gt;Strip the gateway key and attach the&lt;br&gt;&#160;&#160;&#160;integration&#39;s Anthropic credential&lt;/b&gt;&lt;br&gt;&#8226;&#160;Meter tokens, cost, and latency&lt;br&gt;&#8226;&#160;Write the prompt and response log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="154" width="290" height="178" as="geometry"/>
        </mxCell>

        <!-- Anthropic platform -->
        <mxCell id="ant" value="&lt;b&gt;Anthropic&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;your organization and workspace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#E5A300;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="600" height="315" as="geometry"/>
        </mxCell>

        <mxCell id="ant-ep" value="&lt;b&gt;Anthropic API endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;api.anthropic.com&lt;br&gt;/v1/messages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="845" y="140" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="models" value="&lt;b&gt;Models&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Only the ones you provisioned&lt;br&gt;on the integration are reachable&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;claude-&#183;&#183;&#183;-sonnet&lt;br&gt;claude-&#183;&#183;&#183;-opus&lt;br&gt;claude-&#183;&#183;&#183;-haiku&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1150" y="140" width="240" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="key" value="&lt;b&gt;What the gateway holds, one of two&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;API Key&lt;/b&gt; &#8212; a key from the Anthropic console.&lt;br&gt;&lt;b&gt;Workload Identity Federation&lt;/b&gt; &#8212; no Anthropic&lt;br&gt;key is stored at all. The gateway presents a JWT&lt;br&gt;from your IdP and exchanges it for a short-lived&lt;br&gt;token. Cached for 15 minutes at most.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="840" y="250" width="280" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="vis" value="&lt;b&gt;Anthropic-side visibility&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;One principal makes every call,&lt;br&gt;whether that is an API key or a&lt;br&gt;federated service account.&lt;br&gt;&lt;br&gt;Per-user breakdown lives in the AI&lt;br&gt;Gateway logs, not at Anthropic.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1150" y="292" width="240" height="112" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="gateway key + slug" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;fontSize=10;fontFamily=Helvetica;fontColor=#22c55e;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="Anthropic credential&#10;attached here" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;fontSize=10;fontFamily=Helvetica;fontColor=#E5A300;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="ant-ep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="ant-ep" target="models">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="key" target="ant-ep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SCM integration card -->
        <mxCell id="scm" value="&lt;b&gt;Strata Cloud Manager&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;Integration: &lt;font style=&quot;font-family:Courier New&quot;&gt;default-anthropic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="670" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="scm-body" value="&lt;b&gt;Basic information&lt;/b&gt;&lt;br&gt;&#160;&#160;Name, Short Description&lt;br&gt;&#160;&#160;&lt;b&gt;Slug&lt;/b&gt; &lt;font style=&quot;font-family:Courier New&quot;&gt;default-anthropic&lt;/font&gt; &#8212; what the app names in the call&lt;br&gt;&lt;br&gt;&lt;b&gt;Authentication Type&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;two cards, not three&lt;/font&gt;&lt;br&gt;&#160;&#160;&lt;b&gt;API Key&lt;/b&gt; or &lt;b&gt;Workload Identity Federation&lt;/b&gt;. There is no OAuth&lt;br&gt;&#160;&#160;Client Credentials option on this tile, unlike Open AI.&lt;br&gt;&lt;br&gt;&lt;b&gt;Federation fields, when that type is selected&lt;/b&gt;&lt;br&gt;&#160;&#160;Token Endpoint, Client ID, Client Secret, Scope, Audience,&lt;br&gt;&#160;&#160;then &lt;b&gt;Federation Rule ID&lt;/b&gt;, &lt;b&gt;Organization ID&lt;/b&gt;, and the service&lt;br&gt;&#160;&#160;account the rule targets.&lt;br&gt;&lt;br&gt;&lt;b&gt;Model provisioning&lt;/b&gt;&lt;br&gt;&#160;&#160;All models, or an explicit allowlist. Everything off the list is&lt;br&gt;&#160;&#160;unreachable through this integration.&lt;br&gt;&lt;br&gt;&lt;b&gt;Workspace provisioning&lt;/b&gt;&lt;br&gt;&#160;&#160;Which teams see Anthropic in their Model Catalog, and each&lt;br&gt;&#160;&#160;team&#39;s budget and rate limit." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="444" width="636" height="286" as="geometry"/>
        </mxCell>

        <!-- Federation traps -->
        <mxCell id="trap" value="&lt;b&gt;Two Anthropic settings reject a correct configuration&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="750" y="410" width="670" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="trap-body" value="Both live on the Anthropic side, and both fail with the same unhelpful&lt;br&gt;message: the subject token was rejected.&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Max JWT lifetime&lt;/b&gt; must be &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;5400&lt;/font&gt; or higher when the identity&lt;br&gt;&#160;&#160;&#160;provider is Entra ID, because Entra tokens last up to 90 minutes.&lt;br&gt;&#160;&#160;&#160;The default of 3600 is too short and rejects a valid token.&lt;br&gt;&#8226;&#160;&lt;b&gt;JTI replay protection must be disabled&lt;/b&gt; for Okta issuers. The&lt;br&gt;&#160;&#160;&#160;gateway reuses its cached IdP token while it is still valid, and Okta&lt;br&gt;&#160;&#160;&#160;tokens carry a jti, so the second exchange is read as a replay.&lt;br&gt;&#160;&#160;&#160;Entra tokens have no jti, so this does not apply there.&lt;br&gt;&lt;br&gt;The gateway returns only the standard OAuth error code. The real&lt;br&gt;reason stays in gateway logs and never reaches the caller, so a&lt;br&gt;consultant debugging this from the client side is working blind." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="442" width="640" height="210" as="geometry"/>
        </mxCell>

        <!-- Claude.ai split -->
        <mxCell id="split" value="&lt;b&gt;The gateway fronts the Anthropic API. It cannot front Claude.ai.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="750" y="680" width="670" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="split-body" value="Claude.ai in a browser, the desktop app, and the mobile app have no&lt;br&gt;base URL setting. Nothing points them at a gateway, so that traffic&lt;br&gt;never reaches Observability and no budget, allowlist, or guardrail&lt;br&gt;touches it.&lt;br&gt;&lt;br&gt;When a customer says &quot;we use Claude&quot;, establish which one:&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Code calling&lt;/b&gt; &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;api.anthropic.com&lt;/font&gt; &#8212; an SDK, an agent&lt;br&gt;&#160;&#160;&#160;framework, Claude Code, a CI job. This is what the gateway covers.&lt;br&gt;&#8226;&#160;&lt;b&gt;People typing into&lt;/b&gt; &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;claude.ai&lt;/font&gt; &#8212; covered by network egress&lt;br&gt;&#160;&#160;&#160;policy, a CASB or SASE control, or the plan&#39;s own admin tooling.&lt;br&gt;&#160;&#160;&#160;Not by the AI Gateway." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="712" width="640" height="180" as="geometry"/>
        </mxCell>

        <!-- Two meters -->
        <mxCell id="bills" value="&lt;b&gt;Two meters run at once&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="670" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="bills-body" value="&lt;b&gt;1.&#160;&#160;Anthropic bills your Anthropic account for inference.&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Unchanged by the gateway. Same rates, same console.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&#160;&#160;Palo Alto Networks meters flex credits by token volume.&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;1 token = 4 characters. Prompts, MCP, and agent-to-agent traffic&lt;br&gt;&#160;&#160;&#160;&#160;&#160;all count. Identical pricing for SaaS and Hybrid.&lt;br&gt;&lt;br&gt;Because every call now carries one credential, the Anthropic side&lt;br&gt;collapses to a single principal. Per-team and per-app breakdown&lt;br&gt;moves into the gateway logs." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="792" width="640" height="135" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
