<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway fronting Azure AI Foundry" id="aigw-azure-foundry">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1110" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI Gateway fronting Azure AI Foundry" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Azure is the provider that punishes loose naming. The app calls a deployment you created, through a resource you own, in one region, at a pinned API version." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1300" height="24" as="geometry"/>
        </mxCell>

        <!-- App -->
        <mxCell id="app" value="&lt;b&gt;Your application&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url =&lt;br&gt;&#160;&#160;https://aigw.portkey.ai/v1&lt;br&gt;api_key = &amp;lt;gateway key&amp;gt;&lt;br&gt;model =&lt;br&gt;&#160;&#160;@default-azure/&lt;br&gt;&#160;&#160;&amp;lt;deployment name&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="230" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="app-note" value="No resource key. No Entra token. No api-version&#10;to track. The app does not even need to know&#10;the model is in Azure, which is what makes a&#10;later move to another provider a config change." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="308" width="290" height="70" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw" value="&lt;b&gt;Prisma AIRS AI Gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=center;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="330" height="222" as="geometry"/>
        </mxCell>
        <mxCell id="gw-steps" value="&#8226;&#160;Authenticate the gateway key&lt;br&gt;&#8226;&#160;Resolve &lt;font style=&quot;font-family:Courier New&quot;&gt;default-azure&lt;/font&gt;&lt;br&gt;&#8226;&#160;Check the deployment is on the allowlist&lt;br&gt;&#8226;&#160;Check budget and rate limits&lt;br&gt;&#8226;&#160;Apply guardrails&lt;br&gt;&#8226;&#160;&lt;b&gt;Rewrite the call to the Azure endpoint,&lt;br&gt;&#160;&#160;&#160;deployment, and API version, then&lt;br&gt;&#160;&#160;&#160;authenticate with the key or Entra token&lt;/b&gt;&lt;br&gt;&#8226;&#160;Meter tokens, cost, and latency&lt;br&gt;&#8226;&#160;Write the prompt and response log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="154" width="290" height="172" as="geometry"/>
        </mxCell>

        <!-- Azure boundary -->
        <mxCell id="az" value="&lt;b&gt;Your Azure subscription&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;one resource, one region" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#E5A300;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="600" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="ep" value="&lt;b&gt;Foundry resource endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;https://&amp;lt;resource&amp;gt;&lt;br&gt;&#160;&#160;.services.ai.azure.com&lt;br&gt;&#160;&#160;?api-version=&#183;&#183;&#183;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="842" y="140" width="240" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="deps" value="&lt;b&gt;Model deployments&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;You call the deployment,&lt;br&gt;not the model&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;gpt4o-prod&lt;br&gt;chat-eu&lt;br&gt;llama-eval&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Names someone typed at&lt;br&gt;deploy time.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1150" y="140" width="240" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;How the gateway authenticates&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Either the resource API key, or &lt;b&gt;no key at all&lt;/b&gt;:&lt;br&gt;an Entra identity holding &lt;b&gt;Cognitive Services&lt;br&gt;OpenAI User&lt;/b&gt; on the resource itself, not on&lt;br&gt;Key Vault. Keyless removes the secret you would&lt;br&gt;otherwise be rotating forever.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="840" y="262" width="280" height="118" as="geometry"/>
        </mxCell>

        <mxCell id="vis" value="&lt;b&gt;Azure-side visibility&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Azure Monitor and Cost&lt;br&gt;Management see one caller.&lt;br&gt;Per-team breakdown lives in&lt;br&gt;the AI Gateway logs.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1150" y="302" width="240" height="80" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="gateway key + slug" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;fontSize=10;fontFamily=Helvetica;fontColor=#22c55e;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="rewritten to the&#10;deployment path" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;fontSize=10;fontFamily=Helvetica;fontColor=#E5A300;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="ep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="ep" target="deps">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="auth" target="ep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SCM card -->
        <mxCell id="scm" value="&lt;b&gt;Strata Cloud Manager&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;Integration: &lt;font style=&quot;font-family:Courier New&quot;&gt;default-azure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="670" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="scm-body" value="&lt;b&gt;Basic information&lt;/b&gt;&lt;br&gt;&#160;&#160;Name, Description&lt;br&gt;&#160;&#160;&lt;b&gt;Slug&lt;/b&gt; &lt;font style=&quot;font-family:Courier New&quot;&gt;default-azure&lt;/font&gt; &#8212; what the app names in the call&lt;br&gt;&lt;br&gt;&lt;b&gt;Credential and resource&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;stays here, never handed out&lt;/font&gt;&lt;br&gt;&#160;&#160;Resource endpoint URL&#160;&#183;&#160;deployment details&#160;&#183;&#160;API version, and&lt;br&gt;&#160;&#160;either a resource key or an Entra identity with a role on the resource&lt;br&gt;&lt;br&gt;&lt;b&gt;Model provisioning&lt;/b&gt;&lt;br&gt;&#160;&#160;The deployments this integration may reach. Everything not on&lt;br&gt;&#160;&#160;the list is unreachable through this integration.&lt;br&gt;&lt;br&gt;&lt;b&gt;Workspace provisioning&lt;/b&gt;&lt;br&gt;&#160;&#160;Which teams see Azure in their Model Catalog, and each team&#39;s&lt;br&gt;&#160;&#160;budget and rate limit.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pricing adjust multiplier&lt;/b&gt;&lt;br&gt;&#160;&#160;Your enterprise agreement rate, or an internal showback markup." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="464" width="636" height="276" as="geometry"/>
        </mxCell>

        <!-- Which catalog entry -->
        <mxCell id="pick" value="&lt;b&gt;Azure OpenAI and Azure Foundry are two different catalog entries&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="750" y="430" width="670" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="pick-body" value="The provider list carries both, and they are not interchangeable.&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Azure OpenAI&lt;/b&gt; &#8212; your own Azure OpenAI resource, serving the GPT&lt;br&gt;&#160;&#160;&#160;and embedding deployments you created in your subscription.&lt;br&gt;&#8226;&#160;&lt;b&gt;Azure Foundry&lt;/b&gt; &#8212; Azure&#39;s API across a diverse set of foundation&lt;br&gt;&#160;&#160;&#160;models, including models that are not OpenAI&#39;s.&lt;br&gt;&lt;br&gt;Pick by which resource actually hosts the model the app will call. A team&lt;br&gt;using both needs two integrations and two slugs, which is also how you&lt;br&gt;give them two separate budgets." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="462" width="640" height="140" as="geometry"/>
        </mxCell>

        <!-- Deployment name -->
        <mxCell id="dep" value="&lt;b&gt;The deployment name is not the model name&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="750" y="630" width="670" height="206" as="geometry"/>
        </mxCell>
        <mxCell id="dep-body" value="Azure does not serve &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;gpt-4o&lt;/font&gt;. It serves a deployment you created and&lt;br&gt;named, which may be &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;gpt4o-prod&lt;/font&gt;, &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;chat-eu&lt;/font&gt;, or whatever someone typed&lt;br&gt;in the portal that afternoon.&lt;br&gt;&lt;br&gt;That name is what the app puts in the model field, what goes on the&lt;br&gt;allowlist, and what appears in every log row. Rename it in Azure and&lt;br&gt;every caller breaks, surfacing as a model-not-found rather than an&lt;br&gt;auth failure, which sends people looking in the wrong place.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;Agree a deployment naming convention before provisioning, for the&lt;br&gt;same reason you agree the metadata schema before issuing keys.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="662" width="640" height="166" as="geometry"/>
        </mxCell>

        <!-- Two meters -->
        <mxCell id="bills" value="&lt;b&gt;Two meters run at once, and with PTU they will not reconcile&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="750" y="856" width="670" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="bills-body" value="&lt;b&gt;1.&#160;&#160;Azure bills your subscription for inference.&lt;/b&gt; Unchanged by the&lt;br&gt;&#160;&#160;&#160;&#160;&#160;gateway. Same resource, same Cost Management line item.&lt;br&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;If the resource runs on &lt;b&gt;provisioned throughput&lt;/b&gt; rather than&lt;br&gt;&#160;&#160;&#160;&#160;&#160;standard pay-as-you-go, that spend is committed capacity and&lt;br&gt;&#160;&#160;&#160;&#160;&#160;does not move with token counts at all. The gateway&#39;s calculated&lt;br&gt;&#160;&#160;&#160;&#160;&#160;cost figures and the Azure invoice will never match, and they are&lt;br&gt;&#160;&#160;&#160;&#160;&#160;not supposed to. Use the gateway numbers for allocation between&lt;br&gt;&#160;&#160;&#160;&#160;&#160;teams, not for predicting the bill.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&#160;&#160;Palo Alto Networks meters flex credits by token volume.&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;1 token = 4 characters. Identical pricing for SaaS and Hybrid." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="888" width="640" height="170" as="geometry"/>
        </mxCell>

        <!-- Verify -->
        <mxCell id="verify" value="&lt;b&gt;Verify in the customer&#39;s tenant &#8212; this diagram carries the most unconfirmed detail&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="670" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="verify-body" value="The Entra role and endpoint detail come from the repository&#39;s key&lt;br&gt;management guide. The deployment guide explicitly records the Azure&lt;br&gt;integration form&#39;s exact fields as not yet captured, and web research&lt;br&gt;was blocked in this session. Confirm all of the following:&lt;br&gt;&lt;br&gt;&#8226;&#160;Whether the integration form accepts an Entra identity or managed&lt;br&gt;&#160;&#160;&#160;identity at all, or only a static resource key. This is the difference&lt;br&gt;&#160;&#160;&#160;between rotating a secret forever and never holding one.&lt;br&gt;&#8226;&#160;Whether &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;api-version&lt;/font&gt; is a field you set on the integration, or is&lt;br&gt;&#160;&#160;&#160;pinned by the platform. It changes which request shapes work.&lt;br&gt;&#8226;&#160;Whether model provisioning lists deployment names or model names.&lt;br&gt;&#8226;&#160;Whether one integration can span several deployments, several&lt;br&gt;&#160;&#160;&#160;resources, or several regions, or whether each needs its own slug.&lt;br&gt;&#8226;&#160;Which Entra role Azure Foundry needs, given that Cognitive Services&lt;br&gt;&#160;&#160;&#160;OpenAI User is specifically the Azure OpenAI role." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="802" width="640" height="230" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
