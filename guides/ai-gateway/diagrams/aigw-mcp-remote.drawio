<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="Remote MCP, two execution paths" id="aigw-mcp-remote">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Remote MCP: who actually runs the tool" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Not the MCP Gateway. This is the AI Gateway letting a model use MCP tools during inference, and the two modes differ in where tools run, what leaves your environment, and whether anything is logged." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- Mode A -->
        <mxCell id="a" value="&lt;b&gt;Gateway execution&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;prefix the server with &lt;font style=&quot;font-family:Courier New&quot;&gt;@portkey-mcp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontStyle=1;fontFamily=Helvetica;fontColor=#22c55e;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="690" height="420"  as="geometry"/>
        </mxCell>

        <mxCell id="a-app" value="&lt;b&gt;Your application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9px&quot;&gt;x-portkey-beta:&lt;br&gt;&#160;&#160;server-side-mcp-2026-06-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="62" y="150" width="200" height="80"  as="geometry"/>
        </mxCell>

        <mxCell id="a-gw" value="&lt;b&gt;AI Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Calls the model, then runs the&lt;br&gt;tool itself and returns the result.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="297" y="150" width="200" height="80"  as="geometry"/>
        </mxCell>

        <mxCell id="a-model" value="&lt;b&gt;Model provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Asks for a tool call.&lt;br&gt;Never touches the server.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="532" y="150" width="175" height="80"  as="geometry"/>
        </mxCell>

        <mxCell id="a-srv" value="&lt;b&gt;MCP server&lt;/b&gt;&#160;&#160;inside your VPC&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Reached by the gateway only. Credentials never leave your environment.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="297" y="258" width="200" height="72"  as="geometry"/>
        </mxCell>

        <mxCell id="ae1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a-app" target="a-gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a-gw" target="a-model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae3" value="tool runs here" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;fontSize=10;fontFamily=Helvetica;fontColor=#22c55e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a-gw" target="a-srv"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="a-facts" value="&lt;b&gt;Tools run&lt;/b&gt; inside your own environment&lt;br&gt;&lt;b&gt;Credentials&lt;/b&gt; stay in your environment&lt;br&gt;&lt;b&gt;Attribution&lt;/b&gt; via your service or user API key&lt;br&gt;&lt;b&gt;Logging&lt;/b&gt; executions logged and available for audit&lt;br&gt;&lt;br&gt;Required when the server is private, on localhost, or otherwise&lt;br&gt;unreachable from the internet, because a provider cannot reach it&lt;br&gt;at all. Also the route for Bedrock and Vertex AI, which do not&lt;br&gt;execute MCP tools remotely.&lt;br&gt;&lt;br&gt;With the prefix, &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;server_description&lt;/font&gt;, &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;server_url&lt;/font&gt; and &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;require_approval&lt;/font&gt; are ignored if passed." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="62" y="345" width="645" height="160"  as="geometry"/>
        </mxCell>

        <!-- Mode B -->
        <mxCell id="b" value="&lt;b&gt;Provider execution&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;pass a &lt;font style=&quot;font-family:Courier New&quot;&gt;server_url&lt;/font&gt; directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontStyle=1;fontFamily=Helvetica;fontColor=#ef4444;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="690" height="420"  as="geometry"/>
        </mxCell>

        <mxCell id="b-app" value="&lt;b&gt;Your application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9px&quot;&gt;&quot;server_url&quot;:&lt;br&gt;&#160;&#160;&quot;https://mcp.example.com&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="782" y="150" width="200" height="80"  as="geometry"/>
        </mxCell>

        <mxCell id="b-gw" value="&lt;b&gt;AI Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Passes the tool definition&lt;br&gt;through to the provider.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1017" y="150" width="200" height="80"  as="geometry"/>
        </mxCell>

        <mxCell id="b-model" value="&lt;b&gt;Model provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Connects to the server and&lt;br&gt;runs the tool on its own&lt;br&gt;infrastructure.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1252" y="150" width="175" height="80"  as="geometry"/>
        </mxCell>

        <mxCell id="b-srv" value="&lt;b&gt;MCP server&lt;/b&gt;&#160;&#160;public internet&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Reached by the provider, not by you. Must be publicly routable.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1252" y="258" width="175" height="72"  as="geometry"/>
        </mxCell>

        <mxCell id="be1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b-app" target="b-gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b-gw" target="b-model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be3" value="tool runs here" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;fontSize=10;fontFamily=Helvetica;fontColor=#ef4444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b-model" target="b-srv"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="b-facts" value="&lt;b&gt;Tools run&lt;/b&gt; on provider servers&lt;br&gt;&lt;b&gt;Credentials&lt;/b&gt; tokens may reach provider training data&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;and audit pipelines&lt;br&gt;&lt;b&gt;Attribution&lt;/b&gt; none&lt;br&gt;&lt;b&gt;Logging&lt;/b&gt; no execution logging, no security controls&lt;br&gt;&lt;br&gt;The gateway sees the request and the final answer. It does not&lt;br&gt;see the tool call, so nothing about that call reaches your logs,&lt;br&gt;your guardrails, or your audit trail." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="782" y="345" width="645" height="160"  as="geometry"/>
        </mxCell>

        <!-- Header discard -->
        <mxCell id="hdr" value="&lt;b&gt;Nothing is remembered between requests&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="690" height="215"  as="geometry"/>
        </mxCell>
        <mxCell id="hdr-body" value="To avoid leaking keys, the Responses API stores the value of &lt;b&gt;no string&lt;/b&gt; you put in&lt;br&gt;the &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;headers&lt;/font&gt; object, and those values never appear in the response object.&lt;br&gt;&lt;br&gt;Because some servers hand out authenticated URLs, the &lt;b&gt;path&lt;/b&gt; of &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;server_url&lt;/font&gt; is&lt;br&gt;discarded too: &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;example.com/mcp&lt;/font&gt; comes back as &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;example.com&lt;/font&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;The consequence is operational.&lt;/b&gt; Every single request must carry the full&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;server_url&lt;/font&gt; path and every header again. Code that sets them once and&lt;br&gt;reuses a stored response will fail on the second call, usually with a 404." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="582" width="660" height="175"  as="geometry"/>
        </mxCell>

        <!-- Reaching registry servers -->
        <mxCell id="reg" value="&lt;b&gt;Reaching a server that is already in your registry&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="760" y="550" width="690" height="215"  as="geometry"/>
        </mxCell>
        <mxCell id="reg-body" value="A server registered in the MCP Registry can also be used from the inference&lt;br&gt;path, by pointing &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;server_url&lt;/font&gt; at its gateway address:&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;https://aigw.portkey.ai/m/&amp;lt;slug&amp;gt;/mcp&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;No auth or header auth&lt;/b&gt;&#160;&#160;pass the gateway API key as&lt;br&gt;&#160;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;x-portkey-api-key&lt;/font&gt; inside the &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;headers&lt;/font&gt; object.&lt;br&gt;&lt;b&gt;OAuth servers&lt;/b&gt;&#160;&#160;pass the token in the &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;authorization&lt;/font&gt; field on the tool.&lt;br&gt;&lt;br&gt;These bodies carry a plain &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;server_label&lt;/font&gt;, so they are provider execution&lt;br&gt;and the right-hand column above applies. Prefixing the label keeps&lt;br&gt;execution on the gateway." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="778" y="582" width="660" height="175"  as="geometry"/>
        </mxCell>

        <!-- Choosing -->
        <mxCell id="choose" value="&lt;b&gt;Choosing between them&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1410" height="200"  as="geometry"/>
        </mxCell>
        <mxCell id="choose-body" value="&lt;b&gt;Gateway execution is the default answer for an enterprise.&lt;/b&gt; It keeps tool execution and credentials inside your environment, attributes the call to a key you&lt;br&gt;issued, and leaves an audit trail. Provider execution exists because it is simpler and because some providers support it natively, and it is a reasonable choice&lt;br&gt;for a public, unauthenticated server where none of those three properties matters.&lt;br&gt;&lt;br&gt;&lt;b&gt;The decision is not reversible by configuration alone.&lt;/b&gt; It lives in the request body your applications send, so changing it later means changing code and&lt;br&gt;redeploying. Settle it before application teams build against either shape.&lt;br&gt;&lt;br&gt;&lt;b&gt;Gateway execution is a beta feature.&lt;/b&gt; The header carries a date, &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;server-side-mcp-2026-06-01&lt;/font&gt;, so the shape may change. Confirm it still applies before&lt;br&gt;committing a customer to it." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="822" width="1380" height="160"  as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
