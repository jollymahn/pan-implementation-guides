<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway on Azure Container Apps" id="aigw-serverless-azure-aca">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI Gateway hybrid data plane on Azure Container Apps" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Terraform builds everything inside the resource group. No Kubernetes cluster is involved. Prompt content never leaves your subscription: it lands in your own Blob container, and only anonymised metrics go outbound." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1540" height="24" as="geometry"/>
        </mxCell>

        <!-- Applications -->
        <mxCell id="apps" value="&lt;b&gt;Your applications&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Container Apps, VMs, Functions, or&lt;br&gt;anything that can reach the ingress&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url = gateway FQDN&lt;br&gt;api_key = &amp;lt;workspace key&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="apps-note" value="No provider API keys live here.&#10;The app speaks one OpenAI-shaped&#10;API to one endpoint." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="328" width="230" height="50" as="geometry"/>
        </mxCell>

        <!-- Resource group / VNet -->
        <mxCell id="rg" value="&lt;b&gt;Your resource group&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;VNet optional, but required for Private Link and Application Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#E5A300;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="860" height="730" as="geometry"/>
        </mxCell>

        <mxCell id="ingress" value="&lt;b&gt;Ingress&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;built-in ACA, or Application Gateway&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;ingress_type = &quot;aca&quot; gives a managed HTTPS FQDN with no VNet.&lt;br&gt;ingress_type = &quot;application_gateway&quot; adds WAF, your own TLS&lt;br&gt;certificate from Key Vault, and host-based routing for MCP.&lt;br&gt;Raise the request timeout above your longest generation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="175" width="330" height="105" as="geometry"/>
        </mxCell>

        <!-- Container Apps environment -->
        <mxCell id="env" value="&lt;b&gt;Container Apps environment&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;zone redundant when deployed into a VNet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="320" y="310" width="800" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="rep-a" value="&lt;b&gt;Gateway replica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1 vCPU &#183; 2 GiB &#183; port 8787&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Auth &#183; routing &#183; guardrails&lt;br&gt;rate limits &#183; budgets&lt;br&gt;metering &#183; logging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="352" width="370" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="rep-b" value="&lt;b&gt;Gateway replica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1 vCPU &#183; 2 GiB &#183; port 8787&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;KEDA scales replicas between&lt;br&gt;min_replicas and max_replicas on CPU,&lt;br&gt;memory, or concurrent HTTP requests.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="352" width="370" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="env-note" value="&lt;b&gt;Set min_replicas to at least 2 for production.&lt;/b&gt; Container Apps will scale to a single replica, and at min_replicas = 1 a restart or a platform-initiated move is a full outage. The gateway is stateless, so horizontal scaling is the only knob that matters; the per-replica size stays at 1 vCPU and 2 GiB." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="506" width="760" height="68" as="geometry"/>
        </mxCell>

        <!-- Managed services -->
        <mxCell id="redis" value="&lt;b&gt;Cache store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Built-in Redis container app, or&lt;br&gt;Azure Managed Redis over TLS&lt;br&gt;on port 6380.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Synced config &#183; API keys&lt;br&gt;rate limit and budget state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="650" width="245" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="blob" value="&lt;b&gt;Blob Storage &#183; log store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Reached with a managed identity&lt;br&gt;(auth_mode = managed)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;&lt;b&gt;Full prompt and completion bodies&lt;/b&gt;&lt;br&gt;Roughly 10 kB per document.&lt;br&gt;Created for you unless you name one.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="595" y="650" width="250" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="egress" value="&lt;b&gt;Egress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Default ACA egress, or your own&lt;br&gt;route table and firewall when the&lt;br&gt;environment sits in a VNet.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;The outbound path when you&lt;br&gt;are not using Private Link.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="875" y="650" width="245" height="130" as="geometry"/>
        </mxCell>

        <!-- Key Vault -->
        <mxCell id="kv" value="&lt;b&gt;Azure Key Vault&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;RBAC authorisation enabled&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Four secrets, created before Terraform runs:&lt;br&gt;&lt;font style=&quot;font-family:Courier New&quot;&gt;docker-username&#160;&#160;docker-password&lt;br&gt;portkey-client-auth&#160;&#160;organisations-to-sync&lt;/font&gt;&lt;br&gt;&lt;br&gt;The module is given the &lt;b&gt;secret names&lt;/b&gt;, not the values.&lt;br&gt;Raw values never appear in Terraform state.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="175" width="440" height="115" as="geometry"/>
        </mxCell>

        <!-- Outside -->
        <mxCell id="mgmt" value="&lt;b&gt;PAN management plane&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;aigw.portkey.ai&lt;br&gt;albus.portkey.ai&lt;br&gt;azure-cp.portkey.ai&#160;&#160;(Private Link)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Strata Cloud Manager UI&lt;br&gt;Config, analytics, log presentation&lt;br&gt;Licensing and entitlement&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#3b82f6&quot;&gt;&lt;b&gt;Receives anonymised metrics.&lt;/b&gt;&lt;br&gt;Prompt content stays in your subscription.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="300" width="360" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="providers" value="&lt;b&gt;Model providers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;api.openai.com&lt;br&gt;api.anthropic.com&lt;br&gt;&amp;lt;name&amp;gt;.openai.azure.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;The gateway makes these calls now,&lt;br&gt;so the egress rules follow it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#666666;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="560" width="360" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="registry" value="&lt;b&gt;Container registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Gateway images, pulled with the Docker&lt;br&gt;credentials Palo Alto Networks issues&lt;br&gt;against your Organisation ID.&lt;br&gt;&lt;br&gt;Install and upgrade only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#666666;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="738" width="360" height="120" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00294D;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="apps" target="ingress">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1l" value="&lt;b&gt;1&lt;/b&gt;&#160;&#160;HTTPS" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#00294D;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="256" y="182" width="70" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00294D;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=0.25;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="ingress" target="env">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2l" value="&lt;b&gt;2&lt;/b&gt;&#160;&#160;Balanced across replicas, port 8787" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#00294D;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="400" y="279" width="230" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="kv" target="env">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3l" value="&lt;b&gt;3&lt;/b&gt;&#160;&#160;Resolved at deploy time" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#ef4444;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="900" y="292" width="160" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E5A300;strokeWidth=2;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="env" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4l" value="&lt;b&gt;4&lt;/b&gt;&#160;&#160;Read config, write counters" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#E5A300;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="410" y="624" width="180" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E5A300;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="env" target="blob">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5l" value="&lt;b&gt;5&lt;/b&gt;&#160;&#160;Write logs" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#E5A300;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="608" y="624" width="90" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.88;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="env" target="egress">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6l" value="&lt;b&gt;6&lt;/b&gt;&#160;&#160;All egress" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#3b82f6;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1010" y="624" width="90" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.15;entryX=0;entryY=0.85;" edge="1" parent="1" source="egress" target="mgmt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7l" value="&lt;b&gt;7&lt;/b&gt;&#160;&#160;Outbound: config sync, metrics, usage&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Private Link, or internet to aigw / albus" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#3b82f6;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1200" y="502" width="330" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00294D;strokeWidth=2.5;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="egress" target="providers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8l" value="&lt;b&gt;8&lt;/b&gt;&#160;&#160;The LLM call" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#00294D;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1200" y="536" width="140" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="egress" target="registry">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9l" value="&lt;b&gt;9&lt;/b&gt;&#160;&#160;Image pull" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#666666;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1200" y="714" width="120" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ef4444;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=0;exitY=0.05;entryX=0.5;entryY=0;" edge="1" parent="1" source="mgmt" target="ingress">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1170" y="145"/>
              <mxPoint x="485" y="145"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10l" value="&lt;b&gt;10&lt;/b&gt;&#160;&#160;Inbound: private endpoint onto the Container Apps environment, or an IP allow-list" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#ef4444;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="500" y="124" width="640" height="20" as="geometry"/>
        </mxCell>

        <!-- Footer -->
        <mxCell id="foot" value="&lt;b&gt;Configure both directions.&lt;/b&gt;&#160;&#160;Flows 7, 9, and 10 reach Palo Alto Networks, and none of them carries prompt or completion content. Flow 5 is where that content lands, inside your own subscription. Outbound alone leaves a gateway that serves traffic but never appears in Strata Cloud Manager." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="1540" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="foot2" value="Inbound Private Link targets the Container Apps environment itself, not a load balancer, so it works with the built-in ACA ingress. Palo Alto Networks creates the private endpoint in their subscription and you approve the connection request in yours." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="906" width="1540" height="24" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
