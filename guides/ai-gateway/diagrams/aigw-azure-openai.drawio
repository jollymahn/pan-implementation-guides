<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway fronting Azure OpenAI" id="aigw-azure-openai">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI Gateway fronting Azure OpenAI" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Four authentication modes, two of which only work on a self-hosted gateway. The application names a deployment you created, not a model Azure publishes." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1250" height="24" as="geometry"/>
        </mxCell>

        <!-- App -->
        <mxCell id="app" value="&lt;b&gt;Your application&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url =&lt;br&gt;&#160;&#160;https://aigw.portkey.ai/v1&lt;br&gt;api_key = &amp;lt;gateway key&amp;gt;&lt;br&gt;model =&lt;br&gt;&#160;&#160;@azure-prod/&lt;font style=&quot;color:#ef4444&quot;&gt;&amp;lt;deployment&amp;gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="250" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="app-note" value="The model field carries the deployment name you&#10;chose in Azure, not the model name Azure publishes.&#10;This is the single most common first-call failure.&#10;Streaming also needs stream_options include_usage." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="303" width="300" height="70" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw" value="&lt;b&gt;Prisma AIRS AI Gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=center;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="390" y="120" width="330" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="gw-steps" value="&#8226;&#160;Authenticate the gateway key&lt;br&gt;&#8226;&#160;Resolve &lt;font style=&quot;font-family:Courier New&quot;&gt;azure-prod&lt;/font&gt;&lt;br&gt;&#8226;&#160;Check the deployment is provisioned&lt;br&gt;&#8226;&#160;Check budget and rate limits&lt;br&gt;&#8226;&#160;Apply guardrails&lt;br&gt;&#8226;&#160;&lt;b&gt;Strip the gateway key and attach the&lt;br&gt;&#160;&#160;&#160;credential for the selected mode&lt;/b&gt;&lt;br&gt;&#8226;&#160;Meter tokens, cost, and latency&lt;br&gt;&#8226;&#160;Write the prompt and response log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="154" width="290" height="178" as="geometry"/>
        </mxCell>

        <!-- Azure -->
        <mxCell id="az" value="&lt;b&gt;Azure&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;your subscription, your resource group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#E5A300;" vertex="1" parent="1">
          <mxGeometry x="830" y="100" width="590" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="az-ep" value="&lt;b&gt;Azure OpenAI resource&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;https://&amp;lt;resource-name&amp;gt;&lt;br&gt;.openai.azure.com&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The integration stores only the&lt;br&gt;first label as Azure Resource Name.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="855" y="140" width="235" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="deployments" value="&lt;b&gt;Deployments&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;You name each one. The name is&lt;br&gt;what the caller sends.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;prod-chat&#160;&#160;&#8594; gpt-&#183;&#183;&#183;&lt;br&gt;prod-embed &#8594; text-embedding-&#183;&#183;&#183;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="140" width="255" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="role" value="&lt;b&gt;The role assignment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;For the three identity modes, grant&lt;br&gt;&lt;b&gt;Cognitive Services OpenAI User&lt;/b&gt; on the&lt;br&gt;resource. Not Contributor. Not Owner.&lt;br&gt;Revoking the assignment cuts access&lt;br&gt;without touching the gateway.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="850" y="272" width="280" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="vis" value="&lt;b&gt;Azure-side visibility&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;One principal makes every call.&lt;br&gt;Azure Monitor and cost analysis&lt;br&gt;see the integration, never the&lt;br&gt;person behind it.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1140" y="272" width="255" height="90" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="gateway key + slug" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;fontSize=10;fontFamily=Helvetica;fontColor=#22c55e;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="Azure credential&#10;attached here" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;fontSize=10;fontFamily=Helvetica;fontColor=#E5A300;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="az-ep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="az-ep" target="deployments">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="role" target="az-ep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Four modes -->
        <mxCell id="modes" value="&lt;b&gt;Azure Authentication Mode&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;four cards, directly below Slug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="700" height="265" as="geometry"/>
        </mxCell>
        <mxCell id="modes-body" value="&lt;b&gt;Default&lt;/b&gt;&#160;&#160;an API key&lt;br&gt;&#160;&#160;One field: &lt;b&gt;API Key&lt;/b&gt;. Works on a hosted or a self-hosted gateway.&lt;br&gt;&lt;br&gt;&lt;b&gt;Managed&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;self-hosted on Azure only&lt;/font&gt;&lt;br&gt;&#160;&#160;One optional field: &lt;b&gt;Azure Managed ClientID&lt;/b&gt;, needed only for a&lt;br&gt;&#160;&#160;user-assigned identity. Nothing is stored, so nothing rotates.&lt;br&gt;&lt;br&gt;&lt;b&gt;Azure Entra&lt;/b&gt;&#160;&#160;a service principal&lt;br&gt;&#160;&#160;&lt;b&gt;Azure Entra ClientID&lt;/b&gt;, &lt;b&gt;Azure Entra Secret&lt;/b&gt;, &lt;b&gt;Azure Entra Tenant ID&lt;/b&gt;,&lt;br&gt;&#160;&#160;plus a &lt;b&gt;Use Entra Federated Authentication&lt;/b&gt; checkbox.&lt;br&gt;&lt;br&gt;&lt;b&gt;Workload Identity&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;self-hosted on Azure only&lt;/font&gt;&lt;br&gt;&#160;&#160;&lt;b&gt;Azure Workload ClientID&lt;/b&gt; and &lt;b&gt;Azure Workload Tenant ID&lt;/b&gt;. This is&lt;br&gt;&#160;&#160;Azure AD workload identity. There is no token endpoint and no&lt;br&gt;&#160;&#160;service account ID, so it is not the Open AI style of federation." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="452" width="670" height="225" as="geometry"/>
        </mxCell>

        <!-- Foundation Model block -->
        <mxCell id="fm" value="&lt;b&gt;The Foundation Model block&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;on the main form, not under Advanced Options" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="770" y="420" width="650" height="265" as="geometry"/>
        </mxCell>
        <mxCell id="fm-body" value="One integration carries many deployments. Each entry has:&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Deployment Name&lt;/b&gt; &#8212; what the caller sends in the model field&lt;br&gt;&#8226;&#160;&lt;b&gt;Alias Name&lt;/b&gt; &#8212; purpose not confirmed in a tenant&lt;br&gt;&#8226;&#160;&lt;b&gt;API Version&lt;/b&gt; &#8212; per entry, defaults to v1, editable&lt;br&gt;&#8226;&#160;&lt;b&gt;Foundation Model&lt;/b&gt; &#8212; a dropdown of Azure models&lt;br&gt;&#8226;&#160;&lt;b&gt;Make it default model&lt;/b&gt; &#8212; checked by default&lt;br&gt;&lt;br&gt;Add entries with &lt;b&gt;+ Add Model&lt;/b&gt; or &lt;b&gt;+ From Target URI&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Use the same api-version your applications already send. Changing&lt;br&gt;it changes the request contract, not just a label.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color:#E5A300&quot;&gt;Azure Foundry is a different tile and works differently: one Azure&lt;br&gt;Target URI and one optional deployment name, with no model picker.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="788" y="452" width="620" height="225" as="geometry"/>
        </mxCell>

        <!-- Naming trap -->
        <mxCell id="trap" value="&lt;b&gt;A deployment name is not a model name&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="705" width="700" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="trap-body" value="In Azure you give a name to a model when you deploy it, and that name is&lt;br&gt;what every caller must use. A call naming &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;gpt-4o&lt;/font&gt; fails when the&lt;br&gt;deployment is called &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;prod-chat&lt;/font&gt;, even though the model behind it is&lt;br&gt;exactly that.&lt;br&gt;&lt;br&gt;Collect deployment names before the work session. Do not collect model&lt;br&gt;names, because they are not what the application sends.&lt;br&gt;&lt;br&gt;Three products share the Azure name and none is interchangeable:&lt;br&gt;&lt;b&gt;Azure OpenAI&lt;/b&gt; is this tile. &lt;b&gt;Azure Foundry&lt;/b&gt; is a separate tile. &lt;b&gt;Microsoft&lt;br&gt;Copilot Studio&lt;/b&gt; is a different product on a different runtime." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="737" width="670" height="160" as="geometry"/>
        </mxCell>

        <!-- Two meters -->
        <mxCell id="bills" value="&lt;b&gt;Two meters run at once&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="770" y="705" width="650" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="bills-body" value="&lt;b&gt;1.&#160;&#160;Azure bills your subscription for inference.&lt;/b&gt; Unchanged by the&lt;br&gt;&#160;&#160;&#160;&#160;&#160;gateway. Same resource, same rates, same cost analysis blade.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&#160;&#160;Palo Alto Networks meters flex credits by token volume.&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;1 token = 4 characters. Prompts, MCP, and agent-to-agent traffic all&lt;br&gt;&#160;&#160;&#160;&#160;&#160;count. Identical pricing for SaaS and Hybrid.&lt;br&gt;&lt;br&gt;Azure OpenAI is Open AI compatible, so the streaming trap applies here&lt;br&gt;too. Without &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;stream_options: {include_usage: true}&lt;/font&gt; the provider&lt;br&gt;returns no usage data, tokens and cost log as zero, and the budget&lt;br&gt;never sees the spend." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="788" y="737" width="620" height="160" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
