<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="MCP OAuth 2.1, the per-user flow" id="aigw-mcp-oauth21">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="990" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="OAuth 2.1 on an MCP server: why the form asks for nothing" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Selecting OAuth 2.1 adds no fields to the registry entry. There is nothing for an operator to type because each user signs in to the upstream service themselves." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1320" height="24" as="geometry"/>
        </mxCell>

        <!-- Working path -->
        <mxCell id="ok" value="&lt;b&gt;Works&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;the client presents a User key or an IdP login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontStyle=1;fontFamily=Helvetica;fontColor=#22c55e;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1410" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="u1" value="&lt;b&gt;1&lt;/b&gt;&#160;&#160;Alice calls a tool&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Her client sends a &lt;b&gt;User&lt;/b&gt; key, so the&lt;br&gt;request carries an identity: Alice.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="65" y="146" width="245" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="u2" value="&lt;b&gt;2&lt;/b&gt;&#160;&#160;Gateway has no token for Alice&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;It stores no shared credential for this&lt;br&gt;server, so it cannot answer for her. It&lt;br&gt;starts an authorization flow instead.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="345" y="146" width="255" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="u3" value="&lt;b&gt;3&lt;/b&gt;&#160;&#160;Alice signs in upstream&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;She authorizes on the service's own&lt;br&gt;consent screen, as herself. The&lt;br&gt;callback is fixed:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9px&quot;&gt;aigw.portkey.ai/m/oauth/&lt;br&gt;upstream-callback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="635" y="146" width="255" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="u4" value="&lt;b&gt;4&lt;/b&gt;&#160;&#160;Token stored against Alice&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Access token about 1 hour, refresh&lt;br&gt;token about 30 days, refreshed by the&lt;br&gt;gateway without asking again.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="925" y="146" width="255" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="u5" value="&lt;b&gt;5&lt;/b&gt;&#160;&#160;Server sees Alice&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Her own account, her own permissions,&lt;br&gt;her own audit trail on the service side.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="146" width="230" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="ue1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u1" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ue2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#66CCEE;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="u2" target="u3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ue3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u3" target="u4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ue4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u4" target="u5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="ok-note" value="&lt;b&gt;Bob gets his own connection.&lt;/b&gt; The same registry entry serves every user, and each one authorizes separately against their own upstream account. That is the point of this mode: one server definition, many individual identities, and nothing shared between them." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="65" y="290" width="1365" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ok-note2" value="No client secret is stored in the registry entry, and no operator ever handles a user's upstream credential. Revoking one person means disconnecting that person, not rotating a shared key." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontFamily=Helvetica;fontColor=#22c55e;" vertex="1" parent="1">
          <mxGeometry x="65" y="340" width="1365" height="40" as="geometry"/>
        </mxCell>

        <!-- Failing path -->
        <mxCell id="bad" value="&lt;b&gt;Fails&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;the client presents a Service key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontStyle=1;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="425" width="700" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="bad-body" value="A &lt;b&gt;Service&lt;/b&gt; key is tied to nobody. The request arrives with no user identity, so&lt;br&gt;there is no one for the gateway to send to a consent screen and no per-user&lt;br&gt;token to look up. The call stops at step 2 above.&lt;br&gt;&lt;br&gt;The symptom is a &lt;b&gt;500&lt;/b&gt; reading &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;Unable to verify user access&lt;/font&gt;, which reads as a&lt;br&gt;permissions problem and sends people to check roles and tool provisioning.&lt;br&gt;The cause is the kind of credential, not its scope.&lt;br&gt;&lt;br&gt;&lt;b&gt;A key's type is fixed at creation and cannot be converted.&lt;/b&gt; Fixing this means&lt;br&gt;issuing a User key and redeploying whatever held the old one, so settle the&lt;br&gt;key type before building the registry entry." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="457" width="670" height="190" as="geometry"/>
        </mxCell>

        <!-- When DCR fails -->
        <mxCell id="dcr" value="&lt;b&gt;When the service refuses to register the gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="770" y="425" width="680" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="dcr-body" value="Step 3 normally works because the gateway registers itself with the service&lt;br&gt;automatically, through dynamic client registration. Some services refuse:&lt;br&gt;Snowflake, and anything fronted by an enterprise identity provider such as&lt;br&gt;Okta or Entra.&lt;br&gt;&lt;br&gt;The error is &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;Incompatible auth server: does not support&lt;br&gt;dynamic client registration&lt;/font&gt;.&lt;br&gt;&lt;br&gt;The fix is to create an OAuth client with the service yourself and hand the&lt;br&gt;gateway its client ID and secret through &lt;b&gt;Advanced Settings&lt;/b&gt;. That is the only&lt;br&gt;case where this mode needs an operator to type anything." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="788" y="457" width="650" height="190" as="geometry"/>
        </mxCell>

        <!-- The nesting trap -->
        <mxCell id="nest" value="&lt;b&gt;The two boxes that look interchangeable and are not&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1410" height="275" as="geometry"/>
        </mxCell>
        <mxCell id="nest-body" value="Advanced Settings holds three free-text boxes. Two of them take OAuth metadata in &lt;b&gt;different shapes&lt;/b&gt;, and putting the wrong shape in the wrong box fails silently." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="712" width="1380" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="nest-ok" value="&lt;b&gt;Advanced Configuration&lt;/b&gt;&#160;&#160;takes the wrapper&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{&lt;br&gt;&#160;&#160;&quot;oauth_metadata&quot;: {&lt;br&gt;&#160;&#160;&#160;&#160;&quot;issuer&quot;: &quot;https://&amp;lt;your-idp&amp;gt;/...&quot;,&lt;br&gt;&#160;&#160;&#160;&#160;&quot;client_id&quot;: &quot;...&quot;,&lt;br&gt;&#160;&#160;&#160;&#160;&quot;client_secret&quot;: &quot;...&quot;&lt;br&gt;&#160;&#160;}&lt;br&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="745" width="440" height="155" as="geometry"/>
        </mxCell>

        <mxCell id="nest-ok2" value="&lt;b&gt;OAuth Metadata&lt;/b&gt;&#160;&#160;takes the inner object only&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{&lt;br&gt;&#160;&#160;&quot;issuer&quot;: &quot;https://&amp;lt;your-idp&amp;gt;/...&quot;,&lt;br&gt;&#160;&#160;&quot;client_id&quot;: &quot;...&quot;,&lt;br&gt;&#160;&#160;&quot;client_secret&quot;: &quot;...&quot;&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Helvetica;font-size:10px&quot;&gt;Starts at &quot;issuer&quot;. No wrapper.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="518" y="745" width="440" height="155" as="geometry"/>
        </mxCell>

        <mxCell id="nest-bad" value="&lt;b&gt;Wrapper in the OAuth Metadata box&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Everything nests one level too deep. The gateway&lt;br&gt;finds no &lt;font style=&quot;font-family:Courier New&quot;&gt;client_id&lt;/font&gt;, &lt;b&gt;falls back to dynamic client&lt;br&gt;registration without reporting it&lt;/b&gt;, and the original&lt;br&gt;error returns.&lt;br&gt;&lt;br&gt;The credentials look correct in the console the&lt;br&gt;whole time, which is what makes this expensive.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="978" y="745" width="460" height="155" as="geometry"/>
        </mxCell>

        <mxCell id="nest-foot" value="The third box, External Auth Configuration, is self-hosted and enterprise only. It returns 403 on managed SaaS." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="58" y="908" width="1380" height="24" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
