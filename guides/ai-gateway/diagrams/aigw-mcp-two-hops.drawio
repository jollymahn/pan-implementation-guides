<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="MCP Gateway, two authentication hops" id="aigw-mcp-two-hops">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="MCP Gateway: two authentication hops, one tool call" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="The client authenticates to the gateway. The gateway authenticates to the server, with a credential the client never holds. Most authorization errors come from the second hop." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1300" height="24" as="geometry"/>
        </mxCell>

        <!-- Hop labels -->
        <mxCell id="hop1lbl" value="HOP 1&#160;&#160;client to gateway" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="290" y="96" width="220" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="hop2lbl" value="HOP 2&#160;&#160;gateway to MCP server" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#E5A300;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="880" y="96" width="240" height="20" as="geometry"/>
        </mxCell>

        <!-- Client -->
        <mxCell id="client" value="&lt;b&gt;MCP client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Claude Desktop, Cursor, VS Code,&lt;br&gt;a custom agent&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;url:&lt;br&gt;&#160;&#160;aigw.portkey.ai/m/&amp;lt;slug&amp;gt;/mcp&lt;br&gt;Authorization:&lt;br&gt;&#160;&#160;Bearer &amp;lt;gateway key&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="250" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="client-note" value="The client holds one credential, and it is&#10;the gateway's. No upstream server key&#10;ever reaches the developer's machine." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="303" width="280" height="60" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw" value="&lt;b&gt;Prisma AIRS MCP Gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=center;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="510" y="120" width="380" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="gw-steps" value="&lt;b&gt;1&lt;/b&gt;&#160;&#160;Authenticate the gateway key or IdP token&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&#160;&#160;Check the key carries &lt;font style=&quot;font-family:Courier New&quot;&gt;mcp.invoke&lt;/font&gt;&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&#160;&#160;Resolve the slug to a registry entry&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&#160;&#160;Check this user may reach this server&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&#160;&#160;Check this user may call this tool&lt;br&gt;&lt;b&gt;6&lt;/b&gt;&#160;&#160;&lt;b&gt;Drop the gateway key and attach the&lt;br&gt;&#160;&#160;&#160;&#160;&#160;upstream credential&lt;/b&gt;&lt;br&gt;&lt;b&gt;7&lt;/b&gt;&#160;&#160;Proxy the call to the server&lt;br&gt;&lt;b&gt;8&lt;/b&gt;&#160;&#160;Log the request and the response" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="530" y="154" width="340" height="215" as="geometry"/>
        </mxCell>

        <!-- MCP server -->
        <mxCell id="srv" value="&lt;b&gt;MCP server&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#E5A300;" vertex="1" parent="1">
          <mxGeometry x="1120" y="110" width="330" height="312" as="geometry"/>
        </mxCell>
        <mxCell id="srv-tools" value="&lt;b&gt;Tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;An external service, an internal API,&lt;br&gt;or a public server. Only the tools&lt;br&gt;provisioned on the registry entry&lt;br&gt;are reachable.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;search_docs&lt;br&gt;create_issue&lt;br&gt;run_query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1145" y="150" width="280" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="srv-cred" value="&lt;b&gt;What the server sees&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;One credential from the gateway, chosen&lt;br&gt;by the registry entry. Under OAuth 2.1 it&lt;br&gt;is that individual user's own token.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1145" y="318" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="gateway key&#10;+ slug" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;fontSize=10;fontFamily=Helvetica;fontColor=#22c55e;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="upstream credential&#10;attached here" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;fontSize=10;fontFamily=Helvetica;fontColor=#E5A300;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="srv-tools">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Where each hop is configured -->
        <mxCell id="cfg" value="&lt;b&gt;Where each hop is configured&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="700" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="cfg-body" value="&lt;b&gt;Hop 1&#160;&#160;client to gateway&lt;/b&gt;&lt;br&gt;&#160;&#160;AI Security &#8594; AI Gateway &#8594; &lt;b&gt;Security Keys&lt;/b&gt;&lt;br&gt;&#160;&#160;Two tabs, &lt;b&gt;Service&lt;/b&gt; and &lt;b&gt;User&lt;/b&gt;. The tab decides attribution, and&lt;br&gt;&#160;&#160;it decides which upstream auth types will work.&lt;br&gt;&#160;&#160;The key must carry the &lt;font style=&quot;font-family:Courier New&quot;&gt;mcp.invoke&lt;/font&gt; permission.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hop 2&#160;&#160;gateway to MCP server&lt;/b&gt;&lt;br&gt;&#160;&#160;AI Security &#8594; AI Gateway &#8594; Integrations &#8594; &lt;b&gt;MCP Registry&lt;/b&gt;&lt;br&gt;&#160;&#160;The &lt;b&gt;Authentication&lt;/b&gt; control on the registry entry: OAuth 2.1,&lt;br&gt;&#160;&#160;OAuth Client Credentials, None, or Headers.&lt;br&gt;&lt;br&gt;&lt;b&gt;Neither hop knows about the other.&lt;/b&gt; A correct registry entry still&lt;br&gt;fails if the client presents the wrong kind of key, and a correct key&lt;br&gt;still fails if the registry entry points at the wrong URL." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="452" width="670" height="210" as="geometry"/>
        </mxCell>

        <!-- Service key trap -->
        <mxCell id="trap" value="&lt;b&gt;A Service key cannot drive an OAuth 2.1 server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="770" y="420" width="680" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="trap-body" value="&lt;b&gt;OAuth 2.1&lt;/b&gt; on a registry entry is &lt;b&gt;per user&lt;/b&gt;. Each person signs in to the&lt;br&gt;upstream service themselves, so the request must arrive carrying a user&lt;br&gt;identity. A Service key is tied to nobody, so there is no one to sign in.&lt;br&gt;&lt;br&gt;&lt;b&gt;Upstream auth type&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Service key&#160;&#160;&#160;&#160;&#160;&#160;User key&lt;/b&gt;&lt;br&gt;None&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;yes&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;yes&lt;br&gt;Headers&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;yes&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;yes&lt;br&gt;OAuth Client Credentials&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;yes&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;yes&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;&lt;b&gt;OAuth 2.1 (per user)&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;no&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;yes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;The key type is fixed when the key is created and cannot be converted, so&lt;br&gt;this decision comes before the registry entry rather than after it. The&lt;br&gt;symptom is a 500 reading &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;Unable to verify user access&lt;/font&gt;, which reads&lt;br&gt;like a permissions fault rather than a wrong kind of credential." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="788" y="452" width="650" height="210" as="geometry"/>
        </mxCell>

        <!-- What the log holds -->
        <mxCell id="log" value="&lt;b&gt;What the log holds, and what it does not&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="695" width="700" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="log-body" value="Every request is logged with no setup. Each entry carries the tool, the full&lt;br&gt;parameters, the full response, the user, the team, a timestamp, the latency,&lt;br&gt;the status, and which server answered.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tool arguments are logged in full.&lt;/b&gt; A tool that takes a customer record or a&lt;br&gt;query string puts that value in the log. Whether capture can be redacted for&lt;br&gt;a sensitive tool is not documented.&lt;br&gt;&lt;br&gt;Attribution comes from the key the request arrived on. A &lt;b&gt;User&lt;/b&gt; key names the&lt;br&gt;person. A &lt;b&gt;Service&lt;/b&gt; key names the workspace and nothing finer, so every&lt;br&gt;application sharing that key is indistinguishable in the log." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="727" width="670" height="210" as="geometry"/>
        </mxCell>

        <!-- Which hop failed -->
        <mxCell id="which" value="&lt;b&gt;Reading a failure: which hop was it?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="770" y="695" width="680" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="which-body" value="A client usually reports one generic error, so the message describes the hop&lt;br&gt;that did not fail. Check hop 2 first.&lt;br&gt;&lt;br&gt;&lt;b&gt;401&lt;/b&gt;&#160;&#160;Missing or expired token, or the server wants a sign-in.&lt;br&gt;&lt;b&gt;403&lt;/b&gt;&#160;&#160;Authenticated but not allowed. Wrong workspace or server in the&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;URL, or no access to that server.&lt;br&gt;&lt;b&gt;404&lt;/b&gt;&#160;&#160;Wrong slug, or the server is not registered in this workspace.&lt;br&gt;&lt;b&gt;500&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;Unable to verify user access&lt;/font&gt;. Start at the key type.&lt;br&gt;&lt;br&gt;The slug in the URL is the registry slug, never a UUID. Copy the connection&lt;br&gt;URL from the server's own page rather than assembling it by hand." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="788" y="727" width="650" height="210" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
