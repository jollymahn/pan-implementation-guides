<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway fronting Amazon Bedrock" id="aigw-bedrock">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI Gateway fronting Amazon Bedrock" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="The app holds no AWS credential. The gateway signs the Bedrock call with an IAM identity that only it holds, in a region you pin at configuration time." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1200" height="24" as="geometry"/>
        </mxCell>

        <!-- App -->
        <mxCell id="app" value="&lt;b&gt;Your application&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url =&lt;br&gt;&#160;&#160;https://aigw.portkey.ai&lt;br&gt;api_key = &amp;lt;gateway key&amp;gt;&lt;br&gt;model =&lt;br&gt;&#160;&#160;@default-bedrock/&lt;br&gt;&#160;&#160;anthropic.claude-...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="230" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="app-note" value="No AWS access key. No IAM role.&#10;No boto3 credential chain. No SigV4.&#10;The app speaks one API to one endpoint,&#10;whatever the model behind it turns out to be." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="308" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw" value="&lt;b&gt;Prisma AIRS AI Gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=center;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="330" height="248" as="geometry"/>
        </mxCell>
        <mxCell id="gw-steps" value="&#8226;&#160;Authenticate the gateway key&lt;br&gt;&#8226;&#160;Resolve &lt;font style=&quot;font-family:Courier New&quot;&gt;default-bedrock&lt;/font&gt;&lt;br&gt;&#8226;&#160;Check the model is on the allowlist&lt;br&gt;&#8226;&#160;Check budget and rate limits&lt;br&gt;&#8226;&#160;Apply guardrails&lt;br&gt;&#8226;&#160;&lt;b&gt;Translate the request to the Bedrock&lt;br&gt;&#160;&#160;&#160;API shape and sign it with the&lt;br&gt;&#160;&#160;&#160;integration&#39;s IAM credential&lt;/b&gt;&lt;br&gt;&#8226;&#160;Meter tokens, cost, and latency&lt;br&gt;&#8226;&#160;Write the prompt and response log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="154" width="290" height="196" as="geometry"/>
        </mxCell>

        <!-- AWS account -->
        <mxCell id="aws" value="&lt;b&gt;Your AWS account&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;region &lt;font style=&quot;font-family:Courier New&quot;&gt;us-east-1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;fontColor=#E5A300;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="600" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="bedrock-ep" value="&lt;b&gt;Bedrock runtime endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;bedrock-runtime.us-east-1&lt;br&gt;.amazonaws.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="845" y="140" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="models" value="&lt;b&gt;Foundation models&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Only the ones you provisioned&lt;br&gt;on the integration are reachable&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;anthropic.claude-&#183;&#183;&#183;&lt;br&gt;amazon.nova-&#183;&#183;&#183;&lt;br&gt;meta.llama-&#183;&#183;&#183;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1150" y="140" width="240" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="iam" value="&lt;b&gt;IAM identity used by the gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;bedrock:InvokeModel&lt;br&gt;bedrock:InvokeModelWithResponseStream&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nothing else. Not an admin credential.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="826" y="250" width="258" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="cw" value="&lt;b&gt;AWS-side visibility&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CloudTrail and Cost Explorer see&lt;br&gt;one caller: the gateway&#39;s IAM identity.&lt;br&gt;&lt;br&gt;Per-team breakdown lives in the AI&lt;br&gt;Gateway logs, not in AWS billing.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1150" y="292" width="240" height="90" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="gateway key + slug" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;fontSize=10;fontFamily=Helvetica;fontColor=#22c55e;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="SigV4-signed&#10;InvokeModel" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;fontSize=10;fontFamily=Helvetica;fontColor=#E5A300;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="bedrock-ep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="bedrock-ep" target="models">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="iam" target="bedrock-ep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SCM integration card -->
        <mxCell id="scm" value="&lt;b&gt;Strata Cloud Manager&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;Integration: &lt;font style=&quot;font-family:Courier New&quot;&gt;default-bedrock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="670" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="scm-body" value="&lt;b&gt;Basic information&lt;/b&gt;&lt;br&gt;&#160;&#160;Name, Description&lt;br&gt;&#160;&#160;&lt;b&gt;Slug&lt;/b&gt; &lt;font style=&quot;font-family:Courier New&quot;&gt;default-bedrock&lt;/font&gt; &#8212; what the app names in the call&lt;br&gt;&lt;br&gt;&lt;b&gt;Credential&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;stays here, never handed out&lt;/font&gt;&lt;br&gt;&#160;&#160;AWS access key ID&#160;&#183;&#160;AWS secret access key&#160;&#183;&#160;Region&lt;br&gt;&lt;br&gt;&lt;b&gt;Model provisioning&lt;/b&gt;&lt;br&gt;&#160;&#160;All models, or an explicit allowlist. Everything not on&lt;br&gt;&#160;&#160;the list is unreachable through this integration.&lt;br&gt;&lt;br&gt;&lt;b&gt;Workspace provisioning&lt;/b&gt;&lt;br&gt;&#160;&#160;Which teams see Bedrock in their Model Catalog, and&lt;br&gt;&#160;&#160;each team&#39;s budget and rate limit.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pricing adjust multiplier&lt;/b&gt;&lt;br&gt;&#160;&#160;Your negotiated AWS rate, or an internal showback markup." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="58" y="444" width="636" height="286" as="geometry"/>
        </mxCell>

        <!-- Two bills -->
        <mxCell id="bills" value="&lt;b&gt;Two meters run at once &#8212; do not let this surprise Finance&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="750" y="410" width="670" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="bills-body" value="&lt;b&gt;1.&#160;&#160;AWS bills you for Bedrock inference.&lt;/b&gt; Unchanged by the gateway.&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Same account, same rates, same Cost Explorer line item.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&#160;&#160;Palo Alto Networks meters flex credits by token volume.&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;1 token = 4 characters. Prompts, MCP, and agent-to-agent traffic&lt;br&gt;&#160;&#160;&#160;&#160;&#160;all count. Identical pricing for SaaS and Hybrid.&lt;br&gt;&lt;br&gt;The dollar figures in the AI Gateway dashboard are the &lt;b&gt;provider&lt;/b&gt; cost&lt;br&gt;it calculates for you, optionally adjusted by your multiplier. They are&lt;br&gt;not your flex credit consumption. Those are two different numbers&lt;br&gt;in two different places." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="442" width="640" height="160" as="geometry"/>
        </mxCell>

        <!-- Data residency -->
        <mxCell id="resid" value="&lt;b&gt;Where the prompt physically goes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="750" y="630" width="670" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="resid-body" value="&lt;b&gt;SaaS&lt;/b&gt;&#160;&#160;app &#8594; PANW-hosted gateway &#8594; Bedrock in your region.&lt;br&gt;The prompt leaves your environment before it reaches AWS, even&lt;br&gt;though Bedrock itself is inside your own account. For a customer who&lt;br&gt;chose Bedrock specifically to keep inference in their account, this is&lt;br&gt;the conversation to have early, not at cutover.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hybrid&lt;/b&gt;&#160;&#160;app &#8594; gateway pod in your cluster &#8594; Bedrock. The prompt&lt;br&gt;never leaves your environment, and prompt logs can be written to a&lt;br&gt;bucket you own. Only control-plane configuration and metering reach&lt;br&gt;Palo Alto Networks." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="662" width="640" height="140" as="geometry"/>
        </mxCell>

        <!-- Verify in tenant -->
        <mxCell id="verify" value="&lt;b&gt;Verify in the customer&#39;s tenant before committing to these on a design call&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="670" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="verify-body" value="The Bedrock credential fields shown here are the access key, secret,&lt;br&gt;and region pattern. Not yet confirmed in published documentation:&lt;br&gt;&lt;br&gt;&#8226;&#160;Whether the integration can assume an IAM role (&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;sts:AssumeRole&lt;/font&gt;&lt;br&gt;&#160;&#160;&#160;with an external ID) instead of holding a static access key. Many&lt;br&gt;&#160;&#160;&#160;security teams will not issue long-lived AWS keys at all.&lt;br&gt;&#8226;&#160;Whether Bedrock &lt;b&gt;inference profiles&lt;/b&gt; and cross-region inference IDs&lt;br&gt;&#160;&#160;&#160;are selectable in model provisioning.&lt;br&gt;&#8226;&#160;Whether a single integration can span more than one AWS region,&lt;br&gt;&#160;&#160;&#160;or whether each region needs its own integration and slug.&lt;br&gt;&#8226;&#160;Whether PrivateLink to the Bedrock endpoint is supported from a&lt;br&gt;&#160;&#160;&#160;Hybrid data plane." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="792" width="640" height="180" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
