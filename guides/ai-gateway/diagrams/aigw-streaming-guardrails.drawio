<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Streaming and guardrails" id="aigw-streaming">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="630" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Where a streamed response can be stopped, and where it cannot" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Input guardrails run before the first chunk and can kill the request. Output guardrails run after the last one and cannot. The asymmetry is the whole point of the diagram." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1400" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1420" height="232" as="geometry"/>
        </mxCell>
        <mxCell id="bandhdr" value="ONE STREAMING REQUEST, LEFT TO RIGHT" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="114" width="600" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;1.&#160;Client opens the stream&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The app sends &lt;font face=&quot;Courier New&quot;&gt;stream: true&lt;/font&gt; in the request body. The gateway answers with server-sent events over the same HTTPS connection.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="146" width="200" height="166" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;2.&#160;Input guardrails&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Before-request hooks are evaluated before the stream starts, while the gateway still owns the whole response.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#15803d&quot;&gt;&lt;b&gt;This one enforces&lt;/b&gt;&lt;br&gt;Needs async = false. Then deny = true returns 446 and nothing reaches the provider; deny = false returns 246 and the call continues.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=3;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="296" y="146" width="200" height="166" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;3.&#160;Forward to the provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The gateway swaps in the provider credential and opens its own stream upstream. The provider begins emitting tokens.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="532" y="146" width="200" height="166" as="geometry"/>
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;4.&#160;Chunks relay through&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Each frame is passed to the client as it arrives, and the gateway keeps a copy so it can assemble the response later.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#ef4444&quot;&gt;&lt;b&gt;Point of no return&lt;/b&gt;&lt;br&gt;Text delivered here is already on the client. Nothing downstream can take it back.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="768" y="146" width="200" height="166" as="geometry"/>
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;5.&#160;Stream ends&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The provider sends the final &lt;font face=&quot;Courier New&quot;&gt;[DONE]&lt;/font&gt; chunk. The gateway parses the accumulated chunks into one complete response.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1004" y="146" width="200" height="166" as="geometry"/>
        </mxCell>

        <mxCell id="s6" value="&lt;b&gt;6.&#160;Output guardrails&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;After-request hooks run on that assembled response, and their verdicts are sent as one extra chunk after &lt;font face=&quot;Courier New&quot;&gt;[DONE]&lt;/font&gt;.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#b45309&quot;&gt;&lt;b&gt;This one only reports&lt;/b&gt;&lt;br&gt;No action is taken. Fallback does not fire, retry does not fire, and the client already has the text.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=3;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1240" y="146" width="200" height="166" as="geometry"/>
        </mxCell>

        <mxCell id="ea" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="blocklane" value="&lt;b&gt;Blocked here&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;the request is rejected before a single token is generated, the app gets 446, and the attempt is still logged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="296" y="352" width="436" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="b1" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#22c55e;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="blocklane"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="reportlane" value="&lt;b&gt;Reported here&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;the verdict lands in the logs and in the final chunk, so you can alert on it and tune the policy. What it cannot do is unsend the answer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="768" y="352" width="672" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="b2" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#f59e0b;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="reportlane"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="lefthdr" value="WHAT YOU HAVE TO SET" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="434" width="400" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="left" value="&lt;font style=&quot;font-size:11px&quot;&gt;&#8226;&#160;&lt;b&gt;Turn streaming on&lt;/b&gt; with &lt;font face=&quot;Courier New&quot;&gt;stream: true&lt;/font&gt; in the request body. Supported on &lt;font face=&quot;Courier New&quot;&gt;/chat/completions&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;/completions&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;/embeddings&lt;/font&gt;, and &lt;font face=&quot;Courier New&quot;&gt;/messages&lt;/font&gt;.&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;See the guardrail verdicts&lt;/b&gt; by sending &lt;font face=&quot;Courier New&quot;&gt;x-portkey-strict-open-ai-compliance: false&lt;/font&gt;. The header defaults to &lt;font face=&quot;Courier New&quot;&gt;true&lt;/font&gt;, and on that default the &lt;font face=&quot;Courier New&quot;&gt;hook_results&lt;/font&gt; chunks are never emitted.&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Make the input guardrail enforce&lt;/b&gt; by setting async = false and deny = true on it. Left asynchronous, it logs a verdict and blocks nothing.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="456" width="700" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="righthdr" value="WHAT CATCHES PEOPLE OUT" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="434" width="400" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="right" value="&lt;font style=&quot;font-size:11px&quot;&gt;&#8226;&#160;&lt;b&gt;Cost records as zero&lt;/b&gt; on every streamed call, because providers omit usage data by default. Send &lt;font face=&quot;Courier New&quot;&gt;stream_options: {include_usage: true}&lt;/font&gt; or your budgets and chargeback reports will under-count streaming traffic.&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Request timeouts stop applying&lt;/b&gt; once one chunk has arrived in time. A provider that starts fast and then stalls will not trigger a 408.&lt;br&gt;&lt;br&gt;&#8226;&#160;&lt;b&gt;Output guardrails are not a control on streams.&lt;/b&gt; If a policy has to stop content reaching a user, it belongs on the input side, or the route has to be non-streaming.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="760" y="456" width="700" height="130" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
