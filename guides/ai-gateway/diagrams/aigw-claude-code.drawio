<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="Routing Claude Code through the AI Gateway" id="aigw-claude-code">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1162" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Routing Claude Code through the AI Gateway" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Three environment variables, no reinstall and no proxy. This is the one path in the set that has been run end to end and screenshotted, so the values below are observed rather than assumed." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1300" height="24" as="geometry"/>
        </mxCell>

        <!-- Workstation -->
        <mxCell id="ws" value="&lt;b&gt;Developer workstation&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;Claude Code&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;ANTHROPIC_BASE_URL=&lt;br&gt;&#160;&#160;https://aigw.portkey.ai&lt;br&gt;ANTHROPIC_AUTH_TOKEN=&lt;br&gt;&#160;&#160;&amp;lt;gateway API key&amp;gt;&lt;br&gt;ANTHROPIC_CUSTOM_HEADERS=&lt;br&gt;&#160;&#160;x-portkey-provider:&lt;br&gt;&#160;&#160;@default-anthropic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="330" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="ws-note" value="No Anthropic API key on the laptop. The developer's&#10;claude.ai login stays saved and unused while the&#10;gateway token is set, and comes back the moment&#10;the variable is unset." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#22c55e;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="308" width="330" height="70" as="geometry"/>
        </mxCell>

        <!-- wire 1 -->
        <mxCell id="wire1" value="&lt;b&gt;On the wire&lt;/b&gt;&lt;br&gt;POST /v1/messages&lt;br&gt;Authorization: Bearer&lt;br&gt;&#160;&#160;&amp;lt;gateway key&amp;gt;&lt;br&gt;anthropic-version:&lt;br&gt;&#160;&#160;2023-06-01&lt;br&gt;x-portkey-provider:&lt;br&gt;&#160;&#160;@default-anthropic&lt;br&gt;{&quot;model&quot;:&lt;br&gt;&#160;&#160;&quot;claude-fable-5&quot;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#006DCC;strokeWidth=1;fontSize=9;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#006DCC;" vertex="1" parent="1">
          <mxGeometry x="392" y="196" width="216" height="150" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw" value="&lt;b&gt;Prisma AIRS AI Gateway&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;&#8226;&#160;Authenticate the gateway key&lt;br&gt;&#8226;&#160;Read &lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;x-portkey-provider&lt;/font&gt; and&lt;br&gt;&#160;&#160;&#160;resolve the integration&lt;br&gt;&#8226;&#160;Check the allowlist, budget, rate&lt;br&gt;&#160;&#160;&#160;limit, and guardrails&lt;br&gt;&#8226;&#160;&lt;b&gt;Strip the gateway key, attach the&lt;br&gt;&#160;&#160;&#160;Anthropic key&lt;/b&gt;&lt;br&gt;&#8226;&#160;Meter tokens and cost, write the log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="630" y="110" width="280" height="190" as="geometry"/>
        </mxCell>

        <!-- wire 2 -->
        <mxCell id="wire2" value="&lt;b&gt;On the wire&lt;/b&gt;&lt;br&gt;x-api-key:&lt;br&gt;&#160;&#160;sk-ant-...&lt;br&gt;anthropic-version:&lt;br&gt;&#160;&#160;2023-06-01&lt;br&gt;&lt;br&gt;(gateway key and&lt;br&gt;&#160;x-portkey-provider&lt;br&gt;&#160;both removed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ef4444;strokeWidth=1;fontSize=9;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#ef4444;" vertex="1" parent="1">
          <mxGeometry x="932" y="196" width="216" height="150" as="geometry"/>
        </mxCell>

        <!-- Provider -->
        <mxCell id="prov" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;api.anthropic.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;The provider key is attached by the&lt;br&gt;gateway and never exists on the&lt;br&gt;laptop. Anthropic sees one caller,&lt;br&gt;whichever developer sent the prompt.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="1170" y="110" width="250" height="190" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="prov">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- TABLE -->
        <mxCell id="tbl-label" value="The three variables, and what each one is actually for" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="396" width="800" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="h1" value="Variable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="428" width="250" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Set it to" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="428" width="360" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="Why it is needed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="428" width="380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="h4" value="Watch out for" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="428" width="390" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="r1c1" value="&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;ANTHROPIC_BASE_URL&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="250" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r1c2" value="&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;https://aigw.portkey.ai&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SaaS. For Hybrid, your own in-cluster service address.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="460" width="360" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r1c3" value="Replaces &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;api.anthropic.com&lt;/font&gt;. This one value is what moves the traffic; nothing else about the install changes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="460" width="380" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r1c4" value="&lt;font color=&quot;#ef4444&quot;&gt;SCM shows the address with a &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;/v1&lt;/font&gt; suffix.&lt;/font&gt; Claude Code appends its own &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;/v1/messages&lt;/font&gt;, so drop the suffix or the path doubles." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="460" width="390" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="r2c1" value="&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;ANTHROPIC_AUTH_TOKEN&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="526" width="250" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r2c2" value="The gateway API key from &lt;b&gt;AI Gateway &#8594; Security Keys&lt;/b&gt;, with the &lt;b&gt;Completions &#8212; Write&lt;/b&gt; permission." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="526" width="360" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r2c3" value="Sent as &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;Authorization: Bearer&lt;/font&gt;. The gateway authenticates it, then swaps in the provider key it holds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="526" width="380" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r2c4" value="While it is set it takes precedence over a saved claude.ai login, and the session banner changes to &lt;b&gt;API Usage Billing&lt;/b&gt;. That is expected, not an error." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="526" width="390" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="r3c1" value="&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;ANTHROPIC_CUSTOM_HEADERS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#ef4444&quot;&gt;the one everybody forgets&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="592" width="250" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="r3c2" value="&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;x-portkey-provider:&lt;br&gt;&#160;&#160;@default-anthropic&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The slug alone, with an @ prefix.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="592" width="360" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="r3c3" value="Claude Code sends bare model names such as &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;claude-fable-5&lt;/font&gt;, not &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;@slug/model&lt;/font&gt;, so the gateway has no way to tell which integration should serve the call." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="592" width="380" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="r3c4" value="Leave it out and every prompt fails with&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:9.5px;color:#ef4444&quot;&gt;400 Either x-portkey-config or&lt;br&gt;x-portkey-provider header is required&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Direct callers that already send &lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;@slug/model&lt;/font&gt; do not need this header.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="592" width="390" height="76" as="geometry"/>
        </mxCell>

        <mxCell id="r4c1" value="&lt;font style=&quot;font-family:Courier New;font-size:9.5px&quot;&gt;CLAUDE_CODE_ENABLE_&lt;br&gt;GATEWAY_MODEL_DISCOVERY&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;optional&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="668" width="250" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="r4c2" value="&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="668" width="360" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="r4c3" value="Makes the &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;/model&lt;/font&gt; picker list the models your gateway actually serves." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="668" width="380" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="r4c4" value="Without it the picker shows the stock list, which can include models your allowlist will reject." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="668" width="390" height="62" as="geometry"/>
        </mxCell>

        <!-- Callouts -->
        <mxCell id="c1" value="&lt;b&gt;Prove it in this order&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="450" height="292" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="&lt;b&gt;1.&lt;/b&gt;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;echo &quot;$ANTHROPIC_BASE_URL&quot;&lt;/font&gt;&lt;br&gt;&#160;&#160;&#160;&#160;If it prints angle brackets, the placeholders were&lt;br&gt;&#160;&#160;&#160;&#160;never replaced. Stop here.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt;&#160;curl the gateway directly. A body starting&lt;br&gt;&#160;&#160;&#160;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{&quot;id&quot;:&quot;msg_&lt;/font&gt; proves URL and credential.&lt;br&gt;&#160;&#160;&#160;&#160;An unknown-model error still proves both, because&lt;br&gt;&#160;&#160;&#160;&#160;the gateway authenticated before rejecting.&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt;&#160;Run &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;claude&lt;/font&gt;, then &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;/status&lt;/font&gt;. An &lt;b&gt;Anthropic&lt;br&gt;&#160;&#160;&#160;&#160;base URL&lt;/b&gt; row appears only when a gateway is set.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt;&#160;Send a prompt, then open &lt;b&gt;Observability &#8594; Logs&lt;/b&gt;.&lt;br&gt;&#160;&#160;&#160;&#160;The row carries model, tokens, and cost. If the&lt;br&gt;&#160;&#160;&#160;&#160;prompt worked but no row appears, you are still&lt;br&gt;&#160;&#160;&#160;&#160;talking to Anthropic directly." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="792" width="420" height="252" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Where the values live, and which one wins&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="505" y="760" width="450" height="292" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="&lt;b&gt;Shell exports&lt;/b&gt; live only in the terminal that ran them.&lt;br&gt;A Claude Code session started from any other window&lt;br&gt;uses the normal login and shows no base URL row. This&lt;br&gt;is the most common &quot;it did not work&quot; report.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;~/.claude/settings.json&lt;/font&gt;&lt;/b&gt; makes it permanent for&lt;br&gt;every session. Add the three values inside an &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;env&lt;/font&gt;&lt;br&gt;block; the file has to stay one JSON object.&lt;br&gt;&lt;br&gt;&lt;b&gt;Precedence&lt;/b&gt;&lt;br&gt;&#8226;&#160;Settings file beats shell export.&lt;br&gt;&#8226;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;ANTHROPIC_AUTH_TOKEN&lt;/font&gt; beats a saved claude.ai&lt;br&gt;&#160;&#160;&#160;login, which stays saved and unused.&lt;br&gt;&#8226;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;/status&lt;/font&gt; tells you which source is active, so use it&lt;br&gt;&#160;&#160;&#160;rather than guessing." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="521" y="792" width="420" height="252" as="geometry"/>
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;Two decisions to make before you roll this out&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="970" y="760" width="450" height="292" as="geometry"/>
        </mxCell>
        <mxCell id="c3b" value="&lt;b&gt;1.&#160;&#160;Where the key is allowed to be written.&lt;/b&gt;&lt;br&gt;Never in a project&#39;s &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;.claude/settings.json&lt;/font&gt;. That&lt;br&gt;file is committed and shared with everyone who clones&lt;br&gt;the repository. Use the user-level&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;~/.claude/settings.json&lt;/font&gt;, or the gitignored&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;.claude/settings.local.json&lt;/font&gt; for one project.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&#160;&#160;One key per developer, or one for the team.&lt;/b&gt;&lt;br&gt;A shared key makes Observability show one caller for&lt;br&gt;the whole team, and revoking it after a leaver takes&lt;br&gt;everyone offline at once. A key per developer gives&lt;br&gt;per-person cost and clean revocation, at the price of&lt;br&gt;issuing and tracking them.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;Either way, put the person or team in the key&#39;s metadata&lt;br&gt;tags at issue time. That is the only thing the logs can&lt;br&gt;group by later.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="986" y="792" width="420" height="252" as="geometry"/>
        </mxCell>

        <!-- Bottom bar -->
        <mxCell id="foot" value="&lt;b&gt;Claude Code is only the worked example.&lt;/b&gt;&#160;&#160;Any client that accepts a base URL override follows the same pattern with no application logic change: the Anthropic SDK takes &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url&lt;/font&gt; and &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;auth_token&lt;/font&gt; constructor arguments and also reads&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;ANTHROPIC_BASE_URL&lt;/font&gt; from the environment, and the OpenAI SDK takes the same two through its own &lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url&lt;/font&gt; argument. What changes is the endpoint and the credential. Nothing else." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;strokeWidth=1;verticalAlign=middle;align=left;spacingLeft=14;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1072" width="1380" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
