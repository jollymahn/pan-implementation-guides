<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="Connectivity checks — AI Gateway" id="airs-conn-ai-gateway">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Connectivity checks — AI Gateway" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Two directions to test. Your application reaching the gateway, and the gateway reaching everything behind it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1340" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="o0" value="&lt;b&gt;Application host or container&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Where your application runs. Checks 1 to 3 run here, because this is whose egress path carries real traffic.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;Gateway pod or task&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Self-hosted only. Check 4 runs here: these are destinations the gateway process calls, not your application.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="224" width="300" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="peri" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="26" height="232" as="geometry"/>
        </mxCell>
        <mxCell id="perilbl" value="&lt;font style=&quot;font-size:10px;color:#ef4444&quot;&gt;&lt;b&gt;YOUR PERIMETER&lt;/b&gt;&lt;br&gt;firewall · proxy · TLS inspection&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#ef4444;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="338" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="d0" value="&lt;b&gt;aigw.portkey.ai, or your own gateway service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The endpoint your application posts completions to&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="480" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;api.portkey.ai  ·  albus.portkey.ai&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Registration, configuration sync, analytics and log delivery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="188" width="480" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Each LLM provider you integrate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;api.openai.com, api.anthropic.com, Bedrock, Azure, or your own model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="276" width="480" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;service.api.aisecurity.paloaltonetworks.com&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Prisma AIRS scan API, called per request once a guardrail is attached&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
