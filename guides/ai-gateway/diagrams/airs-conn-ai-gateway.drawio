        <mxCell id="b4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=#8b5cf6;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
