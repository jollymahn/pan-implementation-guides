        </mxCell>
        <mxCell id="x0" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#999999;dashed=1;dashPattern=6 6;edgeStyle=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="278" as="sourcePoint"/>
            <mxPoint x="900" y="401" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="xl0" value="only once a guardrail is attached" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#999999;align=center;" vertex="1" parent="1">
          <mxGeometry x="490" y="309.1071428571429" width="220" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="tt" value="What each check proves, and what a failure means" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="498" width="1000" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="h0" value="#" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="50" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="Check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="530" width="320" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Proves" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="530" width="420" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="A failure here means" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="530" width="590" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="r0c0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="558" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c1" value="Gateway address resolves and completes TLS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="558" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c2" value="The base URL is right and the path out is open" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="558" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c3" value="A wrong base URL, or on self-hosted a port-forward that is not running or an ingress that is not exposed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="558" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c0" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="602" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c1" value="Gateway accepts the key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="602" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c2" value="The credential is valid for this workspace and tenant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="602" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c3" value="A 401 is the key. Anything else means the key was accepted and the request was rejected for another reason." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="602" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c0" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="646" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c1" value="A real completion comes back" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="646" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c2" value="Key, integration slug, model provisioning and the gateway path to the provider, all at once" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="646" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c3" value="A 400 naming the model is provisioning. A 400 naming x-portkey-provider is a bare model name with no slug." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="646" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c0" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c1" value="Control plane and logging hosts resolve" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="690" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c2" value="The gateway itself can call home, sync configuration and deliver logs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="690" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c3" value="The gateway registers and reports Healthy in the console while every inference request fails." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="690" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c0" value="&lt;b&gt;Healthy in the console does not mean inference works&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="680" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c0b" value="Connection Status confirms the management path only. An egress&lt;br&gt;control that permits the sync endpoints and blocks the providers&lt;br&gt;produces a gateway that registers, reports Healthy, and fails every&lt;br&gt;request, with nothing in the gateway log at all.&lt;br&gt;&lt;br&gt;Check 3 is the one that settles it, because it is the only rung that&lt;br&gt;puts a real prompt through to a provider and back." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="790" width="650" height="114" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Read the endpoint list off your own gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="760" width="680" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="Hostnames have moved as the product was integrated into Strata&lt;br&gt;Cloud Manager, and material from before that is still in circulation.&lt;br&gt;Different sources name different hosts for the same function, and&lt;br&gt;some record a variable name as though it were a hostname.&lt;br&gt;&lt;br&gt;Rather than trusting any list, including this one, read the values&lt;br&gt;out of the deployment in front of you. The chart supplies them as&lt;br&gt;environment values on the running pod." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="790" width="650" height="114" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
