<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AI Gateway - Client Protocols" id="aigw-client-protocols">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Three groups of client application" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Put each client application into one group. The group tells you what to change, and if you can change it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ GROUP 1 ============ -->
        <mxCell id="g1" value="GROUP 1&#160;&#160;&#8212;&#160;&#160;OPEN AI PROTOCOL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="440" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="g1b" value="&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;Most tools are in this group.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Change these three values:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url = &amp;lt;gateway&amp;gt;/v1&lt;br&gt;api_key&#160;&#160;= &amp;lt;gateway key&amp;gt;&lt;br&gt;model&#160;&#160;&#160;&#160;= @&amp;lt;slug&amp;gt;/&amp;lt;model&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;Add &lt;b&gt;/v1&lt;/b&gt; to the gateway address.&lt;br&gt;You do not need an extra header. The model reference already names the integration.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="62" y="132" width="396" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="g1l" value="&lt;b&gt;Clients in this group&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;Cursor&lt;br&gt;Open AI Codex CLI&lt;br&gt;Open AI SDK, any language&lt;br&gt;LiteLLM and other proxies&lt;br&gt;Your own code that calls /chat/completions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="62" y="326" width="396" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g1n" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Codex needs one more line: wire_api = &quot;responses&quot;.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="62" y="462" width="396" height="30" as="geometry"/>
        </mxCell>

        <!-- ============ GROUP 2 ============ -->
        <mxCell id="g2" value="GROUP 2&#160;&#160;&#8212;&#160;&#160;ANTHROPIC PROTOCOL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#006DCC;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#006DCC;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="510" y="100" width="440" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="g2b" value="&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;These clients send a bare model name.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Change these four values:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;base_url = &amp;lt;gateway&amp;gt;&lt;br&gt;api_key&#160;&#160;= &amp;lt;gateway key&amp;gt;&lt;br&gt;model&#160;&#160;&#160;&#160;= &amp;lt;model name&amp;gt;&lt;br&gt;header&#160;&#160;&#160;= x-portkey-provider:&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;@&amp;lt;slug&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;Do &lt;b&gt;not&lt;/b&gt; add /v1. The client adds its own path.&lt;br&gt;The header is necessary. Without it the gateway cannot select the integration.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="532" y="132" width="396" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="g2l" value="&lt;b&gt;Clients in this group&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;Claude Code&lt;br&gt;Anthropic SDK, any language&lt;br&gt;Your own code that calls /v1/messages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#006DCC;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="532" y="336" width="396" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g2n" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Claude Code reads three environment variables: ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN and ANTHROPIC_CUSTOM_HEADERS.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="532" y="442" width="396" height="50" as="geometry"/>
        </mxCell>

        <!-- ============ GROUP 3 ============ -->
        <mxCell id="g3" value="GROUP 3&#160;&#160;&#8212;&#160;&#160;NO CONFIGURABLE ENDPOINT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#ef4444;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="980" y="100" width="440" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="g3b" value="&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;You cannot send these through the gateway.&lt;br&gt;&lt;br&gt;These are finished products. The vendor controls the model endpoint. There is no setting that changes it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Do not plan to route them.&lt;/b&gt; Tell the customer early. This is a scope question, not a configuration problem.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1002" y="132" width="396" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="g3l" value="&lt;b&gt;Clients in this group&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;The ChatGPT application&lt;br&gt;GitHub Copilot&lt;br&gt;Microsoft 365 Copilot&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The Open AI API is different from the ChatGPT application. The API is in group 1.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1002" y="326" width="396" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g3n" value="&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;Copilot Studio agents are not in this group. See the open question on the client applications page.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1002" y="462" width="396" height="40" as="geometry"/>
        </mxCell>

        <!-- ============ GATEWAY ============ -->
        <mxCell id="gw" value="&lt;b&gt;AI GATEWAY&lt;/b&gt;&#160;&#160;&#160;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#666666&quot;&gt;Group 1 and group 2 arrive here. The gateway accepts both protocols.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="628" width="910" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.72;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#ef4444;dashed=1;dashPattern=4 4;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="g3">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1112" y="656" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="e3l" value="&lt;font style=&quot;font-size:11px;color:#ef4444&quot;&gt;&lt;b&gt;no path&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1124" y="642" width="180" height="28" as="geometry"/>
        </mxCell>

        <!-- ============ CALLOUT ============ -->
        <mxCell id="c1" value="&lt;b&gt;How to put a client into a group&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="712" width="1380" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="Ask two questions about the client.&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Can you set the base URL and the API key?&lt;/b&gt; If you cannot, the client is in group 3. Stop here.&lt;br&gt;&lt;b&gt;2. Does the client send a model name like gpt-4.1, or a reference like @my-slug/gpt-4.1?&lt;/b&gt; A client that accepts the full reference is in group 1. A client that sends only a bare name is in group 2, and it needs the header." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="742" width="1350" height="80" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
