        <mxCell id="xl0" value="only the sources in your inventory" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#999999;align=center;" vertex="1" parent="1">
          <mxGeometry x="490" y="247.5" width="220" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="tt" value="What each check proves, and what a failure means" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="498" width="1000" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="h0" value="#" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="50" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="Check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="530" width="320" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Proves" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="530" width="420" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="A failure here means" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="530" width="590" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="r0c0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="558" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c1" value="API and authentication hosts resolve and complete TLS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="558" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c2" value="The scanning host has a path out to both, which are different hostnames" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="558" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c3" value="A build runner on a locked-down subnet. Test from the runner, not from the machine that configures it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="558" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c0" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="602" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c1" value="Service account obtains a token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="602" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c2" value="The credential a pipeline will use is valid, since the agent authenticates as a service account" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="602" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c3" value="A credential problem rather than a network one. The hosts answered." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="602" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c0" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="646" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c1" value="Scanning API answers and returns the package index URL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="646" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c2" value="The management plane accepts the token and hands back the index to install from" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="646" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c3" value="A 403 here is a role problem on the service account rather than connectivity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="646" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c0" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="50" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="r3c1" value="Private package index is reachable from this machine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="690" width="320" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="r3c2" value="pip on this host can actually install the client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="690" width="420" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="r3c3" value="An internal package mirror that will not pass an extra index through. Raise this weeks before the session." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="690" width="590" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c0" value="&lt;b&gt;Check 4 is the one to run first, not last&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="768" width="680" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c0b" value="The client is not on public PyPI. It installs from an authenticated&lt;br&gt;private index, and many organizations route every package install&lt;br&gt;through an internal mirror that will not pass an extra index URL&lt;br&gt;through to the outside.&lt;br&gt;&lt;br&gt;That is a policy change with a lead time measured in weeks, not a&lt;br&gt;command anyone can run on the day. It is the single most reliable&lt;br&gt;way for a first session to stop before it starts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="798" width="650" height="114" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;There is no wrapper to build for this pillar&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="768" width="680" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="The agent reads seven source types: Hugging Face, Amazon S3,&lt;br&gt;Google Cloud Storage, Azure Blob Storage, JFrog Artifactory,&lt;br&gt;GitLab Model Registry, and a local path. There is no custom&lt;br&gt;connector mechanism, so nobody should go looking for one.&lt;br&gt;&lt;br&gt;Anything else goes through the local path: download the model to&lt;br&gt;the scanning host and scan it there. That is also the documented&lt;br&gt;route for a private Hugging Face repository." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="798" width="650" height="114" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
