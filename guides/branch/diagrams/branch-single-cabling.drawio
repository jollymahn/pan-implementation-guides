<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="Branch Single Firewall Cabling" id="single-cabling">
    <mxGraphModel dx="900" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="0" page="0" pageScale="1" pageWidth="700" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ── Provider Switch (top) ─────────────── -->
        <mxCell id="prov-switch" value="Provider Switch (DHCP Internet / CG-NAT)" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="170" y="40" width="360" height="52" as="geometry"/>
        </mxCell>

        <!-- ── PA-410 firewall ───────────────────── -->
        <mxCell id="fw-box" value="" style="rounded=1;fillColor=#22c55e;strokeColor=#16a34a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="150" y="200" width="400" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="fw-title" value="PA-410  (Single Firewall)" style="text;html=1;fontStyle=1;fontSize=15;fontColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="210" width="400" height="26" as="geometry"/>
        </mxCell>

        <!-- management interface -->
        <mxCell id="mgmt-port" value="management" style="rounded=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="254" width="140" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="mgmt-label" value="OOB — DHCP" style="text;html=1;fontSize=11;fontColor=#f0fdf4;" vertex="1" parent="1">
          <mxGeometry x="340" y="262" width="180" height="20" as="geometry"/>
        </mxCell>

        <!-- eth1/1 interface -->
        <mxCell id="eth1-port" value="eth1/1" style="rounded=1;fillColor=#FFB81C;strokeColor=#E5A300;fontColor=#00294D;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="312" width="140" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="eth1-label" value="zone-public / WAN / SD-WAN (DHCP)" style="text;html=1;fontSize=11;fontColor=#f0fdf4;" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="190" height="20" as="geometry"/>
        </mxCell>

        <!-- eth1/7 interface -->
        <mxCell id="eth7-port" value="eth1/7" style="rounded=1;fillColor=#16a34a;strokeColor=#15803d;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="370" width="140" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="eth7-label" value="zone-private / LAN" style="text;html=1;fontSize=11;fontColor=#f0fdf4;" vertex="1" parent="1">
          <mxGeometry x="340" y="378" width="180" height="20" as="geometry"/>
        </mxCell>

        <!-- ── Connections to provider switch ────── -->
        <mxCell id="mgmt-conn" value="OOB management" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00294D;strokeWidth=2;fontStyle=2;fontSize=10;fontColor=#00294D;endArrow=none;" edge="1" source="mgmt-port" target="prov-switch" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eth1-conn" value="WAN / SD-WAN" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E5A300;strokeWidth=2.5;fontStyle=2;fontSize=10;fontColor=#E5A300;endArrow=none;" edge="1" source="eth1-port" target="prov-switch" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ── LAN Switch (bottom) ──────────────── -->
        <mxCell id="lan-switch" value="Branch LAN Switch" style="rounded=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontStyle=1;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="520" width="260" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="eth7-conn" value="LAN" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2.5;fontStyle=2;fontSize=10;fontColor=#16a34a;endArrow=none;" edge="1" source="eth7-port" target="lan-switch" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SD-WAN AutoVPN label on WAN -->
        <mxCell id="sdwan-note" value="↑ SD-WAN AutoVPN tunnels to hub&#xa;IKEv2/IPsec over internet (CG-NAT traversal)" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#E5A300;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="100" width="400" height="32" as="geometry"/>
        </mxCell>

        <!-- Note about no HA -->
        <mxCell id="no-ha-note" value="No HA crosslinks required.&#xa;Failover handled at SD-WAN layer." style="rounded=1;fillColor=#fff8e1;strokeColor=#FFB81C;fontSize=10;fontStyle=2;fontColor=#E5A300;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="590" width="340" height="36" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
