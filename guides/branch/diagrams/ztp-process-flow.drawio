        <mxCell id="col-cloud" value="ZTP Portal / Internet" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#ffffff;fillColor=#006DCC;strokeColor=none;align=center;" vertex="1" parent="1">
          <mxGeometry x="270" y="20" width="220" height="36" as="geometry"/>
