<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="ZTP Process Flow" id="ztp-flow">
    <mxGraphModel dx="900" dy="1800" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="0" page="0" pageScale="1" pageWidth="900" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ══ COLUMN HEADERS ══════════════════════════════ -->
