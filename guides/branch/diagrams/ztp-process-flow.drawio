        <mxCell id="col-scm" value="Strata Cloud Manager" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#ffffff;fillColor=#00294D;strokeColor=none;align=center;" vertex="1" parent="1">
          <mxGeometry x="510" y="20" width="360" height="36" as="geometry"/>
