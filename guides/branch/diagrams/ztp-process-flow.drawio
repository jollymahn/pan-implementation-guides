        <!-- Column lane backgrounds -->
        <mxCell id="lane-device" value="" style="fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="30" y="56" width="220" height="1820" as="geometry"/>
        </mxCell>
        <mxCell id="lane-cloud" value="" style="fillColor=#e3f7ff;strokeColor=#006DCC;strokeWidth=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="270" y="56" width="220" height="1820" as="geometry"/>
        </mxCell>
        <mxCell id="lane-scm" value="" style="fillColor=#f0f4ff;strokeColor=#00294D;strokeWidth=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="510" y="56" width="360" height="1820" as="geometry"/>
        </mxCell>

        <!-- ══ PRE-BOOT BANNER ══════════════════════════════ -->
        <mxCell id="pre-boot-banner" value="BEFORE POWERING ON DEVICES" style="text;html=1;fontStyle=1;fontSize=11;fontColor=#E5A300;fillColor=#fff8e1;strokeColor=#FFB81C;strokeWidth=1.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="66" width="840" height="24" as="geometry"/>
        </mxCell>

        <!-- PRE-BOOT: SCM folder + snippet -->
        <mxCell id="pre-scm1" value="Create folder structure&#xa;(ztp → 410-ha)" style="rounded=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="200" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="pre-scm2" value="Create ZTP-Default snippet&#xa;(loopback.900 service routes,&#xa;management DHCP)" style="rounded=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="162" width="200" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="pre-scm3" value="Create label groups&#xa;(region, HA-Group)&#xa;+ onboarding rule" style="rounded=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="236" width="200" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="pre-ztp" value="Register device(s) in ZTP portal&#xa;serial + claim key + region + HA-Group" style="rounded=1;fillColor=#006DCC;strokeColor=#004C99;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="236" width="200" height="56" as="geometry"/>
        </mxCell>

        <!-- Arrows within pre-boot -->
        <mxCell id="a-pre1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00294D;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="pre-scm1" target="pre-scm2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-pre2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00294D;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="pre-scm2" target="pre-scm3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══ DIVIDER ══════════════════════════════════════ -->
        <mxCell id="divider1" value="POWER ON DEVICES" style="text;html=1;fontStyle=1;fontSize=11;fontColor=#ef4444;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="310" width="840" height="24" as="geometry"/>
        </mxCell>

        <!-- STEP 1: Power on -->
        <mxCell id="s1-power" value="PA-410 powers on&#xa;(factory default / reset)" style="rounded=1;fillColor=#22c55e;strokeColor=#16a34a;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="348" width="200" height="52" as="geometry"/>
        </mxCell>

        <!-- STEP 2: DHCP -->
        <mxCell id="s2-dhcp" value="management + eth1/1&#xa;request DHCP from&#xa;provider switch" style="rounded=1;fillColor=#22c55e;strokeColor=#16a34a;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="200" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="a-s1s2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="s1-power" target="s2-dhcp" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decision: DHCP received? -->
        <mxCell id="d1-dhcp" value="DHCP on&#xa;both ports?" style="rhombus;fillColor=#FFB81C;strokeColor=#E5A300;fontColor=#00294D;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="496" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a-s2d1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="s2-dhcp" target="d1-dhcp" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- DHCP fail branch -->
        <mxCell id="err1" value="Check provider switch&#xa;DHCP scope and port&#xa;assignments" style="rounded=1;fillColor=#fef2f2;strokeColor=#ef4444;fontColor=#dc2626;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-d1-no" value="NO" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef4444;strokeWidth=1.5;fontStyle=1;fontColor=#ef4444;endArrow=block;endFill=1;" edge="1" source="d1-dhcp" target="err1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="576"/>
              <mxPoint x="140" y="626"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP 3: Contact ZTP portal -->
        <mxCell id="s3-ztp" value="Device contacts ZTP portal&#xa;stratacloudmanager&#xa;.paloaltonetworks.com&#xa;/ztpdeviceactivation" style="rounded=1;fillColor=#006DCC;strokeColor=#004C99;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="496" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a-d1-yes" value="YES" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2;fontStyle=1;fontColor=#16a34a;endArrow=block;endFill=1;" edge="1" source="d1-dhcp" target="s3-ztp" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="536"/>
              <mxPoint x="380" y="536"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Decision: Claim valid? -->
        <mxCell id="d2-claim" value="Serial + claim&#xa;key valid?" style="rhombus;fillColor=#FFB81C;strokeColor=#E5A300;fontColor=#00294D;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="295" y="600" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a-s3d2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#006DCC;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="s3-ztp" target="d2-claim" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Claim fail branch -->
        <mxCell id="err2" value="Check ZTP portal&#xa;registration — confirm&#xa;serial + claim key" style="rounded=1;fillColor=#fef2f2;strokeColor=#ef4444;fontColor=#dc2626;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="706" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-d2-no" value="NO" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef4444;strokeWidth=1.5;fontStyle=1;fontColor=#ef4444;endArrow=block;endFill=1;" edge="1" source="d2-claim" target="err2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="680"/>
              <mxPoint x="380" y="732"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP 4: Cert install + SCM connect -->
        <mxCell id="s4-cert" value="Device installs&#xa;device certificate&#xa;(auto via CSP)" style="rounded=1;fillColor=#22c55e;strokeColor=#16a34a;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="200" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="a-d2-yes" value="YES" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2;fontStyle=1;fontColor=#16a34a;endArrow=block;endFill=1;" edge="1" source="d2-claim" target="s4-cert" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="295" y="640"/>
              <mxPoint x="140" y="640"/>
              <mxPoint x="140" y="680"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP 5: Attempt SCM connection -->
        <mxCell id="s5-connect" value="Device connects to SCM&#xa;TCP 3978 (or 443)" style="rounded=1;fillColor=#22c55e;strokeColor=#16a34a;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="758" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-s4s5" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="s4-cert" target="s5-connect" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decision: SCM reachable? -->
        <mxCell id="d3-scm" value="SCM reachable&#xa;TCP 3978?" style="rhombus;fillColor=#FFB81C;strokeColor=#E5A300;fontColor=#00294D;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="832" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a-s5d3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="s5-connect" target="d3-scm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Port blocked error -->
        <mxCell id="err3" value="TCP 3978 blocked&#xa;upstream — check ISP&#xa;or configure port 443" style="rounded=1;fillColor=#fef2f2;strokeColor=#ef4444;fontColor=#dc2626;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-d3-no" value="NO" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef4444;strokeWidth=1.5;fontStyle=1;fontColor=#ef4444;endArrow=block;endFill=1;" edge="1" source="d3-scm" target="err3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="912"/>
              <mxPoint x="140" y="966"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP 6: Onboarding rule fires -->
        <mxCell id="s6-rule" value="Onboarding rule fires:&#xa;HA-Group label matches&#xa;→ place in 410-ha folder&#xa;→ apply ZTP-Default snippet" style="rounded=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="832" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a-d3-yes" value="YES" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2;fontStyle=1;fontColor=#16a34a;endArrow=block;endFill=1;" edge="1" source="d3-scm" target="s6-rule" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="872"/>
              <mxPoint x="630" y="872"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP 7: First config push -->
        <mxCell id="s7-push1" value="SCM pushes first config:&#xa;enables Advanced Routing&#xa;Engine → triggers reboot" style="rounded=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="940" width="220" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="a-s6s7" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00294D;strokeWidth:2;endArrow=block;endFill=1;" edge="1" source="s6-rule" target="s7-push1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- REBOOT 1 box -->
        <mxCell id="reboot1" value="⟳  AUTO REBOOT 1&#xa;Advanced Routing Engine" style="rounded=1;fillColor=#ef4444;strokeColor=#dc2626;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-s7r1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef4444;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=block;endFill=1;" edge="1" source="s7-push1" target="reboot1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="968"/>
              <mxPoint x="240" y="968"/>
              <mxPoint x="240" y="1036"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP 8: Reconnect + second push -->
        <mxCell id="s8-reconnect" value="Device reboots and&#xa;reconnects to SCM" style="rounded=1;fillColor=#22c55e;strokeColor=#16a34a;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1086" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-r1s8" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="reboot1" target="s8-reconnect" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 9: Second config push -->
        <mxCell id="s9-push2" value="SCM pushes full config:&#xa;loopback.900, service routes&#xa;via eth1/1, interfaces,&#xa;ZTP snippet configuration" style="rounded=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="1086" width="220" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="a-s8s9" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00294D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="s8-reconnect" target="s9-push2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="240" y="1112"/>
              <mxPoint x="520" y="1112"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Optional REBOOT 2 -->
        <mxCell id="reboot2" value="⟳  AUTO REBOOT 2&#xa;(if config requires restart)" style="rounded=1;fillColor=#f97316;strokeColor=#ea580c;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1182" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-s9r2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f97316;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=block;endFill=1;" edge="1" source="s9-push2" target="reboot2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="1122"/>
              <mxPoint x="240" y="1122"/>
              <mxPoint x="240" y="1208"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP 10: Bootstrap Done state -->
        <mxCell id="s10-done" value="Bootstrap Done ✓&#xa;Device Connected to SCM&#xa;Config: Out of Sync (expected)" style="rounded=1;fillColor=#006DCC;strokeColor=#004C99;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="1258" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-r2s10" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="reboot2" target="s10-done" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="1234"/>
              <mxPoint x="140" y="1290"/>
              <mxPoint x="280" y="1290"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- HA note -->
        <mxCell id="ha-note" value="HA Pair: both PA-410s go through&#xa;this flow independently and&#xa;simultaneously. Both must reach&#xa;Bootstrap Done before Phase 4." style="rounded=1;fillColor=#fff8e1;strokeColor=#FFB81C;fontColor=#E5A300;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="520" y="1258" width="320" height="64" as="geometry"/>
        </mxCell>

        <!-- Decision: Both connected? -->
        <mxCell id="d4-both" value="All device(s)&#xa;Connected in SCM?" style="rhombus;fillColor=#FFB81C;strokeColor=#E5A300;fontColor=#00294D;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="295" y="1350" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a-s10d4" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#006DCC;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="s10-done" target="d4-both" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Wait / timeout -->
        <mxCell id="wait-note" value="Wait up to 45 min.&#xa;If still not connected:&#xa;see Troubleshooting T-1" style="rounded=1;fillColor=#fef2f2;strokeColor=#ef4444;fontColor=#dc2626;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="1374" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-d4-no" value="NO" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef4444;strokeWidth=1.5;fontStyle=1;fontColor=#ef4444;endArrow=block;endFill=1;" edge="1" source="d4-both" target="wait-note" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="485" y="1395"/>
              <mxPoint x="620" y="1395"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- FINAL: Proceed to Phase 4 -->
        <mxCell id="end-node" value="✓  Phase 3 Complete&#xa;Proceed to Phase 4:&#xa;Management Interface &amp; HA Prep" style="rounded=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFB81C;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="1476" width="380" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-d4-yes" value="YES" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;strokeWidth=2.5;fontStyle=1;fontColor=#16a34a;endArrow=block;endFill=1;" edge="1" source="d4-both" target="end-node" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="1440"/>
              <mxPoint x="390" y="1476"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ══ LEGEND ════════════════════════════════════════ -->
        <mxCell id="leg-title" value="Legend" style="text;html=1;fontStyle=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="1580" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg-device" value="Device action" style="rounded=1;fillColor=#22c55e;strokeColor=#16a34a;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="1606" width="130" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="leg-cloud" value="Portal / network" style="rounded=1;fillColor=#006DCC;strokeColor=#004C99;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="175" y="1606" width="130" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="leg-scm" value="SCM action" style="rounded=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="1606" width="130" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="leg-decision" value="Decision" style="rhombus;fillColor=#FFB81C;strokeColor=#E5A300;fontColor=#00294D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="465" y="1598" width="90" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="leg-reboot" value="Auto reboot" style="rounded=1;fillColor=#ef4444;strokeColor=#dc2626;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="1606" width="120" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="leg-error" value="Error / check" style="rounded=1;fillColor=#fef2f2;strokeColor=#ef4444;fontColor=#dc2626;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="705" y="1606" width="120" height="28" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
