        <mxCell id="b4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=#8b5cf6;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="829.0" y="223.42857142857144" width="22" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="tt" value="What each check proves, and what a failure means" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="346" width="1000" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="h0" value="#" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="378" width="50" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="Check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="378" width="320" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Proves" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="378" width="420" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="A failure here means" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="378" width="590" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="r0c0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="406" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c1" value="Regional scan endpoint resolves and completes TLS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="406" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c2" value="This environment can reach the region your key belongs to" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="406" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c3" value="A namespace egress policy is the usual cause, and it is invisible from anywhere except inside." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="406" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c0" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="50" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="r1c1" value="Scan endpoint accepts the key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="450" width="320" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="r1c2" value="The key is valid and belongs to this region" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="450" width="420" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="r1c3" value="A 401 or 403 against a reachable endpoint usually means the key was created in a different region." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="450" width="590" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="r2c0" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="502" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c1" value="A scan returns a verdict" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="502" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c2" value="The profile exists, is bound to this key, and is evaluating content" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="502" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c3" value="A body with no action field means the profile name does not match Strata Cloud Manager exactly." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="502" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c0" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="546" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c1" value="Management host resolves" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="546" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c2" value="Keys and profiles can be managed through the API rather than the console" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="546" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c3" value="Not a blocker for scanning. Only matters if key management will be automated." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="546" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c0" value="&lt;b&gt;API keys are locked to the region they were created in&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="616" width="680" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c0b" value="A key made for one region will not authenticate against another&lt;br&gt;region’s endpoint, and the rejection looks exactly like a wrong key.&lt;br&gt;This costs more debugging time than any other single thing in&lt;br&gt;this pillar.&lt;br&gt;&lt;br&gt;Decide the region first, on data residency grounds, then create&lt;br&gt;keys in it. Correcting it later means reissuing every key." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="646" width="650" height="114" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Two APIs, two different credentials&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="616" width="680" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="The scan endpoint authenticates with an API key in an x-pan-token&lt;br&gt;header. The management endpoint authenticates with an OAuth&lt;br&gt;bearer token from a service account.&lt;br&gt;&lt;br&gt;They are not interchangeable, and presenting one to the other is a&lt;br&gt;common early confusion. You only need the second if keys and&lt;br&gt;profiles will be created programmatically." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="646" width="650" height="114" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
