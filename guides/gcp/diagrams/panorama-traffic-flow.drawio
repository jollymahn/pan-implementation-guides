<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="GCP Panorama Traffic Flow" id="gcp-panorama-traffic-flow">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:16px;color:#00294D;&quot;&gt;GCP Panorama &amp;harr; VM-Series Traffic Flow via VPC Peering&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1">
