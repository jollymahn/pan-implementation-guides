        <mxCell id="legend-port-table" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:10px;font-family:Helvetica;&quot;&gt;&lt;tr style=&quot;background:#00294D;color:#fff;&quot;&gt;&lt;td&gt;&lt;b&gt;Port&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Direction&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TCP/3978&lt;/td&gt;&lt;td&gt;FW &amp;rarr; Panorama&lt;/td&gt;&lt;td&gt;Device registration, config push, SW updates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TCP/28443&lt;/td&gt;&lt;td&gt;FW &amp;rarr; Panorama&lt;/td&gt;&lt;td&gt;Log forwarding to Panorama / CDL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TCP/443&lt;/td&gt;&lt;td&gt;Admin &amp;rarr; Panorama&lt;/td&gt;&lt;td&gt;Web UI management access&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TCP/22&lt;/td&gt;&lt;td&gt;Admin &amp;rarr; Panorama&lt;/td&gt;&lt;td&gt;SSH management access&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;HTTPS&lt;/td&gt;&lt;td&gt;Panorama &amp;rarr; Internet&lt;/td&gt;&lt;td&gt;Licensing, content/software updates&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
