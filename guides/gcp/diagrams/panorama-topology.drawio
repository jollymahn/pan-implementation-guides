<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="GCP Panorama Topology" id="gcp-panorama-topology">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:16px;color:#00294D;&quot;&gt;GCP Panorama Standalone Deployment&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="10" width="360" height="30" as="geometry"/>
        </mxCell>

        <!-- Internet -->
        <mxCell id="internet" value="&lt;b&gt;Internet&lt;/b&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="440" y="50" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- VPC Network -->
        <mxCell id="firewall-vpc" value="&lt;b style=&quot;font-size:13px;&quot;&gt;firewall-vpc&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=none;strokeColor=#4285F4;strokeWidth=2;verticalAlign=top;fontSize=13;fontFamily=Helvetica;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="160" y="180" width="720" height="460" as="geometry"/>
        </mxCell>

        <!-- Internet to VPC -->
        <mxCell id="inet-vpc" style="endArrow=block;startArrow=block;html=1;strokeColor=#4285F4;strokeWidth=2;endFill=1;startFill=1;" edge="1" parent="1" source="internet" target="firewall-vpc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- GCP Firewall Rules label -->
        <mxCell id="fw-rules-label" value="&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px;&quot;&gt;&#x1f525; GCP Firewall Rules&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="180" y="205" width="155" height="25" as="geometry"/>
        </mxCell>

        <!-- Panorama Subnet -->
        <mxCell id="pan-subnet" value="&lt;b&gt;panorama-subnet&lt;/b&gt;&lt;br&gt;172.21.21.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;fontSize=11;fontFamily=Helvetica;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="280" y="250" width="480" height="350" as="geometry"/>
        </mxCell>

        <!-- Panorama Instance Box -->
        <mxCell id="pan-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FFB81C;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="310" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="pan-label" value="&lt;b style=&quot;color:#00294D;font-size:14px;&quot;&gt;Panorama&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Compute Engine Instance&lt;br&gt;Private IP: 172.21.21.2&lt;br&gt;External IP: (optional)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="410" y="318" width="180" height="75" as="geometry"/>
        </mxCell>

        <!-- Boot disk -->
        <mxCell id="boot-disk" value="&lt;b&gt;Boot Disk&lt;/b&gt;&lt;br&gt;PAN-OS Image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#3b82f6;strokeWidth=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="470" y="460" width="100" height="45" as="geometry"/>
