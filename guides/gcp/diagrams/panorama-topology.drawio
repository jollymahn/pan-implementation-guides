        <!-- GCP Firewall Rules Table -->
        <mxCell id="fw-rules-table" value="&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:10px;font-family:Helvetica;&quot;&gt;&lt;tr style=&quot;background:#00294D;color:#fff;&quot;&gt;&lt;td&gt;&lt;b&gt;Rule Name&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Port&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Source&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;allow-ssh&lt;/td&gt;&lt;td&gt;TCP/22&lt;/td&gt;&lt;td&gt;Admin CIDR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;allow-https&lt;/td&gt;&lt;td&gt;TCP/443&lt;/td&gt;&lt;td&gt;Admin CIDR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;allow-mgmt&lt;/td&gt;&lt;td&gt;TCP/3978&lt;/td&gt;&lt;td&gt;FW mgmt CIDR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;allow-iap&lt;/td&gt;&lt;td&gt;TCP/22,443&lt;/td&gt;&lt;td&gt;35.235.240.0/20&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#E5A300;fillColor=none;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="320" width="180" height="100" as="geometry"/>
