        <!-- IAP callout -->
        <mxCell id="iap-callout" value="&lt;font style=&quot;font-size:10px;color:#666666;&quot;&gt;&lt;i&gt;Optional: Use IAP tunnel&lt;br&gt;instead of external IP&lt;br&gt;(set attach_public_ip = false)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#CCCCCC;strokeWidth=1;dashed=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="530" width="190" height="50" as="geometry"/>
