          <mxGeometry x="370" y="1306" width="90" height="52" as="geometry"/>
        </mxCell>

        <!-- Invoke skill (right of diamond) -->
        <mxCell id="ph6-invoke" value="&lt;b&gt;Invoke Skill&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666&quot;&gt;Content loads into context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontFamily=Lato;fontSize=10;fontColor=#333;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="1310" width="160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="arr-skill-yes" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#22c55e;strokeWidth=1.5;fontFamily=Lato;fontSize=9;fontColor=#22c55e;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="ph6-skill" target="ph6-invoke" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decide & Act -->
        <mxCell id="ph6-decide" value="&lt;b&gt;Decide &amp; Act&lt;/b&gt; — &lt;font style=&quot;font-size:10px;color:#ccc&quot;&gt;Generate text and/or tool calls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#001a33;fontFamily=Lato;fontSize=11;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="325" y="1384" width="310" height="38" as="geometry"/>
        </mxCell>

        <!-- Skill No → Decide -->
        <mxCell id="arr-skill-no" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#999;strokeWidth=1.5;fontFamily=Lato;fontSize=9;fontColor=#999;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ph6-skill" target="ph6-decide" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Invoke → Decide -->
        <mxCell id="arr-invoke-decide" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#00294D;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=1;entryY=0;" edge="1" source="ph6-invoke" target="ph6-decide" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="1365"/>
              <mxPoint x="635" y="1365"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Output type diamond -->
        <mxCell id="ph6-output" value="&lt;b&gt;Output&lt;br&gt;type?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;fontFamily=Lato;fontSize=10;fontColor=#333;shadow=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="1440" width="100" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="arr-decide-output" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#00294D;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ph6-decide" target="ph6-output" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- SPLIT: TEXT (left) vs TOOL CALL (right)         -->
        <!-- ═══════════════════════════════════════════════ -->

        <!-- Text → Phase 8 (LEFT) -->
        <mxCell id="arr-text-ph8" value="Text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#006DCC;strokeWidth=2;fontFamily=Lato;fontSize=10;fontColor=#006DCC;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="ph6-output" target="ph8-ctr" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="1468"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Tool Call → Phase 7 (RIGHT) -->
        <mxCell id="arr-tool-ph7" value="Tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#006DCC;strokeWidth=2;fontFamily=Lato;fontSize=10;fontColor=#006DCC;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="ph6-output" target="ph7-ctr" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="1468"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- PHASE 8: OUTPUT (left side)                     -->
        <!-- ═══════════════════════════════════════════════ -->
        <mxCell id="ph8-ctr" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#FFB81C;strokeWidth=2;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="1530" width="290" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="ph8-title" value="&lt;b&gt;PHASE 8: OUTPUT&lt;/b&gt;" style="text;html=1;fontSize=12;fontFamily=Lato;fontColor=#E5A300;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="63" y="1534" width="200" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="ph8-display" value="&lt;b&gt;Display to user&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;Rendered markdown in terminal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB81C;strokeColor=#E5A300;fontFamily=Lato;fontSize=11;fontColor=#00294D;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="95" y="1564" width="210" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="ph8-hooks" value="&lt;b&gt;Post-response hooks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Notification / logging hooks fire&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B68EE;strokeColor=#5B4ACE;fontFamily=Lato;fontSize=10;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="105" y="1624" width="190" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="arr-disp-hooks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#00294D;strokeWidth=1.5;" edge="1" source="ph8-display" target="ph8-hooks" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="ph8-done" value="&lt;b&gt;Done — awaiting&lt;br&gt;next prompt&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#001a33;fontFamily=Lato;fontSize=11;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="125" y="1688" width="150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="arr-hooks-done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#00294D;strokeWidth=1.5;" edge="1" source="ph8-hooks" target="ph8-done" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- PHASE 7: TOOL EXECUTION LOOP (right side)       -->
        <!-- ═══════════════════════════════════════════════ -->
        <mxCell id="ph7-ctr" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="1530" width="360" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="ph7-title" value="&lt;b&gt;PHASE 7: TOOL EXECUTION&lt;/b&gt;" style="text;html=1;fontSize=12;fontFamily=Lato;fontColor=#22c55e;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="478" y="1534" width="240" height="20" as="geometry"/>
        </mxCell>

        <!-- Pre-tool hook -->
        <mxCell id="ph7-pre" value="&lt;b&gt;PreToolUse hook&lt;/b&gt; — &lt;font style=&quot;font-size:9px&quot;&gt;can modify / block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B68EE;strokeColor=#5B4ACE;fontFamily=Lato;fontSize=10;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="1564" width="230" height="34" as="geometry"/>
        </mxCell>

        <!-- Permission check -->
        <mxCell id="ph7-perm" value="&lt;b&gt;Permission&lt;br&gt;check&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontFamily=Lato;fontSize=10;fontColor=#333;shadow=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="1616" width="90" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="arr-pre-perm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#00294D;strokeWidth=1.5;" edge="1" source="ph7-pre" target="ph7-perm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- User approve (right of permission) -->
        <mxCell id="ph7-approve" value="&lt;b&gt;User&lt;br&gt;approves?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontFamily=Lato;fontSize=9;fontColor=#333;shadow=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="1620" width="80" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="arr-perm-approve" value="Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f59e0b;strokeWidth=1.5;fontFamily=Lato;fontSize=9;fontColor=#f59e0b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="ph7-perm" target="ph7-approve" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Execute tool -->
        <mxCell id="ph7-exec" value="&lt;b&gt;Execute Tool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666&quot;&gt;Read / Edit / Bash / Agent / Write / MCP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontFamily=Lato;fontSize=11;fontColor=#333;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="1714" width="250" height="40" as="geometry"/>
        </mxCell>

        <!-- Auto-allowed → Execute -->
        <mxCell id="arr-auto-exec" value="Auto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#22c55e;strokeWidth=1.5;fontFamily=Lato;fontSize=9;fontColor=#22c55e;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ph7-perm" target="ph7-exec" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="615" y="1690"/>
              <mxPoint x="645" y="1690"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Approved → Execute -->
        <mxCell id="arr-yes-exec" value="&#10003;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#22c55e;strokeWidth=1.5;fontFamily=Lato;fontSize=10;fontColor=#22c55e;exitX=0.5;exitY=1;entryX=1;entryY=0;" edge="1" source="ph7-approve" target="ph7-exec" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="1695"/>
              <mxPoint x="770" y="1695"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Denied → exits right to loop back -->
        <mxCell id="ph7-denied" value="&lt;font style=&quot;font-size:9px;color:#ef4444&quot;&gt;&#10007; Denied&lt;br&gt;(adjust approach)&lt;/font&gt;" style="text;html=1;fontFamily=Lato;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="1610" width="90" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="arr-deny" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=1.5;exitX=1;exitY=0.5;fontFamily=Lato;fontSize=9;fontColor=#ef4444;" edge="1" source="ph7-approve" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="1643" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Post-tool hook -->
        <mxCell id="ph7-post" value="&lt;b&gt;PostToolUse hook&lt;/b&gt; — &lt;font style=&quot;font-size:9px&quot;&gt;log, notify, validate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B68EE;strokeColor=#5B4ACE;fontFamily=Lato;fontSize=10;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="1776" width="230" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="arr-exec-post" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#00294D;strokeWidth=1.5;" edge="1" source="ph7-exec" target="ph7-post" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Loop label inside Phase 7 -->
        <mxCell id="ph7-loop-label" value="&lt;font style=&quot;font-size:10px;color:#006DCC&quot;&gt;&#10227; Result &#8594; reassemble context &#8594; next API turn&lt;/font&gt;" style="text;html=1;fontFamily=Lato;align=center;" vertex="1" parent="1">
          <mxGeometry x="490" y="1860" width="310" height="18" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- LOOP BACK ARROW (RIGHT SIDE)                    -->
        <!-- Runs along the right edge, from Phase 7 back   -->
        <!-- up to Phase 3. No crossings.                    -->
        <!-- ═══════════════════════════════════════════════ -->
        <mxCell id="arr-loop-back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#006DCC;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="1793" as="sourcePoint"/>
            <mxPoint x="770" y="688" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="880" y="1793"/>
              <mxPoint x="880" y="688"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Loop arrow label -->
        <mxCell id="loop-label-right" value="&lt;font style=&quot;font-size:10px;color:#006DCC&quot;&gt;Tool result &#8594;&lt;br&gt;next API turn&lt;br&gt;(via AIRS)&lt;/font&gt;" style="text;html=1;fontFamily=Lato;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="888" y="1150" width="90" height="40" as="geometry"/>
        </mxCell>

        <!-- Denied also loops back (joins the same right-side path) -->
        <mxCell id="arr-denied-loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=1.5;dashed=1;dashPattern=6 3;endArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="1643" as="sourcePoint"/>
            <mxPoint x="880" y="1643" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="denied-joins-label" value="&lt;font style=&quot;font-size:9px;color:#ef4444&quot;&gt;(joins loop)&lt;/font&gt;" style="text;html=1;fontFamily=Lato;align=left;" vertex="1" parent="1">
          <mxGeometry x="888" y="1635" width="70" height="14" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- AIRS INSPECTION ZONE — dashed boundary          -->
        <!-- Wraps Phases 3, 4, 5 to show everything in     -->
        <!-- between Claude Code and Claude API is scanned   -->
        <!-- ═══════════════════════════════════════════════ -->
        <mxCell id="airs-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FA582D;strokeWidth=3;dashed=1;dashPattern=8 4;opacity=25;" vertex="1" parent="1">
          <mxGeometry x="215" y="588" width="570" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="airs-zone-label" value="&lt;b style=&quot;font-size:11px;color:#FA582D&quot;&gt;PRISMA AIRS INSPECTION ZONE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#999&quot;&gt;All traffic between Claude Code &#8596; Claude API passes through AIRS&lt;/font&gt;" style="text;html=1;fontFamily=Lato;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="1248" width="340" height="26" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- BOTTOM NOTE                                     -->
        <!-- ═══════════════════════════════════════════════ -->
        <mxCell id="loop-note" value="&lt;font style=&quot;font-size:10px;color:#006DCC&quot;&gt;&#10227; Tool loop repeats until final text response. Each API round-trip passes through AIRS both ways.&lt;/font&gt;" style="text;html=1;fontFamily=Lato;align=center;verticalAlign=middle;rounded=1;fillColor=#e7f3ff;strokeColor=#3b82f6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="270" y="1940" width="460" height="30" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
