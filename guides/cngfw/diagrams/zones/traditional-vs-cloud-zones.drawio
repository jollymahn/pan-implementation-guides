<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="Traditional PAN-OS vs Cloud NGFW Zones" id="trad-vs-cloud-zones">
    <mxGraphModel dx="1100" dy="680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ── Title ──────────────────────────────────────────── -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:16px;color:#00294D;&quot;&gt;Security Zones: Traditional PAN-OS vs Cloud NGFW&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="10" width="640" height="30" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════════════════ -->
        <!--  LEFT SIDE: Traditional PAN-OS                         -->
        <!-- ══════════════════════════════════════════════════════ -->
        <mxCell id="trad-container" value="&lt;b&gt;Traditional PAN-OS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;fontSize=14;fontFamily=Helvetica;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="30" y="55" width="500" height="590" as="geometry"/>
        </mxCell>

        <!-- Firewall box -->
        <mxCell id="trad-fw-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="185" y="190" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="trad-fw-label" value="&lt;b&gt;PA-Series / VM-Series&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="200" y="205" width="160" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="trad-fw-icon" value="&#x1f6e1;&#xfe0f;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="260" y="228" width="40" height="30" as="geometry"/>
        </mxCell>

        <!-- Trust zone (green) -->
        <mxCell id="trad-trust" value="&lt;b&gt;Trust Zone&lt;/b&gt;&lt;br&gt;eth1/2 — 10.0.1.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="100" width="180" height="55" as="geometry"/>
        </mxCell>

        <!-- Untrust zone (gold) -->
        <mxCell id="trad-untrust" value="&lt;b&gt;Untrust Zone&lt;/b&gt;&lt;br&gt;eth1/1 — 203.0.113.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="325" y="100" width="185" height="55" as="geometry"/>
        </mxCell>

        <!-- DMZ zone (blue) -->
        <mxCell id="trad-dmz" value="&lt;b&gt;DMZ Zone&lt;/b&gt;&lt;br&gt;eth1/3 — 10.0.2.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#006DCC;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="185" y="310" width="190" height="50" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="trad-trust-fw" style="endArrow=block;startArrow=block;html=1;strokeColor=#22c55e;strokeWidth=2;endFill=1;startFill=1;" edge="1" parent="1" source="trad-trust" target="trad-fw-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="trad-untrust-fw" style="endArrow=block;startArrow=block;html=1;strokeColor=#E5A300;strokeWidth=2;endFill=1;startFill=1;" edge="1" parent="1" source="trad-untrust" target="trad-fw-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="trad-dmz-fw" style="endArrow=block;startArrow=block;html=1;strokeColor=#006DCC;strokeWidth=2;endFill=1;startFill=1;" edge="1" parent="1" source="trad-dmz" target="trad-fw-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Key points -->
        <mxCell id="trad-bullet1" value="&lt;b&gt;1:1 mapping&lt;/b&gt; — each physical/logical interface&#xa;is bound to exactly one zone" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="390" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="trad-bullet2" value="&lt;b&gt;Interzone default = DENY&lt;/b&gt; — traffic between&#xa;zones is dropped unless a policy rule allows it" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="435" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="trad-bullet3" value="&lt;b&gt;Intrazone default = ALLOW&lt;/b&gt; — traffic within the&#xa;same zone is permitted (configurable)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="480" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="trad-bullet4" value="&lt;b&gt;Custom zones&lt;/b&gt; — create as many zones as needed&#xa;(e.g., trust, untrust, dmz, mgmt, db)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="525" width="270" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="trad-bullet5" value="&lt;b&gt;Policy uses zone pairs&lt;/b&gt; — rules specify&#xa;source zone → destination zone" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="55" y="570" width="240" height="40" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════════════════ -->
        <!--  RIGHT SIDE: Cloud NGFW                                -->
        <!-- ══════════════════════════════════════════════════════ -->
        <mxCell id="cloud-container" value="&lt;b&gt;Cloud NGFW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;fontSize=14;fontFamily=Helvetica;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="570" y="55" width="500" height="590" as="geometry"/>
        </mxCell>

        <!-- Cloud NGFW box -->
        <mxCell id="cloud-fw-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="735" y="190" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-fw-label" value="&lt;b&gt;Cloud NGFW&lt;/b&gt;&lt;br&gt;(managed service)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="755" y="195" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-fw-icon" value="&#x1f6e1;&#xfe0f;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="800" y="228" width="40" height="30" as="geometry"/>
        </mxCell>

        <!-- No physical interfaces -->
        <mxCell id="cloud-no-intf" value="&lt;font color=&quot;#999999&quot;&gt;&lt;i&gt;No physical interfaces&lt;br&gt;No interface-to-zone binding&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="745" y="105" width="180" height="40" as="geometry"/>
        </mxCell>

        <!-- Cloud abstractions -->
        <mxCell id="cloud-gwlb" value="&lt;b&gt;AWS&lt;/b&gt;: GWLB endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ff9900;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="600" y="310" width="150" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-subnet" value="&lt;b&gt;Azure&lt;/b&gt;: Delegated subnets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078d4;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="890" y="310" width="155" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-gwlb-fw" style="endArrow=block;startArrow=block;html=1;strokeColor=#ff9900;strokeWidth=1;endFill=1;startFill=1;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="cloud-gwlb" target="cloud-fw-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-subnet-fw" style="endArrow=block;startArrow=block;html=1;strokeColor=#0078d4;strokeWidth=1;endFill=1;startFill=1;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="cloud-subnet" target="cloud-fw-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Key points -->
        <mxCell id="cloud-bullet1" value="&lt;b&gt;No interface binding&lt;/b&gt; — Cloud NGFW has no&#xa;physical/logical interfaces to map zones to" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="600" y="390" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-bullet2" value="&lt;b&gt;Zone behavior varies by platform&lt;/b&gt;:&#xa;AWS = no zones, Azure = depends on mgmt mode" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="600" y="435" width="300" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-bullet3" value="&lt;b&gt;Rules typically use any/any zones&lt;/b&gt; — traffic&#xa;direction determined by IP ranges or prefix lists" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="600" y="480" width="310" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-bullet4" value="&lt;b&gt;Exception: Azure + Panorama&lt;/b&gt; — uses&#xa;pre-defined public/private zones (not custom)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="600" y="525" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-bullet5" value="&lt;b style=&quot;color:#ef4444;&quot;&gt;⚠ Intrazone-default = ALLOW&lt;/b&gt; (Azure/Panorama)&#xa;— must override to DENY immediately" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="600" y="570" width="310" height="40" as="geometry"/>
        </mxCell>

        <!-- Divider arrow -->
        <mxCell id="divider-arrow" style="endArrow=block;html=1;strokeColor=#00294D;strokeWidth=3;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="330" as="sourcePoint"/>
            <mxPoint x="560" y="330" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="divider-label" value="&lt;b style=&quot;color:#00294D;&quot;&gt;Cloud&#xa;Abstraction&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="527" y="275" width="80" height="40" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
