        <!-- ============================================ -->
        <mxCell id="diagram-title" value="&lt;font style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;DNS Proxy + DNS Security — Cloud NGFW for Azure&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
