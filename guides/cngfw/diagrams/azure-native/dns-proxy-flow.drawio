        </mxCell>
        <mxCell id="cngfw-label" value="&lt;b&gt;Cloud NGFW&lt;/b&gt;&lt;br&gt;10.100.0.196" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="462" y="72" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cngfw-icon" value="&#x1f6e1;&#xfe0f;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="507" y="108" width="46" height="36" as="geometry"/>
        </mxCell>

        <!-- DNS Proxy callout box -->
        <mxCell id="dns-proxy-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="370" y="195" width="150" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="dns-proxy-label" value="&lt;b&gt;DNS Proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Intercepts DNS queries&lt;br&gt;on port 53&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="380" y="197" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- DNS Security callout box -->
        <mxCell id="dns-security-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#f59e0b;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="195" width="160" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="dns-security-label" value="&lt;b&gt;DNS Security&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Threat Intelligence Check&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="575" y="198" width="150" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="dns-security-categories" value="&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:10px;font-family:Helvetica;&quot;&gt;&lt;tr style=&quot;background:#f59e0b;color:#fff;&quot;&gt;&lt;td colspan=&quot;2&quot;&gt;&lt;b&gt;Categories&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C2&lt;/td&gt;&lt;td&gt;Malware&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Phishing&lt;/td&gt;&lt;td&gt;DGA&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="585" y="245" width="110" height="65" as="geometry"/>
        </mxCell>

        <!-- Arrow: Cloud NGFW to DNS Proxy -->
        <mxCell id="cngfw-to-proxy" style="endArrow=block;html=1;strokeColor=#3b82f6;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="150" as="sourcePoint"/>
            <mxPoint x="445" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Arrow: DNS Proxy to DNS Security -->
        <mxCell id="proxy-to-security" style="endArrow=block;html=1;strokeColor=#f59e0b;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="227" as="sourcePoint"/>
            <mxPoint x="560" y="227" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ============================================ -->
        <!-- DECISION: SAFE vs MALICIOUS                  -->
        <!-- ============================================ -->

        <!-- Decision diamond -->
        <mxCell id="decision" value="&lt;b&gt;Safe?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="470" y="355" width="80" height="60" as="geometry"/>
        </mxCell>

        <!-- Arrow: DNS Security to Decision -->
        <mxCell id="security-to-decision" style="endArrow=block;html=1;strokeColor=#333333;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="315" as="sourcePoint"/>
            <mxPoint x="540" y="370" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="640" y="370"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ============================================ -->
        <!-- SAFE PATH (green) — right, then to Azure DNS -->
        <!-- ============================================ -->

        <!-- Azure DNS box (right side) -->
        <mxCell id="azure-dns-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#006DCC;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="930" y="185" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="azure-dns-label" value="&lt;b&gt;Azure DNS&lt;/b&gt;&lt;br&gt;168.63.129.16" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="950" y="198" width="110" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrow: Decision YES to Azure DNS -->
        <mxCell id="safe-to-dns" value="&lt;font color=&quot;#22c55e&quot; style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;YES — Forward&lt;/b&gt;&lt;/font&gt;" style="endArrow=block;html=1;strokeColor=#22c55e;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint x="550" y="375" as="sourcePoint"/>
            <mxPoint x="930" y="230" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="790" y="375"/>
              <mxPoint x="870" y="290"/>
            </Array>
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Green response arrow: Azure DNS back to Spoke VM -->
        <mxCell id="dns-response-safe" value="" style="endArrow=block;html=1;strokeColor=#22c55e;strokeWidth=3;endFill=1;curved=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="245" as="sourcePoint"/>
            <mxPoint x="165" y="195" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="700" y="480"/>
              <mxPoint x="350" y="490"/>
              <mxPoint x="200" y="400"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="safe-response-label" value="&lt;font color=&quot;#22c55e&quot; style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Resolved IP returned&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="320" y="488" width="150" height="25" as="geometry"/>
        </mxCell>

        <!-- ============================================ -->
        <!-- MALICIOUS PATH (red) — sinkhole back to VM  -->
        <!-- ============================================ -->

        <!-- Sinkhole box -->
        <mxCell id="sinkhole-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="430" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sinkhole-label" value="&lt;font color=&quot;#ef4444&quot;&gt;&lt;b&gt;Sinkhole Response&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Returns non-routable IP&lt;br&gt;(e.g., 72.5.65.111)&lt;/font&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="348" y="430" width="165" height="60" as="geometry"/>
        </mxCell>

        <!-- Arrow: Decision NO to Sinkhole -->
        <mxCell id="malicious-to-sinkhole" value="&lt;font color=&quot;#ef4444&quot; style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;NO — Block&lt;/b&gt;&lt;/font&gt;" style="endArrow=block;html=1;strokeColor=#ef4444;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="490" y="415" as="sourcePoint"/>
            <mxPoint x="450" y="430" as="targetPoint"/>
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Red arrow: Sinkhole response back to VM -->
        <mxCell id="sinkhole-to-vm" value="" style="endArrow=block;html=1;strokeColor=#ef4444;strokeWidth=3;endFill=1;dashed=1;dashPattern=8 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="460" as="sourcePoint"/>
            <mxPoint x="155" y="260" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="200" y="430"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sinkhole-response-label" value="&lt;font color=&quot;#ef4444&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Connection blocked&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="165" y="395" width="130" height="25" as="geometry"/>
        </mxCell>

        <!-- ============================================ -->
        <!-- FLOW ARROWS (numbered steps)                 -->
        <!-- ============================================ -->

        <!-- Arrow 1: VM sends DNS query to Cloud NGFW -->
        <mxCell id="flow-vm-to-cngfw" style="endArrow=block;html=1;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 4;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="165" y="185" as="sourcePoint"/>
            <mxPoint x="430" y="110" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="300" y="145"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-vm-label" value="&lt;font style=&quot;font-size:10px;&quot;&gt;DNS query (port 53)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="245" y="120" width="130" height="25" as="geometry"/>
        </mxCell>

        <!-- ============================================ -->
        <!-- STEP NUMBER BADGES                           -->
        <!-- ============================================ -->

        <!-- Step 1: VM sends DNS query -->
        <mxCell id="step1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="190" y="145" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 2: Query arrives at Cloud NGFW -->
        <mxCell id="step2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="398" y="90" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 3: DNS Proxy intercepts -->
        <mxCell id="step3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="195" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 4: DNS Security checks -->
        <mxCell id="step4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;strokeColor=none;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="195" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 5a: Safe — forward to Azure DNS -->
        <mxCell id="step5a" value="5a" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="890" y="185" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 5b: Malicious — sinkhole -->
        <mxCell id="step5b" value="5b" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef4444;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="505" y="430" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- ============================================ -->
        <!-- LEGEND at bottom-right                       -->
        <!-- ============================================ -->
        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="420" width="240" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="legend-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="840" y="425" width="60" height="25" as="geometry"/>
        </mxCell>

        <!-- Legend: Green = allowed -->
        <mxCell id="legend-green-line" style="endArrow=block;html=1;strokeColor=#22c55e;strokeWidth=3;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="845" y="467" as="sourcePoint"/>
            <mxPoint x="895" y="467" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-green-text" value="&lt;font style=&quot;font-size:11px;&quot;&gt;Safe — resolved response&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="900" y="455" width="160" height="25" as="geometry"/>
        </mxCell>

        <!-- Legend: Red = blocked -->
        <mxCell id="legend-red-line" style="endArrow=block;html=1;strokeColor=#ef4444;strokeWidth=3;endFill=1;dashed=1;dashPattern=8 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="845" y="497" as="sourcePoint"/>
            <mxPoint x="895" y="497" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-red-text" value="&lt;font style=&quot;font-size:11px;&quot;&gt;Malicious — sinkhole&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="900" y="485" width="140" height="25" as="geometry"/>
        </mxCell>

        <!-- Legend: Black dashed = DNS query -->
        <mxCell id="legend-black-line" style="endArrow=block;html=1;strokeColor=#000000;strokeWidth=2;endFill=1;dashed=1;dashPattern=8 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="845" y="527" as="sourcePoint"/>
            <mxPoint x="895" y="527" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-black-text" value="&lt;font style=&quot;font-size:11px;&quot;&gt;DNS query flow&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="900" y="515" width="110" height="25" as="geometry"/>
        </mxCell>

        <!-- ============================================ -->
