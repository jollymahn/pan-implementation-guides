<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Target Types" id="airs-red-target-types">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1110" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Three target types, and what each one can connect with" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="The type is the first choice in the wizard and the one that shapes everything after it: which connection methods appear, whether the background fields are mandatory, and whether Agentic Profiling runs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ APPLICATION ============ -->
        <mxCell id="app" value="&lt;b style=&quot;font-size:15px&quot;&gt;APPLICATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=center;spacingTop=12;fontSize=15;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="440" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="app-b" value="&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;A chatbot, a copilot, a RAG application: something&lt;br&gt;an AI model answers through, with a front end&lt;br&gt;and a prompt of its own.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Connection methods&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:11px&quot;&gt;REST&#160;&#160;&#183;&#160;&#160;STREAMING&#160;&#160;&#183;&#160;&#160;WEBSOCKET&#160;&#160;&#183;&#160;&#160;CUSTOM&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Background fields&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;mandatory&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Industry, use case, competitors. They are what make&lt;br&gt;the attacks realistic rather than generic.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Agentic Profiling&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#666666&quot;&gt;does not run&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Everything the attack agent knows about this target&lt;br&gt;is what you typed into the profile.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="62" y="136" width="396" height="280" as="geometry"/>
        </mxCell>

        <!-- ============ AGENT ============ -->
        <mxCell id="agt" value="&lt;b style=&quot;font-size:15px&quot;&gt;AGENT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#006DCC;strokeWidth=2;verticalAlign=top;align=center;spacingTop=12;fontSize=15;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="510" y="100" width="440" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="agt-b" value="&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;Something that chooses its own tools and&lt;br&gt;sequences its own actions. The tool surface is the&lt;br&gt;attack surface, which is why this type exists.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Connection methods&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:11px&quot;&gt;REST&#160;&#160;&#183;&#160;&#160;STREAMING&#160;&#160;&#183;&#160;&#160;WEBSOCKET&#160;&#160;&#183;&#160;&#160;CUSTOM&lt;br&gt;MS_COPILOT_STUDIO&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Background fields&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;mandatory&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Same three fields as an Application.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Agentic Profiling&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#22c55e&quot;&gt;runs after validation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Probing conversations map the capabilities, the&lt;br&gt;system prompt, and the tools, into a read-only&lt;br&gt;System Capabilities section of the profile.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="532" y="136" width="396" height="280" as="geometry"/>
        </mxCell>

        <!-- ============ MODEL ============ -->
        <mxCell id="mdl" value="&lt;b style=&quot;font-size:15px&quot;&gt;MODEL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;verticalAlign=top;align=center;spacingTop=12;fontSize=15;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="980" y="100" width="440" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="mdl-b" value="&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;A raw inference endpoint with no application&lt;br&gt;around it. You are testing the model as shipped,&lt;br&gt;without a system prompt or a guardrail in front.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Connection methods&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:11px&quot;&gt;OPENAI&#160;&#160;&#183;&#160;&#160;HUGGING_FACE&lt;br&gt;DATABRICKS&#160;&#160;&#183;&#160;&#160;BEDROCK&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Background fields&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#22c55e&quot;&gt;optional&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;There is no business context to describe, so the&lt;br&gt;wizard does not insist on one.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Agentic Profiling&lt;/b&gt;&#160;&#160;&lt;font style=&quot;color:#666666&quot;&gt;does not run&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Nothing to profile: no tools, no instructions.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1002" y="136" width="396" height="280" as="geometry"/>
        </mxCell>

        <!-- ============ CONNECTION TABLE ============ -->
        <mxCell id="ct-title" value="Connection methods in full" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="452" width="900" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="h1" value="Connection method" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="484" width="230" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Target type" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="484" width="170" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="Authentication" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="484" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h4" value="What you provide, and what to watch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="484" width="700" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="r1a" value="REST" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="230" height="34" as="geometry"/></mxCell>
        <mxCell id="r1b" value="Application, Agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="514" width="170" height="34" as="geometry"/></mxCell>
        <mxCell id="r1c" value="Headers, Basic, OAuth 2.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="514" width="280" height="34" as="geometry"/></mxCell>
        <mxCell id="r1d" value="Endpoint URL, plus the request and response templates. The default choice, and the one both bridges present" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="514" width="700" height="34" as="geometry"/></mxCell>

        <mxCell id="r2a" value="STREAMING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="548" width="230" height="34" as="geometry"/></mxCell>
        <mxCell id="r2b" value="Application, Agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="548" width="170" height="34" as="geometry"/></mxCell>
        <mxCell id="r2c" value="Headers, Basic, OAuth 2.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="548" width="280" height="34" as="geometry"/></mxCell>
        <mxCell id="r2d" value="Endpoint URL and the SSE configuration. For text/event-stream or application/x-ndjson responses" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="548" width="700" height="34" as="geometry"/></mxCell>

        <mxCell id="r3a" value="WEBSOCKET" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="582" width="230" height="42" as="geometry"/></mxCell>
        <mxCell id="r3b" value="Application, Agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="582" width="170" height="42" as="geometry"/></mxCell>
        <mxCell id="r3c" value="Headers, Basic. &lt;font style=&quot;color:#ef4444&quot;&gt;No OAuth 2.0&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="582" width="280" height="42" as="geometry"/></mxCell>
        <mxCell id="r3d" value="WebSocket URL and the message format. Natively supported, so no wrapper is needed, but see the limitation below before promising multi-turn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="582" width="700" height="42" as="geometry"/></mxCell>

        <mxCell id="r4a" value="CUSTOM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="624" width="230" height="42" as="geometry"/></mxCell>
        <mxCell id="r4b" value="Application, Agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="624" width="170" height="42" as="geometry"/></mxCell>
        <mxCell id="r4c" value="Whatever your script implements" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="624" width="280" height="42" as="geometry"/></mxCell>
        <mxCell id="r4d" value="A Python adapter script, running in the adapter sidecar. Needs a Network Channel at v1.4.0 or higher with the sidecar enabled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="624" width="700" height="42" as="geometry"/></mxCell>

        <mxCell id="r5a" value="MS_COPILOT_STUDIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="666" width="230" height="42" as="geometry"/></mxCell>
        <mxCell id="r5b" value="Agent only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="666" width="170" height="42" as="geometry"/></mxCell>
        <mxCell id="r5c" value="Microsoft delegated auth, through an Entra ID app registration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="666" width="280" height="42" as="geometry"/></mxCell>
        <mxCell id="r5d" value="Schema Name from Settings, Advanced, Metadata. Setup needs an interactive login, so book someone with access to both tenants" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="666" width="700" height="42" as="geometry"/></mxCell>

        <mxCell id="r6a" value="OPENAI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="230" height="32" as="geometry"/></mxCell>
        <mxCell id="r6b" value="Model only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="708" width="170" height="32" as="geometry"/></mxCell>
        <mxCell id="r6c" value="API key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="708" width="280" height="32" as="geometry"/></mxCell>
        <mxCell id="r6d" value="api_key and model_name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="708" width="700" height="32" as="geometry"/></mxCell>

        <mxCell id="r7a" value="HUGGING_FACE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="230" height="32" as="geometry"/></mxCell>
        <mxCell id="r7b" value="Model only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="740" width="170" height="32" as="geometry"/></mxCell>
        <mxCell id="r7c" value="API key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="740" width="280" height="32" as="geometry"/></mxCell>
        <mxCell id="r7d" value="api_key and model_name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="740" width="700" height="32" as="geometry"/></mxCell>

        <mxCell id="r8a" value="DATABRICKS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="230" height="32" as="geometry"/></mxCell>
        <mxCell id="r8b" value="Model only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="772" width="170" height="32" as="geometry"/></mxCell>
        <mxCell id="r8c" value="Access token or OAuth" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="772" width="280" height="32" as="geometry"/></mxCell>
        <mxCell id="r8d" value="api_key or the OAuth configuration, plus model_name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="772" width="700" height="32" as="geometry"/></mxCell>

        <mxCell id="r9a" value="BEDROCK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="804" width="230" height="42" as="geometry"/></mxCell>
        <mxCell id="r9b" value="Model only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="804" width="170" height="42" as="geometry"/></mxCell>
        <mxCell id="r9c" value="IAM credentials" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="804" width="280" height="42" as="geometry"/></mxCell>
        <mxCell id="r9d" value="region, access_id, secret_key, model_name. Reaches InvokeModel. It carries no agent identifier, so it cannot reach a Bedrock Agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="804" width="700" height="42" as="geometry"/></mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;A WebSocket target cannot do stateful multi-turn&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="876" width="680" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="The platform closes the connection after each prompt, so nothing&lt;br&gt;accumulates between turns. Every attack in the sequence arrives as&lt;br&gt;an independent message, and the chained attacks that need a&lt;br&gt;conversation to build on cannot run at all. OAuth 2.0 is not&lt;br&gt;supported on this method either.&lt;br&gt;&lt;br&gt;Both gaps are closed the same two ways: a Custom Target Adapter&lt;br&gt;using call_target, or a REST-to-WebSocket wrapper that holds the&lt;br&gt;connection open on your side." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="906" width="650" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Choose Agent when the thing chooses its own actions&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="876" width="680" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="The type is not cosmetic. Agent is the only one that triggers&lt;br&gt;Agentic Profiling, and profiling is what hands an agent-led scan a&lt;br&gt;map of the tool surface to attack. Register an agent as an&lt;br&gt;Application and the scan tests it as a chatbot.&lt;br&gt;&lt;br&gt;Both bridges in the appendix front something that picks its own&lt;br&gt;tools, so both are registered as Agent targets even though the&lt;br&gt;connection method is plain REST. Profiling and manual context&lt;br&gt;combine, and anything you type by hand wins." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="906" width="650" height="150" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
