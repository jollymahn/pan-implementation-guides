<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Azure AI Foundry Bridge" id="airs-red-bridge-foundry">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Bridge B &#8212; reaching an Azure AI Foundry agent" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Same two-field contract as the Bedrock bridge, same bearer token, different runtime. This one exists for a simpler reason: there is no Foundry connection method in the wizard at all." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ FLOW ============ -->
        <mxCell id="airs" value="&lt;b&gt;AI Red Teaming&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Target type &lt;b&gt;Agent&lt;/b&gt;,&lt;br&gt;connection method&lt;br&gt;&lt;b&gt;REST API&lt;/b&gt;, accessibility&lt;br&gt;&lt;b&gt;Public&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="210" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="az" value="&lt;b&gt;YOUR AZURE SUBSCRIPTION&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#006DCC;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#006DCC;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="950" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="fn" value="&lt;b&gt;Function App&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:Courier New;color:#666666&quot;&gt;https://&amp;lt;name&amp;gt;.azurewebsites.net/api/scan&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;&lt;b&gt;1&lt;/b&gt;&#160;&#160;Checks the bearer token itself. Azure's own function&lt;br&gt;&#160;&#160;&#160;&#160;&#160;keys are not used, for the same reason as on AWS.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&#160;&#160;Acquires a token with its managed identity. No secret&lt;br&gt;&#160;&#160;&#160;&#160;&#160;for Azure is stored in the app or in SCM.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&#160;&#160;Maps the session id to a Foundry thread so multi-turn&lt;br&gt;&#160;&#160;&#160;&#160;&#160;attacks keep their context.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="130" width="480" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="mi" value="&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;role assignment on the Foundry project&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="500" y="288" width="230" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="thr" value="&lt;font style=&quot;font-size:9px;font-family:Courier New;color:#666666&quot;&gt;_THREADS: session_id &amp;#8594; thread id&#160;&#160;(in memory)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="744" y="288" width="236" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="fdy" value="&lt;b&gt;Foundry project&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;project endpoint from the&lt;br&gt;Overview page&lt;br&gt;&lt;br&gt;agent id begins &lt;b&gt;asst_&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="130" width="230" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="airs" target="fn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1l" value="&lt;font style=&quot;font-size:10px;color:#006DCC&quot;&gt;&lt;b&gt;POST&lt;/b&gt;, Authorization: Bearer&lt;br&gt;{&quot;prompt&quot;: &quot;{INPUT}&quot;, &quot;session_id&quot;: &quot;&quot;}&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="254" y="118" width="244" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=0;exitY=0.82;exitDx=0;exitDy=0;entryX=1;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="airs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2l" value="&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;{&quot;output&quot;: &quot;{RESPONSE}&quot;, &quot;session_id&quot;: &quot;&quot;}&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="254" y="244" width="244" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="fdy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3l" value="&lt;font style=&quot;font-size:10px;color:#22c55e&quot;&gt;&lt;b&gt;identity token&lt;/b&gt;&lt;br&gt;run on the thread&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="984" y="134" width="172" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;dashed=1;dashPattern=8 4;exitX=0;exitY=0.82;exitDx=0;exitDy=0;entryX=1;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="fdy" target="fn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4l" value="&lt;font style=&quot;font-size:10px;color:#006DCC&quot;&gt;the assistant message&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="984" y="252" width="172" height="40" as="geometry"/>
        </mxCell>

        <!-- ============ A FOLDER NOT A FILE ============ -->
        <mxCell id="pf-title" value="An Azure Function is a folder, not a file" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="362" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="pf-lede" value="The AWS path writes one file and zips it. Azure's deployment tool expects a project, and creating function_app.py on its own and trying to publish it fails because there is nothing to publish. Make the folder first." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="386" width="1380" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="pf" value="&lt;b&gt;bridge-foundry/&lt;/b&gt;&lt;br&gt;&#160;&#160;&#9500;&#9472;&#9472; function_app.py&#160;&#160;&#160;&#160;&#160;&lt;font style=&quot;color:#666666&quot;&gt;the program: bearer check, identity token, thread map, one reply&lt;/font&gt;&lt;br&gt;&#160;&#160;&#9500;&#9472;&#9472; host.json&lt;br&gt;&#160;&#160;&#9500;&#9472;&#9472; local.settings.json&lt;br&gt;&#160;&#160;&#9500;&#9472;&#9472; requirements.txt&lt;br&gt;&#160;&#160;&#9492;&#9472;&#9472; .funcignore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="414" width="680" height="142" as="geometry"/>
        </mxCell>
        <mxCell id="tool" value="&lt;b&gt;Tooling to confirm before the call&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226;&#160;&#160;&lt;font style=&quot;font-family:Courier New&quot;&gt;az version&lt;/font&gt;, then &lt;font style=&quot;font-family:Courier New&quot;&gt;az login&lt;/font&gt;&lt;br&gt;&#8226;&#160;&#160;&lt;b&gt;Azure Functions Core Tools v4&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-family:Courier New&quot;&gt;func --version&lt;/font&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;A separate install from the Azure CLI, and the piece most often missing&lt;br&gt;&#8226;&#160;&#160;Python 3.11 or 3.12 locally&lt;br&gt;&#8226;&#160;&#160;An existing resource group and storage account&lt;br&gt;&#8226;&#160;&#160;Permission to create a role assignment on the Foundry project" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="414" width="680" height="142" as="geometry"/>
        </mxCell>

        <!-- ============ SHARED CONTRACT ============ -->
        <mxCell id="sc-title" value="The contract both bridges expose" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="584" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="sc-lede" value="Identical on AWS and Azure, so the console configuration differs only in the URL and the token. The prompt goes in at {INPUT} and the reply comes back at {RESPONSE}." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="608" width="1380" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="sc-req" value="&lt;font style=&quot;color:#666666&quot;&gt;// Request body pasted into Verify &amp;amp; Edit JSON&lt;/font&gt;&lt;br&gt;{ &quot;prompt&quot;: &lt;b&gt;&quot;{INPUT}&quot;&lt;/b&gt;, &quot;session_id&quot;: &quot;&quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="636" width="680" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="sc-res" value="&lt;font style=&quot;color:#666666&quot;&gt;// Response body pasted into Verify &amp;amp; Edit JSON&lt;/font&gt;&lt;br&gt;{ &quot;output&quot;: &lt;b&gt;&quot;{RESPONSE}&quot;&lt;/b&gt;, &quot;session_id&quot;: &quot;&quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="636" width="680" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="sc-note" value="Both bridges check the bearer token themselves rather than relying on the cloud provider's own request signing, because the platform can send an Authorization header but cannot compute a SigV4 signature or acquire a managed identity token. The provider's native auth has to terminate inside the bridge." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="696" width="1380" height="28" as="geometry"/>
        </mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;The thread map does not survive a cold start&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="680" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="The session-to-thread dictionary lives in the process, so it empties&lt;br&gt;whenever the function app goes cold. Conversations in flight at&lt;br&gt;that moment lose their history and the later turns of a chained&lt;br&gt;attack land without the context they were built on.&lt;br&gt;&lt;br&gt;Tolerable for a short scan. For a long agent-led run, back the map&lt;br&gt;with Table Storage or Redis keyed on session_id. That is a small&lt;br&gt;change and it is the difference between a multi-turn result you can&lt;br&gt;defend and one you cannot." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="770" width="650" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Copilot Studio is the wrong door&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="740" width="680" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="MS_COPILOT_STUDIO is the only Azure agent connector in the&lt;br&gt;wizard, and the shared branding makes it read as coverage for&lt;br&gt;Foundry. It is a different product on a different runtime, and&lt;br&gt;pointing it at a Foundry agent fails at authentication.&lt;br&gt;&lt;br&gt;Confirm which one the customer actually runs during discovery.&lt;br&gt;Foundry means this bridge, a developer, and a day. Copilot Studio&lt;br&gt;means the native connector, an interactive login, and someone&lt;br&gt;with access to both the environment and the Entra ID tenant." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="770" width="650" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="Credential scope is a reason to prefer a bridge even where a native connector exists. A Bedrock model target asks for long-lived IAM keys in a SaaS console; both bridges use an execution role or a managed identity instead, and the only secret in SCM is a token you control." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="952" width="1380" height="28" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
