<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Type 2 REST to WebSocket" id="airs-red-wrapper-websocket">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Type 2 &#8212; a REST front on a WebSocket agent" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="The native WebSocket method works, until the engagement needs a conversation or OAuth 2.0. Moving the socket into a service of your own buys back both, and the platform never knows the difference." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ NATIVE ============ -->
        <mxCell id="natl" value="NATIVE WEBSOCKET METHOD&#160;&#160;&#8212;&#160;&#160;WHAT IT CAN AND CANNOT DO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#ef4444;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1380" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="n-airs" value="&lt;b&gt;AI Red Teaming&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="70" y="156" width="190" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n-t1" value="&lt;b&gt;turn 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;open&#160;&#183;&#160;send&#160;&#183;&#160;read&#160;&#183;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;close&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="330" y="156" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n-t2" value="&lt;b&gt;turn 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;open&#160;&#183;&#160;send&#160;&#183;&#160;read&#160;&#183;&#160;&lt;font style=&quot;color:#ef4444&quot;&gt;close&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="330" y="216" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n-agent" value="&lt;b&gt;WebSocket agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Every turn arrives on a&lt;br&gt;brand new connection, so&lt;br&gt;nothing is remembered.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="156" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n-e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="n-airs" target="n-t1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n-e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="n-airs" target="n-t2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n-e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="n-t1" target="n-agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n-e4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="n-t2" target="n-agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n-cost" value="&lt;b style=&quot;color:#ef4444&quot;&gt;What that costs you&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226;&#160;&#160;&lt;b&gt;No stateful multi-turn.&lt;/b&gt; Attack sequences run as independent prompts. The&lt;br&gt;&#160;&#160;&#160;&#160;&#160;chained attacks that need a conversation to build on cannot run at all.&lt;br&gt;&lt;br&gt;&#8226;&#160;&#160;&lt;b&gt;No OAuth 2.0.&lt;/b&gt; Headers and Basic only. An agent behind an OAuth 2.0 token&lt;br&gt;&#160;&#160;&#160;&#160;&#160;endpoint is out of reach on this method whatever else you configure.&lt;br&gt;&lt;br&gt;&#8226;&#160;&#160;&lt;b&gt;A private WebSocket target&lt;/b&gt; also needs channel client v1.3.0 or higher." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="860" y="140" width="540" height="140" as="geometry"/>
        </mxCell>

        <!-- ============ WRAPPER ============ -->
        <mxCell id="wrl" value="WITH A REST-TO-WEBSOCKET WRAPPER&#160;&#160;&#8212;&#160;&#160;BOTH LIMITS GONE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1380" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="w-airs" value="&lt;b&gt;AI Red Teaming&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Target configured as&lt;br&gt;REST API, stateful&lt;br&gt;multi-turn enabled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="378" width="190" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="w-posts" value="&lt;b&gt;turn 1&lt;/b&gt;&#160;&#160;POST, session_id in the body&lt;br&gt;&lt;b&gt;turn 2&lt;/b&gt;&#160;&#160;POST, same session_id&lt;br&gt;&lt;b&gt;turn 3&lt;/b&gt;&#160;&#160;POST, same session_id&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Stateless from the platform's point of view.&lt;br&gt;Each POST is complete on its own.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#006DCC;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="378" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="w-wrap" value="&lt;b&gt;REST-to-WebSocket wrapper&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;&#8226;&#160;&#160;Holds one persistent WebSocket per session&lt;br&gt;&#8226;&#160;&#160;Keeps the conversation history behind the session id&lt;br&gt;&#8226;&#160;&#160;Exchanges and refreshes the OAuth 2.0 token before&lt;br&gt;&#160;&#160;&#160;&#160;&#160;each frame it sends&lt;br&gt;&#8226;&#160;&#160;Reassembles streamed chunks into one reply&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="378" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="w-agent" value="&lt;b&gt;WebSocket agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;One connection, held open&lt;br&gt;across every turn, so the&lt;br&gt;agent's own session state&lt;br&gt;accumulates the way a real&lt;br&gt;conversation would.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1150" y="378" width="240" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="w-e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="w-airs" target="w-posts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w-e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="w-posts" target="w-wrap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w-e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;startArrow=block;startFill=1;" edge="1" parent="1" source="w-wrap" target="w-agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w-e3l" value="&lt;font style=&quot;font-size:10px;color:#22c55e&quot;&gt;&lt;b&gt;one socket,&lt;br&gt;held open&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1060" y="406" width="90" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="w-foot" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;From the console this is an ordinary REST target. Stateful multi-turn needs response_id_field and request_id_field pointed at wherever your wrapper puts the session id.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="70" y="536" width="1320" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ DECISION ============ -->
        <mxCell id="d-title" value="Which of the three fixes to use" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="596" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="dh1" value="Situation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="628" width="420" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="dh2" value="Use" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="628" width="320" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="dh3" value="Why" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="628" width="640" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="d1a" value="Single-turn prompts, header or basic auth" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="420" height="36" as="geometry"/></mxCell>
        <mxCell id="d1b" value="The native WEBSOCKET method" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="460" y="656" width="320" height="36" as="geometry"/></mxCell>
        <mxCell id="d1c" value="Nothing to build. The limits do not bite on a single-turn scan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="780" y="656" width="640" height="36" as="geometry"/></mxCell>
        <mxCell id="d2a" value="Multi-turn or OAuth 2.0 needed, Kubernetes available" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="692" width="420" height="36" as="geometry"/></mxCell>
        <mxCell id="d2b" value="Custom Target Adapter, Pattern B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="460" y="692" width="320" height="36" as="geometry"/></mxCell>
        <mxCell id="d2c" value="call_target owns the socket, authenticate() holds the token, and there is no new service to host" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="780" y="692" width="640" height="36" as="geometry"/></mxCell>
        <mxCell id="d3a" value="Multi-turn or OAuth 2.0 needed, no Kubernetes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="420" height="36" as="geometry"/></mxCell>
        <mxCell id="d3b" value="This wrapper" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="460" y="728" width="320" height="36" as="geometry"/></mxCell>
        <mxCell id="d3c" value="4 to 8 hours, longer once conversation history has to survive across prompts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="780" y="728" width="640" height="36" as="geometry"/></mxCell>

        <!-- ============ CALLOUT ============ -->
        <mxCell id="c1" value="&lt;b&gt;Session state has to live somewhere that survives a restart&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1380" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="A dictionary in the wrapper process is the obvious first implementation and it works until the process restarts. An Attack Library scan runs for about five hours; a container&lt;br&gt;recycled in the middle of one drops every in-flight conversation, and the attacks that depended on earlier turns quietly stop making sense rather than failing loudly.&lt;br&gt;&lt;br&gt;For a short scan that is a reasonable trade. For a long agent-led run, back the session map with Redis or a table keyed on the session id, and make the wrapper reconnect&lt;br&gt;the socket rather than lose the conversation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="820" width="1350" height="82" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
