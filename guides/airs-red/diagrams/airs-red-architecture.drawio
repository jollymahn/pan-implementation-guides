<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Architecture" id="airs-red-architecture">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI Red Teaming, end to end" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="One console, three API planes, and a target somewhere outside the platform. Everything on this page sits behind one base domain and one tenant header, so the only real variable is how the attack traffic reaches the target." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ CONSOLE ============ -->
        <mxCell id="console" value="&lt;b&gt;STRATA CLOUD MANAGER&lt;/b&gt;&#160;&#160;&#160;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#666666&quot;&gt;AI Security&#160;&#8594;&#160;AI Red Teaming&#160;&#8594;&#160;Dashboard&#160;&#183;&#160;Targets&#160;&#183;&#160;Network Channels&#160;&#183;&#160;Scans&#160;&#183;&#160;Reports&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB81C;strokeColor=#E5A300;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1380" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="ce1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#00294D;exitX=0.16;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="console" target="mgmt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#00294D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="console" target="data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#00294D;exitX=0.84;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="console" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="api-note" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Anything the console does, the API does. Base URL &lt;font style=&quot;font-family:Courier New&quot;&gt;https://api.sase.paloaltonetworks.com&lt;/font&gt;, with &lt;font style=&quot;font-family:Courier New&quot;&gt;Authorization: Bearer&lt;/font&gt; and &lt;font style=&quot;font-family:Courier New&quot;&gt;Prisma-Tenant: &amp;lt;TSG_ID&amp;gt;&lt;/font&gt; on every call.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="158" width="1380" height="22" as="geometry"/>
        </mxCell>

        <!-- ============ THREE PLANES ============ -->
        <mxCell id="mgmt" value="&lt;b&gt;MANAGEMENT PLANE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:Courier New;color:#666666&quot;&gt;/ai-red-teaming/mgmt-plane/v1&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;&lt;b&gt;What you set up&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Targets: create, update, delete&lt;br&gt;Target profiles and background&lt;br&gt;Probe and validate-auth&lt;br&gt;Custom prompt sets, CSV upload&lt;br&gt;Dashboard overview&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="440" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;DATA PLANE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:Courier New;color:#666666&quot;&gt;/ai-red-teaming/data-plane/v1&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;&lt;b&gt;What runs and what comes back&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Scans: start, list, status, abort&lt;br&gt;Categories and languages&lt;br&gt;Static and dynamic reports&lt;br&gt;Remediation and runtime policy config&lt;br&gt;Error logs, quota, dashboard trends&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#006DCC;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="200" width="440" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="broker" value="&lt;b&gt;NETWORK BROKER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:Courier New;color:#666666&quot;&gt;/ai-red-teaming/data-plane/network-broker/v1&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;&lt;b&gt;How private targets are reached&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Channels: create, list, get, update&lt;br&gt;Channel statistics, which carry the&lt;br&gt;registry, chart and image references&lt;br&gt;for the Helm install&lt;br&gt;&lt;br&gt;Only needed for a private endpoint.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="200" width="440" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="pe1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;" edge="1" parent="1" source="mgmt" target="routes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="data" target="routes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="broker" target="routes"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ ROUTES ============ -->
        <mxCell id="routes" value="&lt;b&gt;HOW THE TRAFFIC GETS THERE&lt;/b&gt;&#160;&#160;&#160;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#666666&quot;&gt;one of five routes, chosen per target&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#00294D;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="1380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="rt1" value="&lt;b&gt;1&lt;/b&gt;&#160;&#160;Public&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;direct over TLS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="62" y="486" width="256" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="rt2" value="&lt;b&gt;2&lt;/b&gt;&#160;&#160;Private, IP allowlist&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;one inbound rule&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3b82f6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="334" y="486" width="256" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="rt3" value="&lt;b&gt;3&lt;/b&gt;&#160;&#160;Private, Network Channel&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;outbound tunnel from Kubernetes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5A300;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="606" y="486" width="256" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="rt4" value="&lt;b&gt;4&lt;/b&gt;&#160;&#160;Custom Target Adapter&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;your Python, in the channel pod&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8b5cf6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="878" y="486" width="256" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="rt5" value="&lt;b&gt;5&lt;/b&gt;&#160;&#160;Wrapper or bridge&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;your HTTPS service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1150" y="486" width="248" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="re" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#00294D;" edge="1" parent="1" source="routes" target="sut"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ TARGET ============ -->
        <mxCell id="sut" value="&lt;b&gt;THE AI SYSTEM UNDER TEST&lt;/b&gt;&#160;&#160;&#160;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#666666&quot;&gt;outside the platform, running on the customer's own infrastructure, unmodified&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1380" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="sut1" value="&lt;b style=&quot;color:#E5A300&quot;&gt;APPLICATION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Chatbot, copilot, RAG app&lt;br&gt;&lt;br&gt;REST&#160;&#183;&#160;STREAMING&#160;&#183;&#160;WEBSOCKET&#160;&#183;&#160;CUSTOM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ef4444;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="62" y="640" width="430" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="sut2" value="&lt;b style=&quot;color:#006DCC&quot;&gt;AGENT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Chooses its own tools. Profiled automatically&lt;br&gt;&lt;br&gt;The four above, plus MS_COPILOT_STUDIO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ef4444;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="515" y="640" width="430" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="sut3" value="&lt;b style=&quot;color:#22c55e&quot;&gt;MODEL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;A raw inference endpoint&lt;br&gt;&lt;br&gt;OPENAI&#160;&#183;&#160;HUGGING_FACE&#160;&#183;&#160;DATABRICKS&#160;&#183;&#160;BEDROCK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ef4444;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="968" y="640" width="430" height="82" as="geometry"/>
        </mxCell>

        <!-- ============ SUPPORTING ============ -->
        <mxCell id="auth" value="&lt;b&gt;Authentication&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-family:Courier New;color:#666666&quot;&gt;POST https://auth.apps.paloaltonetworks.com&lt;br&gt;&#160;&#160;&#160;&#160;&#160;/oauth2/access_token&lt;br&gt;&lt;br&gt;grant_type = client_credentials&lt;br&gt;scope&#160;&#160;&#160;&#160;&#160;&#160;= tsg_id:&amp;lt;TSG_ID&amp;gt;&lt;br&gt;basic auth = CLIENT_ID:CLIENT_SECRET&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="786" width="440" height="202" as="geometry"/>
        </mxCell>
        <mxCell id="order" value="&lt;b&gt;The order the pieces have to arrive in&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;&lt;b&gt;1&lt;/b&gt;&#160;&#160;Deployment profile and license&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&#160;&#160;IAM: superuser, or a custom role&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&#160;&#160;Network Channel, if the target is private&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&#160;&#160;Target, validated end to end&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&#160;&#160;Scan&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;A private target cannot validate until the channel&lt;br&gt;is ONLINE, and a scan cannot start until the target&lt;br&gt;is VALIDATED.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="786" width="440" height="202" as="geometry"/>
        </mxCell>
        <mxCell id="say" value="&lt;b&gt;Worth saying out loud to the customer&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;Nothing is installed in front of the application and&lt;br&gt;nothing changes about how its real users reach it.&lt;br&gt;The platform behaves like any other API client&lt;br&gt;holding a credential.&lt;br&gt;&lt;br&gt;What does change: attack prompts arrive at a&lt;br&gt;production-shaped endpoint for hours at a stretch.&lt;br&gt;Agree the window, the rate limit, and who is&lt;br&gt;watching the alerts.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="786" width="440" height="202" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
