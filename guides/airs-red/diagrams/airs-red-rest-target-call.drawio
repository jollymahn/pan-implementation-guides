<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - REST Target Call" id="airs-red-rest-target-call">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="One attack prompt against a REST target" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="A scan repeats this round trip hundreds of times. Two template fields decide whether it works at all: {INPUT} says where the prompt goes, {RESPONSE} says where the reply is found." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ SIX STAGES ============ -->
        <mxCell id="s1" value="&lt;b&gt;Attack prompt&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Taken from the curated&lt;br&gt;library, or written on the&lt;br&gt;spot by the attack agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="128" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Request JSON&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;{INPUT} is replaced with&lt;br&gt;the prompt. Every other&lt;br&gt;field is sent as captured&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="272" y="128" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;HTTPS POST&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;TLS, from the static&lt;br&gt;AIRS egress IP, carrying&lt;br&gt;the configured auth header&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="504" y="128" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Target endpoint&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The application answers,&lt;br&gt;refuses, or throttles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="736" y="128" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;Response JSON&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;{RESPONSE} marks the&lt;br&gt;field holding the reply.&lt;br&gt;Dot notation finds it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="968" y="128" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;Verdict&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The reply is scored and&lt;br&gt;recorded: successful,&lt;br&gt;blocked, or an error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="128" width="200" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="e12" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e56" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="n1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="272" y="104" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="504" y="104" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="736" y="104" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="968" y="104" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="104" width="24" height="24" as="geometry"/></mxCell>

        <mxCell id="plat-band" value="&lt;font style=&quot;font-size:10px;color:#00294D&quot;&gt;&lt;b&gt;Inside the AI Red Teaming cloud&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="248" width="300" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="cust-band" value="&lt;font style=&quot;font-size:10px;color:#ef4444&quot;&gt;&lt;b&gt;Your infrastructure&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="736" y="248" width="200" height="20" as="geometry"/>
        </mxCell>

        <!-- ============ THE TWO TEMPLATES ============ -->
        <mxCell id="tpl-title" value="The two editors in Wizard Step 5" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="288" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="tpl-lede" value="Both are structural templates, not literal payloads. Capture a real request and a real response from the application with browser DevTools, then replace exactly one value in each." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="312" width="1380" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="req-hdr" value="Request JSON&#160;&#160;&#8212;&#160;&#160;where the prompt goes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="342" width="680" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="req-body" value="{&lt;br&gt;&#160;&#160;&quot;messages&quot;: [&lt;br&gt;&#160;&#160;&#160;&#160;{ &quot;role&quot;: &quot;system&quot;, &quot;content&quot;: &quot;You are a helpful HR assistant for Acme Corp.&quot; },&lt;br&gt;&#160;&#160;&#160;&#160;{ &quot;role&quot;: &quot;user&quot;,&#160;&#160;&#160;&quot;content&quot;: &lt;b&gt;&quot;{INPUT}&quot;&lt;/b&gt; }&lt;br&gt;&#160;&#160;],&lt;br&gt;&#160;&#160;&quot;temperature&quot;: 0.7,&lt;br&gt;&#160;&#160;&quot;max_tokens&quot;: 500&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="680" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="req-note" value="{INPUT} appears exactly once, as the value of the user message. The system prompt stays as captured: it is part of what the attack is testing. Nothing else is removed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="502" width="680" height="34" as="geometry"/>
        </mxCell>

        <mxCell id="res-hdr" value="Response JSON&#160;&#160;&#8212;&#160;&#160;where the reply is found" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="342" width="680" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="res-body" value="{&lt;br&gt;&#160;&#160;&quot;id&quot;: &quot;chatcmpl-abc123&quot;, &quot;object&quot;: &quot;chat.completion&quot;, &quot;model&quot;: &quot;gpt-4o&quot;,&lt;br&gt;&#160;&#160;&quot;choices&quot;: [&lt;br&gt;&#160;&#160;&#160;&#160;{ &quot;index&quot;: 0,&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&quot;message&quot;: { &quot;role&quot;: &quot;assistant&quot;, &quot;content&quot;: &lt;b&gt;&quot;{RESPONSE}&quot;&lt;/b&gt; },&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&quot;finish_reason&quot;: &quot;stop&quot; }&lt;br&gt;&#160;&#160;],&lt;br&gt;&#160;&#160;&quot;usage&quot;: { &quot;total_tokens&quot;: 57 }&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="370" width="680" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="res-note" value="The position of {RESPONSE} becomes the extraction path choices[0].message.content. Replace the reply text only, never a wrapper object or a metadata field, and capture one complete response rather than a streaming chunk." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="740" y="502" width="680" height="34" as="geometry"/>
        </mxCell>

        <!-- ============ WHAT THE STATUS CODE MEANS ============ -->
        <mxCell id="sc-title" value="What the target returns, and what the report makes of it" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="552" width="900" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="sh1" value="Target returns" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="586" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sh2" value="Configured in the wizard?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="586" width="300" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sh3" value="How the attack is recorded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="586" width="380" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sh4" value="What that does to the numbers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="940" y="586" width="480" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="sr1a" value="&lt;b&gt;200&lt;/b&gt; with a reply" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="616" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="sr1b" value="Response JSON template" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="616" width="300" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="sr1c" value="Scored. Successful if the reply contains the unsafe behavior, blocked if it does not" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="560" y="616" width="380" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="sr1d" value="Counts toward the Attack Success Rate either way" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="940" y="616" width="480" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="sr2a" value="&lt;b&gt;429&lt;/b&gt; throttled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="658" width="220" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sr2b" value="Rate Limit Error Code and a sample exception body" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="658" width="300" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sr2c" value="Recognized as throttling. The platform backs off and retries instead of failing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="560" y="658" width="380" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sr2d" value="Leave it unset and the scan fails outright. Set Endpoint Rate Limit to about 80 percent of the real ceiling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="940" y="658" width="480" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="sr3a" value="&lt;b&gt;400, 403&lt;/b&gt; or a custom code, from a built-in guardrail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="706" width="220" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="sr3b" value="Guardrail Error Code and a sample exception body" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="706" width="300" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="sr3c" value="Recorded as blocked by a guardrail, which is a finding in its own right" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="560" y="706" width="380" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="sr3d" value="Leave it unset and every successful defense is filed as a scan error, so the report shows noise where it should show the guardrail working" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="940" y="706" width="480" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="sr4a" value="&lt;b&gt;Any other non-200&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="sr4b" value="Nothing to configure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="760" width="300" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="sr4c" value="Logged as an error against that attack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="560" y="760" width="380" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="sr4d" value="Visible in the error log during the scan. A run with many of these finishes PARTIALLY_COMPLETE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="940" y="760" width="480" height="42" as="geometry"/>
        </mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;An unconfigured guardrail code understates the target&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="834" width="680" height="178" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="A target with good guardrails refuses a lot of prompts. If the&lt;br&gt;platform has not been told which status code means refusal, every&lt;br&gt;one of those refusals lands in the report as a scan error rather&lt;br&gt;than as a defense that held.&lt;br&gt;&lt;br&gt;Send one known-harmful prompt by hand before the deployment&lt;br&gt;call, note the status code and the body it returns, and paste both&lt;br&gt;into Wizard Step 6. It takes a minute and it changes the report." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="864" width="650" height="142" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Validation failures map to one of four causes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="834" width="680" height="178" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="Validate sends one live probe and checks the reply against the&lt;br&gt;response template, so a failure is always one of these:&lt;br&gt;&lt;br&gt;&#8226;&#160;&#160;Connection error&#160;&#8212;&#160;wrong URL, or a Network Channel that is OFFLINE&lt;br&gt;&#8226;&#160;&#160;401 or 403&#160;&#8212;&#160;the key or token is wrong or has expired&lt;br&gt;&#8226;&#160;&#160;JSON mismatch&#160;&#8212;&#160;the response template does not match reality&lt;br&gt;&#8226;&#160;&#160;Timeout&#160;&#8212;&#160;the agent is slower than the platform will wait&lt;br&gt;&lt;br&gt;Only after it passes does Target Background unlock." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="864" width="650" height="142" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="Status flow for the target itself:&#160;&#160;&lt;b&gt;DRAFT&lt;/b&gt;&#160;&#8594;&#160;&lt;b&gt;VALIDATING&lt;/b&gt;&#160;&#8594;&#160;&lt;b&gt;VALIDATED&lt;/b&gt;&#160;&#8594;&#160;&lt;b&gt;ACTIVE&lt;/b&gt; once a scan has run against it. FAILED sends you back to the URL, the credential, or the response template." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="1380" height="24" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
