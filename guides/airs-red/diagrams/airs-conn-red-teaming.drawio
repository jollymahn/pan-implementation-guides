            <mxPoint x="340" y="278" as="sourcePoint"/>
            <mxPoint x="900" y="313" as="targetPoint"/>
            <Array as="points"><mxPoint x="840" y="309"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=#8b5cf6;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="829.0" y="298.25" width="22" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="tt" value="What each check proves, and what a failure means" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="1000" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="h0" value="#" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="442" width="50" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="Check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="442" width="320" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Proves" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="442" width="420" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="A failure here means" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="442" width="590" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="r0c0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c1" value="API host resolves and completes TLS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="470" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c2" value="DNS, routing and certificate trust, before any credential is involved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="470" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r0c3" value="A network problem, never an account problem. Work down from DNS to egress to TLS inspection." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="470" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c0" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="514" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c1" value="Authentication host resolves and completes TLS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="514" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c2" value="That the token endpoint is reachable, which is blocked separately more often than people expect" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="514" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r1c3" value="An egress rule that named the API host and not this one. Both are needed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="514" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c0" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="558" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c1" value="Service account obtains a token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="558" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c2" value="The client identifier and secret are valid and the tenant scope is right" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="558" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r2c3" value="A credential problem. invalid_client is usually a trailing space in a pasted secret." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="558" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c0" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="602" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c1" value="Management plane answers an authenticated request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="602" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c2" value="End to end: this environment can do everything Red Teaming asks of it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="602" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r3c3" value="A 403 is a role or tenant mismatch rather than connectivity, since the token was accepted." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="602" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r4c0" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="646" width="50" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r4c1" value="Container registry resolves from the cluster" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="646" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r4c2" value="The Helm install will be able to pull the channel client image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="646" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r4c3" value="helm install stops at ImagePullBackOff before anything else can be diagnosed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="646" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c0" value="&lt;b&gt;These checks do not test the path to your target&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="716" width="680" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c0b" value="Attack traffic travels from the Palo Alto Networks cloud to your&lt;br&gt;target, not from the machine you are sitting at. Nothing here can&lt;br&gt;prove that path.&lt;br&gt;&lt;br&gt;Confirm the target separately by calling it the way an ordinary&lt;br&gt;client would, from outside your network if it is meant to be public.&lt;br&gt;If it is private, the Network Channel or an allowlisted source IP is&lt;br&gt;what carries the traffic, and check 5 covers the first of those." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="746" width="650" height="114" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Run check 5 from inside the cluster, not near it&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="716" width="680" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="kubectl run curl-test --image=curlimages/curl --rm -it&lt;br&gt;--restart=Never -- curl -v https://registry.ai-red-teaming.&lt;br&gt;paloaltonetworks.com/&lt;br&gt;&lt;br&gt;A NetworkPolicy on the namespace is invisible from the node, from&lt;br&gt;a bastion, and from your laptop. The only honest test is a pod on&lt;br&gt;the same namespace the channel client will run in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="746" width="650" height="114" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
