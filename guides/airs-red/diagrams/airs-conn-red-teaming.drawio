        <mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E5A300;strokeColor=#E5A300;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="661.5" y="132.90625" width="22" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;edgeStyle=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
