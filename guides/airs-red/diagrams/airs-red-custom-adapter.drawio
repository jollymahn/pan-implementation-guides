<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Custom Target Adapter" id="airs-red-custom-adapter">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1190" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Custom Target Adapter &#8212; who makes the call" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="A Python script the platform runs in the adapter sidecar beside your Network Channel client. Your code and your credentials stay in your cluster. Which functions you implement decides whether the platform fires the request or you do." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ PATTERN A ============ -->
        <mxCell id="laneA" value="PATTERN A&#160;&#160;&#8212;&#160;&#160;HTTP TARGETS, THE PLATFORM MAKES THE CALL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#006DCC;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#006DCC;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="680" height="516" as="geometry"/>
        </mxCell>

        <mxCell id="a-s1" value="&lt;b&gt;session_pre_process(context)&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;OPTIONAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Runs once on the first turn of every conversation, including a single-turn&lt;br&gt;Attack Library scan. Returns SessionPreProcessResult(session_state=...),&lt;br&gt;readable afterwards as context.session.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Courier New;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="66" y="134" width="628" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="a-s2" value="&lt;b&gt;authenticate(context)&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;OPTIONAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Called on demand, not on a schedule. Returns AuthResult(ttl=..., data=...),&lt;br&gt;cached for that TTL and re-fetched on expiry or on an auth error. Read it&lt;br&gt;back as context.auth. Per-request signing does not belong here.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Courier New;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="66" y="216" width="628" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="a-s3" value="&lt;b&gt;pre_process(context, inference_input)&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:9px;color:#006DCC&quot;&gt;REQUIRED FOR A&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Every turn, before the call. The prompt arrives as inference_input.prompt.&lt;br&gt;Returns PreProcessResult(url, headers, json_body): a description of the&lt;br&gt;request, not the request itself. HMAC and SigV4 signing go here.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11;fontFamily=Courier New;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="66" y="298" width="628" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="a-fire" value="&lt;b&gt;THE PLATFORM FIRES THE HTTP REQUEST&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;AIRS executes the descriptor your pre_process returned. This single step is the&lt;br&gt;whole difference between the two patterns.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="66" y="380" width="628" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-s4" value="&lt;b&gt;post_process(context, raw_response)&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:9px;color:#006DCC&quot;&gt;REQUIRED FOR A&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Every turn, after the reply arrives. Read the body with raw_response.json_body,&lt;br&gt;which is a property and not a method call. Return PostProcessResult(output=...).&lt;br&gt;Call raise_rate_limited(retry_after=n) or raise_auth_error(msg) here.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=11;fontFamily=Courier New;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="66" y="458" width="628" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="a-out" value="&lt;b&gt;output&lt;/b&gt;&#160;&#160;the reply text, handed back to the scan engine and scored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="66" y="542" width="628" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a-e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="a-s1" target="a-s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="a-s2" target="a-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="a-s3" target="a-fire"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="a-fire" target="a-s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e5" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="a-s4" target="a-out"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ PATTERN B ============ -->
        <mxCell id="laneB" value="PATTERN B&#160;&#160;&#8212;&#160;&#160;NON-HTTP TRANSPORTS, YOU MAKE THE CALL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#8b5cf6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="100" width="680" height="516" as="geometry"/>
        </mxCell>

        <mxCell id="b-s1" value="&lt;b&gt;session_pre_process(context)&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;OPTIONAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Identical to Pattern A. Works with both patterns, and is the right place to&lt;br&gt;create a server-side session the agent requires before the first message.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Courier New;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="766" y="134" width="628" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="b-s2" value="&lt;b&gt;authenticate(context)&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;OPTIONAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Also identical. A token fetched here survives in context.auth across every&lt;br&gt;turn of the conversation, so the exchange is not repeated per prompt.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=11;fontFamily=Courier New;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="766" y="216" width="628" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="b-s3" value="&lt;b&gt;call_target(context, inference_input)&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:9px;color:#8b5cf6&quot;&gt;REQUIRED FOR B&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Every turn. You own the whole cycle: open the connection, send the prompt,&lt;br&gt;read frames until the agent signals it has finished, close, and return&lt;br&gt;CallTargetResult(output=...).&lt;br&gt;&lt;br&gt;This is the path for WebSocket, GraphQL, gRPC, an SDK client, and any custom&lt;br&gt;framing or streaming protocol. The platform makes no request of its own.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;fontSize=11;fontFamily=Courier New;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="766" y="298" width="628" height="146" as="geometry"/>
        </mxCell>
        <mxCell id="b-warn" value="&lt;font style=&quot;color:#ef4444&quot;&gt;&lt;b&gt;If call_target exists, pre_process and post_process are ignored&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Silently, with no warning, even when all three are in the same file. For an HTTP target&lt;br&gt;that needs several calls per turn, use context.http inside pre_process rather than&lt;br&gt;switching patterns.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="766" y="520" width="628" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="b-out" value="&lt;b&gt;output&lt;/b&gt;&#160;&#160;the reply text, handed back to the scan engine and scored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="462" width="628" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="b-e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#8b5cf6;" edge="1" parent="1" source="b-s1" target="b-s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#8b5cf6;" edge="1" parent="1" source="b-s2" target="b-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="b-s3" target="b-out"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ CONTEXT TABLE ============ -->
        <mxCell id="ctx-title" value="The context object &#8212; the only state that survives a turn" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="680" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="ch1" value="Attribute" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="210" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="ch2" value="What it holds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="672" width="470" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="cr1a" value="context.vars[&quot;key&quot;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="210" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="cr1b" value="Non-sensitive configuration: endpoint URLs, model names. Visible in the SCM UI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="700" width="470" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="cr2a" value="context.secrets[&quot;key&quot;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="738" width="210" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="cr2b" value="API keys and passwords. Masked in the UI and scrubbed from logs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="738" width="470" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="cr3a" value="context.auth[&quot;key&quot;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="776" width="210" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="cr3b" value="Whatever authenticate() put in AuthResult.data. Persists across turns within one conversation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="776" width="470" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="cr4a" value="context.session[&quot;key&quot;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="814" width="210" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="cr4b" value="Whatever session_pre_process() put in session_state. Resets between conversations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="814" width="470" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="cr5a" value="context.http" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="852" width="210" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="cr5b" value="A platform-provided httpx client with a 100-second timeout. Use it for extra calls inside any function" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="852" width="470" height="38" as="geometry"/>
        </mxCell>

        <!-- ============ RUNTIME LIMITS ============ -->
        <mxCell id="rl-title" value="Runtime limits &#8212; what the sidecar will and will not do" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="640" width="680" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="rh1" value="Limit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="672" width="340" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="rh2" value="Value" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="672" width="340" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="rr1a" value="Total execution per turn, all functions combined" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="700" width="340" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="rr1b" value="110 seconds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1080" y="700" width="340" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="rr2a" value="HTTP timeout on context.http" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="732" width="340" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="rr2b" value="100 seconds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1080" y="732" width="340" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="rr3a" value="context.auth plus context.session, serialized" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="764" width="340" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="rr3b" value="64 KB combined" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1080" y="764" width="340" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="rr4a" value="Script state between turns" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="796" width="340" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="rr4b" value="None. Module-level globals are discarded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1080" y="796" width="340" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="rr5a" value="Importable Python packages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="828" width="340" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="rr5b" value="stdlib, httpx, websockets. Anything else needs a support request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1080" y="828" width="340" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="rr6a" value="Cold start, per turn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="860" width="340" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="rr6b" value="50 to 200 ms; the script is loaded fresh each time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1080" y="860" width="340" height="30" as="geometry"/>
        </mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;Do not import the result types&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="914" width="680" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="The runtime injects every one of them. Use PreProcessResult,&lt;br&gt;PostProcessResult, CallTargetResult, AuthResult and&lt;br&gt;SessionPreProcessResult directly, along with the error signals&lt;br&gt;raise_rate_limited(retry_after=n) and raise_auth_error(message).&lt;br&gt;&lt;br&gt;An import line for any of these is the first thing to delete when a&lt;br&gt;script that looks right refuses to validate. Two more worth&lt;br&gt;remembering: the prompt is inference_input.prompt, and the body&lt;br&gt;is raw_response.json_body, a property rather than a call." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="944" width="650" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;The adapter is a development task, not a configuration task&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="914" width="680" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="The customer writes it, tests it, and maintains it. Palo Alto&lt;br&gt;Networks does not, and neither does Professional Services.&lt;br&gt;Budget at least one development sprint for a non-trivial protocol.&lt;br&gt;&lt;br&gt;Surface this during discovery. A target that needs an adapter&lt;br&gt;turns a half-day onboarding into a piece of software with an&lt;br&gt;owner, and if it needs a package outside stdlib, httpx and&lt;br&gt;websockets, add the support request lead time on top." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="944" width="650" height="150" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
