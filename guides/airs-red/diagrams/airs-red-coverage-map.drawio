<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Coverage Map" id="airs-red-coverage-map">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="What has a connector, and what needs code" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Two managed agent runtimes in wide use have no way in, for two different reasons. Found during discovery, it stays a half-day of onboarding; found on the deployment call, it becomes a development task." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ NATIVE ============ -->
        <mxCell id="nat" value="REACHED NATIVELY&#160;&#160;&#8212;&#160;&#160;PICK A CONNECTION METHOD AND FILL IN THE FORM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="660" height="600" as="geometry"/>
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;An agent behind an HTTPS endpoint that takes JSON and returns JSON&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;REST. The common case, and the shape both bridges present.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="64" y="142" width="612" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;An agent that streams its answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;STREAMING, for text/event-stream or application/x-ndjson.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="64" y="206" width="612" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;A WebSocket agent, single-turn, without OAuth 2.0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;WEBSOCKET. Native, so no wrapper. Read the two limits before committing.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="64" y="270" width="612" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;A Microsoft Copilot Studio agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;MS_COPILOT_STUDIO, Agent targets only. The agent must already be published.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="64" y="334" width="612" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;A Bedrock foundation model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;BEDROCK, which reaches InvokeModel. The model, not an agent built on it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="64" y="398" width="612" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;An OpenAI model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;OPENAI, with an API key and a model name.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="64" y="462" width="612" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;A Hugging Face model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;HUGGING_FACE, same two fields.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="64" y="526" width="612" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;A Databricks serving endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;DATABRICKS, with an access token or an OAuth configuration.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="64" y="590" width="612" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n-foot" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Private versions of any of these are still native. A Network Channel changes the path, not the connection method.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="64" y="654" width="612" height="34" as="geometry"/>
        </mxCell>

        <!-- ============ NEEDS CODE ============ -->
        <mxCell id="code" value="NEEDS CODE&#160;&#160;&#8212;&#160;&#160;AN ADAPTER IF THERE IS KUBERNETES, OTHERWISE A WRAPPER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#ef4444;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="660" height="600" as="geometry"/>
        </mxCell>

        <mxCell id="g1" value="&lt;b&gt;An AWS Bedrock Agent&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:9px;color:#ef4444&quot;&gt;THREE SEPARATE BLOCKERS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;BEDROCK reaches InvokeModel and has no field for an agent id or alias id.&lt;br&gt;A REST target cannot compute the SigV4 signature InvokeAgent requires.&lt;br&gt;InvokeAgent answers with a chunked event stream, which {RESPONSE} cannot map.&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;Fix: a bridge that collapses the event stream into one JSON document.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="784" y="142" width="612" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;An Azure AI Foundry agent&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:9px;color:#ef4444&quot;&gt;NO CONNECTOR EXISTS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;There is no Foundry connection method in the wizard at all. Copilot Studio is&lt;br&gt;the only Azure agent connector, and it is a different product on a different runtime.&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;Fix: a bridge on an Azure Function App, using a managed identity.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="784" y="232" width="612" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;A WebSocket agent that needs multi-turn or OAuth 2.0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The native method closes the connection after every prompt, and does not&lt;br&gt;speak OAuth 2.0.&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;Fix: Pattern B call_target, or a REST-to-WebSocket wrapper holding the socket open.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="784" y="322" width="612" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="&lt;b&gt;An agent with no HTTP face, reachable only through an SDK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The platform speaks HTTP, so there is nothing for it to address.&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;Fix: a REST shim in the same environment as the SDK. Two to four hours.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="784" y="412" width="612" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="g5" value="&lt;b&gt;An agent on gRPC, SOAP, or AMQP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;None of these can be expressed as a cURL, so the wizard has nothing to import.&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;Fix: Pattern B call_target, or a REST shim translating to the protocol.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="784" y="502" width="612" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="g6" value="&lt;b&gt;An agent that signs every request: SigV4, HMAC, or mTLS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The signature covers the body, which does not exist yet at authentication time.&lt;br&gt;&lt;font style=&quot;color:#ef4444&quot;&gt;Fix: sign inside pre_process, or put a signing proxy in front. Never authenticate().&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="784" y="592" width="612" height="84" as="geometry"/>
        </mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;Copilot Studio is not Azure AI Foundry&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="724" width="440" height="198" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="The shared Azure branding makes the one&lt;br&gt;Azure connector in the wizard read as&lt;br&gt;coverage for both. It is not. They are&lt;br&gt;separate products on separate runtimes,&lt;br&gt;and a Foundry agent needs the bridge.&lt;br&gt;&lt;br&gt;Worth confirming which one the customer&lt;br&gt;actually runs before the call, because the&lt;br&gt;answer changes the plan by a day." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="754" width="410" height="158" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Discovery does not feed Red Teaming&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="510" y="724" width="440" height="198" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="An agent that turns up in SCM cloud&lt;br&gt;discovery does not become a scannable&lt;br&gt;target. There is no action on a discovered&lt;br&gt;asset that creates one.&lt;br&gt;&lt;br&gt;Discovery is read-only inventory. Targets&lt;br&gt;are created by hand under AI Security,&lt;br&gt;AI Red Teaming, Targets, one at a time,&lt;br&gt;with the connection details typed in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="526" y="754" width="410" height="158" as="geometry"/>
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;A bridge can beat a working connector&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="980" y="724" width="440" height="198" as="geometry"/>
        </mxCell>
        <mxCell id="c3b" value="A native Bedrock model target asks you to&lt;br&gt;paste long-lived IAM keys into a SaaS&lt;br&gt;console. A bridge never holds a cloud&lt;br&gt;credential at all: it wears an execution role&lt;br&gt;or a managed identity while it runs, and the&lt;br&gt;only secret in SCM is a bearer token you&lt;br&gt;can rotate or revoke on your own.&lt;br&gt;&lt;br&gt;Raise that with a security team that balks&lt;br&gt;at the keys. It is often the deciding factor." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="996" y="754" width="410" height="158" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
