<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Type 3 Signing and Auth Proxy" id="airs-red-wrapper-signing-proxy">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Type 3 &#8212; signing and token-refresh proxies" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Two problems the platform cannot solve on its own: it does not sign requests, and it does not refresh a token that expires in the middle of a five-hour scan. Both are closed by a service that sits in the path and adds what is missing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ SIGV4 ============ -->
        <mxCell id="sg" value="A&#160;&#160;&#8212;&#160;&#160;SIGV4 SIGNING PROXY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#E5A300;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1380" height="214" as="geometry"/>
        </mxCell>
        <mxCell id="sg-airs" value="&lt;b&gt;AI Red Teaming&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Sends an unsigned&lt;br&gt;JSON body&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="sg-proxy" value="&lt;b&gt;Signing proxy&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Reads the body, computes the canonical request and&lt;br&gt;the HMAC-SHA256 digest over it, and adds the three&lt;br&gt;headers AWS expects before forwarding:&lt;br&gt;&lt;font style=&quot;font-family:Courier New&quot;&gt;Authorization&#160;&#160;&#183;&#160;&#160;x-amz-date&#160;&#160;&#183;&#160;&#160;x-amz-content-sha256&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="470" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="sg-agent" value="&lt;b&gt;API Gateway endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;service name execute-api.&lt;br&gt;Rejects anything unsigned.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="150" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="sg-e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="sg-airs" target="sg-proxy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sg-e1l" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;POST, bearer token&lt;br&gt;no signature&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="276" y="156" width="198" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="sg-e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="sg-proxy" target="sg-agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sg-e2l" value="&lt;font style=&quot;font-size:10px;color:#22c55e&quot;&gt;&lt;b&gt;signed&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="956" y="162" width="198" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sg-warn" value="&lt;font style=&quot;color:#ef4444&quot;&gt;&lt;b&gt;This pattern does not reach a Bedrock Agent.&lt;/b&gt;&lt;/font&gt;&#160;&#160;It streams the upstream body straight back, which suits execute-api. InvokeAgent answers with a chunked event stream instead of a JSON document, so the platform receives bytes that {RESPONSE} cannot map. That needs the Bedrock bridge, which collapses the stream into one body." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="266" width="1320" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ OKTA ============ -->
        <mxCell id="ok" value="B&#160;&#160;&#8212;&#160;&#160;OKTA TOKEN-REFRESH PROXY, STRATEGY C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#8b5cf6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1380" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="ok-airs" value="&lt;b&gt;AI Red Teaming&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Holds one static bearer&lt;br&gt;token for the proxy, and&lt;br&gt;nothing that expires&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="386" width="200" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="ok-proxy" value="&lt;b&gt;Token-refresh proxy&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Holds a long-lived refresh token. Before forwarding,&lt;br&gt;it checks the cached access token and exchanges for&lt;br&gt;a fresh one if it expires within the next two minutes,&lt;br&gt;then injects it and passes the body through unchanged.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="386" width="470" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="ok-idp" value="&lt;b&gt;Okta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;/oauth2/v1/token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="534" width="190" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ok-agent" value="&lt;b&gt;The agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Sees a valid Okta access&lt;br&gt;token on every request,&lt;br&gt;hour five included.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="386" width="230" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="ok-e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;" edge="1" parent="1" source="ok-airs" target="ok-proxy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ok-e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="ok-proxy" target="ok-agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ok-e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;dashed=1;dashPattern=8 4;startArrow=block;startFill=1;" edge="1" parent="1" source="ok-proxy" target="ok-idp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ok-e3l" value="&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;refresh, only when the cached token is about to expire&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="542" width="300" height="34" as="geometry"/>
        </mxCell>

        <!-- ============ STRATEGY TABLE ============ -->
        <mxCell id="st-title" value="Try the cheaper Okta strategies first" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="606" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="st-lede" value="An Attack Library scan runs for roughly five hours. A one-hour token expires four times inside it, and the platform will not renew one on your behalf." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="1380" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="sh1" value="Strategy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="400" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="sh2" value="Effort" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="660" width="240" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="sh3" value="What it costs you" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="660" width="740" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="s1a" value="&lt;b&gt;A&lt;/b&gt;&#160;&#160;A service account with a non-expiring token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="400" height="38" as="geometry"/></mxCell>
        <mxCell id="s1b" value="A conversation with the identity team" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="688" width="240" height="38" as="geometry"/></mxCell>
        <mxCell id="s1c" value="Nothing technical. Some organizations will not issue one, which is the only reason this is not always the answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="688" width="740" height="38" as="geometry"/></mxCell>
        <mxCell id="s2a" value="&lt;b&gt;B&lt;/b&gt;&#160;&#160;Scan inside the token lifetime and restart by hand" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="726" width="400" height="38" as="geometry"/></mxCell>
        <mxCell id="s2b" value="None to build" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="726" width="240" height="38" as="geometry"/></mxCell>
        <mxCell id="s2c" value="Someone has to be present to restart the scan, and the run arrives as several partial reports rather than one" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="726" width="740" height="38" as="geometry"/></mxCell>
        <mxCell id="s3a" value="&lt;b&gt;C&lt;/b&gt;&#160;&#160;The refresh proxy above" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="764" width="400" height="38" as="geometry"/></mxCell>
        <mxCell id="s3b" value="A service to build, host, and retire" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="764" width="240" height="38" as="geometry"/></mxCell>
        <mxCell id="s3c" value="It now holds a long-lived refresh token, and it has to respect Okta's own rate limits on token exchange" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="764" width="740" height="38" as="geometry"/></mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;Signing belongs in pre_process, never in authenticate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="828" width="680" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="Where Kubernetes is available, a Custom Target Adapter replaces&lt;br&gt;both proxies on this page and neither of them has to be hosted.&lt;br&gt;&lt;br&gt;Put the signature in pre_process, because a SigV4 or HMAC digest&lt;br&gt;covers the request body and the body does not exist yet when&lt;br&gt;authenticate() runs. Use authenticate() for the token exchange,&lt;br&gt;where its TTL caching earns its keep." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="858" width="650" height="112" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;A proxy holding credentials is a target of its own&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="828" width="680" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="Either proxy ends up holding the material that reaches the agent:&lt;br&gt;an AWS access key pair, or a refresh token good for the length of&lt;br&gt;the engagement. Both are more valuable than the bearer token&lt;br&gt;standing in front of them.&lt;br&gt;&lt;br&gt;Keep it off the public internet where you can, give it credentials&lt;br&gt;scoped to the one agent, and retire it when scanning ends." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="858" width="650" height="112" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
