<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Bedrock Agent Bridge" id="airs-red-bridge-bedrock">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Bridge A &#8212; reaching an AWS Bedrock Agent" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="A small Lambda that speaks plain JSON on one side and InvokeAgent on the other. It exists because the BEDROCK connection method reaches InvokeModel, carries no agent identifier, and could not read the answer if it did." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ FLOW ============ -->
        <mxCell id="airs" value="&lt;b&gt;AI Red Teaming&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Target type &lt;b&gt;Agent&lt;/b&gt;,&lt;br&gt;connection method&lt;br&gt;&lt;b&gt;REST API&lt;/b&gt;, accessibility&lt;br&gt;&lt;b&gt;Public&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="210" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="aws" value="&lt;b&gt;YOUR AWS ACCOUNT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#E5A300;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="950" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="lam" value="&lt;b&gt;Lambda function URL&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#ef4444&quot;&gt;AuthType NONE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:Courier New;color:#666666&quot;&gt;https://&amp;lt;id&amp;gt;.lambda-url.us-east-1.on.aws/&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;&lt;b&gt;1&lt;/b&gt;&#160;&#160;hmac.compare_digest on the bearer token. This check,&lt;br&gt;&#160;&#160;&#160;&#160;&#160;inside the handler, is the actual gate on the function.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&#160;&#160;boto3 signs InvokeAgent with the execution role's&lt;br&gt;&#160;&#160;&#160;&#160;&#160;credentials. Nothing long-lived is stored anywhere.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&#160;&#160;Collapses the returned event stream into one string.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="130" width="480" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="role" value="&lt;b&gt;Execution role&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;worn while the function runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#E5A300;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="500" y="288" width="230" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cfg" value="&lt;font style=&quot;font-size:9px;font-family:Courier New;color:#666666&quot;&gt;read_timeout=120, connect_timeout=10, retries max 2&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="744" y="288" width="236" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="bag" value="&lt;b&gt;Bedrock Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;bedrock-agent-runtime&lt;br&gt;&lt;b&gt;InvokeAgent&lt;/b&gt;&lt;br&gt;&lt;br&gt;agentId&#160;&#183;&#160;agentAliasId&lt;br&gt;sessionId&#160;&#183;&#160;inputText&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="130" width="230" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="airs" target="lam"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1l" value="&lt;font style=&quot;font-size:10px;color:#006DCC&quot;&gt;&lt;b&gt;POST&lt;/b&gt;, Authorization: Bearer&lt;br&gt;{&quot;prompt&quot;: &quot;{INPUT}&quot;, &quot;session_id&quot;: &quot;&quot;}&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="254" y="118" width="244" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=0;exitY=0.82;exitDx=0;exitDy=0;entryX=1;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="lam" target="airs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2l" value="&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;{&quot;output&quot;: &quot;{RESPONSE}&quot;, &quot;session_id&quot;: &quot;&quot;}&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="254" y="244" width="244" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="lam" target="bag"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3l" value="&lt;font style=&quot;font-size:10px;color:#22c55e&quot;&gt;&lt;b&gt;SigV4 signed&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="984" y="140" width="172" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;dashed=1;dashPattern=8 4;exitX=0;exitY=0.82;exitDx=0;exitDy=0;entryX=1;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="bag" target="lam"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4l" value="&lt;font style=&quot;font-size:10px;color:#ef4444&quot;&gt;a chunked&lt;br&gt;&lt;b&gt;event stream&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="984" y="252" width="172" height="40" as="geometry"/>
        </mxCell>

        <!-- ============ WHY ============ -->
        <mxCell id="why-title" value="Three reasons there is no connector for this" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="362" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="wh1" value="The obstacle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="394" width="480" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="wh2" value="Why no setting in the console gets around it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="394" width="900" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="y1a" value="BEDROCK reaches InvokeModel only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="480" height="34" as="geometry"/></mxCell>
        <mxCell id="y1b" value="The connection method has no field for an agent id or an alias id, so there is nowhere to say which agent you mean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="422" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="y2a" value="InvokeAgent requires a SigV4 signature" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="480" height="34" as="geometry"/></mxCell>
        <mxCell id="y2b" value="A REST target sends the headers you type in. It cannot compute a digest over a body it has just generated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="456" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="y3a" value="InvokeAgent returns an event stream" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="480" height="34" as="geometry"/></mxCell>
        <mxCell id="y3b" value="{RESPONSE} maps a field inside a JSON document. A chunked stream has no such field, which is why a signing proxy alone still fails here" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="490" width="900" height="34" as="geometry"/></mxCell>

        <!-- ============ FOUR PIECES ============ -->
        <mxCell id="fp-title" value="The four pieces, and where each one lives" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="552" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="ph1" value="Piece" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="584" width="260" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="ph2" value="What it is" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="584" width="620" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="ph3" value="Where it lives" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="584" width="500" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="p1a" value="The program" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="260" height="34" as="geometry"/></mxCell>
        <mxCell id="p1b" value="handler.py, zipped and uploaded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="612" width="620" height="34" as="geometry"/></mxCell>
        <mxCell id="p1c" value="A folder on your own machine until the deploy step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="612" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="p2a" value="A permissions badge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="646" width="260" height="34" as="geometry"/></mxCell>
        <mxCell id="p2b" value="An IAM execution role the function wears while it runs, so no cloud credential is stored" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="646" width="620" height="34" as="geometry"/></mxCell>
        <mxCell id="p2c" value="Your AWS account. Allow a moment for IAM to propagate before the first invoke" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="646" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="p3a" value="A public address" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="260" height="34" as="geometry"/></mxCell>
        <mxCell id="p3b" value="A Lambda function URL, created by the deploy step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="680" width="620" height="34" as="geometry"/></mxCell>
        <mxCell id="p3c" value="Pasted into SCM as the Endpoint URL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="680" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="p4a" value="A bearer token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="714" width="260" height="34" as="geometry"/></mxCell>
        <mxCell id="p4b" value="A 64-character hex string the handler compares against. Any request without it is rejected" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="714" width="620" height="34" as="geometry"/></mxCell>
        <mxCell id="p4c" value="Generated during deploy, pasted into the Authorization header in SCM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="714" width="500" height="34" as="geometry"/></mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;AuthType NONE is deliberate, and the token is the real gate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="776" width="680" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="A function URL set to AWS_IAM would need the caller to sign the&lt;br&gt;request, which is the thing the platform cannot do. Hence NONE,&lt;br&gt;with the bearer check moved inside the handler.&lt;br&gt;&lt;br&gt;Treat the result as internet-reachable and gated by one secret.&lt;br&gt;Rotate the token at the end of the engagement and delete the&lt;br&gt;function URL once scanning is finished, the same as you would&lt;br&gt;retire any other test target." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="806" width="650" height="116" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Two details that cost an afternoon each&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="776" width="680" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="&lt;b&gt;Use a real alias, not TSTALIASID.&lt;/b&gt; The draft test alias points at&lt;br&gt;whatever is currently in the console editor, so a scan against it is&lt;br&gt;not reproducible. Find the agent id under Agents, and the alias id&lt;br&gt;in the Aliases section beneath it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Give the agent time to answer.&lt;/b&gt; A prompt that sets the agent off&lt;br&gt;calling tools takes far longer than a model completion, which is&lt;br&gt;why the client is built with a 120-second read timeout." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="806" width="650" height="116" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="Test the bridge with curl until it returns HTTP 200 before opening the console. The wizard reports only that validation failed, so every problem you carry in with you is harder to diagnose there than it was in your terminal." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="944" width="1380" height="24" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
