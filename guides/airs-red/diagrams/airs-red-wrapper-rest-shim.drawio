<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Type 1 REST Shim" id="airs-red-wrapper-rest-shim">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Type 1 &#8212; a REST shim in front of an agent with no HTTP face" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="The platform speaks HTTP and nothing else. An agent reachable only through a Python or Java SDK, or over gRPC or SOAP, has no address for it to POST to. A thin FastAPI application with one route gives it one." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ FLOW ============ -->
        <mxCell id="airs" value="&lt;b&gt;AI Red Teaming&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Target configured as a plain&lt;br&gt;REST endpoint. Nothing in the&lt;br&gt;console hints at a shim.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="240" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="env" value="&lt;b&gt;THE AGENT'S OWN RUNTIME&lt;/b&gt;&#160;&#160;&#160;same container, same VPC, or same host" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=10;fontStyle=1;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="90" width="920" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="shim" value="&lt;b&gt;REST shim&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;FastAPI or Flask, one POST route&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Checks the bearer token, pulls the last user message&lt;br&gt;out of the messages array, calls the agent the only way&lt;br&gt;it can be called, and shapes the answer back into JSON.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="130" width="420" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;The agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;agent_sdk.chat(system=..., user=...)&lt;br&gt;or a gRPC stub, or a SOAP envelope,&lt;br&gt;or an AMQP message&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1130" y="130" width="260" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="airs" target="shim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a1l" value="&lt;font style=&quot;font-size:10px;color:#006DCC&quot;&gt;&lt;b&gt;HTTPS POST /chat&lt;/b&gt;&lt;br&gt;Authorization: Bearer &amp;lt;token&amp;gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="286" y="110" width="238" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="shim" target="airs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2l" value="&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;&lt;b&gt;HTTP 200&lt;/b&gt; with the reply at the mapped path&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="286" y="228" width="238" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="a3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="shim" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3l" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;the native call&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="955" y="136" width="170" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="a4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;dashed=1;dashPattern=8 4;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="shim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4l" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;response.text&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="955" y="228" width="170" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="co" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;The shim runs where the SDK can reach the agent. That is the whole reason it exists, and it is also why it cannot be hosted anywhere convenient.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="530" y="258" width="860" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ CODE ============ -->
        <mxCell id="code-title" value="The route, stripped to what matters" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="314" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="code" value="@app.post(&quot;/chat&quot;)&lt;br&gt;async def chat(request: ChatRequest, _=Depends(verify_token)):&lt;br&gt;&#160;&#160;&#160;&#160;&lt;font style=&quot;color:#22c55e&quot;&gt;# {INPUT} lands in the last user message&lt;/font&gt;&lt;br&gt;&#160;&#160;&#160;&#160;user_message&#160;&#160;= next((m.content for m in reversed(request.messages) if m.role == &quot;user&quot;), &quot;&quot;)&lt;br&gt;&#160;&#160;&#160;&#160;system_prompt = next((m.content for m in request.messages if m.role == &quot;system&quot;), &quot;&quot;)&lt;br&gt;&lt;br&gt;&#160;&#160;&#160;&#160;response = agent_sdk.chat(system=system_prompt, user=user_message)&lt;br&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&lt;font style=&quot;color:#22c55e&quot;&gt;# OpenAI-shaped, so the response template is a path the customer already knows&lt;/font&gt;&lt;br&gt;&#160;&#160;&#160;&#160;return {&quot;choices&quot;: [{&quot;message&quot;: {&quot;role&quot;: &quot;assistant&quot;, &quot;content&quot;: response.text}, &quot;finish_reason&quot;: &quot;stop&quot;}]}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="346" width="1380" height="166" as="geometry"/>
        </mxCell>

        <!-- ============ WIZARD VALUES ============ -->
        <mxCell id="wv-title" value="What goes in the wizard" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="wh1" value="Field" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="562" width="300" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="wh2" value="Value" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="562" width="1080" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="w1a" value="Connection method" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="w1b" value="REST API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="590" width="1080" height="30" as="geometry"/></mxCell>
        <mxCell id="w2a" value="Endpoint URL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="w2b" value="https://&amp;lt;shim-host&amp;gt;:8080/chat" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="620" width="1080" height="30" as="geometry"/></mxCell>
        <mxCell id="w3a" value="Authorization header" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="w3b" value="Bearer &amp;lt;token the shim checks&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="650" width="1080" height="30" as="geometry"/></mxCell>
        <mxCell id="w4a" value="Request JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="w4b" value="{&quot;messages&quot;:[{&quot;role&quot;:&quot;system&quot;,&quot;content&quot;:&quot;...&quot;},{&quot;role&quot;:&quot;user&quot;,&quot;content&quot;:&quot;{INPUT}&quot;}]}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="680" width="1080" height="30" as="geometry"/></mxCell>
        <mxCell id="w5a" value="Response JSON path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="w5b" value="choices[0].message.content" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="710" width="1080" height="30" as="geometry"/></mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;Anything other than 200 is an error, not a finding&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="766" width="680" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="The shim has to return HTTP 200 with a JSON body at the mapped&lt;br&gt;path. A 500 on a prompt the SDK did not like becomes a scan error&lt;br&gt;and the attack is lost, so catch exceptions inside the route and&lt;br&gt;return the failure text as content instead of letting it escape." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="796" width="650" height="74" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Reach for the adapter first&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="766" width="680" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="Where there is Kubernetes near the agent, a Custom Target Adapter&lt;br&gt;does this job with nothing extra to host, and no new internet-facing&lt;br&gt;service to secure and decommission. Build time here is two to four&lt;br&gt;hours for a single-method SDK, four to eight once gRPC stubs are in it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="796" width="650" height="74" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
