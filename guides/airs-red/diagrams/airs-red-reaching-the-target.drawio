<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Reaching the Target" id="airs-red-reaching-the-target">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1330" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Getting in front of the application" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="AI Red Teaming is a client of the target, not a layer in front of it. The platform makes every call; the only question is which route the attack prompts take to arrive. Five routes exist, and the first one that fits is the one to use." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ THE PLATFORM ============ -->
        <mxCell id="platform" value="&lt;b&gt;AI Red Teaming&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SaaS data plane&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Builds the attack prompt,&lt;br&gt;sends it, reads the reply,&lt;br&gt;scores the result.&lt;br&gt;&lt;br&gt;Always the caller.&lt;br&gt;Never in the live path of&lt;br&gt;the application's own users.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="170" height="672" as="geometry"/>
        </mxCell>

        <!-- ============ LANE 1 - PUBLIC ============ -->
        <mxCell id="l1" value="1&#160;&#160;&#8212;&#160;&#160;PUBLIC ENDPOINT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontStyle=1;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="1180" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="l1-mid" value="&lt;b&gt;Public internet&lt;/b&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="120" width="190" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l1-tgt" value="&lt;b&gt;Agent endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;answers HTTPS from anywhere&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1110" y="120" width="290" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l1-a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;exitX=1;exitY=0.09;exitDx=0;exitDy=0;" edge="1" parent="1" source="platform" target="l1-mid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l1-a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="l1-mid" target="l1-tgt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l1-lbl" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;TLS, from the static&lt;br&gt;AIRS egress IP&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="680" y="118" width="420" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l1-note" value="&lt;b&gt;Nothing to deploy.&lt;/b&gt;&#160;&#160;Plain HTTP is rejected, so the endpoint must already terminate TLS. If it filters on source IP, the egress address is in the wizard tooltip beside the Public option." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="256" y="186" width="1150" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ LANE 2 - IP ALLOWLIST ============ -->
        <mxCell id="l2" value="2&#160;&#160;&#8212;&#160;&#160;PRIVATE, REACHED BY IP ALLOWLIST" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3b82f6;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontStyle=1;fontColor=#3b82f6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="224" width="1180" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="l2-mid" value="&lt;b&gt;Customer firewall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;inbound rule permitting&lt;br&gt;the AIRS egress IP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="254" width="300" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l2-tgt" value="&lt;b&gt;Agent endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;private network, inbound permitted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1110" y="254" width="290" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l2-a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#3b82f6;exitX=1;exitY=0.27;exitDx=0;exitDy=0;" edge="1" parent="1" source="platform" target="l2-mid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l2-a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#3b82f6;" edge="1" parent="1" source="l2-mid" target="l2-tgt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l2-lbl" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;still inbound over the internet, now from one known address&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="780" y="252" width="320" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l2-note" value="&lt;b&gt;No software to install,&lt;/b&gt;&#160;&#160;but a firewall change ticket usually takes one to five business days. Raise it during pre-engagement discovery, not on the deployment call." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="256" y="320" width="1150" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ LANE 3 - NETWORK CHANNEL ============ -->
        <mxCell id="l3" value="3&#160;&#160;&#8212;&#160;&#160;PRIVATE, REACHED BY NETWORK CHANNEL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E5A300;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontStyle=1;fontColor=#E5A300;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="358" width="1180" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="l3-mid" value="&lt;b&gt;Network Channel client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Helm chart in your Kubernetes cluster&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="388" width="300" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l3-tgt" value="&lt;b&gt;Agent endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;private network, no inbound rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1110" y="388" width="290" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l3-a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;dashed=1;dashPattern=8 4;exitX=1;exitY=0.46;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="platform" target="l3-mid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l3-a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;" edge="1" parent="1" source="l3-mid" target="l3-tgt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l3-lbl1" value="&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;&lt;b&gt;the cluster dials out&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="386" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="l3-lbl2" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;attack prompts ride back down the open tunnel, then cross the private network&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="780" y="386" width="320" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l3-note" value="&lt;b&gt;Outbound WebSocket only.&lt;/b&gt;&#160;&#160;Three FQDNs must already be open from the cluster: api.sase.paloaltonetworks.com, auth.apps.paloaltonetworks.com, registry.ai-red-teaming.paloaltonetworks.com" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="256" y="454" width="1150" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ LANE 4 - CUSTOM ADAPTER ============ -->
        <mxCell id="l4" value="4&#160;&#160;&#8212;&#160;&#160;CUSTOM TARGET ADAPTER, INSIDE THE CHANNEL POD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontStyle=1;fontColor=#8b5cf6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="492" width="1180" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="l4-mid" value="&lt;b&gt;Adapter sidecar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;localhost:8010 beside the channel client&lt;br&gt;runs your Python script&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="522" width="300" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l4-tgt" value="&lt;b&gt;Agent on any transport&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;WebSocket, gRPC, GraphQL, SDK, signed HTTP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1110" y="522" width="290" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l4-a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#8b5cf6;exitX=1;exitY=0.66;exitDx=0;exitDy=0;" edge="1" parent="1" source="platform" target="l4-mid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l4-a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#8b5cf6;" edge="1" parent="1" source="l4-mid" target="l4-tgt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l4-lbl" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;your code chooses the protocol, the framing, and the signature&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="780" y="520" width="320" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l4-note" value="&lt;b&gt;Route 3 is a prerequisite.&lt;/b&gt;&#160;&#160;Channel client v1.4.0 or higher with adapterSidecar.enabled=true. The script is written and maintained by the customer; budget a development sprint for a non-trivial protocol." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="256" y="588" width="1150" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ LANE 5 - WRAPPER ============ -->
        <mxCell id="l5" value="5&#160;&#160;&#8212;&#160;&#160;WRAPPER OR BRIDGE, WHEN THERE IS NO KUBERNETES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontStyle=1;fontColor=#ef4444;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="626" width="1180" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="l5-mid" value="&lt;b&gt;Your HTTPS service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;REST shim&#160;&#183;&#160;REST-to-WebSocket&#160;&#183;&#160;signing proxy&lt;br&gt;Bedrock bridge&#160;&#183;&#160;Foundry bridge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="656" width="300" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l5-tgt" value="&lt;b&gt;Agent with no reachable HTTP face&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SDK only, signed only, or a managed runtime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1110" y="656" width="290" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l5-a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;exitX=1;exitY=0.86;exitDx=0;exitDy=0;" edge="1" parent="1" source="platform" target="l5-mid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l5-a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="l5-mid" target="l5-tgt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l5-lbl1" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;plain REST, bearer token&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="654" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="l5-lbl2" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;the native call: SDK method, SigV4 request, managed identity&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="780" y="654" width="320" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l5-note" value="&lt;b&gt;Customer built and customer maintained.&lt;/b&gt;&#160;&#160;Palo Alto Networks does not write wrappers. Where Kubernetes is available, route 4 does the same work with nothing extra to host, monitor, or secure." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="256" y="722" width="1150" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ DECISION TABLE ============ -->
        <mxCell id="tbl-title" value="Picking a route &#8212; stop at the first row that matches" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="788" width="900" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="h1" value="Your situation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="822" width="430" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Route" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="822" width="250" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="What you deploy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="822" width="380" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h4" value="Lead time to plan for" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="822" width="320" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="t1a" value="The endpoint answers HTTPS from the internet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="852" width="430" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t1b" value="&lt;b&gt;1&lt;/b&gt;&#160;&#160;Public" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="852" width="250" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t1c" value="Nothing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="720" y="852" width="380" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t1d" value="None, unless the endpoint filters on source IP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1100" y="852" width="320" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="t2a" value="It is private, and one inbound rule can be added for it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="896" width="430" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t2b" value="&lt;b&gt;2&lt;/b&gt;&#160;&#160;Private, IP allowlist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="896" width="250" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t2c" value="Nothing. A firewall rule for the AIRS egress IP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="720" y="896" width="380" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t2d" value="One to five business days for change approval" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1100" y="896" width="320" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="t3a" value="It is private and inbound rules are not permitted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="430" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t3b" value="&lt;b&gt;3&lt;/b&gt;&#160;&#160;Private, Network Channel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="940" width="250" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t3c" value="The Helm chart, in any Kubernetes distribution that can reach the agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="720" y="940" width="380" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t3d" value="30 to 60 minutes with a cluster already running, plus whatever opening the three FQDNs takes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1100" y="940" width="320" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="t4a" value="The transport is not HTTP, or every request must be signed, and Kubernetes is available" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="984" width="430" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="t4b" value="&lt;b&gt;4&lt;/b&gt;&#160;&#160;Custom Target Adapter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="984" width="250" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="t4c" value="A Python script in the adapter sidecar. Pattern B for a non-HTTP transport, pre_process for a signature" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="720" y="984" width="380" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="t4d" value="A development sprint for a non-trivial protocol, and a support request if the script needs a package beyond stdlib, httpx, and websockets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1100" y="984" width="320" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="t5a" value="Same as the row above, but there is no Kubernetes anywhere near the agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1036" width="430" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t5b" value="&lt;b&gt;5&lt;/b&gt;&#160;&#160;Wrapper" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="1036" width="250" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t5c" value="A FastAPI service you host and secure yourself" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="720" y="1036" width="380" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t5d" value="2 to 8 hours of development, longer with stateful sessions or mTLS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1036" width="320" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="t6a" value="The target is an AWS Bedrock Agent or an Azure AI Foundry agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="430" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="t6b" value="&lt;b&gt;5&lt;/b&gt;&#160;&#160;Bridge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="1080" width="250" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="t6c" value="A Lambda function URL, or an Azure Function App. No route reaches either runtime natively" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="720" y="1080" width="380" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="t6d" value="Half a day, most of it spent on the permissions badge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1080" width="320" height="48" as="geometry"/>
        </mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;Nothing is installed in front of the live application&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1152" width="680" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="Red Teaming never sits between the application and its real users.&lt;br&gt;It opens a second door and knocks on it, the same way any other API&lt;br&gt;client would. Routes 4 and 5 add a component, but that component&lt;br&gt;carries scan traffic only.&lt;br&gt;&lt;br&gt;AI Gateway and Network Intercept are the products that do sit in the&lt;br&gt;live path. Keeping the three apart saves a long conversation with a&lt;br&gt;customer who has heard that one of them needs a maintenance window." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="1182" width="650" height="116" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Prefer the adapter over a wrapper wherever Kubernetes exists&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="1152" width="680" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="Routes 4 and 5 solve the same problems. The adapter wins because&lt;br&gt;Palo Alto Networks manages its execution lifecycle, it already has&lt;br&gt;private network access through the channel, and there is no extra&lt;br&gt;internet-facing service to host, patch, and take down afterwards.&lt;br&gt;&lt;br&gt;Either way the code belongs to the customer. Find out on the&lt;br&gt;discovery call whether a developer is available, because a target&lt;br&gt;that needs route 4 or 5 is not a configuration task." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="1182" width="650" height="116" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
