<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Multi-Turn Sessions" id="airs-red-multi-turn">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1066" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Multi-turn &#8212; who is remembering the conversation" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Some of the strongest attacks work by building across turns rather than landing in one prompt. Whether that is possible comes down to a single question: does the target keep the conversation, or do you have to hand it back every time?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ STATELESS ============ -->
        <mxCell id="sl" value="STATELESS&#160;&#160;&#8212;&#160;&#160;SESSIONS SET TO NO, THE PLATFORM CARRIES THE HISTORY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3b82f6;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#3b82f6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="680" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="sl-t1" value="&lt;b&gt;turn 1&lt;/b&gt;&#160;&#160;&#8594;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;[ user: attack 1 ]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3b82f6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="66" y="140" width="628" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sl-t2" value="&lt;b&gt;turn 2&lt;/b&gt;&#160;&#160;&#8594;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;[ user: attack 1, assistant: reply 1, user: attack 2 ]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3b82f6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="66" y="196" width="628" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sl-t3" value="&lt;b&gt;turn 3&lt;/b&gt;&#160;&#160;&#8594;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;[ user: attack 1, assistant: reply 1, user: attack 2, assistant: reply 2, user: attack 3 ]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3b82f6;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="66" y="252" width="628" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sl-note" value="Every request is complete on its own, and it grows. The agent rebuilds the context from the history array each time and holds nothing between calls.&lt;br&gt;&lt;br&gt;&lt;b&gt;The field to get right&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;assistant_role&lt;/font&gt;&#160;&#160;the label this agent uses for its own messages in the history, often assistant.&lt;br&gt;&lt;br&gt;&lt;b&gt;Use it when&lt;/b&gt; the target is a standard stateless REST API with no session management of its own, which is the common case for anything built as a thin wrapper over a model." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="66" y="316" width="628" height="170" as="geometry"/>
        </mxCell>

        <!-- ============ STATEFUL ============ -->
        <mxCell id="sf" value="STATEFUL&#160;&#160;&#8212;&#160;&#160;SESSIONS SET TO YES, THE TARGET CARRIES THE HISTORY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="100" width="680" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="sf-t1" value="&lt;b&gt;turn 1&lt;/b&gt;&#160;&#160;&#8594;&#160;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ message: attack 1 }&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#22c55e&quot;&gt;&#8592;&#160;&#160;the reply, and a session id the target just minted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="766" y="140" width="628" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sf-t2" value="&lt;b&gt;turn 2&lt;/b&gt;&#160;&#160;&#8594;&#160;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ session_id: abc, message: attack 2 }&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#22c55e&quot;&gt;&#8592;&#160;&#160;the reply, with the same session id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="766" y="196" width="628" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sf-t3" value="&lt;b&gt;turn 3&lt;/b&gt;&#160;&#160;&#8594;&#160;&#160;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ session_id: abc, message: attack 3 }&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;the request stays the same size however long the conversation runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22c55e;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="766" y="252" width="628" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sf-note" value="The target keeps the conversation behind a session id. The platform's only job is to read that id out of one response and put it back into the next request.&lt;br&gt;&lt;br&gt;&lt;b&gt;The two fields to get right&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;response_id_field&lt;/font&gt;&#160;&#160;the JSON path where the session id appears in the response&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px&quot;&gt;request_id_field&lt;/font&gt;&#160;&#160;the JSON path where it is injected on the next request&lt;br&gt;&lt;br&gt;&lt;b&gt;Use it when&lt;/b&gt; the agent manages its own history server-side, which includes both bridges in the appendix: each maps a session id onto an upstream conversation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="766" y="316" width="628" height="170" as="geometry"/>
        </mxCell>

        <!-- ============ WHERE IT CANNOT HAPPEN ============ -->
        <mxCell id="nope-title" value="Where multi-turn is not available at all" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="528" width="900" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="h1" value="Connection method" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="300" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Multi-turn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="560" width="220" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="What to do about it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="560" width="860" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="r1a" value="REST API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="r1b" value="Stateful or stateless" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="588" width="220" height="34" as="geometry"/></mxCell>
        <mxCell id="r1c" value="Nothing. Turn it on in Wizard Step 5 and fill in the fields for whichever mode the agent uses" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="588" width="860" height="34" as="geometry"/></mxCell>

        <mxCell id="r2a" value="STREAMING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="622" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="r2b" value="Stateful or stateless" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="622" width="220" height="34" as="geometry"/></mxCell>
        <mxCell id="r2c" value="Nothing. Multi-turn configuration is available on this method too" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="622" width="860" height="34" as="geometry"/></mxCell>

        <mxCell id="r3a" value="WEBSOCKET" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="r3b" value="&lt;font style=&quot;color:#ef4444&quot;&gt;&lt;b&gt;Neither&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="656" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="r3c" value="The connection closes after every prompt, so there is no session to configure. Use a Custom Target Adapter with call_target, or a REST-to-WebSocket wrapper" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="656" width="860" height="42" as="geometry"/></mxCell>

        <mxCell id="r4a" value="CUSTOM, through an adapter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="698" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="r4b" value="Whatever you implement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="698" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="r4c" value="session_pre_process() creates the server-side session once per conversation, and context.session carries it into every later turn. It resets between conversations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="698" width="860" height="42" as="geometry"/></mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;Handing over the system prompt is the strongest thing you can do&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="768" width="680" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="Filling in system_prompt on the target profile turns the run into&lt;br&gt;white-box testing, the most effective mode available. The attack&lt;br&gt;agent reads the instructions and the guardrails it has to get past,&lt;br&gt;and writes prompts aimed at those specific sentences.&lt;br&gt;&lt;br&gt;Customers hesitate because it feels like handing over the keys.&lt;br&gt;The answer is that an attacker who finds a System Prompt Leak&lt;br&gt;gets it anyway, and the point of the exercise is to find out what&lt;br&gt;happens next." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="798" width="650" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Multi-turn is where the interesting failures are&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="768" width="680" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="A target that refuses every single-turn attack can still be walked&lt;br&gt;into the same answer over four polite exchanges. Multi-Turn is&lt;br&gt;one of the nine Security subcategories for exactly that reason,&lt;br&gt;and it is the category a chatbot with good filters most often fails.&lt;br&gt;&lt;br&gt;So a WebSocket target scanned on the native method is not&lt;br&gt;getting a complete assessment, however clean the report looks.&lt;br&gt;Say so before the customer reads a low risk score as an all-clear." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="798" width="650" height="160" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
