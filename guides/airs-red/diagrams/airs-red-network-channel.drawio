        <mxCell id="fr2a" value="auth.apps.paloaltonetworks.com" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
