<mxfile host="app.diagrams.net" agent="Claude" version="26.0.0">
  <diagram name="AIRS Red Teaming - Network Channel" id="airs-red-network-channel">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="The Network Channel tunnel" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="For a target with no inbound rules. A client in your cluster dials out, the connection stays open, and the attack traffic travels back down the connection the cluster itself opened." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1380" height="24" as="geometry"/>
        </mxCell>

        <!-- ============ AIRS CLOUD ============ -->
        <mxCell id="cloud" value="&lt;b&gt;AI RED TEAMING CLOUD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F7FF;strokeColor=#66CCEE;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="280" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="broker" value="&lt;b&gt;Network Broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;/data-plane/network-broker/v1&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Terminates the tunnel and&lt;br&gt;routes scan traffic into it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="62" y="150" width="236" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="scanner" value="&lt;b&gt;Scan engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Builds and scores every&lt;br&gt;attack prompt, exactly as&lt;br&gt;it would for a public target&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66CCEE;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#00294D;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="62" y="276" width="236" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-note" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Nothing here knows or cares&lt;br&gt;that the target is private.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="62" y="376" width="236" height="40" as="geometry"/>
        </mxCell>

        <!-- ============ PERIMETER ============ -->
        <mxCell id="fw" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=9;fontFamily=Helvetica;fontColor=#ef4444;" vertex="1" parent="1">
          <mxGeometry x="524" y="110" width="16" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="fw-in" value="&lt;font style=&quot;font-size:10px;color:#ef4444&quot;&gt;&lt;b&gt;PERIMETER&lt;/b&gt;&#160;&#160;no inbound rule required&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="446" width="210" height="46" as="geometry"/>
        </mxCell>

        <!-- ============ CUSTOMER NETWORK ============ -->
        <mxCell id="custnet" value="&lt;b&gt;CUSTOMER NETWORK&lt;/b&gt;&#160;&#160;&#160;VPC, data center, or on-premises" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="540" y="110" width="880" height="330" as="geometry"/>
        </mxCell>

        <mxCell id="k8s" value="&lt;b&gt;KUBERNETES CLUSTER&lt;/b&gt;&#160;&#160;&#160;EKS, AKS, GKE, k3s, Minikube, or Kind on a VM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#22c55e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=10;fontStyle=1;fontColor=#22c55e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="570" y="150" width="460" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="pod" value="&lt;b&gt;panw-network-client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;namespace airs-red-teaming&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Installed by Helm with a client ID,&lt;br&gt;a client secret, and the channel UUID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="595" y="186" width="410" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="pod-res" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;CPU request 100m, limit 200m&#160;&#160;&#183;&#160;&#160;memory request 128Mi, limit 256Mi&lt;br&gt;Small enough to land on an existing node without a capacity conversation.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="595" y="306" width="410" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pod-ver" value="&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;&lt;b&gt;Service account needs the airt.network_channels_client permission.&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="595" y="352" width="410" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;Private AI system&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the target under test&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Reachable from the cluster.&lt;br&gt;Not reachable from the internet,&lt;br&gt;and it does not need to be.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#333333;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="186" width="250" height="140" as="geometry"/>
        </mxCell>

        <!-- ============ ARROWS ============ -->
        <mxCell id="a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#22c55e;dashed=1;dashPattern=8 4;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="pod" target="broker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a1-lbl" value="&lt;font style=&quot;font-size:10px;color:#22c55e&quot;&gt;&lt;b&gt;1&#160;&#160;outbound WSS on 443&lt;/b&gt;&lt;br&gt;the cluster dials out and holds the connection open&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="314" y="118" width="206" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="broker" target="pod">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2-lbl" value="&lt;font style=&quot;font-size:10px;color:#E5A300&quot;&gt;&lt;b&gt;2&#160;&#160;attack prompts&lt;/b&gt;&lt;br&gt;sent down the tunnel the client opened&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="314" y="282" width="206" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="a3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#E5A300;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="pod" target="agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3-lbl" value="&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;&lt;b&gt;3&lt;/b&gt;&#160;&#160;in-cluster HTTPS&lt;br&gt;to the agent&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1008" y="164" width="140" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="a4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#006DCC;dashed=1;dashPattern=8 4;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="pod">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a4-lbl" value="&lt;font style=&quot;font-size:10px;color:#006DCC&quot;&gt;&lt;b&gt;4&lt;/b&gt;&#160;&#160;the reply, back&lt;br&gt;the way it came&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1008" y="298" width="140" height="44" as="geometry"/>
        </mxCell>

        <!-- ============ FQDN TABLE ============ -->
        <mxCell id="fq-title" value="What has to be open before the deployment call" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="468" width="900" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="fq-lede" value="All three are outbound from the cluster. They cannot be opened in real time during the session, so test them with curl from inside the cluster beforehand." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
