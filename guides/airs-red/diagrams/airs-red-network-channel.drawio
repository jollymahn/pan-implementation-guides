          <mxGeometry x="460" y="586" width="300" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="fr2c" value="The client starts but cannot authenticate, so the channel shows OFFLINE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
