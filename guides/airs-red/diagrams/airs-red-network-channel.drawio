        <mxCell id="fr3a" value="registry.ai-red-teaming.paloaltonetworks.com" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="fr3b" value="Container registry, for the first image pull" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="620" width="300" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="fr3c" value="helm install fails at ImagePullBackOff, before anything else can be diagnosed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="760" y="620" width="660" height="34" as="geometry"/>
        </mxCell>

        <!-- ============ VERSION FLOOR ============ -->
        <mxCell id="v-title" value="Client version floors &#8212; check before you promise a capability" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#00294D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="686" width="900" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="vh1" value="Capability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="718" width="420" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="vh2" value="Minimum client version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="718" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="vh3" value="Detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00294D;strokeColor=#00294D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="718" width="740" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="vr1a" value="Custom SSL certificates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="748" width="420" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="vr1b" value="v1.0.4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="748" width="220" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="vr1c" value="Mount an internal CA bundle so the client trusts a privately issued certificate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="680" y="748" width="740" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="vr2a" value="HTTP or HTTPS proxy for the outbound leg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="420" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="vr2b" value="v1.0.5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="780" width="220" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="vr2c" value="Required wherever egress is forced through a proxy rather than allowed directly" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="680" y="780" width="740" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="vr3a" value="A WebSocket target reached through the channel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="812" width="420" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="vr3b" value="v1.3.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="812" width="220" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="vr3c" value="A public WebSocket target has no such floor. This applies only to a private one" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="680" y="812" width="740" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="vr4a" value="Custom Target Adapter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="844" width="420" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="vr4b" value="v1.4.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="844" width="220" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="vr4c" value="And adapterSidecar.enabled=true, which is off by default even on a current chart" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#dee2e6;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="680" y="844" width="740" height="32" as="geometry"/>
        </mxCell>

        <!-- ============ CALLOUTS ============ -->
        <mxCell id="c1" value="&lt;b&gt;Channel states, and what each one is telling you&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ff;strokeColor=#3b82f6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="908" width="680" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="&lt;b&gt;DRAFT&lt;/b&gt;&#160;&#160;The channel exists in the console; no client has connected yet.&lt;br&gt;This is the expected state between creating it and running Helm.&lt;br&gt;&lt;br&gt;&lt;b&gt;ONLINE&lt;/b&gt;&#160;&#160;The client is connected and the tunnel is live. A private target&lt;br&gt;cannot be validated until the channel reaches this state, because&lt;br&gt;validation sends a real probe through the tunnel.&lt;br&gt;&lt;br&gt;&lt;b&gt;OFFLINE&lt;/b&gt;&#160;&#160;The client has disconnected. Start with kubectl get pods -n&lt;br&gt;airs-red-teaming, then the three FQDNs, then the service account&lt;br&gt;permission." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="56" y="938" width="650" height="134" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;A Helm upgrade restarts the pod and interrupts running scans&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontFamily=Helvetica;fontColor=#00294D;" vertex="1" parent="1">
          <mxGeometry x="740" y="908" width="680" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="Every scan traveling through this channel is cut off when the pod&lt;br&gt;restarts. An Attack Library run takes roughly five hours, so an&lt;br&gt;upgrade in the middle of one loses most of a working day.&lt;br&gt;&lt;br&gt;Settle the version before scanning starts. If the engagement might&lt;br&gt;need a Custom Target Adapter later, install v1.4.0 or higher with&lt;br&gt;the sidecar already enabled, even if no adapter exists yet. Enabling&lt;br&gt;it costs one small container; enabling it later costs the scan that&lt;br&gt;was running at the time." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="756" y="938" width="650" height="134" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
